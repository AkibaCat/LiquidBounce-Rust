--- /dev/null
+++ b/crates/horizon-hooks/src/gpu_ui.rs
@@ -0,0 +1,89 @@
+//! GPU GUI layers after the HUD and menus, before screenshots and HDR display encoding.
+//!
+//! A layer owns its textures, pipelines and browser state. Nothing is packed into the GUI atlas,
+//! so an offscreen browser can paint at the full viewport resolution. Register before running
+//! the game. The engine calls the layers in registration order on the game's render thread.
+//! No layer registered means no extra GPU pass and no change to the original picture.
+use crate::TooLate;
+use crate::registry::Registry;
+
+/// The same wgpu version as the renderer; consumers need no separate GPU dependency.
+pub use wgpu;
+
+/// The extra attachment on the float HDR lane. See [`Frame::coverage_view`].
+pub const COVERAGE_FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::R8Unorm;
+
+/// The final GUI target, borrowed only for this callback. GPU resources must belong to `device`.
+/// A recreated renderer can supply a new device; drop textures/pipelines from its old device.
+pub struct Frame<'a> {
+    pub device: &'a wgpu::Device,
+    pub queue: &'a wgpu::Queue,
+    /// Encode into this buffer; do not submit it or acquire/present another surface frame.
+    pub encoder: &'a mut wgpu::CommandEncoder,
+    /// The HUD's independent target with layered HDR, otherwise the current frame target.
+    /// Do not overwrite it or read it back as HDR output. It need not support TEXTURE_BINDING.
+    pub color: &'a wgpu::Texture,
+    pub color_view: &'a wgpu::TextureView,
+    /// The format of `color_view`, which can differ from the swapchain's sRGB view.
+    pub color_format: wgpu::TextureFormat,
+    /// With layered HDR, attach this as colour attachment 1, Load/Store, and output the GUI
+    /// sample's opacity at location 1. Blend RED as One + OneMinusSrc, Add, preserving the
+    /// existing coverage. Otherwise omit attachment/output 1. Never clear either target.
+    pub coverage_view: Option<&'a wgpu::TextureView>,
+    /// Physical pixels of this target. Fullscreen viewport/scissor: (0, 0, size[0], size[1]).
+    /// This can differ from `window_size` for splitscreen/offscreen rendering or captures.
+    pub size: [u32; 2],
+    pub window_size: [u32; 2],
+    /// Opaque window identity for per-window state, valid only for this process.
+    pub window_id: u64,
+    /// OS device pixel ratio; independent of Minecraft's GUI scale.
+    pub window_scale: f64,
+    /// Physical pixels per Minecraft GUI pixel for this frame.
+    pub gui_scale: f32,
+    /// The local splitscreen player (`crate::seat`) whose frame is being drawn.
+    pub seat: usize,
+    pub title: bool,
+    /// A frame-generation image: draw the latest GUI, but don't advance its simulation twice.
+    pub generated: bool,
+    pub offscreen: bool,
+    pub hdr: bool,
+}
+
+/// Draw an independent GUI texture over the existing picture, including title/menu frames.
+/// Return quickly, never panic, and use Load/Store on every supplied attachment. Upload browser
+/// pixels through `queue` and sample that texture, rather than sampling the world target.
+///
+/// Colour is vanilla's stored gamma here, before PQ/scRGB encoding (docs/hdr-passes.md). CEF
+/// BGRA8 is premultiplied: use a non-sRGB Bgra8Unorm texture and blend colour/alpha as One +
+/// OneMinusSrcAlpha, Add. On the layered HDR lane also update coverage as documented above;
+/// otherwise HDR would keep the world's light over opaque GUI. Do not filter or clamp the
+/// world's picture or change HDR's retained world texture. Keep finite nonnegative output.
+///
+/// Resources are per device/window/seat. Respect `device.limits().max_texture_dimension_2d`
+/// when resizing, release old surfaces, and do not hold a browser mutex while it paints.
+pub trait Layer: Sync {
+    fn draw(&self, frame: &mut Frame<'_>);
+}
+
+static LAYERS: Registry<dyn Layer> = Registry::new();
+
+/// Adds a layer above those registered before it. Call before the game starts.
+pub fn register(layer: &'static dyn Layer) -> Result<(), TooLate> {
+    LAYERS.register(layer)
+}
+
+/// The engine's dispatch side. Only the engine calls it.
+pub mod engine {
+    use super::*;
+
+    /// Seals registration on first use. With no layers, no render context is built.
+    pub fn any() -> bool {
+        !LAYERS.all().is_empty()
+    }
+
+    pub fn draw(frame: &mut Frame<'_>) {
+        for layer in LAYERS.all() {
+            layer.draw(frame);
+        }
+    }
+}
