+        ctx.replace_clicked = sim.can_be_replaced(sim.state(input.clicked_pos), &ctx);
+        if !ctx.replace_clicked {
+            ctx.pos = rel(input.clicked_pos, input.face);
+        }
+        if binding.game_master && !input.can_use_game_master_blocks {
+            return None;
+        }
+        match binding.kind {
+            ItemKind::StandingAndWall | ItemKind::HangingSign => {
+                let wall = binding
+                    .wall_block
+                    .and_then(|block| sim.state_for_placement(block, &ctx));
+                let attachment = binding.attachment.unwrap_or(Direction::Down);
+                let mut chosen = None;
+                for direction in ctx.nearest_looking_directions() {
+                    if direction == attachment.opposite() {
+                        continue;
+                    }
+                    let candidate = if direction == attachment {
+                        sim.state_for_placement(binding.block, &ctx)
+                    } else {
+                        wall
+                    };
+                    if let Some(candidate) = candidate {
+                        let hanging_ok = binding.kind != ItemKind::HangingSign
+                            || !self.instance_of(candidate, Class::WallHangingSign)
+                            || sim.wall_hanging_sign_can_place(candidate, ctx.pos);
+                        if hanging_ok && sim.can_survive(candidate, ctx.pos) {
+                            chosen = Some(candidate);
+                            break;
+                        }
+                    }
+                }
+                chosen.filter(|state| unobstructed(sim.level, ctx.pos, *state, false))
+            }
+            _ => {
+                let must_survive = binding.kind != ItemKind::Scaffolding;
+                sim.state_for_placement(binding.block, &ctx)
+                    .filter(|state| {
+                        (!must_survive || sim.can_survive(*state, ctx.pos))
+                            && unobstructed(sim.level, ctx.pos, *state, true)
+                    })
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/stronghold_finder.rs b/crates/horizon-client/src/game/stronghold_finder.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/stronghold_finder.rs
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::{
+    chunk::Section,
+    hud::{HudBatch, Rect},
+    world_primitives::{PrimitiveShape, WorldPrimitives},
+};
+use horizon_protocol::packets::play::Clientbound as C;
+use horizon_world::registry::BlockStateId;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::{Arc, Weak},
+};
+#[derive(Default)]
+pub(super) struct Cache {
+    sections: BTreeMap<(i32, i32, i32), (Weak<Section>, Vec<([i32; 3], String)>)>,
+    events: Vec<Value>,
+    hud: Vec<String>,
+}
+impl Game<'_> {
+    fn client_stronghold_eligible(&self) -> bool {
+        self.client_smart_eat_player() && self.dim == super::Dim::Overworld
+    }
+    fn client_stronghold_enabled(&self) -> bool {
+        if !self.client_stronghold_eligible() {
+            return false;
+        }
+        let mut out = String::new();
+        self.native_client_stronghold_finder("{\"action\":\"options\"}", &mut out);
+        out == "true"
+    }
+    // Item callbacks may run inside another module's host action. Queue facts
+    // locally and dispatch on tick, after that actor lock has been released.
+    pub(super) fn client_stronghold_used(&self, eye: bool, consumes: bool) {
+        if !eye || !consumes || !self.client_stronghold_eligible() {
+            return;
+        }
+        if let Some(p) = self.player.as_ref() {
+            self.client_stronghold_cache.borrow_mut().events.push(json!({"action":"used","position":[p.position.x,p.position.y,p.position.z],"tick":p.health.tick_count}));
+        }
+    }
+    pub(super) fn client_stronghold_packet(&self, packet: &C) {
+        if !self.client_stronghold_eligible() {
+            return;
+        }
+        let C::AddEntity(p) = packet else {
+            return;
+        };
+        let eye = self
+            .remote
+            .as_ref()
+            .and_then(|r| r.builtin.get("minecraft:entity_type"))
+            .and_then(|r| r.name(p.kind))
+            == Some("minecraft:eye_of_ender");
+        if !eye {
+            return;
+        }
+        let tick = self.player.as_ref().map_or(0, |p| p.health.tick_count);
+        self.client_stronghold_cache
+            .borrow_mut()
+            .events
+            .push(json!({"action":"spawn","id":p.id,"position":p.position,"tick":tick}));
+    }
+    pub(super) fn client_stronghold_local_spawn(&self, id: u32, position: [f64; 3]) {
+        if self.remote.is_none() && self.client_stronghold_eligible() {
+            let tick = self.player.as_ref().map_or(0, |p| p.health.tick_count);
+            self.client_stronghold_cache
+                .borrow_mut()
+                .events
+                .push(json!({"action":"spawn","id":id,"position":position,"tick":tick}));
+        }
+    }
+    fn client_stronghold_emit(&self, input: Value) {
+        self.native_client_stronghold_finder(&input.to_string(), &mut String::new());
+    }
+    pub(super) fn client_stronghold_tick(&self) {
+        let events = std::mem::take(&mut self.client_stronghold_cache.borrow_mut().events);
+        if !self.client_stronghold_enabled() {
+            self.client_stronghold_cache.borrow_mut().sections.clear();
+            return;
+        }
+        // The integrated server can create the eye before Item.use RETURN.
+        // Consume recorded throws before queued spawn delivery in this turn.
+        for e in events
+            .iter()
+            .filter(|e| e["action"] == "used")
+            .chain(events.iter().filter(|e| e["action"] != "used"))
+        {
+            self.client_stronghold_emit(e.clone());
+        }
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        let eyes = self
+            .end
+            .eyes_tracked()
+            .map(
+                |(id, position, velocity)| json!({"id":id,"position":position,"velocity":velocity}),
+            )
+            .collect::<Vec<_>>();
+        self.client_stronghold_emit(
+            json!({"action":"tick","tick":p.health.tick_count,"eyes":eyes}),
+        );
+    }
+    fn client_stronghold_portals(&self) {
+        let matches = |id: u32| {
+            matches!(
+                self.res.facts().get(BlockStateId(id)).name.as_ref(),
+                "minecraft:end_portal" | "minecraft:end_portal_frame"
+            )
+        };
+        let mut cache = self.client_stronghold_cache.borrow_mut();
+        let mut present = BTreeSet::new();
+        let mut changed = Vec::new();
+        for (&(cx, cz), chunk) in self.world.chunks.iter() {
+            for (sy, section) in chunk.sections.iter().enumerate() {
+                let key = (cx, chunk.min_y() + sy as i32 * 16, cz);
+                present.insert(key);
+                let weak = Arc::downgrade(section);
+                if cache
+                    .sections
+                    .get(&key)
+                    .is_some_and(|(old, _)| Weak::ptr_eq(old, &weak))
+                {
+                    continue;
+                }
+                let mut positions = Vec::new();
+                if section.blocks.maybe_has(matches) {
+                    for i in 0..4096 {
+                        if matches(section.get(i)) {
+                            let pos = [
+                                cx.wrapping_mul(16).wrapping_add((i & 15) as i32),
+                                key.1 + (i >> 8) as i32,
+                                cz.wrapping_mul(16).wrapping_add((i >> 4 & 15) as i32),
+                            ];
+                            positions.push((
+                                pos,
+                                self.res
+                                    .facts()
+                                    .get(BlockStateId(section.get(i)))
+                                    .name
+                                    .to_string(),
+                            ));
+                        }
+                    }
+                }
+                if let Some((_, old)) = cache.sections.insert(key, (weak, positions.clone())) {
+                    for (pos, _) in old {
+                        changed.push(json!({"position":pos,"name":"minecraft:air"}));
+                    }
+                }
+                for (pos, name) in positions {
+                    changed.push(json!({"position":pos,"name":name}));
+                }
+            }
+        }
+        let removed = cache
+            .sections
+            .keys()
+            .filter(|k| !present.contains(k))
+            .copied()
+            .collect::<Vec<_>>();
+        for key in removed {
+            if let Some((_, old)) = cache.sections.remove(&key) {
+                for (pos, _) in old {
+                    changed.push(json!({"position":pos,"name":"minecraft:air"}));
+                }
+            }
+        }
+        drop(cache);
+        if !changed.is_empty() {
+            self.client_stronghold_emit(json!({"action":"blocks","blocks":changed}));
+        }
+    }
+    pub(super) fn client_stronghold_geometry(&self, out: &mut WorldPrimitives, partial: f64) {
+        self.client_stronghold_cache.borrow_mut().hud.clear();
+        if !self.client_stronghold_enabled() {
+            return;
+        }
+        self.client_stronghold_portals();
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        let player = [
+            self.previous_position.x + (p.position.x - self.previous_position.x) * partial,
+            self.previous_position.y + (p.position.y - self.previous_position.y) * partial,
+            self.previous_position.z + (p.position.z - self.previous_position.z) * partial,
+        ];
+        let mut data = String::new();
+        self.native_client_stronghold_finder(
+            &json!({"action":"render","player":player}).to_string(),
+            &mut data,
+        );
+        let Ok(v) = serde_json::from_str::<Value>(&data) else {
+            return;
+        };
+        if let Ok(hud) = serde_json::from_value::<Vec<String>>(v["hud"].clone()) {
+            self.client_stronghold_cache.borrow_mut().hud = hud;
+        }
+        for line in v["lines"].as_array().into_iter().flatten() {
+            if let (Ok(start), Ok(end), Some(color)) = (
+                serde_json::from_value(line["start"].clone()),
+                serde_json::from_value(line["end"].clone()),
+                line["color"].as_u64(),
+            ) {
+                out.line(start, end, color as u32, 1.).through_walls();
+            }
+        }
+        for plane in v["planes"].as_array().into_iter().flatten() {
+            let (Ok([x, y, z]), Some(size), Some(color)) = (
+                serde_json::from_value::<[f64; 3]>(plane["position"].clone()),
+                plane["size"].as_f64(),
+                plane["color"].as_u64(),
+            ) else {
+                continue;
+            };
+            let color = color as u32;
+            let dark = (color & 0xff000000)
+                | ((color >> 16 & 255) * 7 / 10 << 16)
+                | ((color >> 8 & 255) * 7 / 10 << 8)
+                | ((color & 255) * 7 / 10);
+            let corners = [
+                [x, y, z],
+                [x + size, y, z],
+                [x + size, y, z + size],
+                [x, y, z + size],
+            ];
+            out.push(PrimitiveShape::LiquidBounceQuad {
+                corners,
+                colors: [color; 4],
+            })
+            .through_walls();
+            for i in 0..4 {
+                out.line(corners[i], corners[(i + 1) % 4], dark, 1.)
+                    .through_walls();
+            }
+        }
+    }
+    pub(super) fn client_stronghold_overlay(&self, batch: &mut HudBatch) {
+        if !self.client_stronghold_enabled() {
+            return;
+        }
+        let cache = self.client_stronghold_cache.borrow();
+        let (ascent, height) = self.gui.atlas.font.liquidbounce_target_metrics();
+        let scale = 9. / height;
+        for (index, text) in cache.hud.iter().enumerate() {
+            let glyphs = text
+                .chars()
+                .map(|c| self.gui.atlas.font.liquidbounce_target_glyph(c, false))
+                .collect::<Vec<_>>();
+            let width = glyphs.iter().map(|g| g.advance).sum::<f32>() * scale;
+            let left = batch.width * 0.5 - width * 0.5;
+            let baseline = batch.height * 0.5 + 10. + index as f32 * 10. + ascent * scale;
+            for shadow in [true, false] {
+                let mut x = left + if shadow { scale } else { 0. };
+                let y = baseline + if shadow { scale } else { 0. };
+                let color = if shadow { 0xff3f3f3f } else { 0xffffffff };
+                for g in &glyphs {
+                    if let Some(Rect { u0, v0, u1, v1, .. }) = g.rect {
+                        let x0 = x + g.left * scale;
+                        let x1 = x + g.right * scale;
+                        let y0 = y + g.top * scale;
+                        let y1 = y + g.bottom * scale;
+                        batch.quad(
+                            [[x0, y0], [x1, y0], [x1, y1], [x0, y1]],
+                            [[u0, v0], [u1, v0], [u1, v1], [u0, v1]],
+                            color,
+                        );
+                    }
+                    x += g.advance * scale;
+                }
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/kill_aura.rs b/crates/horizon-client/src/game/kill_aura.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/kill_aura.rs
@@ -0,0 +1,1559 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! KillAura's live entity, ray, held-item and game-mode action boundary.
+use super::{
+    Game,
+    auto_bow_math::{B, V},
+};
+use horizon_client::{first_person::Hand, mod_api::ServerboundPlayPacket as S};
+use horizon_core::geometry::{Aabb, Vec3};
+use horizon_protocol::packets::play;
+use horizon_world::world_ray::{RayBlockMode, RayFluidMode};
+use serde_json::{Value, json};
+fn v(p: Vec3) -> V {
+    V(p.x, p.y, p.z)
+}
+fn p(v: V) -> Vec3 {
+    Vec3::new(v.0, v.1, v.2)
+}
+fn bounds(b: Aabb) -> B {
+    B {
+        lo: v(b.min_position()),
+        hi: v(b.max_position()),
+    }
+}
+fn outline(g: &Game<'_>, a: V, b: V) -> bool {
+    super::client_ghost_hand::clip(
+        g,
+        &mut super::no_web_ray::NoWebRay(g),
+        p(a),
+        p(b),
+        RayBlockMode::Outline,
+        RayFluidMode::None,
+        4096,
+    )
+    .is_ok_and(|h| h.miss)
+}
+fn angles(g: &Game<'_>, q: &Value) -> (f32, f32) {
+    (
+        q["rotation"][0].as_f64().unwrap_or(f64::from(g.yaw)) as f32,
+        q["rotation"][1].as_f64().unwrap_or(f64::from(g.pitch)) as f32,
+    )
+}
+impl Game<'_> {
+    fn kill_aura_block_animation(&self, stack: &horizon_client::items::ItemStack) -> bool {
+        let view = horizon_client::item_render::stack_view(stack);
+        let components = self.pack.item_renderer.models.components_view(&view);
+        let generic = match &*stack.item {
+            "minecraft:bow"
+            | "minecraft:bundle"
+            | "minecraft:white_bundle"
+            | "minecraft:orange_bundle"
+            | "minecraft:magenta_bundle"
+            | "minecraft:light_blue_bundle"
+            | "minecraft:yellow_bundle"
+            | "minecraft:lime_bundle"
+            | "minecraft:pink_bundle"
+            | "minecraft:gray_bundle"
+            | "minecraft:light_gray_bundle"
+            | "minecraft:cyan_bundle"
+            | "minecraft:purple_bundle"
+            | "minecraft:blue_bundle"
+            | "minecraft:brown_bundle"
+            | "minecraft:green_bundle"
+            | "minecraft:red_bundle"
+            | "minecraft:black_bundle"
+            | "minecraft:spyglass"
+            | "minecraft:trident"
+            | "minecraft:crossbow"
+            | "minecraft:goat_horn"
+            | "minecraft:brush" => false,
+            _ => true,
+        };
+        let mut animation = if stack.item.as_ref() == "minecraft:shield" {
+            horizon_world::consumable::UseAnimation::Block
+        } else if generic {
+            components.get("minecraft:consumable").map_or(
+                horizon_world::consumable::UseAnimation::None,
+                horizon_client::first_person::consumable_animation,
+            )
+        } else {
+            horizon_world::consumable::UseAnimation::None
+        };
+        self.native_use_animation(stack, &mut animation);
+        animation == horizon_world::consumable::UseAnimation::Block
+    }
+    fn kill_aura_interact_pick(&self, q: &Value) -> Option<super::ClientReachPick> {
+        let raycast = q["raycast"].as_u64().unwrap_or(2);
+        if raycast == 0 {
+            return None;
+        }
+        let eye = self.eye_position().map(|a| V(a[0], a[1], a[2]))?;
+        let (yaw, pitch) = angles(self, q);
+        let range = q["range"].as_f64().unwrap_or(3.);
+        let end = eye.fma(range, v(Vec3::direction_from_rotation(pitch, yaw)));
+        self.kill_aura_candidates()
+            .into_iter()
+            .filter(|c| {
+                raycast != 1
+                    || q["eligible"]
+                        .as_array()
+                        .into_iter()
+                        .flatten()
+                        .any(|v| v.as_i64() == Some(i64::from(c.id)))
+            })
+            .filter_map(|c| {
+                let b =
+                    bounds(c.bounds).inflate(self.client_pick_margin(c.id, c.pick_radius as f32));
+                let point = if b.contains(eye) {
+                    Some(eye)
+                } else if c.same_root_vehicle {
+                    None
+                } else {
+                    b.clip(eye, end)
+                }?;
+                let distance_squared = point.sub(eye).len2();
+                Some(super::ClientReachPick {
+                    kind: c.kind,
+                    index: c.index,
+                    id: c.id,
+                    local_id: c.local_id,
+                    distance: distance_squared.sqrt(),
+                    distance_squared,
+                    point: point.array(),
+                    location: std::array::from_fn(|i| point.array()[i] - c.position[i]),
+                })
+            })
+            .min_by(|a, b| a.distance_squared.total_cmp(&b.distance_squared))
+    }
+    fn kill_aura_item_enabled(&self, stack: &horizon_client::items::ItemStack) -> bool {
+        let name = stack.item.as_ref();
+        let flags = super::client_vomit_blocks::CLIENT_ITEM_FEATURES
+            .binary_search_by_key(&name, |(name, _)| *name)
+            .ok()
+            .map_or(&[][..], |i| {
+                super::client_vomit_blocks::CLIENT_ITEM_FEATURES[i].1
+            });
+        let enabled = self
+            .remote
+            .as_ref()
+            .map_or(&self.level.enabled_features, |r| &r.features);
+        flags.iter().all(|flag| enabled.iter().any(|v| v == flag))
+    }
+    fn kill_aura_block_hand(&self, assume: bool) -> Option<i32> {
+        for (hand, slot) in [
+            (0, self.client_hotbar_slot()),
+            (1, super::shield::OFFHAND_SLOT),
+        ] {
+            let Some(s) = self.stack_in(slot) else {
+                continue;
+            };
+            if !self.kill_aura_item_enabled(s) {
+                continue;
+            }
+            let default = self
+                .items()
+                .get(&s.item)
+                .and_then(|i| i.use_cooldown.clone());
+            let group = horizon_client::cooldowns::group(s, default.as_ref());
+            if self.kill_aura_block_animation(s)
+                && self.shield_cooldown == 0
+                && !self.cooldowns.is_on_cooldown(&group)
+            {
+                return Some(hand);
+            }
+        }
+        // The compatibility fallback applies only when blocks_attacks does
+        // not exist; the actual negotiated 26.3 protocol has that component.
+        let _ = assume;
+        None
+    }
+    fn kill_aura_box(&self, id: i32) -> Option<(B, bool)> {
+        if let Some(e) = super::auto_bow::entities(self)
+            .into_iter()
+            .find(|e| e.id == id)
+        {
+            return Some((bounds(e.bounds), true));
+        }
+        self.kill_aura_candidates()
+            .into_iter()
+            .find(|c| c.id == id)
+            .map(|c| {
+                (
+                    bounds(c.bounds),
+                    self.native_entity(id as u32)
+                        .and_then(|e| self.native_living(e))
+                        .is_some(),
+                )
+            })
+    }
+    fn kill_aura_hit(
+        &self,
+        id: i32,
+        eye: V,
+        rotation: (f32, f32),
+        range: f64,
+        walls: f64,
+    ) -> Option<(bool, f64, Option<f64>)> {
+        let (physical, _) = self.kill_aura_box(id)?;
+        // EnderDragon itself is not pickable in 26.3. Its real parts own
+        // the entity ray; the parent remains an attack-only target alias.
+        if self
+            .dragon
+            .as_ref()
+            .is_some_and(|dragon| dragon.id as i32 == id)
+            || self.mobs.iter().any(|mob| {
+                mob.id as i32 == id
+                    && horizon_client::command::args::normalize(&mob.kind.id)
+                        == "minecraft:ender_dragon"
+            })
+        {
+            return Some((false, physical.distance(eye), None));
+        }
+        let b = physical.inflate(self.client_pick_margin(id, 0.));
+        let end = eye.fma(
+            range,
+            v(Vec3::direction_from_rotation(rotation.1, rotation.0)),
+        );
+        let shared = self.riding.is_some_and(|r| {
+            self.client_reach_root_vehicle(r) == self.client_reach_root_vehicle(id as u32)
+        });
+        let hit = if b.contains(eye) {
+            Some(eye)
+        } else if shared {
+            None
+        } else {
+            b.clip(eye, end)
+        };
+        Some((
+            hit.is_some_and(|h| {
+                let d = h.sub(eye).len2();
+                d <= walls * walls || d <= range * range && outline(self, eye, h)
+            }),
+            physical.distance(eye),
+            hit.map(|h| h.sub(eye).len2()),
+        ))
+    }
+    fn kill_aura_held_range(&self, distance: f64, increase: f32) -> bool {
+        let range = self
+            .stack_in(self.client_hotbar_slot())
+            .and_then(|s| self.stack_attack_range(s));
+        let value = |key: &str, default: f32| {
+            range
+                .as_ref()
+                .and_then(|r| r[key].as_f64())
+                .map_or(default, |v| v as f32)
+        };
+        let (mut min, mut max, mut cmin, mut cmax) = (
+            value("min_reach", 0.),
+            value("max_reach", 3.),
+            value("min_creative_reach", 0.),
+            value("max_creative_reach", 5.),
+        );
+        self.native_client_attack_range(&mut min, &mut max, &mut cmin, &mut cmax);
+        let margin = value("hitbox_margin", 0.3);
+        let (min, max) = if self.creative {
+            (cmin, cmax)
+        } else {
+            (min, max)
+        };
+        distance >= f64::from(min.max(0.) - margin)
+            && distance <= f64::from(max + increase + margin)
+    }
+    fn kill_aura_use(&mut self, q: &Value) -> bool {
+        let (yaw, pitch) = angles(self, q);
+        let Some(hand) = q["hand"]
+            .as_i64()
+            .filter(|h| [0, 1].contains(h))
+            .map(|h| h as i32)
+        else {
+            return false;
+        };
+        let hands = if q["vanilla"] == true {
+            vec![0, 1]
+        } else {
+            vec![hand]
+        };
+        let interact = q["mode"].as_u64() == Some(1);
+        let picked = interact.then(|| self.kill_aura_interact_pick(q)).flatten();
+        if picked.is_some_and(|hit| {
+            !self.border.contains(
+                (hit.point[0] - hit.location[0]).floor(),
+                (hit.point[2] - hit.location[2]).floor(),
+            )
+        }) {
+            return false;
+        }
+        let old_pick = self.client_kill_aura_pick;
+        let old_ignore = self.client_kill_aura_ignore_entities;
+        let old_block_reach = self.block_reach;
+        if interact {
+            self.client_kill_aura_pick = picked;
+            self.client_kill_aura_ignore_entities = true;
+            self.block_reach = if picked.is_some() {
+                f64::MAX
+            } else {
+                self.block_reach.max(self.entity_reach)
+            };
+        }
+        let tick_hit = self.tick_hit.take();
+        let tick_mob = self.tick_mob.take();
+        let used = self.native_with_item_rotation(yaw, pitch, |g| {
+            for use_hand in hands {
+                g.use_failed = false;
+                let hand_enum = if use_hand == 0 { Hand::Main } else { Hand::Off };
+                let block = (interact && picked.is_none()).then(|| g.pick()).flatten();
+                let facing = picked.is_some() || block.is_some();
+                let interacted = if interact && g.remote.is_some() {
+                    let entity = picked.is_some();
+                    if let Some(picked) =
+                        picked.filter(|hit| matches!(hit.kind, 10 | 11 | KILL_AURA_GUEST))
+                    {
+                        // Players, EndCrystals and dragon parts pass the
+                        // client interaction. remote_object_hit's generic
+                        // consuming answer does not apply to these types.
+                        g.send(S::Interact(play::Interact {
+                            id: picked.id,
+                            hand: use_hand,
+                            location: picked.location,
+                            secondary: g.player.as_ref().is_some_and(|p| p.shift_key_down),
+                        }));
+                        false
+                    } else if entity {
+                        g.remote_use_entity(hand_enum)
+                    } else if block.is_some() {
+                        g.remote_use_item_on(hand_enum)
+                    } else {
+                        false
+                    }
+                } else if interact {
+                    if let Some(picked) = picked {
+                        g.with_hand(hand_enum, |g| {
+                            g.interact_entity(Some(super::InteractTarget {
+                                id: picked.id,
+                                location: picked.location,
+                            }))
+                            .unwrap_or(false)
+                        })
+                    } else if let Some(hit) = block.as_ref() {
+                        // Separate useItemOn from Item.use, as the upstream
+                        // strict interaction helper does for each hand.
+                        let guest = g.guest_use;
+                        g.guest_use = Some(super::GuestUse::OnBlock(hand_enum));
+                        let result =
+                            g.with_hand(hand_enum, |g| g.use_hand(Some(hit)).unwrap_or(false));
+                        g.guest_use = guest;
+                        result
+                    } else {
+                        false
+                    }
+                } else {
+                    false
+                };
+                if interacted {
+                    return use_hand == hand && q["vanilla"] != true && !g.use_failed;
+                }
+                if facing && q["vanilla"] != true {
+                    return false;
+                }
+                if g.native_client_use_item(use_hand, yaw, pitch) {
+                    return use_hand == hand;
+                }
+            }
+            false
+        });
+        self.tick_hit = tick_hit;
+        self.tick_mob = tick_mob;
+        self.client_kill_aura_pick = old_pick;
+        self.client_kill_aura_ignore_entities = old_ignore;
+        self.block_reach = old_block_reach;
+        used
+    }
+    fn kill_aura_keep_visual(&mut self, id: i32, area: Aabb, critical: bool) {
+        let kind = self
+            .level_entity(id)
+            .map(|e| self.target_type(e))
+            .unwrap_or_default();
+        let spin = self.player.as_ref().map_or(0., |p| p.auto_spin_attack_dmg);
+        let base = if spin > 0. {
+            spin
+        } else {
+            self.attack_damage()
+        };
+        let speed = self
+            .player
+            .as_mut()
+            .and_then(|p| p.attribute("minecraft:attack_speed").ok())
+            .unwrap_or_else(|| self.main_hand_attack_speed());
+        let strength = self.hand_strength.scale(0.5, speed);
+        let magic = (self.enchanted_damage(&kind, base) - base) * strength;
+        let damage = base * (0.2 + strength * strength * 0.8);
+        if damage > 0. || magic > 0. {
+            if magic > 0. {
+                self.area_critical_hit(id, area, true);
+            }
+            if critical {
+                let at = self
+                    .player
+                    .as_ref()
+                    .map(|p| [p.position.x, p.position.y, p.position.z]);
+                self.audio
+                    .play("minecraft:entity.player.attack.crit", at, 1., 1.);
+                self.area_critical_hit(id, area, false);
+            }
+        }
+    }
+    fn kill_aura_attack(&mut self, id: u32, keep: bool, critical: bool) -> bool {
+        self.kill_aura_attack_with_swing(id,keep,critical,0)
+    }
+    pub(super) fn kill_aura_attack_with_swing(&mut self,id:u32,keep:bool,critical:bool,swing:u8)->bool{
+        if self.client_projectile_puncher_piercing() {
+            return true;
+        }
+        let Some(c) = self.kill_aura_attack_candidate(id) else {
+            return false;
+        };
+        let living = self
+            .native_entity(id)
+            .and_then(|e| self.native_living(e))
+            .is_some();
+        if !self.client_weapon_before_attack(id, living) {
+            return false;
+        }
+        let old_keep = self.client_kill_aura_keep_sprint;
+        let old_hook = self.client_kill_aura_attack_hook;
+        self.client_kill_aura_keep_sprint = keep;
+        self.client_kill_aura_attack_hook = Some(id);
+        if horizon_core::version::PROTOCOL_VERSION <= 47 {
+            self.client_projectile_puncher_swing(swing);
+        }
+        self.native_client_ensure_carried();
+        if self.remote.is_some() {
+            self.send(S::Attack(play::Attack { id: id as i32 }));
+            if keep {
+                self.kill_aura_keep_visual(id as i32, c.bounds, critical);
+            }
+            if !self.spectator() {
+                let is_player = self
+                    .mobs
+                    .iter()
+                    .find(|m| m.id == id)
+                    .is_some_and(|m| m.kind.id.as_str() == "minecraft:player");
+                self.native_client_attack(id, is_player);
+                if let Some(i) = self.mobs.iter().position(|m| m.id == id) {
+                    if !keep {
+                        self.remote_player_attack(i);
+                    }
+                }
+            }
+        } else {
+            // Scope the existing exact native object/mob actions to this
+            // chosen EntityHitResult, preserving integrated-world simulation.
+            let point = bounds(c.bounds).center();
+            let eye = self
+                .eye_position()
+                .map(|a| V(a[0], a[1], a[2]))
+                .unwrap_or(point);
+            let d = point.sub(eye).len2();
+            let old_pick = self.client_kill_aura_pick;
+            let tick_hit = self.tick_hit.take();
+            let tick_mob = self.tick_mob.take();
+            let old_range = (self.block_reach, self.entity_reach);
+            self.client_kill_aura_pick = Some(super::ClientReachPick {
+                kind: c.kind,
+                index: c.index,
+                id: c.id,
+                local_id: c.local_id,
+                distance: d.sqrt(),
+                distance_squared: d,
+                point: point.array(),
+                location: std::array::from_fn(|i| point.array()[i] - c.position[i]),
+            });
+            let old_implicit = self.client_projectile_puncher_hide_implicit;
+            self.client_projectile_puncher_hide_implicit = true;
+            self.block_reach = f64::MAX;
+            self.entity_reach = f64::MAX;
+            if self.kill_aura_extra_local_attack(c).is_none() {
+                let is_player = self
+                    .mobs
+                    .iter()
+                    .find(|m| m.id == id)
+                    .is_some_and(|m| m.kind.id.as_str() == "minecraft:player");
+                self.native_client_attack(id, is_player);
+                let _ = self.attack();
+            }
+            self.block_reach = old_range.0;
+            self.entity_reach = old_range.1;
+            self.client_kill_aura_pick = old_pick;
+            self.client_projectile_puncher_hide_implicit = old_implicit;
+            self.tick_hit = tick_hit;
+            self.tick_mob = tick_mob;
+        }
+        self.reset_attack_strength();
+        if horizon_core::version::PROTOCOL_VERSION > 47 {
+            self.client_projectile_puncher_swing(swing);
+        }
+        self.client_kill_aura_keep_sprint = old_keep;
+        self.client_kill_aura_attack_hook = old_hook;
+        true
+    }
+    pub(super) fn kill_aura_query(&mut self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        if q["op"] == "raytrace" || q["op"] == "point" {
+            return self.aimbot_query(text);
+        }
