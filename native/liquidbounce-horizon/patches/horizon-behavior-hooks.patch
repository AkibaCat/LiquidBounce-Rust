diff --git a/crates/horizon-client-render/src/gfx/jump_effect.rs b/crates/horizon-client-render/src/gfx/jump_effect.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/jump_effect.rs
@@ -0,0 +1,613 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleJumpEffect: floating endpoint gradients, then original ShaderLayer's RGBA8
+//! silhouettes -> nearest rows -> Euclidean field -> style -> straight-alpha scene blend.
+use glam::{DVec3, Mat4, Vec2, Vec4};
+use std::{borrow::Cow, cell::RefCell};
+use wgpu::util::DeviceExt;
+#[derive(Clone,Debug,serde::Deserialize)]
+pub struct Quad{pub corners:[[f64;3];4],pub colors:[[f32;4];4],pub uv:[[f32;2];4],pub inner_color:[f32;4],pub inner:f32,pub shape:u32}
+#[derive(Clone,Debug,serde::Deserialize)]pub struct Effect{pub style:usize,pub params:[f32;8],pub accent:[f32;4],pub range:f32,pub opacity:f32}
+#[derive(Default,Debug,serde::Deserialize)]pub struct Frame{pub quads:Vec<Quad>,pub effect:Option<Effect>,pub depth:bool,pub texture:String}
+thread_local!{static PENDING:RefCell<Option<Frame>>=const{RefCell::new(None)};}
+pub fn begin_frame(json:&str){PENDING.with_borrow_mut(|f|*f=serde_json::from_str(json).ok());}
+#[repr(C)]#[derive(Clone,Copy,Debug,bytemuck::Pod,bytemuck::Zeroable)]
+pub struct Vertex{pub clip:[f32;4],pub color:[f32;4],pub uv:[f32;2],pub inner_color:[f32;4],pub params:[f32;4]}
+pub fn vertices(frame:&Frame,projection:Mat4,camera:DVec3,_size:[u32;2])->Vec<Vertex>{
+    let mut out:Vec<Vertex>=frame.quads.iter().flat_map(|q|{let v:[Vertex;4]=std::array::from_fn(|i|Vertex{clip:(projection*(DVec3::from_array(q.corners[i])-camera).as_vec3().extend(1.)).to_array(),color:q.colors[i],uv:q.uv[i],inner_color:q.inner_color,params:[q.shape as f32,q.inner,0.,0.]});[0,1,2,0,2,3].map(|i|v[i])}).collect();
+    if frame.effect.is_some()&&!frame.depth{for v in &mut out{v.clip[1]=-v.clip[1];}}
+    out
+}
+const FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba8Unorm;
+const COMMON: &str = include_str!("jump-effect-shaders/effect.glsl");
+const SOURCES: [&str; 11] = [
+    include_str!("jump-effect-shaders/field_rows.frag"),
+    include_str!("jump-effect-shaders/field_columns.frag"),
+    include_str!("jump-effect-shaders/smooth.frag"),
+    include_str!("jump-effect-shaders/outline.frag"),
+    include_str!("jump-effect-shaders/neon.frag"),
+    include_str!("jump-effect-shaders/rainbow.frag"),
+    include_str!("jump-effect-shaders/ripple.frag"),
+    include_str!("jump-effect-shaders/hologram.frag"),
+    include_str!("jump-effect-shaders/halftone.frag"),
+    include_str!("jump-effect-shaders/chromatic.frag"),
+    include_str!("jump-effect-shaders/aura.frag"),
+];
+/// Only resource bindings and version change. Original field scans, RGB565 packing,
+/// 8-bit distance encoding, noise functions and all nine style formulas remain verbatim.
+pub fn fragment_source(index: usize) -> String {
+    let globals = "layout(std140,set=0,binding=1) uniform Globals {vec4 Clock;ivec4 CameraBlock;vec4 CameraFrac;};\n#define GameTime Clock.x\n#define CameraBlockPos CameraBlock.xyz\n#define CameraOffset CameraFrac.xyz\n";
+    let common = COMMON
+        .replace("#include <minecraft:globals.glsl>", globals)
+        .replace(
+            "layout(std140) uniform EffectData",
+            "layout(std140,set=0,binding=0) uniform EffectData",
+        );
+    let source=SOURCES[index].lines().filter(|l|!l.starts_with("#version")&&!l.starts_with("#extension")).collect::<Vec<_>>().join("\n").replace("#include <liquidbounce:effect/effect.glsl>",&common).replace("layout(std140) uniform EffectView","layout(std140,set=0,binding=2) uniform EffectView").replace("uniform sampler2D InSampler;","layout(set=0,binding=3) uniform texture2D InTexture;\nlayout(set=0,binding=4) uniform sampler InFilter;\n#define InSampler sampler2D(InTexture,InFilter)");
+    format!("#version 450\n{source}")
+}
+pub fn fragment_module(index: usize) -> Result<naga::Module, String> {
+    let source = fragment_source(index);
+    let module = naga::front::glsl::Frontend::default()
+        .parse(
+            &naga::front::glsl::Options::from(naga::ShaderStage::Fragment),
+            &source,
+        )
+        .map_err(|e| e.emit_to_string(&source))?;
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::all(),
+    )
+    .validate(&module)
+    .map_err(|e| e.to_string())?;
+    Ok(module)
+}
+struct Targets {
+    size: [u32; 2],
+    views: [wgpu::TextureView; 5],
+}
+pub struct JumpEffectRenderer {
+    layout: wgpu::BindGroupLayout,
+    pipelines: [wgpu::RenderPipeline; 11],
+    capture:[wgpu::RenderPipeline;2],
+    plain:[wgpu::RenderPipeline;2],
+    images:Images,
+    composite: wgpu::RenderPipeline,
+    flip_capture:wgpu::RenderPipeline,
+    sampler: wgpu::Sampler,
+    targets: Option<Targets>,
+    pending: Option<(Frame, wgpu::Buffer, u32)>,
+}
+impl JumpEffectRenderer {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat, linear: bool) -> Self {
+        let uniform = |binding| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: wgpu::ShaderStages::FRAGMENT,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        };
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("LiquidBounce ShaderLayer"),
+            entries: &[
+                uniform(0),
+                uniform(1),
+                uniform(2),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 3,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 4,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("LiquidBounce ShaderLayer"),
+            bind_group_layouts: &[Some(&layout)],
+            ..Default::default()
+        });
+        let images=Images::new(device);
+        let empty = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("JumpEffect mesh"),
+            bind_group_layouts: &[Some(&images.layout)],
+            ..Default::default()
+        });
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("JumpEffect"),
+            source: wgpu::ShaderSource::Wgsl(include_str!("jump-effect.wgsl").into()),
+        });
+        let attributes=wgpu::vertex_attr_array![0=>Float32x4,1=>Float32x4,2=>Float32x2,3=>Float32x4,4=>Float32x4];
+        let constants = [(
+            "FRAME_LINEAR",
+            f64::from(u8::from(
+                linear && format == wgpu::TextureFormat::Rgba16Float,
+            )),
+        )];
+        let make = |vertex: &str,
+                    fragment: &wgpu::ShaderModule,
+                    entry: &str,
+                    target: wgpu::TextureFormat,
+                    mesh: bool,
+                    blend: bool,
+                    depth:bool| {
+            let buffers = [Some(wgpu::VertexBufferLayout {
+                array_stride: 72,
+                step_mode: wgpu::VertexStepMode::Vertex,
+                attributes: &attributes,
+            })];
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("LiquidBounce JumpEffect"),
+                layout: Some(if mesh { &empty } else { &pipeline_layout }),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(vertex),
+                    compilation_options: Default::default(),
+                    buffers: if mesh { &buffers } else { &[] },
+                },
+                primitive: wgpu::PrimitiveState {
+                    cull_mode: None,
+                    ..Default::default()
+                },
+                depth_stencil:mesh.then_some(wgpu::DepthStencilState{format:wgpu::TextureFormat::Depth32Float,depth_write_enabled:Some(depth),depth_compare:Some(if depth{wgpu::CompareFunction::GreaterEqual}else{wgpu::CompareFunction::Always}),stencil:Default::default(),bias:Default::default()}),
+                multisample: Default::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: fragment,
+                    entry_point: Some(entry),
+                    compilation_options: wgpu::PipelineCompilationOptions {
+                        constants: if entry == "plain" || entry == "composite" {
+                            &constants
+                        } else {
+                            &[]
+                        },
+                        ..Default::default()
+                    },
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: target,
+                        blend: blend.then_some(wgpu::BlendState::ALPHA_BLENDING),
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let pipelines = std::array::from_fn(|i| {
+            let module =
+                fragment_module(i).unwrap_or_else(|e| panic!("LiquidBounce style {i}: {e}"));
+            let fragment = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("LiquidBounce original GLSL"),
+                source: wgpu::ShaderSource::Naga(Cow::Owned(module)),
+            });
+            make("screen", &fragment, "main", FORMAT, false, false,false)
+        });
+        let capture=std::array::from_fn(|depth|make("mesh",&shader,"capture",FORMAT,true,true,depth==1));
+        let plain=std::array::from_fn(|depth|make("mesh",&shader,"plain",format,true,true,depth==1));
+        let composite = make(
+            "composite_screen",
+            &shader,
+            "composite",
+            format,
+            false,
+            true,
+            false,
+        );
+        let flip_capture=make("composite_screen",&shader,"flip_capture",FORMAT,false,false,false);
+        Self {
+            layout,
+            pipelines,
+            capture,
+            plain,
+            images,
+            composite,
+            flip_capture,
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor::default()),
+            targets: None,
+            pending: None,
+        }
+    }
+    pub fn pending(&self) -> bool {
+        self.pending.is_some()
+    }
+    pub fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        queue:&wgpu::Queue,
+        projection: Mat4,
+        camera: DVec3,
+        size: [u32; 2],
+        title: bool,
+    ) {
+        self.pending = None;
+        let frame = PENDING.with_borrow_mut(Option::take);
+        let Some(mut frame) = frame.filter(|_| !title) else {
+            return;
+        };
+        let Some(texture)=self.images.prepare(device,queue,&frame.texture)else{return;};
+        frame.texture=texture;
+        let mesh = vertices(&frame, projection, camera, size);
+        if mesh.is_empty() {
+            return;
+        }
+        let count = mesh.len() as u32;
+        let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("JumpEffect mesh"),
+            contents: bytemuck::cast_slice(&mesh),
+            usage: wgpu::BufferUsages::VERTEX,
+        });
+        if frame.effect.is_some() && self.targets.as_ref().is_none_or(|t| t.size != size) {
+            let views = std::array::from_fn(|_| {
+                device
+                    .create_texture(&wgpu::TextureDescriptor {
+                        label: Some("LiquidBounce RGBA8 style target"),
+                        size: wgpu::Extent3d {
+                            width: size[0],
+                            height: size[1],
+                            depth_or_array_layers: 1,
+                        },
+                        mip_level_count: 1,
+                        sample_count: 1,
+                        dimension: wgpu::TextureDimension::D2,
+                        format: FORMAT,
+                        usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                            | wgpu::TextureUsages::TEXTURE_BINDING,
+                        view_formats: &[],
+                    })
+                    .create_view(&Default::default())
+            });
+            self.targets = Some(Targets { size, views });
+        }
+        self.pending = Some((frame, buffer, count));
+    }
+    pub fn draw(
+        &mut self,
+        device: &wgpu::Device,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        scene_depth:&wgpu::TextureView,
+        game_time: f32,
+        camera: DVec3,
+        view: Mat4,
+        fov: f32,
+    ) {
+        let Some((frame, buffer, count)) = self.pending.take() else {
+            return;
+        };
+        let depth=usize::from(frame.depth);
+        let Some((_,image_group))=self.images.textures.get(&frame.texture)else{return;};
+        let pass = |encoder: &mut wgpu::CommandEncoder,
+                    target: &wgpu::TextureView,
+                    pipeline: &wgpu::RenderPipeline,
+                    group: Option<&wgpu::BindGroup>,
+                    mesh: bool,
+                    clear: bool| {
+            let mut p = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("LiquidBounce JumpEffect"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: target,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: if clear {
+                            wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT)
+                        } else {
+                            wgpu::LoadOp::Load
+                        },
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                depth_stencil_attachment:mesh.then_some(wgpu::RenderPassDepthStencilAttachment{view:scene_depth,depth_ops:Some(wgpu::Operations{load:wgpu::LoadOp::Load,store:wgpu::StoreOp::Store}),stencil_ops:None}),
+                ..Default::default()
+            });
+            p.set_pipeline(pipeline);
+            if let Some(g) = group {
+                p.set_bind_group(0, g, &[]);
+            }
+            if mesh {
+                p.set_vertex_buffer(0, buffer.slice(..));
+                p.draw(0..count, 0..1);
+            } else {
+                p.draw(0..3, 0..1);
+            }
+        };
+        let Some(effect) = frame.effect else {
+            pass(encoder,target,&self.plain[depth],Some(image_group),true,false);
+            return;
+        };
+        let targets = self.targets.as_ref().unwrap();
+        let mut data = [0f32; 16];
+        data[..8].copy_from_slice(&effect.params);
+        data[8..12].copy_from_slice(&effect.accent);
+        data[12] = effect.range;
+        data[13] = effect.opacity;
+        let effect_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectData"),
+            contents: bytemuck::cast_slice(&data),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let blocks = camera.floor().as_ivec3();
+        let offset = blocks.as_dvec3() - camera;
+        let mut globals = [0u32; 12];
+        globals[0] = game_time.to_bits();
+        globals[4] = blocks.x as u32;
+        globals[5] = blocks.y as u32;
+        globals[6] = blocks.z as u32;
+        globals[8] = (offset.x as f32).to_bits();
+        globals[9] = (offset.y as f32).to_bits();
+        globals[10] = (offset.z as f32).to_bits();
+        let globals = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Globals"),
+            contents: bytemuck::cast_slice(&globals),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let inverse = view.inverse();
+        let right = inverse.x_axis;
+        let up = inverse.y_axis;
+        let forward = -inverse.z_axis;
+        let tangent = (fov.to_radians() / 2.).tan();
+        let axes = [
+            right.to_array(),
+            up.to_array(),
+            forward.to_array(),
+            [
+                tangent * targets.size[0] as f32 / targets.size[1] as f32,
+                tangent,
+                0.,
+                0.,
+            ],
+        ];
+        let axes = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectView"),
+            contents: bytemuck::cast_slice(&axes),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let group = |source: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("LiquidBounce ShaderLayer"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: effect_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: globals.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: axes.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::TextureView(source),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 4,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        if frame.depth {
+            pass(encoder,&targets.views[4],&self.capture[1],Some(image_group),true,true);
+            let flipped=group(&targets.views[4]);
+            pass(encoder,&targets.views[0],&self.flip_capture,Some(&flipped),false,true);
+        }else{pass(encoder,&targets.views[0],&self.capture[0],Some(image_group),true,true);}
+        for (i, pipeline) in [0, 1, effect.style + 2].into_iter().enumerate() {
+            let group = group(&targets.views[i]);
+            pass(
+                encoder,
+                &targets.views[i + 1],
+                &self.pipelines[pipeline],
+                Some(&group),
+                false,
+                true,
+            );
+        }
+        let group = group(&targets.views[3]);
+        pass(encoder, target, &self.composite, Some(&group), false, false);
+    }
+}
+
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Image file flow: new valid paths replace pending decode; failure/nonfile retains last success.
+include!("jump-effect-textures.rs");
+thread_local! {static IMAGE_ERROR:RefCell<Option<String>>=const{RefCell::new(None)};}
+pub fn take_error() -> Option<String> {
+    IMAGE_ERROR.with_borrow_mut(Option::take)
+}
+struct Images {
+    layout: wgpu::BindGroupLayout,
+    sampler: wgpu::Sampler,
+    textures: std::collections::BTreeMap<String, (wgpu::Texture, wgpu::BindGroup)>,
+    selected: Option<String>,
+    loading: Option<(
+        String,
+        std::sync::mpsc::Receiver<Result<(u32, u32, Vec<u8>), String>>,
+    )>,
+    last: Option<String>,
+}
+impl Images {
+    fn new(device: &wgpu::Device) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("JumpEffect texture"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            address_mode_u: wgpu::AddressMode::ClampToEdge,
+            address_mode_v: wgpu::AddressMode::ClampToEdge,
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        Self {
+            layout,
+            sampler,
+            textures: Default::default(),
+            selected: None,
+            loading: None,
+            last: None,
+        }
+    }
+    fn upload(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        path: String,
+        width: u32,
+        height: u32,
+        data: &[u8],
+    ) {
+        let texture = device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("JumpEffect image"),
+            size: wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        queue.write_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: &texture,
+                mip_level: 0,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            data,
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(width * 4),
+                rows_per_image: Some(height),
+            },
+            wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+        );
+        let view = texture.create_view(&Default::default());
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("JumpEffect texture"),
+            layout: &self.layout,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&view),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::Sampler(&self.sampler),
+                },
+            ],
+        });
+        if !path.starts_with("builtin:") {
+            self.textures.retain(|p, _| p.starts_with("builtin:"));
+        }
+        self.textures.insert(path, (texture, group));
+    }
+    fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        path: &str,
+    ) -> Option<String> {
+        if !path.starts_with("builtin:") && self.selected.as_deref() != Some(path) {
+            self.selected = Some(path.into());
+            if std::path::Path::new(path).is_file() {
+                let path = path.to_owned();
+                let (tx, rx) = std::sync::mpsc::channel();
+                self.loading = Some((path.clone(), rx));
+                std::thread::spawn(move || {
+                    let result = std::fs::read(&path)
+                        .map_err(|e| e.to_string())
+                        .and_then(|b| {
+                            if b.starts_with(&[0xff, 0xd8]) {
+                                crate::hud::decode_image_bytes(&b)
+                            } else {
+                                crate::hud::decode_bytes(&b)
+                            }
+                            .map_err(|e| e.to_string())
+                        });
+                    let _ = tx.send(result);
+                });
+            }
+        }
+        let ready = self
+            .loading
+            .as_ref()
+            .and_then(|(path, rx)| rx.try_recv().ok().map(|result| (path.clone(), result)));
+        if let Some((path, result)) = ready {
+            self.loading = None;
+            match result {
+                Ok((w, h, data)) => {
+                    self.upload(device, queue, path.clone(), w, h, &data);
+                    self.last = Some(path);
+                }
+                Err(e) => IMAGE_ERROR.with_borrow_mut(|v| {
+                    *v = Some(format!(
+                        "Failed to load texture from '{}' for JumpEffect Image ({e})",
+                        std::path::Path::new(&path)
+                            .file_name()
+                            .unwrap_or_default()
+                            .to_string_lossy()
+                    ))
+                }),
+            }
+        }
+        if !path.starts_with("builtin:") {
+            return self.last.clone();
+        }
+        if !self.textures.contains_key(path) {
+            let decoded = if path == "builtin:White" {
+                Some((1, 1, vec![255; 4]))
+            } else {
+                let index = match path {
+                    "builtin:LiquidBounce" => 0,
+                    "builtin:LiquidBounceWithLogo" => 1,
+                    _ => return None,
+                };
+                crate::skins::base64_decode(PNGS[index])
+                    .and_then(|b| crate::hud::decode_bytes(&b).ok())
+            };
+            if let Some((w, h, data)) = decoded {
+                self.upload(device, queue, path.into(), w, h, &data);
+            }
+        }
+        self.textures.contains_key(path).then(|| path.into())
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/jump-effect.wgsl b/crates/horizon-client-render/src/gfx/jump-effect.wgsl
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/jump-effect.wgsl
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+override FRAME_LINEAR: bool = false;
+struct MeshOut{@builtin(position)position:vec4<f32>,@location(0)color:vec4<f32>,@location(1)uv:vec2<f32>,@location(2)inner_color:vec4<f32>,@location(3)@interpolate(flat)params:vec4<f32>}
+@vertex fn mesh(@location(0)clip:vec4<f32>,@location(1)color:vec4<f32>,@location(2)uv:vec2<f32>,@location(3)inner_color:vec4<f32>,@location(4)params:vec4<f32>)->MeshOut{return MeshOut(clip,color,uv,inner_color,params);}
+@group(0)@binding(0)var image:texture_2d<f32>;
+@group(0)@binding(1)var image_sampler:sampler;
+fn source_color(v:MeshOut)->vec4<f32>{
+    var color=v.color;let texel=textureSample(image,image_sampler,v.uv);let dist=length(v.uv*2.-vec2(1.));let aa=max(fwidth(dist),0.0001);
+    if u32(v.params.x+0.5)==1u{color*=texel;}else{
+        let inner=clamp(v.params.y,0.,1.);let outer_alpha=1.-smoothstep(-aa,0.,dist-1.);var inner_alpha=1.;if inner>0.{inner_alpha=1.-smoothstep(-aa,0.,inner-dist);}
+        let t=clamp((dist-inner)/max(1.-inner,0.0001),0.,1.);color=mix(v.inner_color,v.color,t);color.a*=outer_alpha*inner_alpha;
+    }return color;
+}
+@fragment fn capture(v:MeshOut)->@location(0)vec4<f32>{let color=source_color(v);if color.a<=0.001{discard;}return color;}
+@fragment fn plain(v:MeshOut)->@location(0)vec4<f32>{var color=source_color(v);if color.a<=0.001{discard;}if FRAME_LINEAR{color=vec4(pow(max(color.rgb,vec3(0.)),vec3(2.2)),color.a);}return color;}
+struct ScreenOut {@builtin(position) position:vec4<f32>,@location(0) uv:vec2<f32>}
+fn screen_vertex(i:u32)->ScreenOut{let p=array<vec2<f32>,3>(vec2(-1.0,-1.0),vec2(3.0,-1.0),vec2(-1.0,3.0))[i];var o:ScreenOut;o.position=vec4(p.x,-p.y,0.0,1.0);o.uv=p*0.5+0.5;return o;}
+@vertex fn screen(@builtin(vertex_index) i:u32)->ScreenOut{return screen_vertex(i);}
+@vertex fn composite_screen(@builtin(vertex_index) i:u32)->ScreenOut{var o=screen_vertex(i);o.position.y = -o.position.y;return o;}
+@group(0) @binding(3) var styled:texture_2d<f32>;
+@fragment fn composite(i:ScreenOut)->@location(0) vec4<f32>{let size=textureDimensions(styled);let p=clamp(vec2<i32>(i.uv*vec2<f32>(size)),vec2(0),vec2<i32>(size)-1);var c=textureLoad(styled,p,0);if FRAME_LINEAR{c=vec4(pow(max(c.rgb,vec3(0.0)),vec3(2.2)),c.a);}return c;}
+
+@fragment fn flip_capture(i:ScreenOut)->@location(0)vec4<f32>{let size=textureDimensions(styled);let p=clamp(vec2<i32>(i.uv*vec2<f32>(size)),vec2(0),vec2<i32>(size)-1);return textureLoad(styled,p,0); }
