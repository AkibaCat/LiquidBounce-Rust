+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Agent Terrain Reach.kt. Rays use the real world's outline/collider clip.
+use super::{
+    aabb::Aabb,
+    geometry::{BlockPos, Vec3},
+    terrain::{Terrain, TerrainLevel, TerrainState},
+};
+use std::cmp::Ordering;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ClipBlock {
+    Outline,
+    Collider,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RayHit {
+    Miss,
+    Block(BlockPos),
+}
+pub trait ReachLevel<B: TerrainState>: TerrainLevel<B> {
+    fn clip(&self, from: Vec3, to: Vec3, shapes: ClipBlock) -> RayHit;
+}
+#[derive(Clone, Copy, Debug)]
+pub struct ReachOptions {
+    pub reach: f64,
+    pub from: Vec3,
+    pub block: Option<BlockPos>,
+    pub eye_height: f64,
+    pub requires_support: bool,
+}
+impl ReachOptions {
+    pub fn new(reach: f64, from: Vec3) -> Self {
+        Self {
+            reach,
+            from,
+            block: None,
+            eye_height: 1.62_f32 as f64,
+            requires_support: true,
+        }
+    }
+}
+pub fn reach_positions<B: TerrainState, L: ReachLevel<B>>(
+    terrain: &mut Terrain<B, L>,
+    body: Aabb,
+    options: ReachOptions,
+) -> Vec<BlockPos> {
+    let center = BlockPos::containing(body.center());
+    let radius = options.reach.ceil() as i32;
+    let mut positions = Vec::new();
+    for dx in radius.wrapping_neg()..=radius {
+        for dz in radius.wrapping_neg()..=radius {
+            for dy in radius.wrapping_neg().wrapping_sub(2)..=radius {
+                let pos = center.offset(dx, dy, dz);
+                let Some(feet) = feet_at(terrain, pos, options.requires_support) else {
+                    continue;
+                };
+                let eyes = Vec3::new(feet.x, feet.y + options.eye_height, feet.z);
+                if !terrain.body_box(feet).intersects(body)
+                    && body.distance_sqr(eyes) <= options.reach * options.reach
+                    && sees(terrain, eyes, body, options.reach, options.block)
+                {
+                    positions.push(pos);
+                }
+            }
+        }
+    }
+    positions.sort_by(|left, right| {
+        let left = feet_at(terrain, *left, options.requires_support)
+            .map_or(f64::MAX, |feet| feet.distance_sqr(options.from));
+        let right = feet_at(terrain, *right, options.requires_support)
+            .map_or(f64::MAX, |feet| feet.distance_sqr(options.from));
+        double_compare(left, right)
+    });
+    positions.truncate(8);
+    positions
+}
+fn feet_at<B: TerrainState, L: TerrainLevel<B>>(
+    terrain: &mut Terrain<B, L>,
+    pos: BlockPos,
+    requires_support: bool,
+) -> Option<Vec3> {
+    if let Some(feet) = terrain.feet(pos) {
+        return Some(feet);
+    }
+    if requires_support {
+        return None;
+    }
+    let feet = Vec3::bottom_center(pos);
+    terrain.is_clear(terrain.body_box(feet)).then_some(feet)
+}
+pub fn sees<B: TerrainState, L: ReachLevel<B>>(
+    terrain: &Terrain<B, L>,
+    eyes: Vec3,
+    body: Aabb,
+    reach: f64,
+    block: Option<BlockPos>,
+) -> bool {
+    if body.contains(eyes) {
+        return true;
+    }
+    let shapes = if block.is_some() {
+        ClipBlock::Outline
+    } else {
+        ClipBlock::Collider
+    };
+    for fx in [0.05, 0.275, 0.5, 0.725, 0.95] {
+        for fy in [0.05, 0.275, 0.5, 0.725, 0.95] {
+            for fz in [0.05, 0.275, 0.5, 0.725, 0.95] {
+                let point = Vec3::new(
+                    body.min.x + fx * (body.max.x - body.min.x),
+                    body.min.y + fy * (body.max.y - body.min.y),
+                    body.min.z + fz * (body.max.z - body.min.z),
+                );
+                if eyes.distance_sqr(point) > reach * reach {
+                    continue;
+                }
+                let hit = terrain.level().clip(eyes, point, shapes);
+                if match block {
+                    Some(block) => hit == RayHit::Block(block),
+                    None => hit == RayHit::Miss,
+                } {
+                    return true;
+                }
+            }
+        }
+    }
+    false
+}
+fn double_compare(left: f64, right: f64) -> Ordering {
+    if left < right {
+        return Ordering::Less;
+    }
+    if left > right {
+        return Ordering::Greater;
+    }
+    let bits = |value: f64| {
+        if value.is_nan() {
+            0x7ff8_0000_0000_0000i64
+        } else {
+            value.to_bits() as i64
+        }
+    };
+    bits(left).cmp(&bits(right))
+}
diff --git a/crates/horizon-client/src/navigation/replanner.rs b/crates/horizon-client/src/navigation/replanner.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/replanner.rs
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Minecraft Agent 0abf69ac route/Replanner.kt.
+use super::{
+    background::{BackgroundLevel, BackgroundSearch, Executor, SearchFactory, SliceSearch},
+    destination::{Destination, NearDestination},
+    geometry::{BlockPos, BlockRegion, Vec3},
+    search::Outcome,
+};
+use std::sync::Arc;
+
+pub trait ReplannerLevel<T>: BackgroundLevel<T> {
+    /// LiveLevel.isKnown: loaded chunk and dimension height, without the border test.
+    fn is_known(&mut self, pos: BlockPos) -> bool;
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct SearchGoal {
+    pub goal: NearDestination,
+    pub start: Vec3,
+    pub stage_range: Option<f64>,
+}
+#[derive(Clone, Debug)]
+pub struct SearchKey<V> {
+    pub start: BlockPos,
+    pub goal: NearDestination,
+    pub staged: bool,
+    pub variant: V,
+}
+impl<V: PartialEq> PartialEq for SearchKey<V> {
+    fn eq(&self, other: &Self) -> bool {
+        fn bits(value: f64) -> u64 {
+            if value.is_nan() {
+                f64::NAN.to_bits()
+            } else {
+                value.to_bits()
+            }
+        }
+        self.start == other.start
+            && self.goal.center == other.goal.center
+            && bits(self.goal.radius) == bits(other.goal.radius)
+            && self.staged == other.staged
+            && self.variant == other.variant
+    }
+}
+#[derive(Clone, Copy)]
+struct Request {
+    goal: Vec3,
+    stage: Option<NearDestination>,
+}
+impl Request {
+    fn is_for(request: Option<Self>, goal: Vec3) -> bool {
+        request.is_some_and(|request| request.goal.distance_sqr(goal) < 1.5 * 1.5)
+    }
+}
+
+pub type RouteFactory<T, S> = Arc<dyn Fn(&mut T, SearchGoal) -> S + Send + Sync>;
+pub struct Replanner<V, T, S, R> {
+    background: BackgroundSearch<SearchKey<V>, T, S, R>,
+    vertical_margin: i32,
+    ticks: i32,
+    last_request: i32,
+    retry_at: i32,
+    requested: Option<Request>,
+    routed: Option<Request>,
+    failed: bool,
+    ends_at_stage: bool,
+}
+impl<
+        V: PartialEq + Clone + Send + Sync + 'static,
+        T: Send + 'static,
+        S: SliceSearch<T, R> + Send + 'static,
+        R: Clone + Send + 'static,
+    > Replanner<V, T, S, R>
+{
+    pub const STAGE_LEAD: f64 = 12.0;
+    pub fn new(vertical_margin: i32, executor: Arc<dyn Executor>) -> Self {
+        Self {
+            background: BackgroundSearch::new(executor),
+            vertical_margin,
+            ticks: 0,
+            last_request: i32::MIN / 2,
+            retry_at: 0,
+            requested: None,
+            routed: None,
+            failed: false,
+            ends_at_stage: false,
+        }
+    }
+    pub fn ticks(&self) -> i32 {
+        self.ticks
+    }
+    pub fn failed(&self) -> bool {
+        self.failed
+    }
+    pub fn ends_at_stage(&self) -> bool {
+        self.ends_at_stage
+    }
+    pub fn is_searching(&self) -> bool {
+        !self.background.is_idle()
+    }
+    pub fn preview(&self) -> Option<&[Vec3]> {
+        self.background.preview()
+    }
+    pub fn tick(&mut self) {
+        self.ticks = self.ticks.wrapping_add(1);
+    }
+    pub fn poll(&mut self, level: &mut impl BackgroundLevel<T>) -> Outcome<R> {
+        let result = self.background.poll(level);
+        match result {
+            Outcome::Searching => return result,
+            Outcome::Failed(_) => {
+                self.failed = true;
+                self.retry_at = self.ticks.wrapping_add(20);
+            }
+            _ => {
+                self.failed = false;
+                self.ends_at_stage = false;
+                self.routed = self.requested;
+            }
+        }
+        self.background.cancel();
+        result
+    }
+    pub fn route_ends(&mut self, end: BlockPos) {
+        self.ends_at_stage = self
+            .routed
+            .and_then(|request| request.stage)
+            .is_some_and(|stage| !stage.is_goal(end));
+    }
+    pub fn forget(&mut self) {
+        self.routed = None;
+    }
+    pub fn has_goal_moved(&self, goal: Vec3) -> bool {
+        !Request::is_for(self.routed, goal)
+    }
+    pub fn is_new_goal(&self, goal: Vec3) -> bool {
+        !Request::is_for(self.requested, goal)
+    }
+    pub fn is_due(&self, urgent: bool) -> bool {
+        self.ticks >= self.retry_at
+            && (urgent || !self.is_searching() && self.ticks.wrapping_sub(self.last_request) >= 5)
+    }
+
+    #[allow(clippy::too_many_arguments)] // Source request plus the explicit main-thread level borrow.
+    pub fn request(
+        &mut self,
+        level: &mut impl ReplannerLevel<T>,
+        start: Vec3,
+        goal: NearDestination,
+        max_length: f64,
+        variant: V,
+        stage_range: f64,
+        search: RouteFactory<T, S>,
+    ) {
+        if !level.has_level() {
+            return;
+        }
+        let staged = start.distance_sqr(goal.center) >= (max_length / 2.0) * (max_length / 2.0)
+            || !level.is_known(BlockPos::containing(goal.center));
+        let region = if staged {
+            BlockRegion::around(start, &[], stage_range, self.vertical_margin)
+        } else {
+            goal.region(start, max_length, self.vertical_margin)
+        };
+        let descriptor = SearchGoal {
+            goal,
+            start,
+            stage_range: staged.then_some(stage_range),
+        };
+        let new_search: SearchFactory<T, S> = Arc::new(move |terrain| search(terrain, descriptor));
+        self.background.request(
+            level,
+            SearchKey {
+                start: BlockPos::containing(start),
+                goal,
+                staged,
+                variant,
+            },
+            region,
+            new_search,
+        );
+        if self.is_new_goal(goal.center) {
+            self.failed = false;
+        }
+        self.requested = Some(Request {
+            goal: goal.center,
+            stage: staged.then_some(goal),
+        });
+        self.last_request = self.ticks;
+    }
+    pub fn reset(&mut self) {
+        self.background.cancel();
+        self.requested = None;
+        self.routed = None;
+        self.failed = false;
+        self.ends_at_stage = false;
+    }
+    pub fn block_changed(&mut self, pos: BlockPos) {
+        self.background.block_changed(pos);
+    }
+    pub fn level_changed(&mut self) {
+        self.background.level_changed();
+    }
+}
diff --git a/crates/horizon-client/src/navigation/ride/boating.rs b/crates/horizon-client/src/navigation/ride/boating.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/ride/boating.rs
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Inventory boat placement, boarding, shore recovery and pickup.
+use super::super::{
+    aabb::Aabb,
+    geometry::{BlockPos, Vec3},
+    terrain::{TerrainLevel, TerrainState},
+};
+use super::{
+    body::{RideBody, RideEntity, RideLook},
+    moves::RideState,
+    steering::sub,
+    view_rotation::ViewRotation,
+};
+pub trait BoatState: RideState {
+    fn is_air(&self) -> bool;
+}
+pub trait BoatInventory: Clone {
+    fn item_is_boat(&self, slot: i32) -> bool;
+    fn suitable_hotbar_slot(&self) -> i32;
+}
+pub trait BoatEntity: RideEntity {
+    type Inventory: BoatInventory;
+    fn on_ground(&self) -> bool;
+    fn is_in_water(&self) -> bool;
+    fn eye_position(&self) -> Vec3;
+    fn block_interaction_range(&self) -> f64;
+    fn entity_interaction_range(&self) -> f64;
+    fn inventory(&self) -> Self::Inventory;
+    fn main_hand_is_boat(&self) -> bool;
+    fn passengers_empty(&self) -> bool;
+    fn is_alive(&self) -> bool;
+    fn distance_to(&self, other: &Self) -> f32;
+    fn attack_strength_scale(&self, partial: f32) -> f32;
+    fn item_is_boat(&self) -> bool;
+}
+pub trait BoatFluid: Clone {
+    fn is_water(&self) -> bool;
+    fn height<B: BoatState, L: BoatLevel<B>>(&self, level: &L, pos: BlockPos) -> f32;
+}
+pub trait BoatLevel<B: BoatState>: TerrainLevel<B> {
+    type Entity: BoatEntity;
+    type Fluid: BoatFluid;
+    fn fluid_state(&self, pos: BlockPos) -> Self::Fluid;
+    fn boats(&self, box_: Aabb) -> Vec<Self::Entity>;
+    fn items(&self, box_: Aabb) -> Vec<Self::Entity>;
+    /// OUTLINE / ANY fluid, with the supplied player's collision context.
+    fn boat_clip(&self, eye: Vec3, end: Vec3, player: &Self::Entity) -> Option<BlockPos>;
+}
+pub trait BoatBody:
+    RideBody<State: BoatState, Entity: BoatEntity, Level: BoatLevel<Self::State, Entity = Self::Entity>>
+{
+    fn can_boat(&self) -> bool;
+    fn can_click_inventory(&self) -> bool;
+    fn should_stand(&mut self);
+    fn select_hotbar_slot(&mut self, slot: i32);
+    fn release_hotbar_slot(&mut self);
+    fn swap_with_hotbar(&mut self, inventory: i32, hotbar: i32);
+    fn sent_view_vector(&self) -> Vec3;
+    fn use_main_hand(&mut self) -> bool;
+    fn sees(&self, entity: &Self::Entity) -> bool;
+    fn interact_main_hand(&mut self, entity: &Self::Entity);
+    fn attack(&mut self, entity: &Self::Entity);
+}
+pub trait SwimAhead {
+    fn swim_ahead(&mut self) -> Vec<BlockPos>;
+}
+#[derive(Clone)]
+enum Phase<E> {
+    Idle,
+    Placing { water: BlockPos, hotbar: i32 },
+    Placed { water: BlockPos },
+    Boarding(E),
+    Riding(E),
+    Breaking(E),
+    Collecting(Vec3),
+}
+pub struct Boating<E> {
+    phase: Phase<E>,
+    ticks: i32,
+    refused: Option<BlockPos>,
+    walk_target: Option<Vec3>,
+}
+impl<E: BoatEntity> Default for Boating<E> {
+    fn default() -> Self {
+        Self {
+            phase: Phase::Idle,
+            ticks: 0,
+            refused: None,
+            walk_target: None,
+        }
+    }
+}
+impl<E: BoatEntity> Boating<E> {
+    pub fn walk_target(&self) -> Option<Vec3> {
+        self.walk_target
+    }
+    pub fn tick<B: BoatBody<Entity = E>>(
+        &mut self,
+        body: &mut B,
+        follower: &mut impl SwimAhead,
+    ) -> bool {
+        let player = body.player();
+        self.walk_target = None;
+        self.ticks = self.ticks.wrapping_add(1);
+        match self.phase.clone() {
+            Phase::Idle => {
+                let Some(water) = self.spot(body, follower) else {
+                    return false;
+                };
+                let slot = self.boat_slot(body);
+                if slot < 0 {
+                    return false;
+                }
+                if !(0..9).contains(&slot) && !body.can_click_inventory() {
+                    body.should_stand();
+                    return true;
+                }
+                let hotbar = self.hold(body, slot);
+                self.enter(body, Phase::Placing { water, hotbar });
+                true
+            }
+            Phase::Placing { water, hotbar } => self.place(body, water, hotbar),
+            Phase::Placed { water } => {
+                let boat = body
+                    .level()
+                    .boats(Aabb::from_block(water).inflate(Vec3::new(1.5, 1.5, 1.5)))
+                    .into_iter()
+                    .find(|b| b.passengers_empty());
+                if let Some(boat) = boat {
+                    self.enter(body, Phase::Boarding(boat))
+                } else if self.ticks > 10 {
+                    self.refuse(body, water)
+                }
+                true
+            }
+            Phase::Boarding(boat) => self.board(body, boat),
+            Phase::Riding(boat) => {
+                if player.is_passenger() {
+                    return false;
+                }
+                self.enter(body, Phase::Breaking(boat));
+                true
+            }
+            Phase::Breaking(boat) => self.break_boat(body, boat),
+            Phase::Collecting(at) => self.collect(body, at),
+        }
+    }
+    pub fn halt(&mut self, body: &mut impl BoatBody<Entity = E>) {
+        if !matches!(self.phase, Phase::Riding(_)) {
+            self.enter(body, Phase::Idle)
+        }
+        self.walk_target = None;
+    }
+    fn enter(&mut self, body: &mut impl BoatBody<Entity = E>, next: Phase<E>) {
+        if matches!(self.phase, Phase::Placing { .. }) && !matches!(next, Phase::Placing { .. }) {
+            body.release_hotbar_slot()
+        }
+        self.phase = next;
+        self.ticks = 0;
+    }
+    fn refuse(&mut self, body: &mut impl BoatBody<Entity = E>, water: BlockPos) {
+        self.refused = Some(water);
+        self.enter(body, Phase::Idle)
+    }
+    fn spot<B: BoatBody<Entity = E>>(
+        &self,
+        body: &B,
+        follower: &mut impl SwimAhead,
+    ) -> Option<BlockPos> {
+        let player = body.player();
+        if !body.can_boat() || player.is_passenger() || !player.on_ground() || player.is_in_water()
+        {
+            return None;
+        }
+        let swim = follower.swim_ahead();
+        if swim.len() < 5 {
+            return None;
+        }
+        let level = body.level();
+        let eye = player.eye_position();
+        for pos in swim.into_iter().take(3) {
+            if Some(pos) == self.refused
+                || !level.fluid_state(pos).is_water()
+                || !level.block_state(pos.above()).is_air()
+                || Vec3::new(
+                    f64::from(pos.x) + 0.5,
+                    f64::from(pos.y) + 0.5,
+                    f64::from(pos.z) + 0.5,
+                )
+                .distance(eye)
+                    > player.block_interaction_range() - 0.5
+            {
+                continue;
+            }
+            let mut clear = true;
+            'scan: for z in pos.z.wrapping_sub(1)..=pos.z.wrapping_add(1) {
+                for x in pos.x.wrapping_sub(1)..=pos.x.wrapping_add(1) {
+                    let at = BlockPos::new(x, pos.y, z);
+                    if !level.block_state(at).collision_shape(&level, at).is_empty() {
+                        clear = false;
+                        break 'scan;
+                    }
+                }
+            }
+            if clear {
+                return Some(pos);
+            }
+        }
+        None
+    }
+    fn boat_slot(&self, body: &impl BoatBody<Entity = E>) -> i32 {
+        let inventory = body.player().inventory();
+        (0..36)
+            .find(|slot| inventory.item_is_boat(*slot))
+            .unwrap_or(-1)
+    }
+    fn hold(&self, body: &mut impl BoatBody<Entity = E>, slot: i32) -> i32 {
+        let hotbar = if (0..9).contains(&slot) {
+            slot
+        } else {
+            let hotbar = body.player().inventory().suitable_hotbar_slot();
+            body.swap_with_hotbar(slot, hotbar);
+            hotbar
+        };
+        body.select_hotbar_slot(hotbar);
+        hotbar
+    }
+    fn place<B: BoatBody<Entity = E>>(
+        &mut self,
+        body: &mut B,
+        water: BlockPos,
+        hotbar: i32,
+    ) -> bool {
+        let player = body.player();
+        if self.ticks > 20 {
+            self.refuse(body, water);
+            return false;
+        }
+        body.select_hotbar_slot(hotbar);
+        let level = body.level();
+        let surface = Vec3::new(
+            f64::from(water.x) + 0.5,
+            f64::from(water.y) + f64::from(level.fluid_state(water).height(&level, water)),
+            f64::from(water.z) + 0.5,
+        );
+        let view = ViewRotation::from_vector(sub(surface, player.eye_position()));
+        body.look(view.y_rot, view.x_rot, RideLook::Aim);
+        let eye = player.eye_position();
+        let look = body.sent_view_vector();
+        let scale = player.block_interaction_range();
+        let end = Vec3::new(
+            eye.x + look.x * scale,
+            eye.y + look.y * scale,
+            eye.z + look.z * scale,
+        );
+        if level.boat_clip(eye, end, &player) == Some(water)
+            && player.main_hand_is_boat()
+            && body.use_main_hand()
+        {
+            self.enter(body, Phase::Placed { water })
+        }
+        true
+    }
+    fn board<B: BoatBody<Entity = E>>(&mut self, body: &mut B, boat: E) -> bool {
+        let player = body.player();
+        if player.is_passenger() {
+            self.enter(body, Phase::Riding(boat));
+            return false;
+        }
+        if !boat.is_alive() || self.ticks > 40 {
+            self.refused = Some(BlockPos::containing(boat.position()));
+            self.enter(body, Phase::Breaking(boat));
+            return true;
+        }
+        let bounds = boat.bounding_box();
+        let center = bounds.center();
+        let view = ViewRotation::from_vector(sub(center, player.eye_position()));
+        body.look(view.y_rot, view.x_rot, RideLook::Aim);
+        if self.ticks % 5 == 0 && body.sees(&boat) {
+            body.interact_main_hand(&boat)
+        }
+        true
+    }
+    fn break_boat<B: BoatBody<Entity = E>>(&mut self, body: &mut B, boat: E) -> bool {
+        let player = body.player();
+        if !boat.is_alive() {
+            self.enter(body, Phase::Collecting(boat.position()));
+            return true;
+        }
+        let distance = boat.distance_to(&player);
+        if self.ticks > 200 || f64::from(distance) > player.entity_interaction_range() + 3.0 {
+            self.enter(body, Phase::Idle);
+            return false;
+        }
+        let bounds = boat.bounding_box();
+        let center = bounds.center();
+        let view = ViewRotation::from_vector(sub(center, player.eye_position()));
+        body.look(view.y_rot, view.x_rot, RideLook::Aim);
+        if f64::from(distance) > player.entity_interaction_range() {
+            self.walk_target = Some(boat.position())
+        } else if player.attack_strength_scale(0.5) >= 0.9_f32 && body.sees(&boat) {
+            body.attack(&boat)
+        }
+        true
+    }
+    fn collect<B: BoatBody<Entity = E>>(&mut self, body: &mut B, at: Vec3) -> bool {
+        let item = body
+            .level()
+            .items(Aabb::new(
+                Vec3::new(at.x - 3.0, at.y - 2.0, at.z - 3.0),
+                Vec3::new(at.x + 3.0, at.y + 2.0, at.z + 3.0),
+            ))
+            .into_iter()
+            .find(|item| item.item_is_boat());
+        let Some(item) = item else {
+            if self.ticks > 10 {
+                self.enter(body, Phase::Idle)
+            }
+            return self.ticks <= 10;
+        };
+        if self.ticks > 100 {
+            self.enter(body, Phase::Idle);
+            return false;
+        }
+        self.walk_target = Some(item.position());
+        true
+    }
+}
