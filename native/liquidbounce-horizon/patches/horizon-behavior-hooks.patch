new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/ride/steering.rs
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::super::{
+    geometry::{BlockPos, Vec3},
+    input::Input,
+    terrain::TerrainLevel,
+    walk_jump::{vector_yaw, wrap_degrees},
+};
+use super::{
+    body::{RideBody, RideEntity, RideLook},
+    moves::RideState,
+    vehicle::{JUMP_CHARGE_TICKS,VehicleEntity},
+};
+pub struct Steering {
+    last_y_rot: f32,
+    charge_ticks: i32,
+}
+impl Default for Steering {
+    fn default() -> Self {
+        Self {
+            last_y_rot: f32::NAN,
+            charge_ticks: 0,
+        }
+    }
+}
+impl Steering {
+    pub fn reset(&mut self) {
+        self.last_y_rot = f32::NAN;
+        self.charge_ticks = 0;
+    }
+    pub fn boat<B: RideBody>(&mut self, body: &mut B, boat: &B::Entity, target: Vec3, brake: bool) {
+        let y_rot = boat.y_rot();
+        let turn_rate = if self.last_y_rot.is_nan() {
+            0.0
+        } else {
+            wrap_degrees(y_rot - self.last_y_rot)
+        };
+        self.last_y_rot = y_rot;
+        let below = BlockPos::containing(Vec3::new(boat.x(), boat.y() - 0.1, boat.z()));
+        let friction = if body.level().block_state(below).friction() >= 0.9_f32 {
+            0.98_f32
+        } else {
+            0.9_f32
+        };
+        let coast = turn_rate * friction / (1.0 - friction);
+        let offset=sub(target,boat.position());
+        let off = wrap_degrees(vector_yaw(offset.x,offset.z) - y_rot);
+        let error = off - coast;
+        let slow_enough = !brake || horizontal_length(boat.delta_movement()) < 0.12;
+        body.press(
+            Input {
+                forward: off.abs() < 35.0 && slow_enough,
+                backward: !slow_enough,
+                left: error < -4.0,
+                right: error > 4.0,
+                jump: false,
+                shift: false,
+                sprint: false,
+            },
+            true,
+        );
+    }
+    pub fn mount<B: RideBody>(
+        &mut self,
+        body: &mut B,
+        mount: &B::Entity,
+        target: Vec3,
+        jump_to: Option<Vec3>,
+        reach: f64,
+    ) {
+        let offset=sub(target,mount.position());
+        let desired = vector_yaw(offset.x,offset.z);
+        let facing = self.face(body, desired);
+        let aligned = wrap_degrees(desired - facing).abs() < 50.0;
+        let at_jump =
+            jump_to.is_some_and(|jump_to| horizontal_distance(mount.position(), jump_to) < reach);
+        self.charge_ticks = if at_jump {
+            self.charge_ticks.wrapping_add(1)
+        } else {
+            0
+        };
+        body.press(
+            Input {
+                forward: aligned,
+                jump: (1..=JUMP_CHARGE_TICKS).contains(&self.charge_ticks),
+                ..Input::EMPTY
+            },
+            true,
+        );
+        if self.charge_ticks > JUMP_CHARGE_TICKS + 20 {
+            self.charge_ticks = 0;
+        }
+    }
+    pub fn stop(&mut self, body: &mut impl RideBody, sneak: bool) {
+        self.reset();
+        body.press(
+            Input {
+                shift: sneak,
+                ..Input::EMPTY
+            },
+            true,
+        );
+    }
+    pub fn face(&mut self, body: &mut impl RideBody, y_rot: f32) -> f32 {
+        let player = body.player();
+        let facing = player.y_rot() + wrap_degrees(y_rot - player.y_rot()).clamp(-35.0, 35.0);
+        body.look(facing, player.x_rot(), RideLook::View);
+        facing
+    }
+}
+pub(crate) fn sub(to: Vec3, from: Vec3) -> Vec3 {
+    Vec3::new(to.x - from.x, to.y - from.y, to.z - from.z)
+}
+pub(crate) fn horizontal_distance(from: Vec3, to: Vec3) -> f64 {
+    horizontal_length(sub(to, from))
+}
+pub(crate) fn horizontal_length(v: Vec3) -> f64 {
+    (v.x * v.x + v.z * v.z).sqrt()
+}
diff --git a/crates/horizon-client/src/navigation/ride/vehicle.rs b/crates/horizon-client/src/navigation/ride/vehicle.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/ride/vehicle.rs
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::super::geometry::{Vec3, java_max};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum VehicleKind {
+    Boat,
+    Mount,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EntityKind {
+    Boat,
+    Horse,
+    Camel,
+    Other,
+}
+pub trait VehicleEntity {
+    fn entity_kind(&self) -> EntityKind;
+    fn passenger_riding_position(&self, rider: &Self) -> Vec3;
+    fn y(&self) -> f64;
+    fn bounding_height(&self) -> f32;
+    fn bounding_width(&self) -> f32;
+    fn eye_height(&self) -> f32;
+    fn max_up_step(&self) -> f32;
+    fn can_jump(&self) -> bool;
+    fn jump_strength(&self) -> f64;
+    fn jump_boost_power(&self) -> f32;
+    fn safe_fall_distance(&self) -> f64;
+    fn movement_speed(&self) -> f64;
+}
+pub const JUMP_CHARGE_TICKS: i32 = 11;
+pub const BOAT_WATER_SPEED: f64 = 0.35;
+pub const BOAT_ICE_SPEED: f64 = 1.0;
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Vehicle {
+    pub kind: VehicleKind,
+    pub width: f64,
+    pub height: f64,
+    pub step_height: f64,
+    pub jump_height: f64,
+    pub safe_fall: i32,
+    pub speed: f64,
+    pub ice_speed: f64,
+}
+impl Vehicle {
+    pub fn of<E: VehicleEntity>(rider: &E, vehicle: &E) -> Option<Self> {
+        let seat = vehicle.passenger_riding_position(rider).y - vehicle.y();
+        let height = java_max(
+            f64::from(vehicle.bounding_height()),
+            seat + f64::from(rider.eye_height()) + 0.05,
+        );
+        match vehicle.entity_kind() {
+            EntityKind::Boat => Some(Self {
+                kind: VehicleKind::Boat,
+                width: f64::from(vehicle.bounding_width()),
+                height,
+                step_height: 0.0,
+                jump_height: 0.0,
+                safe_fall: 1,
+                speed: BOAT_WATER_SPEED,
+                ice_speed: BOAT_ICE_SPEED,
+            }),
+            EntityKind::Horse | EntityKind::Camel => {
+                let width = f64::from(vehicle.bounding_width());
+                let step_height = f64::from(vehicle.max_up_step());
+                let jump_height = jump_height_of(vehicle);
+                let safe_fall = (vehicle.safe_fall_distance() as i32).wrapping_sub(1);
+                let speed = vehicle.movement_speed() * 2.158;
+                Some(Self {
+                    kind: VehicleKind::Mount,
+                    width,
+                    height,
+                    step_height,
+                    jump_height,
+                    safe_fall,
+                    speed,
+                    ice_speed: speed,
+                })
+            }
+            EntityKind::Other => None,
+        }
+    }
+}
+pub fn jump_height_of<E: VehicleEntity>(mount: &E) -> f64 {
+    if mount.entity_kind() == EntityKind::Camel || !mount.can_jump() {
+        return 0.0;
+    }
+    let mut velocity = mount.jump_strength() + f64::from(mount.jump_boost_power());
+    let mut height = 0.0;
+    while velocity > 0.0 {
+        height += velocity;
+        velocity = (velocity - 0.08) * f64::from(0.98_f32);
+    }
+    java_max(height - 0.2, 0.0)
+}
diff --git a/crates/horizon-client/src/navigation/route_report.rs b/crates/horizon-client/src/navigation/route_report.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/route_report.rs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Agent RouteReport.kt: renderer events deduplicate by original reference identity.
+use super::geometry::{BlockPos, Vec3};
+
+/// Stable identity of an owning source object. Allocate monotonically and keep
+/// the same value while that object lives; equal contents never imply identity.
+/// Zero denotes Kotlin's shared emptyList singleton.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct RouteIdentity(pub u64);
+impl RouteIdentity { pub const EMPTY_LIST: Self = Self(0); }
+pub struct IdentityRef<'a, T: ?Sized> { pub identity: RouteIdentity, pub value: &'a T }
+impl<T: ?Sized> Copy for IdentityRef<'_, T> {}
+impl<T: ?Sized> Clone for IdentityRef<'_, T> { fn clone(&self) -> Self { *self } }
+impl<'a, T: ?Sized> IdentityRef<'a, T> {
+ pub fn new(identity: RouteIdentity, value: &'a T) -> Self { Self { identity, value } }
+}
+/// A host chooses its live progress representation (for example, a stable
+/// Follower/TargetProgress handle) and can retain that owner from the callback.
+pub trait RouteListener {
+ type Progress: ?Sized;
+ fn route_searching(&mut self, _start: Vec3, _goal: Vec3, _radius: f64,
+   _preview: Option<IdentityRef<'_, [Vec3]>>) {}
+ fn route_following(&mut self, _points: IdentityRef<'_, [Vec3]>,
+   _progress: IdentityRef<'_, Self::Progress>) {}
+ fn blocks_ahead(&mut self, _breaks: IdentityRef<'_, [BlockPos]>,
+   _places: IdentityRef<'_, [BlockPos]>) {}
+ fn route_done(&mut self) {}
+ fn route_invalid(&mut self) {}
+ fn route_cleared(&mut self) {}
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Shown { Nothing, Searching, Following, Done, Invalid }
+pub struct RouteReport {
+ shown: Shown,
+ start: Option<Vec3>,
+ goal: Option<Vec3>,
+ radius: f64,
+ preview: Option<RouteIdentity>,
+ points: Option<RouteIdentity>,
+ progress: Option<RouteIdentity>,
+ breaks: RouteIdentity,
+ places: RouteIdentity,
+}
+impl Default for RouteReport {
+ fn default() -> Self {
+  Self { shown: Shown::Nothing, start: None, goal: None, radius: 0.0,
+   preview: None, points: None, progress: None,
+   breaks: RouteIdentity::EMPTY_LIST, places: RouteIdentity::EMPTY_LIST }
+ }
+}
+impl RouteReport {
+ pub fn searching(&mut self, listener: &mut impl RouteListener, start: Vec3,
+   goal: Vec3, radius: f64, preview: Option<IdentityRef<'_, [Vec3]>>) {
+  let preview_identity = preview.map(|p| p.identity);
+  if self.shown == Shown::Searching && self.start == Some(start)
+    && self.goal == Some(goal) && self.radius == radius && self.preview == preview_identity { return; }
+  self.shown = Shown::Searching;
+  self.start = Some(start); self.goal = Some(goal); self.radius = radius;
+  self.preview = preview_identity; self.points = None; self.progress = None;
+  listener.route_searching(start, goal, radius, preview);
+ }
+ pub fn following<L: RouteListener>(&mut self, listener: &mut L,
+   points: IdentityRef<'_, [Vec3]>, progress: IdentityRef<'_, L::Progress>) {
+  if self.shown == Shown::Following && self.points == Some(points.identity)
+    && self.progress == Some(progress.identity) { return; }
+  self.shown = Shown::Following;
+  self.points = Some(points.identity); self.progress = Some(progress.identity);
+  listener.route_following(points, progress);
+ }
+ pub fn blocks(&mut self, listener: &mut impl RouteListener,
+   breaks: IdentityRef<'_, [BlockPos]>, places: IdentityRef<'_, [BlockPos]>) {
+  if self.breaks == breaks.identity && self.places == places.identity { return; }
+  self.breaks = breaks.identity; self.places = places.identity;
+  listener.blocks_ahead(breaks, places);
+ }
+ pub fn done(&mut self, listener: &mut impl RouteListener) {
+  if self.shown != Shown::Done { self.shown = Shown::Done; listener.route_done(); }
+ }
+ pub fn invalid(&mut self, listener: &mut impl RouteListener) {
+  if self.shown != Shown::Invalid { self.shown = Shown::Invalid; listener.route_invalid(); }
+ }
+ pub fn clear(&mut self, listener: &mut impl RouteListener) {
+  self.start = None; self.goal = None; self.preview = None;
+  self.points = None; self.progress = None;
+  self.breaks = RouteIdentity::EMPTY_LIST; self.places = RouteIdentity::EMPTY_LIST;
+  if self.shown != Shown::Nothing { self.shown = Shown::Nothing; listener.route_cleared(); }
+ }
+}
