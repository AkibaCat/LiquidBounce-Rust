+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        game_time: f32,
+        camera: DVec3,
+        view: Mat4,
+        fov: f32,
+        entity_group:&wgpu::BindGroup,
+        mask:Option<(&wgpu::TextureView,u32,bool)>,
+        capture_only:bool,
+    ) {
+        let Some((frame, buffer, count)) = self.pending.as_ref() else {
+            return;
+        };
+        let pass = |encoder: &mut wgpu::CommandEncoder,
+                    target: &wgpu::TextureView,
+                    pipeline: &wgpu::RenderPipeline,
+                    group: Option<&wgpu::BindGroup>,
+                    mesh: bool,
+                    clear: bool| {
+            let mut p = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("LiquidBounce Breadcrumbs"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: target,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: if clear {
+                            wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT)
+                        } else {
+                            wgpu::LoadOp::Load
+                        },
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+            p.set_pipeline(pipeline);
+            if let Some(g) = group {
+                p.set_bind_group(0, g, &[]);
+            }
+            if mesh {
+                p.set_vertex_buffer(0, buffer.slice(..));
+                p.draw(0..*count, 0..1);
+            } else {
+                p.draw(0..3, 0..1);
+            }
+        };
+        let Some(effect) = frame.effect.as_ref() else {
+            pass(encoder, target, &self.plain, None, true, false);
+            return;
+        };
+        let targets = self.targets.as_ref().unwrap();
+        let mut data = [0f32; 16];
+        data[..8].copy_from_slice(&effect.params);
+        data[8..12].copy_from_slice(&effect.accent);
+        data[12] = effect.range;
+        data[13] = effect.opacity;
+        let effect_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectData"),
+            contents: bytemuck::cast_slice(&data),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let blocks = camera.floor().as_ivec3();
+        let offset = blocks.as_dvec3() - camera;
+        let mut globals = [0u32; 12];
+        globals[0] = game_time.to_bits();
+        globals[4] = blocks.x as u32;
+        globals[5] = blocks.y as u32;
+        globals[6] = blocks.z as u32;
+        globals[8] = (offset.x as f32).to_bits();
+        globals[9] = (offset.y as f32).to_bits();
+        globals[10] = (offset.z as f32).to_bits();
+        let globals = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Globals"),
+            contents: bytemuck::cast_slice(&globals),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let inverse = view.inverse();
+        let right = inverse.x_axis;
+        let up = inverse.y_axis;
+        let forward = -inverse.z_axis;
+        let tangent = (fov.to_radians() / 2.).tan();
+        let axes = [
+            right.to_array(),
+            up.to_array(),
+            forward.to_array(),
+            [
+                tangent * targets.size[0] as f32 / targets.size[1] as f32,
+                tangent,
+                0.,
+                0.,
+            ],
+        ];
+        let axes = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectView"),
+            contents: bytemuck::cast_slice(&axes),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let group = |source: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("LiquidBounce ShaderLayer"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: effect_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: globals.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: axes.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::TextureView(source),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 4,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        if let Some((source,tag,untagged))=mask {
+            let data=[tag,u32::from(untagged),0,0];
+            let uniform=device.create_buffer_init(&wgpu::util::BufferInitDescriptor{label:Some("EffectMask"),contents:bytemuck::cast_slice(&data),usage:wgpu::BufferUsages::UNIFORM});
+            let group=device.create_bind_group(&wgpu::BindGroupDescriptor{label:Some("OutlineGlow tag mask"),layout:&self.mask_layout,entries:&[wgpu::BindGroupEntry{binding:0,resource:wgpu::BindingResource::TextureView(source)},wgpu::BindGroupEntry{binding:2,resource:uniform.as_entire_binding()}]});
+            pass(encoder,&targets.views[0],&self.mask_pipeline,Some(&group),false,true);
+        }else{
+        pass(encoder, &targets.views[0], &self.capture, None, true, true);
+        if let Some((vertices,count))=self.model_pending.as_ref(){let mut p=encoder.begin_render_pass(&wgpu::RenderPassDescriptor{label:Some("OutlineGlow real model silhouettes"),color_attachments:&[Some(wgpu::RenderPassColorAttachment{view:&targets.views[0],depth_slice:None,resolve_target:None,ops:wgpu::Operations{load:wgpu::LoadOp::Load,store:wgpu::StoreOp::Store}})],..Default::default()});p.set_pipeline(&self.model_pipeline);p.set_bind_group(0,entity_group,&[]);p.set_vertex_buffer(0,vertices.slice(..));p.draw(0..*count,0..1);}
+        }
+        if capture_only{return;}
+        if effect.style==9{for(source,dest,pipeline)in[(0,1,11),(1,2,12),(2,3,13)]{let group=group(&targets.views[source]);pass(encoder,&targets.views[dest],&self.pipelines[pipeline],Some(&group),false,true);}}else{
+        for (i, pipeline) in [0, 1, effect.style + 2].into_iter().enumerate() {
+            let group = group(&targets.views[i]);
+            pass(
+                encoder,
+                &targets.views[i + 1],
+                &self.pipelines[pipeline],
+                Some(&group),
+                false,
+                true,
+            );
+        }
+        }
+        // Common renderer combines straight-alpha style targets before one scene conversion.
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/outline_glow.rs b/crates/horizon-client-render/src/gfx/outline_glow.rs
