@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Derived from LiquidBounce ae0eb396, ModuleAntiExploit and its packet mixins.
+pub const LIMITS: [&str; 4] = [
+    "ExplosionStrength",
+    "ParticlesAmount",
+    "ParticlesSpeed",
+    "ObfuscatedMessage",
+];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Settings {
+    pub limits: u32,
+    pub cancel_demo: bool,
+    pub ignore_protocol: bool,
+    pub max_obfuscated: i32,
+    pub notify: bool,
+    pub scoreboard_fix: bool,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            limits: 15,
+            cancel_demo: true,
+            ignore_protocol: true,
+            max_obfuscated: 128,
+            notify: true,
+            scoreboard_fix: false,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Notice {
+    Explosion,
+    Amount,
+    Speed,
+    Obfuscated,
+    Demo,
+}
+impl Notice {
+    pub fn error(self) -> bool {
+        matches!(self, Self::Explosion | Self::Amount | Self::Speed)
+    }
+    pub fn message(self, lang: u8) -> &'static str {
+        match (self, lang) {
+            (Self::Explosion, 1) => "已限制过强的爆炸冲击力",
+            (Self::Explosion, 2) => "已限制過強的爆炸衝擊力",
+            (Self::Explosion, _) => "Limited too strong explosion",
+            (Self::Amount, 1) => "已限制过多的粒子",
+            (Self::Amount, 2) => "已限制過多的粒子",
+            (Self::Amount, _) => "Limited too many particles",
+            (Self::Speed, 1) => "已限制过快的粒子速度",
+            (Self::Speed, 2) => "已限制過快的粒子速度",
+            (Self::Speed, _) => "Limited too fast particles speed",
+            (Self::Obfuscated, 1) => "已拦截包含过长乱码的文本",
+            (Self::Obfuscated, 2) => "已攔截包含過長亂碼的文字",
+            (Self::Obfuscated, _) => "Blocked text with too long obfuscated text",
+            (Self::Demo, 1) => "已取消演示版提示界面",
+            (Self::Demo, 2) => "已取消試玩版提示介面",
+            (Self::Demo, _) => "Cancelled demo GUI (just annoying thing)",
+        }
+    }
+}
+#[derive(Default)]
+pub struct AntiExploit {
+    pub settings: Settings,
+    pub running: bool,
+    last_notice: [Option<i64>; 4],
+    pub notices: Vec<Notice>,
+}
+impl AntiExploit {
+    pub fn limit(&self, index: usize) -> bool {
+        self.running && self.settings.limits & (1 << index) != 0
+    }
+    pub fn notify(&mut self, notice: Notice, now: i64) {
+        if !self.settings.notify {
+            return;
+        }
+        let index = match notice {
+            Notice::Explosion => Some(0),
+            Notice::Amount => Some(1),
+            Notice::Speed => Some(2),
+            Notice::Obfuscated => Some(3),
+            Notice::Demo => None,
+        };
+        if let Some(i) = index {
+            let cooldown = if i == 3 { 10_000 } else { 1000 };
+            if self.last_notice[i].is_some_and(|prev| now.saturating_sub(prev) < cooldown) {
+                return;
+            }
+            self.last_notice[i] = Some(now);
+        }
+        self.notices.push(notice);
+    }
+    pub fn explosion(&mut self, push: [f64; 3], now: i64) -> [f64; 3] {
+        if !self.limit(0) {
+            return push;
+        }
+        // Java Math.clamp propagates NaN; != still reports that change.
+        let fixed = push.map(|v| v.clamp(-10.0, 10.0));
+        if fixed.iter().zip(push).any(|(a, b)| *a != b) {
+            self.notify(Notice::Explosion, now);
+        }
+        fixed
+    }
+    pub fn particle_count(&mut self, count: i32, now: i64) -> i32 {
+        if self.limit(1) && count >= 500 {
+            self.notify(Notice::Amount, now);
+            100
+        } else {
+            count
+        }
+    }
+    pub fn particle_speed(&mut self, speed: [f32; 3], now: i64) -> [f32; 3] {
+        speed.map(|v| {
+            if self.limit(2) && v >= 10.0 {
+                self.notify(Notice::Speed, now);
+                10.0
+            } else {
+                v
+            }
+        })
+    }
+    pub fn demo(&mut self, now: i64) -> bool {
+        if self.running && self.settings.cancel_demo {
+            self.notify(Notice::Demo, now);
+            true
+        } else {
+            false
+        }
+    }
+    pub fn blocked<'a>(&self, spans: impl IntoIterator<Item = (bool, &'a str)>) -> bool {
+        if !self.limit(3) {
+            return false;
+        }
+        let mut run = 0usize;
+        for (obfuscated, text) in spans {
+            if obfuscated {
+                run = run.saturating_add(text.encode_utf16().count());
+            } else {
+                run = 0;
+            }
+            if obfuscated && (run as i64) >= i64::from(self.settings.max_obfuscated) {
+                return true;
+            }
+        }
+        false
+    }
+}
