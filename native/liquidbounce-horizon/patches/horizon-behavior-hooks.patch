+            let axes = [Axis::X, Axis::Y, Axis::Z];
+            (0..3)
+                .map(|i| {
+                    let d = eye[i] - eye[i].clamp(b.min(axes[i]), b.max(axes[i]));
+                    d * d
+                })
+                .sum::<f64>()
