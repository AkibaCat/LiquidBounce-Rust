--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_edge.rs
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! MovementUtils.findEdgeCollision with actual standing dimensions and shapes.
+use super::Game;
+use horizon_core::{
+    geometry::{Aabb, Vec3},
+    position::BlockPos,
+};
+use horizon_world::collision_context::CollisionContext;
+
+fn fma(at: Vec3, scale: f64, direction: Vec3) -> Vec3 {
+    Vec3::new(
+        scale.mul_add(direction.x, at.x),
+        scale.mul_add(direction.y, at.y),
+        scale.mul_add(direction.z, at.z),
+    )
+}
+pub(super) fn find(game: &Game<'_>, from: Vec3, to: Vec3, allowed_drop: f32) -> Option<Vec3> {
+    let direction = to.subtract(from);
+    if direction.length_squared() <= 1.0e-12 {
+        return None;
+    }
+    let player = game.player.as_ref()?;
+    let dimensions = horizon_client::pose::Pose::Standing.dimensions(player.scale);
+    let union = dimensions.bounds(from).union_bounds(dimensions.bounds(to));
+    let min = union.min_position();
+    let max = union.max_position();
+    let minimum = [
+        (min.x - 0.3 - 1.0e-7).floor() as i32,
+        (min.y - f64::from(allowed_drop) - 1.0e-7).floor() as i32,
+        (min.z - 0.3 - 1.0e-7).floor() as i32,
+    ];
+    let maximum = [
+        (max.x + 0.3 + 1.0e-7).floor() as i32,
+        (min.y + 1.0e-7).floor() as i32,
+        (max.z + 0.3 + 1.0e-7).floor() as i32,
+    ];
+    let extended_from = fma(from, -1000.0, direction);
+    let extended_to = fma(to, 1000.0, direction);
+    let mut scene = horizon_client::collisions::SceneCollisions {
+        world: &game.world,
+        binding: game.collision,
+        subject: None,
+    };
+    let mut boxes = Vec::new();
+    // BlockPos.betweenClosed enumerates x, then y, then z.
+    for z in minimum[2]..=maximum[2] {
+        for y in minimum[1]..=maximum[1] {
+            for x in minimum[0]..=maximum[0] {
+                let state = game.world.block(x, y, z);
+                let shape = game
+                    .collision
+                    .collision_shape_with_context(
+                        &mut scene,
+                        state,
+                        BlockPos::new(x, y, z),
+                        &CollisionContext::empty(false),
+                    )
+                    .expect("Scaffold edge support shape");
+                for bounds in shape.boxes() {
+                    let min = bounds.min_position();
+                    let max = bounds.max_position();
+                    let adjusted = Aabb::new(
+                        Vec3::new(min.x - 0.3, min.y - 1.0, min.z - 0.3),
+                        Vec3::new(
+                            max.x + 0.3,
+                            max.y + f64::from(allowed_drop) + 0.05,
+                            max.z + 0.3,
+                        ),
+                    )
+                    .move_by(Vec3::new(
+                        f64::from(x),
+                        f64::from(y),
+                        f64::from(z),
+                    ));
+                    if adjusted.clip(extended_from, extended_to).is_some() {
+                        boxes.push(adjusted);
+                    }
+                }
+            }
+        }
+    }
+    let mut at = from;
+    loop {
+        let containing: Vec<_> = boxes.iter().copied().filter(|b| b.contains(at)).collect();
+        if containing.is_empty() {
+            return Some(at);
+        }
+        if containing.iter().any(|b| b.contains(to)) {
+            return None;
+        }
+        let mut next = None;
+        let mut distance = f64::INFINITY;
+        for bounds in &containing {
+            let point = bounds
+                .clip(extended_to, extended_from)
+                .expect("Scaffold reverse edge ray");
+            let candidate = point.distance_squared(to);
+            if next.is_none() || candidate < distance {
+                next = Some(point);
+                distance = candidate;
+            }
+        }
+        at = next.expect("Scaffold containing support");
+        boxes.retain(|b| !containing.contains(b));
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_aim_rules.rs b/crates/horizon-client/src/game/scaffold_aim_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_aim_rules.rs
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Source FaceTargetPositionFactory geometry for Scaffold's eight aim modes.
+pub type Point = [f64; 3];
+pub fn add(a: Point, b: Point) -> Point {
+    std::array::from_fn(|i| a[i] + b[i])
+}
+pub fn sub(a: Point, b: Point) -> Point {
+    std::array::from_fn(|i| a[i] - b[i])
+}
+fn scale(a: Point, b: f64) -> Point {
+    a.map(|v| v * b)
+}
+fn dot(a: Point, b: Point) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn length(a: Point) -> f64 {
+    dot(a, a).sqrt()
+}
+fn normalize(a: Point) -> Point {
+    let n = length(a);
+    if n < 1.0e-5 {
+        [0.; 3]
+    } else {
+        a.map(|v| v / n)
+    }
+}
+fn cross(a: Point, b: Point) -> Point {
+    [
+        a[1] * b[2] - a[2] * b[1],
+        a[2] * b[0] - a[0] * b[2],
+        a[0] * b[1] - a[1] * b[0],
+    ]
+}
+fn fma(at: Point, t: f64, d: Point) -> Point {
+    std::array::from_fn(|i| t.mul_add(d[i], at[i]))
+}
+fn distance(a: Point, b: Point) -> f64 {
+    let d = sub(a, b);
+    dot(d, d)
+}
+fn zero(a: Point) -> bool {
+    dot(a, a).abs() < 1.0e-5
+}
+fn wrap(angle: f32) -> f32 {
+    let mut a = angle % 360.;
+    if a >= 180. {
+        a -= 360.;
+    }
+    if a < -180. {
+        a += 360.;
+    }
+    a
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Mode {
+    Center,
+    Random,
+    Stabilized,
+    NearestRotation,
+    ReverseYaw,
+    DiagonalYaw,
+    AngleYaw,
+    EdgePoint,
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Face {
+    pub from: Point,
+    pub to: Point,
+}
+impl Face {
+    pub fn dimensions(self) -> Point {
+        sub(self.to, self.from)
+    }
+    pub fn area(self) -> f64 {
+        let d = self.dimensions();
+        d[0] * d[1] + d[1] * d[2] + d[0] * d[2]
+    }
+    pub fn center(self) -> Point {
+        let d = self.dimensions();
+        std::array::from_fn(|i| self.from[i] + 0.5 * d[i])
+    }
+    pub fn trim(self) -> Self {
+        let offset = scale(self.dimensions(), 0.15);
+        let low = add(self.from, offset);
+        let high = sub(self.to, offset);
+        let center = self.center();
+        Self {
+            from: std::array::from_fn(|i| if low[i] > high[i] { center[i] } else { low[i] }),
+            to: std::array::from_fn(|i| if low[i] > high[i] { center[i] } else { high[i] }),
+        }
+    }
+    fn offset(self, p: Point) -> Self {
+        Self {
+            from: add(self.from, p),
+            to: add(self.to, p),
+        }
+    }
+    fn axes(self) -> (Point, Point) {
+        let d = self.dimensions();
+        if d[0] == 0. {
+            ([0., d[1], 0.], [0., 0., d[2]])
+        } else if d[1] == 0. {
+            ([d[0], 0., 0.], [0., 0., d[2]])
+        } else {
+            assert_eq!(d[2], 0.);
+            ([0., d[1], 0.], [d[0], 0., 0.])
+        }
+    }
+    fn edges(self) -> Vec<Linear> {
+        let (a, b) = self.axes();
+        let mut edges = Vec::new();
+        for d in [a, b] {
+            if !zero(d) {
+                edges.push(Linear {
+                    anchor: self.from,
+                    direction: d,
+                    segment: true,
+                });
+                edges.push(Linear {
+                    anchor: self.to,
+                    direction: scale(d, -1.),
+                    segment: true,
+                });
+            }
+        }
+        edges
+    }
+    fn plane(self) -> Plane {
+        let (a, b) = self.axes();
+        Plane::from_params(self.from, a, b)
+    }
+    fn nearest(self, line: Linear) -> Point {
+        let intersection = self.plane().intersection(line);
+        let edges = self.edges();
+        let center = self.center();
+        if let Some(point) = intersection {
+            if edges.is_empty()
+                || edges.iter().all(|edge| {
+                    let at = edge.at(0.5);
+                    dot(sub(at, point), sub(at, center)) > 0.
+                })
+            {
+                return point;
+            }
+        }
+        let mut nearest = None;
+        let mut best = f64::INFINITY;
+        for edge in edges {
+            if let Some((a, b)) = edge.nearest_pair(line) {
+                let d = distance(a, b);
+                if nearest.is_none() || d < best {
+                    nearest = Some(a);
+                    best = d;
+                }
+            }
+        }
+        nearest.or(intersection).unwrap_or(center)
+    }
+    fn coerce(self, line: Linear) -> Option<Linear> {
+        let mut candidates: Vec<_> = self
+            .edges()
+            .into_iter()
+            .filter_map(|edge| line.nearest_pair(edge).map(|(a, b)| (distance(a, b), b)))
+            .collect();
+        candidates.sort_by(|a, b| a.0.total_cmp(&b.0));
+        let a = candidates.first()?.1;
+        let b = candidates.get(1)?.1;
+        let direction = sub(b, a);
+        (!zero(direction)).then_some(Linear {
+            anchor: a,
+            direction,
+            segment: true,
+        })
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Linear {
+    pub anchor: Point,
+    pub direction: Point,
+    pub segment: bool,
+}
+impl Linear {
+    fn at(self, t: f64) -> Point {
+        fma(self.anchor, t, self.direction)
+    }
+    fn project(self, t: f64) -> f64 {
+        if !t.is_finite() {
+            f64::NAN
+        } else if self.segment {
+            t.clamp(0., 1.)
+        } else {
+            t
+        }
+    }
+    fn normal_parameter(self, t: f64) -> Option<f64> {
+        (t.is_finite() && (!self.segment || (-1e-9..=1. + 1e-9).contains(&t)))
+            .then(|| self.project(t))
+    }
+    pub fn nearest(self, point: Point) -> Point {
+        let t = self.project(
+            dot(self.direction, sub(point, self.anchor)) / dot(self.direction, self.direction),
+        );
+        assert!(!t.is_nan(), "Scaffold line cannot project this point");
+        self.at(t)
+    }
+    fn nearest_pair(self, other: Self) -> Option<(Point, Point)> {
+        let delta = sub(self.anchor, other.anchor);
+        let a = dot(self.direction, self.direction);
+        let b = dot(self.direction, other.direction);
+        let c = dot(other.direction, other.direction);
+        let d = dot(self.direction, delta);
+        let e = dot(other.direction, delta);
+        let determinant = a * c - b * b;
+        let mut best = None;
+        let mut best_distance = f64::INFINITY;
+        let mut candidate = |u, v| {
+            let (Some(u), Some(v)) = (self.normal_parameter(u), other.normal_parameter(v)) else {
+                return;
+            };
+            let d: Point =
+                std::array::from_fn(|i| delta[i] + self.direction[i] * u - other.direction[i] * v);
+            let distance = dot(d, d);
+            if best.is_none() || distance < best_distance - 1e-9 {
+                best = Some((u, v));
+                best_distance = distance;
+            }
+        };
+        if determinant > 1e-9 * a * c {
+            candidate((b * e - c * d) / determinant, (a * e - b * d) / determinant);
+        }
+        if self.segment {
+            for u in [0., 1.] {
+                candidate(u, other.project((b * u + e) / c));
+            }
+        }
+        if other.segment {
+            for v in [0., 1.] {
+                candidate(self.project((b * v - d) / a), v);
+            }
+        }
+        candidate(self.project(-d / a), 0.);
+        candidate(0., other.project(e / c));
+        best.map(|(a, b)| (self.at(a), other.at(b)))
+    }
+}
+#[derive(Clone, Copy, Debug)]
+struct Plane {
+    position: Point,
+    normal: Point,
+}
+impl Plane {
+    fn from_params(position: Point, a: Point, b: Point) -> Self {
+        let normal = normalize(cross(a, b));
+        assert!(!zero(normal), "Scaffold plane must have nonzero normal");
+        Self { position, normal }
+    }
+    fn intersection(self, line: Linear) -> Option<Point> {
+        let d = dot(self.position, self.normal);
+        let e = dot(line.direction, self.normal);
+        if e.abs() < 1.0e-5 {
+            return None;
+        }
+        let t = (d - dot(line.anchor, self.normal)) / e;
+        Some(line.at(line.normal_parameter(t)?))
+    }
+    fn intersection_plane(self, other: Self) -> Option<Linear> {
+        let first = other.normal;
+        let second = self.normal;
+        let direction = cross(first, second);
+        let squared = dot(direction, direction);
+        if squared.abs() < 1e-5 {
+            return None;
+        }
+        let first_distance = dot(first, other.position);
+        let second_distance = dot(second, self.position);
+        let point = scale(
+            add(
+                scale(cross(second, direction), first_distance),
+                scale(cross(direction, first), second_distance),
+            ),
+            1. / squared,
+        );
+        Some(Linear {
+            anchor: point,
+            direction,
+            segment: false,
+        })
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Location {
+    pub position: Point,
+    pub eye: Point,
+    pub rotation: [f32; 2],
+    pub moving: bool,
+}
+pub trait Math {
+    fn rotation_direction(&mut self, rotation: [f32; 2]) -> Point;
+    fn yaw_axis(&mut self, yaw: f32) -> Point;
+    fn point_yaw(&mut self, delta: Point) -> f32;
+    fn random_between(&mut self, from: f64, to: f64) -> f64;
+}
+fn nearest(face: Face, target: Point, location: Location, math: &mut impl Math) -> Point {
+    if face.area().abs() < 1e-5 {
+        return face.from;
+    }
+    let line = Linear {
+        anchor: sub(location.eye, target),
+        direction: math.rotation_direction(location.rotation),
+        segment: false,
+    };
+    face.nearest(line)
+}
+fn stabilized(
+    face: Face,
+    target: Point,
+    location: Location,
+    optimal: Option<Linear>,
+    math: &mut impl Math,
+) -> Point {
+    let trimmed = face.trim().offset(target);
+    let target_face = optimal
+        .and_then(|optimal| {
+            let nearest = optimal.nearest(location.position);
+            let direction = normalize(sub(location.position, nearest));
+            let from_player = Linear {
+                anchor: location.eye,
+                direction: optimal.direction,
+                segment: false,
+            };
+            let collision = trimmed.plane().intersection(from_player)?;
+            let b = fma(location.position, 2., direction);
+            // AABB constructor sorts the crop's bounds before clamping each point.
+            let a = [collision[0], location.position[1] - 2., collision[2]];
+            let b = [b[0], location.position[1] + 1., b[2]];
+            let clamp =
+                |p: Point| std::array::from_fn(|i| p[i].clamp(a[i].min(b[i]), a[i].max(b[i])));
+            let clipped = Face {
+                from: clamp(trimmed.from),
+                to: clamp(trimmed.to),
+            };
+            (clipped.area() >= 0.0001).then_some(clipped)
+        })
+        .unwrap_or(trimmed);
+    nearest(
+        target_face.offset(scale(target, -1.)),
+        target,
+        location,
+        math,
+    )
+}
+fn closest_yaw(segment: Linear, target: f32, eye: Point, math: &mut impl Math) -> Point {
+    let start = math.point_yaw(sub(segment.anchor, eye));
+    let end = math.point_yaw(sub(segment.at(1.), eye));
+    let diff = wrap(end - start);
+    let target = wrap(target - start);
+    let t = if diff != 0. { target / diff } else { 0. };
+    segment.at(f64::from(t.clamp(0., 1.)))
+}
+fn aim_yaw(
+    face: Face,
+    target: Point,
+    location: Location,
+    angle: f32,
+    math: &mut impl Math,
+) -> Option<Point> {
+    if face.area().abs() < 1e-5 {
+        return Some(face.from);
+    }
+    let eye = sub(location.eye, target);
+    let yaw = wrap(location.rotation[0]);
+    let high = wrap(yaw + angle);
+    let low = wrap(yaw - angle);
+    let plane = face.plane();
+    let mut sample = |yaw| {
+        let direction = math.yaw_axis(yaw);
+        let yaw_plane = Plane::from_params(eye, direction, [0., 1., 0.]);
+        let intersection = plane.intersection_plane(yaw_plane)?;
+        let segment = face.coerce(intersection)?;
+        let point = closest_yaw(segment, yaw, eye, math);
+        let tolerance = wrap(math.point_yaw(sub(point, eye)) - yaw).abs();
+        Some((point, tolerance))
+    };
+    let high = sample(high);
+    let low = sample(low);
+    match (high, low) {
+        (Some((a, x)), Some((b, y))) if x <= 5. && y <= 5. => Some(if x < y { a } else { b }),
+        (Some((a, x)), _) if x <= 5. => Some(a),
+        (_, Some((b, y))) if y <= 5. => Some(b),
+        _ => None,
+    }
+}
+pub fn sample(
+    mode: Mode,
+    face: Face,
+    target: Point,
+    location: Location,
+    optimal: Option<Linear>,
+    math: &mut impl Math,
+) -> Point {
+    match mode {
+        Mode::Center => face.center(),
+        Mode::Random => {
+            let face = face.trim();
+            std::array::from_fn(|i| {
+                if face.from[i] == face.to[i] {
+                    face.from[i]
+                } else {
+                    math.random_between(face.from[i], face.to[i])
+                }
+            })
+        }
+        Mode::NearestRotation => nearest(face.trim(), target, location, math),
+        Mode::Stabilized => stabilized(face, target, location, optimal, math),
+        Mode::ReverseYaw | Mode::DiagonalYaw | Mode::AngleYaw => {
+            let face = face.trim();
+            let angle = match mode {
+                Mode::ReverseYaw => 180.,
+                Mode::DiagonalYaw => 75.,
+                _ => 45.,
+            };
+            if location.moving {
+                if let Some(point) = aim_yaw(face, target, location, angle, math) {
+                    return point;
+                }
+            }
+            nearest(face, target, location, math)
+        }
+        Mode::EdgePoint => {
+            let face = face.trim();
+            if !location.moving {
+                return nearest(face, target, location, math);
+            }
+            let player = sub(location.position, target);
+            let mut point = face.from;
+            let mut best = f64::NEG_INFINITY;
+            for x in [face.from[0], face.to[0]] {
+                for y in [face.from[1], face.to[1]] {
+                    for z in [face.from[2], face.to[2]] {
+                        let p = [x, y, z];
+                        let d = distance(p, player);
+                        if d > best {
+                            point = p;
+                            best = d;
+                        }
+                    }
+                }
+            }
+            point
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_height_rules.rs b/crates/horizon-client/src/game/scaffold_height_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_height_rules.rs
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleScaffold lifecycle, target height and placement tick decisions.
+pub type BlockPos = [i32; 3];
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Timing {
+    #[default]
+    Normal,
+    OnTick,
+    OnTickSnap,
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum SameY {
+    #[default]
+    Off,
+    On,
+    JumpKey,
+    Falling,
+    Hypixel,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Hand {
+    Main,
+    Off,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SlotAction {
+    Select(usize),
+    Reset,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Selection {
+    pub action: SlotAction,
+    pub has_main: bool,
+}
+
+/// Source deliberately ignores selectSlotSilently's cancellation return when
+/// deciding hasBlockInMainHand. The real held stack is still queried afterward.
+pub fn select_block(
+    auto_block: bool,
+    main: bool,
+    offhand: bool,
+    best_slot: Option<usize>,
+) -> Selection {
+    if auto_block
+        && !main
+        && !offhand
+        && let Some(slot) = best_slot
+    {
+        return Selection {
+            action: SlotAction::Select(slot),
+            has_main: true,
+        };
+    }
+    Selection {
+        action: SlotAction::Reset,
+        has_main: main,
+    }
+}
+pub fn hand(main: bool, offhand: bool) -> Option<Hand> {
+    if main {
+        Some(Hand::Main)
+    } else if offhand {
+        Some(Hand::Off)
+    } else {
+        None
+    }
+}
+pub fn valid_crosshair(point: [f64; 3], eye: [f64; 3], face: [i32; 3], min_dist: f32) -> bool {
+    if face[1] != 0 {
+        return true;
+    }
+    let axis = if face[2] != 0 { 2 } else { 0 };
+    (point[axis] - eye[axis]).abs() >= f64::from(min_dist)
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct PositionFacts {
+    pub block: BlockPos,
+    pub velocity_y: f64,
+    pub input_jump: bool,
+    pub physical_jump: bool,
+    pub moving: bool,
+    pub horizontal_collision: bool,
+}
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct State {
+    pub placement_y: i32,
+    pub start_y: i32,
+    pub jumps: i32,
+    pub was_towering: bool,
+    pub force_sneak: i32,
+}
+impl State {
+    pub fn enabled(&mut self, block_y: i32) {
+        self.placement_y = block_y.wrapping_sub(1);
+        self.start_y = block_y;
+        self.jumps = 2;
+    }
+    /// Other reset effects (planner/history/slot/renderer/target/NoFallBlink)
+    /// are performed by the runtime. The source retains its height/tower data.
+    pub fn reset(&mut self) {
+        self.force_sneak = 0;
+    }
+    pub fn tick_begin(&mut self, block_y: i32, on_ground: bool, physical_jump: bool) {
+        if on_ground {
+            self.placement_y = block_y.wrapping_sub(1);
+            self.jumps = self.jumps.wrapping_add(1);
+            self.was_towering = false;
+        }
+        if physical_jump {
+            self.start_y = block_y;
+            self.jumps = 2;
+        }
+    }
+    pub fn is_towering(&mut self, tower_selected: bool, physical_jump: bool) -> bool {
+        let active = tower_selected && physical_jump;
+        if active {
+            self.was_towering = true;
+        }
+        active
+    }
+    pub fn take_forced_sneak(&mut self) -> bool {
+        if self.force_sneak <= 0 {
+            return false;
+        }
+        self.force_sneak -= 1;
+        true
+    }
+    pub fn ledge_sneak(&mut self, ticks: i32) -> bool {
+        if ticks > self.force_sneak {
+            self.force_sneak = ticks;
+            true
+        } else {
+            false
+        }
+    }
+    /// Called only after the tower/down/ceiling precedence is resolved.
+    pub fn targeted_position(&mut self, facts: PositionFacts, same_y: SameY) -> BlockPos {
+        let mut pos = facts.block;
+        if facts.input_jump && (!facts.moving || facts.horizontal_collision) {
+            pos[1] = pos[1].wrapping_sub(1);
+            return pos;
+        }
+        let same_y = match same_y {
+            SameY::Off => None,
+            SameY::On => Some(self.placement_y),
+            SameY::JumpKey => (!facts.physical_jump).then_some(self.placement_y),
+            SameY::Falling => (facts.velocity_y < 0.2).then_some(self.placement_y),
+            SameY::Hypixel => Some(
+                if facts.velocity_y == -0.15233518685055708 && self.jumps >= 2 {
+                    self.jumps = 0;
+                    self.start_y
+                } else {
+                    self.start_y.wrapping_sub(1)
+                },
+            ),
+        };
+        pos[1] = same_y.unwrap_or_else(|| pos[1].wrapping_sub(1));
+        pos
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Attempt {
+    pub enabled: bool,
+    pub failed_only: bool,
+    pub suitable_hand: bool,
+    pub block_hit: bool,
+    pub can_place_on_face: bool,
+    pub same_y: SameY,
+    pub physical_jump: bool,
+    pub clicked_y: i32,
+    pub clicked_up: bool,
+    pub placement_y: i32,
+    pub player_block_y: i32,
+}
+pub fn simulate_attempt(a: Attempt) -> bool {
+    if !a.suitable_hand || !a.enabled || !a.block_hit {
+        return false;
+    }
+    if a.failed_only {
+        return !a.can_place_on_face;
+    }
+    if a.same_y != SameY::Off && (a.same_y != SameY::JumpKey || a.physical_jump) {
+        return a.clicked_y == a.placement_y && (!a.clicked_up || !a.can_place_on_face);
+    }
+    let below = a.player_block_y.wrapping_sub(1);
+    let under = a.clicked_y <= below;
+    let towering = a.clicked_y == below && a.can_place_on_face && a.clicked_up;
+    under && !towering
+}
diff --git a/crates/horizon-client/src/game/scaffold_technique_rules.rs b/crates/horizon-client/src/game/scaffold_technique_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_technique_rules.rs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Source Normal/Expand control decisions, independent of world queries.
+pub fn normal_radius(freeze: bool, down: bool) -> i32 {
+    if freeze {
+        4
+    } else if down {
+        2
+    } else {
+        1
+    }
+}
+pub fn reverse_rotation(yaw: f32, pitch: f32) -> [f32; 2] {
+    [
+        (yaw / 45.0).round_ties_even() * 45.0,
+        if pitch < 45.0 { 45.0 } else { pitch },
+    ]
+}
+/// Java/Kotlin's Float arithmetic and truncating conversion are significant at
+/// diagonal headings. The caller supplies Kotlin sin/cos(Float) results.
+pub fn expand_position(position: [f64; 3], xz: [f32; 2], step: i32) -> [i32; 3] {
+    let [x, y, z] = position.map(|v| v.floor() as i32);
+    [
+        x.wrapping_add((xz[0] * step as f32) as i32),
+        y,
+        z.wrapping_add((xz[1] * step as f32) as i32),
+    ]
+}
+/// Target height is resolved lazily by the callback. In Hypixel SameY the
+/// resolution changes jumps, so candidates after a successful placement must
+/// never resolve their heights.
+pub fn find_expand<T>(
+    position: [f64; 3],
+    xz: [f32; 2],
+    length: i32,
+    mut find: impl FnMut([i32; 3]) -> Option<T>,
+) -> Option<T> {
+    for step in 0..=length {
+        if let Some(target) = find(expand_position(position, xz, step)) {
+            return Some(target);
+        }
+    }
+    None
+}
diff --git a/crates/horizon-client/src/game/scaffold_techniques.rs b/crates/horizon-client/src/game/scaffold_techniques.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_techniques.rs
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete source Normal/Expand target, rotation and crosshair operations.
+use super::{
+    Game, ItemStack,
+    block_placement::{self as placement, Target},
+    scaffold_aim_rules as aim, scaffold_height_rules as height, scaffold_technique_rules as rules,
+};
+use horizon_client::pose::Pose;
+use horizon_core::{
+    geometry::{
+        Vec3,
+        trig::{DEG_TO_RAD, RAD_TO_DEG},
+    },
+    jmath,
+};
+use serde_json::{Value, json};
+
+struct Math;
+fn point(value: Vec3) -> [f64; 3] {
+    [value.x, value.y, value.z]
+}
+impl aim::Math for Math {
+    fn rotation_direction(&mut self, r: [f32; 2]) -> aim::Point {
+        point(Vec3::direction_from_rotation(r[1], r[0]))
+    }
+    fn yaw_axis(&mut self, yaw: f32) -> aim::Point {
+        point(Vec3::new(0.0, 0.0, 1.0).rotate_y(yaw * DEG_TO_RAD))
+    }
+    fn point_yaw(&mut self, p: aim::Point) -> f32 {
+        (jmath::atan2(-p[0], p[2]) as f32) * RAD_TO_DEG
+    }
+    fn random_between(&mut self, from: f64, to: f64) -> f64 {
+        super::edge_random::with_thread_random(|random| random.next_f64_between(from, to))
+    }
+}
+fn mode(value: &Value) -> Option<aim::Mode> {
+    Some(match value.as_str()? {
+        "Center" => aim::Mode::Center,
+        "Random" => aim::Mode::Random,
+        "Stabilized" => aim::Mode::Stabilized,
+        "NearestRotation" => aim::Mode::NearestRotation,
+        "ReverseYaw" => aim::Mode::ReverseYaw,
+        "DiagonalYaw" => aim::Mode::DiagonalYaw,
+        "AngleYaw" => aim::Mode::AngleYaw,
+        "EdgePoint" => aim::Mode::EdgePoint,
+        _ => return None,
+    })
+}
+fn line(value: &Value) -> Option<aim::Linear> {
+    Some(aim::Linear {
+        anchor: serde_json::from_value(value["position"].clone()).ok()?,
+        direction: serde_json::from_value(value["direction"].clone()).ok()?,
+        segment: false,
+    })
+}
+fn write_target(target: &Target) -> Value {
+    json!({"interacted":target.interacted,"placed":target.placed,"direction":target.direction,
+        "point":target.point,"minY":target.min_y,"rotation":target.rotation})
+}
+fn target(value: &Value) -> Option<Target> {
+    Some(Target {
+        interacted: serde_json::from_value(value["interacted"].clone()).ok()?,
+        placed: serde_json::from_value(value["placed"].clone()).ok()?,
+        direction: serde_json::from_value(value["direction"].clone()).ok()?,
+        point: serde_json::from_value(value["point"].clone()).ok()?,
+        min_y: value["minY"].as_f64()?,
+        rotation: serde_json::from_value(value["rotation"].clone()).ok()?,
+    })
+}
+fn pose(value: &Value) -> Option<Pose> {
+    Some(match value.as_str()? {
+        "Standing" | "STANDING" => Pose::Standing,
+        "Crouching" | "CROUCHING" => Pose::Crouching,
+        "Swimming" | "SWIMMING" => Pose::Swimming,
+        "FallFlying" | "FALL_FLYING" => Pose::FallFlying,
+        "SpinAttack" | "SPIN_ATTACK" => Pose::SpinAttack,
+        "Sleeping" | "SLEEPING" => Pose::Sleeping,
+        _ => return None,
+    })
+}
+fn same_y(value: &Value) -> Option<height::SameY> {
+    Some(match value.as_str()? {
+        "Off" => height::SameY::Off,
+        "On" => height::SameY::On,
+        "JumpKey" => height::SameY::JumpKey,
+        "Falling" => height::SameY::Falling,
+        "Hypixel" => height::SameY::Hypixel,
+        _ => return None,
+    })
+}
+struct Height {
+    state: height::State,
+    same_y: height::SameY,
+    facts: height::PositionFacts,
+    towering: bool,
+    down: bool,
+    ceiling: bool,
+}
+impl Height {
+    fn read(game: &Game<'_>, value: &Value) -> Option<Self> {
+        let player = game.player.as_ref()?;
+        let keys = horizon_client::reverse_step_bridge::keys();
+        let integer = |key: &str| i32::try_from(value["state"][key].as_i64()?).ok();
+        Some(Self {
+            state: height::State {
+                placement_y: integer("placementY")?,
+                start_y: integer("startY")?,
+                jumps: integer("jumps")?,
+                was_towering: value["state"]["wasTowering"].as_bool()?,
+                force_sneak: 0,
+            },
+            same_y: same_y(&value["sameY"])?,
+            facts: height::PositionFacts {
+                block: [0; 3],
+                velocity_y: player.velocity.y,
+                input_jump: keys[4] || player.was_auto_jump,
+                physical_jump: game.keys.held(horizon_client::actions::Action::Jump),
+                moving: player.move_vector != [0.0, 0.0],
+                horizontal_collision: player.collision.horizontal,
+            },
+            towering: value["towering"].as_bool()?,
+            down: value["downRunning"].as_bool()? && value["shouldGoDown"].as_bool()?,
+            ceiling: value["ceiling"].as_bool()?,
+        })
+    }
+    fn target(&mut self, mut block: [i32; 3]) -> [i32; 3] {
+        if self.towering || self.state.was_towering {
+            if self.towering {
+                self.state.was_towering = true;
+            }
+            block[1] = block[1].wrapping_sub(1);
+            block
+        } else if self.down {
+            block[1] = block[1].wrapping_sub(2);
+            block
+        } else if self.ceiling {
+            block[1] = block[1].wrapping_add(3);
+            block
+        } else {
+            self.state.targeted_position(
+                height::PositionFacts {
+                    block,
+                    ..self.facts
+                },
+                self.same_y,
+            )
+        }
+    }
+    fn write(&self) -> Value {
+        json!({"placementY":self.state.placement_y,"startY":self.state.start_y,
+            "jumps":self.state.jumps,"wasTowering":self.state.was_towering})
+    }
+}
+impl Game<'_> {
+    pub(super) fn scaffold_technique_query(&mut self, text: &str) -> Option<String> {
+        let request = serde_json::from_str::<Value>(text).ok()?;
+        let technique = request["technique"].as_str()?;
+        if !matches!(technique, "Normal" | "Expand" | "GodBridge" | "Breezily") {
+            return None;
+        }
+        match request["op"].as_str()? {
+            "plan" => {
+                let predicted: [f64; 3] =
+                    serde_json::from_value(request["position"].clone()).ok()?;
+                let rotation: [f32; 2] =
+                    serde_json::from_value(request["serverRotation"].clone()).ok()?;
+                let player = self.player.as_ref()?;
+                let yaw = player.yaw;
+                let eye_height = pose(&request["pose"])?.dimensions(player.scale).eye_height;
+                let mut location = placement::capture_location(self, Some(predicted), rotation)?;
+                location.eye_height = eye_height;
+                let stack = if request["slot"].is_null() {
+                    ItemStack::new("minecraft:sandstone", 64)
+                } else {
+                    let slot = usize::try_from(request["slot"].as_u64()?).ok()?;
+                    if slot > 8 {
+                        return None;
+                    }
+                    self.inventory.get(slot)?.as_ref()?.clone()
+                };
+                let mut height = Height::read(self, &request["height"])?;
+                let found = if technique == "Normal" {
+                    let aim_mode = mode(&request["aimMode"])?;
+                    let optimal = if request["optimalLine"].is_null() {
+                        None
+                    } else {
+                        Some(line(&request["optimalLine"])?)
+                    };
+                    let down = request["height"]["shouldGoDown"].as_bool()?;
+                    let mut factory =
+                        |_: &Game<'_>,
+                         face: placement::Face,
+                         block: [i32; 3],
+                         location: placement::Location| {
+                            Some(aim::sample(
+                                aim_mode,
+                                aim::Face {
+                                    from: face.from,
+                                    to: face.to,
+                                },
+                                block.map(f64::from),
+                                aim::Location {
+                                    position: location.position,
+                                    eye: location.eye(),
+                                    rotation: location.rotation,
+                                    moving: location.moving,
+                                },
+                                optimal,
+                                &mut Math,
+                            ))
+                        };
+                    let mut options = placement::Options::center(&stack, location);
+                    options.offsets = placement::offsets(rules::normal_radius(
+                        request["freeze"].as_bool()?,
+                        down,
+                    ));
+                    options.priority =
+                        optimal.map_or(placement::Priority::Position(predicted), |line| {
+                            placement::Priority::Line {
+                                position: line.anchor,
+                                direction: line.direction,
+                            }
+                        });
+                    options.face = placement::FaceFactory::Custom(&mut factory);
+                    options.consider_facing_away = down;
+                    let block = height.target(predicted.map(|v| v.floor() as i32));
+                    placement::find(self, block, &mut options)
+                } else if technique == "Expand" {
+                    let length = i32::try_from(request["length"].as_i64()?).ok()?;
+                    if !(1..=10).contains(&length) {
+                        return None;
+                    }
+                    let radians = yaw * DEG_TO_RAD;
+                    let xz = [
+                        -(jmath::sin(f64::from(radians)) as f32),
+                        jmath::cos(f64::from(radians)) as f32,
+                    ];
+                    let mut options = placement::Options::center(&stack, location);
+                    options.consider_facing_away = true;
+                    // BlockOffsetOptions.Default compares against the live player,
+                    // though its sole zero offset makes the ordering unobservable.
+                    let p = self.player.as_ref()?;
+                    options.priority =
+                        placement::Priority::Position([p.position.x, p.position.y, p.position.z]);
+                    rules::find_expand(predicted, xz, length, |candidate| {
+                        placement::find(self, height.target(candidate), &mut options)
+                    })
+                } else {
+                    let mut options=placement::Options::center(&stack,location);
+                    options.offsets=placement::offsets(1);
+                    options.priority=placement::Priority::Position(predicted);
+                    let block=height.target(predicted.map(|v|v.floor()as i32));
+                    placement::find(self,block,&mut options)
+                };
+                Some(
+                    json!({"target":found.as_ref().map(write_target),"heightState":height.write()})
+                        .to_string(),
+                )
+            }
+            "rotation" => {
+                if technique == "Normal"
+                    && request["telly"]["enabled"].as_bool()?
+                    && request["telly"]["doNotAim"].as_bool()?
+                {
+                    return Some(match request["telly"]["resetMode"].as_str()? {
+                        "Reverse" => {
+                            let p = self.player.as_ref()?;
+                            json!(rules::reverse_rotation(p.yaw, p.pitch)).to_string()
+                        }
+                        "Reset" => "null".into(),
+                        _ => return None,
+                    });
+                }
+                let target = target(&request["target"])?;
+                let rotation = if technique == "Expand" {
+                    placement::looking_at(
+                        target.placed.map(|v| f64::from(v) + 0.5),
+                        self.eye_position()?,
+                    )
+                } else {
+                    if request["requiresSight"].as_bool()? {
+                        let range = self
+                            .interaction_range("minecraft:block_interaction_range", 4.5, 5.0)
+                            .max(self.interaction_range(
+                                "minecraft:entity_interaction_range",
+                                3.0,
+                                5.0,
+                            ));
+                        // Original checks sight, then falls through to the same target
+                        // rotation even when the check fails.
+                        let _sight = placement::trace_world(self, target.rotation, range)
+                            .is_some_and(|hit| hit.pos == target.interacted);
+                    }
+                    target.rotation
+                };
+                Some(json!(rotation).to_string())
+            }
+            "crosshair" => {
+                let target = target(&request["target"])?;
+                let rotation = serde_json::from_value(request["rotation"].clone()).ok()?;
+                let range = self
+                    .interaction_range("minecraft:block_interaction_range", 4.5, 5.0)
+                    .max(self.interaction_range("minecraft:entity_interaction_range", 3.0, 5.0));
+                let fallback = technique == "Expand" || technique == "Normal" && request["shouldGoDown"].as_bool()?;
+                let click = placement::verify_click(
+                    self,
+                    &target,
+                    rotation,
+                    range,
+                    placement::ClickTrace::World,
+                    if fallback {
+                        placement::FailedClick::PlannedHit
+                    } else {
+                        placement::FailedClick::Nothing
+                    },
+                )?;
+                Some(json!({"block":click.hit.pos,"face":click.hit.face,"point":click.hit.point,"inside":click.inside}).to_string())
+            }
+            _ => None,
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_click_inside.rs b/crates/horizon-client/src/game/scaffold_click_inside.rs
