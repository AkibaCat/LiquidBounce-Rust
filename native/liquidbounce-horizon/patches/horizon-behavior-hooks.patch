+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use super::entity::{Entity as _, with_entity_mut};
+use horizon_core::geometry::Vec3;
+use horizon_protocol::packets::play::MoveVehicleRequest;
+impl Game<'_> {
+    pub(super) fn client_mace_kill_vehicle(
+        &mut self,
+        id: u32,
+        position: Option<[f64; 3]>,
+    ) -> Option<MoveVehicleRequest> {
+        let tracked = self
+            .remote
+            .as_mut()
+            .and_then(|r| r.liquidbounce_mace_kill_state(id as i32, None, false));
+        // setPos leaves old positions, velocity, passengers and ground intact.
+        if let Some(handle) = self.native_walk_entity(id) {
+            return Some(with_entity_mut!(self,handle,e=>{
+                if let Some([x,y,z])=position{*e.position_mut()=Vec3::new(x,y,z);}
+                let p=e.position();let [yaw,pitch]=e.rotation();
+                MoveVehicleRequest{position:[p.x,p.y,p.z],yaw,pitch,on_ground:e.on_ground()}
+            }));
+        }
+        if let Some(display) = self.text_displays.get_mut(&(id as i32)) {
+            let (position, [yaw, pitch]) = display.liquidbounce_mace_kill_position(position);
+            return Some(MoveVehicleRequest {
+                position,
+                yaw,
+                pitch,
+                on_ground: tracked.is_some_and(|(_, _, ground)| ground),
+            });
+        }
+        let target = self
+            .native_entity(id)
+            .and_then(|entity| self.native_entity_target(entity));
+        let mut rotation = tracked.map_or([0.0, 0.0], |(_, rotation, _)| rotation);
+        if let Some(e) = self.others.iter().find(|e| e.id == id) {
+            rotation = [e.yaw, e.pitch];
+        }
+        if let Some(e) = self.fangs.list.iter().find(|e| e.id == id) {
+            rotation[0] = e.yaw;
+        }
+        if let Some(e) = self.dragon.as_ref().filter(|e| e.id == id) {
+            rotation[0] = e.yaw;
+        }
+        if let Some(e) = self.cushions.iter().find(|e| e.id == id) {
+            rotation[0] = e.yaw;
+        }
+        let mut hanging = None;
+        let mut frame_codec = false;
+        if let Some([x, y, z]) = position {
+            let at = Vec3::new(x, y, z);
+            if let Some(e) = self.others.iter_mut().find(|e| e.id == id) {
+                e.position = at;
+            }
+            if let Some(e) = self.crystals.iter_mut().find(|e| e.id == id) {
+                e.position = at;
+            }
+            if let Some(e) = self.dragon.as_mut().filter(|e| e.id == id) {
+                e.position = at;
+            }
+            if let Some(e) = self.cushions.iter_mut().find(|e| e.id == id) {
+                e.position = at;
+                e.pos = [x.floor() as i32, y.floor() as i32, z.floor() as i32];
+            }
+            if let Some(e) = self.fangs.list.iter_mut().find(|e| e.id == id) {
+                e.pos = [x, y, z];
+            }
+            if let Some(e) = self.ominous_spawners.iter_mut().find(|e| e.id == id) {
+                e.position = [x, y, z];
+            }
+            if let Some(e) = self.breath_clouds.iter_mut().find(|e| e.id == id) {
+                e.at = [x, y, z];
+            }
+            if let Some(e) = self.interactions.get_mut(&(id as i32)) {
+                e.position = at;
+            }
+            // BlockAttachedEntity.setPos stores BlockPos.containing, then
+            // HangingEntity.recalculateBoundingBox sets its centre as position.
+            if let Some(e) = self.paintings.iter_mut().find(|e| e.id == id) {
+                e.pos = [x.floor() as i32, y.floor() as i32, z.floor() as i32];
+            }
+            if let Some(e) = self.item_frames.iter_mut().find(|e| e.id == id) {
+                e.pos = [x.floor() as i32, y.floor() as i32, z.floor() as i32];
+                frame_codec = true;
+            }
+            if let Some(block) = self.remote_knots.get_mut(&id) {
+                *block = [x.floor() as i32, y.floor() as i32, z.floor() as i32];
+            }
+        }
+        if let Some(e) = self.paintings.iter().find(|e| e.id == id) {
+            let (lo, hi) = e.bounds();
+            hanging = Some(std::array::from_fn(|i| (lo[i] + hi[i]) / 2.0));
+            if tracked.is_none() {
+                rotation = [f32::from(e.facing & 3) * 90.0, 0.0];
+            }
+        }
+        if let Some(e) = self.item_frames.iter().find(|e| e.id == id) {
+            let (lo, hi) = e.bounds();
+            hanging = Some(std::array::from_fn(|i| (lo[i] + hi[i]) / 2.0));
+        }
+        if let Some(block) = self.remote_knots.get(&id) {
+            let p = horizon_client::mobs::leash::knot_state(*block).position;
+            hanging = Some([p.x, p.y, p.z]);
+        }
+        let at = target
+            .and_then(|target| self.target_position(target))
+            .or(hanging)
+            .or_else(|| {
+                self.interactions.get(&(id as i32)).map(|e| {
+                    let p = e.position;
+                    [p.x, p.y, p.z]
+                })
+            })
+            .or_else(|| {
+                self.remote
+                    .as_mut()
+                    .and_then(|r| r.liquidbounce_mace_kill_state(id as i32, position, false))
+                    .map(|(p, _, _)| p)
+            })?;
+        if position.is_some() && (target.is_none() || frame_codec) {
+            // ItemFrame.recalculateBoundingBox also syncs its packet codec;
+            // other setPos calls leave that server delta base alone.
+            if let Some(r) = self.remote.as_mut() {
+                r.liquidbounce_mace_kill_state(id as i32, Some(at), frame_codec);
+            }
+        }
+        let on_ground = self.crystals.iter().find(|e| e.id == id).map_or_else(
+            || tracked.is_some_and(|(_, _, ground)| ground),
+            |e| e.fall.0,
+        );
+        let [yaw, pitch] = rotation;
+        Some(MoveVehicleRequest {
+            position: at,
+            yaw,
+            pitch,
+            on_ground,
+        })
+    }
+}
diff --git a/crates/horizon-client/src/game/spear_kill_target.rs b/crates/horizon-client/src/game/spear_kill_target.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/spear_kill_target.rs
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! SpearKillTargetFinder. Ray 1 uses the camera; ray 2 the managed rotation.
+use super::Game;
+use horizon_core::geometry::{Aabb, Vec3};
+pub(super) fn look(yaw: f32, pitch: f32) -> Vec3 {
+    Vec3::direction_from_rotation(pitch, yaw)
+}
+fn raw(b: Aabb) -> [f64; 6] {
+    let a = b.min_position();
+    let z = b.max_position();
+    [a.x, a.y, a.z, z.x, z.y, z.z]
+}
+fn section(p: Vec3) -> [i32; 3] {
+    [
+        (p.x.floor() as i32) >> 4,
+        (p.y.floor() as i32) >> 4,
+        (p.z.floor() as i32) >> 4,
+    ]
+}
+pub(super) struct Living {
+    pub id: i32,
+    pub position: Vec3,
+    pub previous: Vec3,
+    pub bounds: Aabb,
+    pub order: ([i32; 3], u64),
+}
+fn at(id: i32, position: Vec3, previous: Vec3, bounds: Aabb, seq: u64) -> Living {
+    Living {
+        id,
+        position,
+        previous,
+        bounds,
+        order: (section(position), seq),
+    }
+}
+pub(super) fn living(g: &Game<'_>) -> Vec<Living> {
+    let local = g.remote.as_ref().map_or(0, |r| r.entity_id);
+    let mut entities: Vec<_> = g
+        .mobs
+        .iter()
+        .filter(|m| {
+            m.id as i32 != local
+                && m.alive()
+                && !m.removed
+                && g.dragon.as_ref().is_none_or(|d| d.id != m.id)
+        })
+        .map(|m| Living {
+            id: m.id as i32,
+            position: m.position,
+            previous: m.previous,
+            bounds: m.bounds(),
+            order: (
+                section(m.position),
+                if m.extra.section_seq == 0 {
+                    m.join.get()
+                } else {
+                    m.extra.section_seq
+                },
+            ),
+        })
+        .collect();
+    entities.extend(g.armor_stands.iter().filter(|s| s.health > 0.0).map(|s| {
+        at(
+            s.id as i32,
+            s.position,
+            s.previous,
+            s.bounds(),
+            s.join.get(),
+        )
+    }));
+    if let Some(d) = g.dragon.as_ref().filter(|d| d.alive()) {
+        let p = d.position;
+        entities.push(at(
+            d.id as i32,
+            p,
+            d.previous,
+            Aabb::new(
+                Vec3::new(p.x - 8.0, p.y, p.z - 8.0),
+                Vec3::new(p.x + 8.0, p.y + 8.0, p.z + 8.0),
+            ),
+            0,
+        ));
+    }
+    for guest in g
+        .lan
+        .iter()
+        .flat_map(|l| l.hub.guests.iter())
+        .filter(|p| p.placed && p.dimension == g.dim.id() && p.entity_id != local)
+    {
+        if entities.iter().any(|p| p.id == guest.entity_id) {
+            continue;
+        }
+        if let Some(body) = guest.motion.as_ref().filter(|b| !b.health.dead_or_dying()) {
+            let p = Vec3::new(guest.position[0], guest.position[1], guest.position[2]);
+            let old = Vec3::new(
+                guest.previous_position[0],
+                guest.previous_position[1],
+                guest.previous_position[2],
+            );
+            entities.push(at(
+                guest.entity_id,
+                p,
+                old,
+                body.dimensions.bounds(p),
+                u64::from(guest.conn),
+            ));
+        }
+    }
+    entities.sort_by_key(|e| {
+        let [x, y, z] = e.order.0;
+        (x, z, y, e.order.1)
+    });
+    entities
+}
+pub(super) fn boxes(g: &Game<'_>, id: i32) -> Vec<[f64; 6]> {
+    if let Some(d) = g.dragon.as_ref().filter(|d| d.id as i32 == id) {
+        return (0..8).map(|i| raw(d.part_box(i))).collect();
+    }
+    if let Some(m) = g.mobs.iter().find(|m| m.id as i32 == id) {
+        return vec![raw(m.bounds())];
+    }
+    if let Some(s) = g.armor_stands.iter().find(|s| s.id as i32 == id) {
+        return vec![raw(s.bounds())];
+    }
+    living(g)
+        .into_iter()
+        .find(|e| e.id == id)
+        .map_or_else(Vec::new, |e| vec![raw(e.bounds)])
+}
+pub(super) fn find(g: &mut Game<'_>, maximum: f32) -> Option<(i32, f64)> {
+    let player = g.player.as_ref()?;
+    let p = player.position;
+    let eye = Vec3::new(p.x, p.y + f64::from(player.dimensions.eye_height), p.z);
+    let look = look(g.yaw, g.pitch);
+    let delta = look.scale(f64::from(maximum));
+    // Kotlin Vec3.fma uses Math.fma for each coordinate.
+    let end = Vec3::new(
+        f64::from(maximum).mul_add(look.x, eye.x),
+        f64::from(maximum).mul_add(look.y, eye.y),
+        f64::from(maximum).mul_add(look.z, eye.z),
+    );
+    let half = f64::from(player.dimensions.width) / 2.0;
+    let query = player
+        .bounds()
+        .expand_towards(delta)
+        .inflate(Vec3::new(half, half, half));
+    let speed =
+        player.velocity.x * look.x + player.velocity.y * look.y + player.velocity.z * look.z;
+    let range = g
+        .using
+        .and_then(|(slot, _)| g.stack_in(slot))
+        .and_then(|s| g.stack_attack_range(s));
+    let (mut min, mut max, mut min_creative, mut max_creative) = if let Some(r) = range {
+        let read = |k: &str, d: f32| r[k].as_f64().map_or(d, |v| v as f32);
+        (
+            read("min_reach", 0.0),
+            read("max_reach", 3.0),
+            read("min_creative_reach", 0.0),
+            read("max_creative_reach", 5.0),
+        )
+    } else {
+        let max = g.interaction_range("minecraft:entity_interaction_range", 3.0, 5.0) as f32;
+        (0.0, max, 0.0, max)
+    };
+    g.native_client_attack_range(&mut min, &mut max, &mut min_creative, &mut max_creative);
+    let (minimum, maximum) = if g.creative {
+        (min_creative, max_creative)
+    } else {
+        (min, max)
+    };
+    let lunge = (f64::from(minimum) + (f64::from(maximum) + speed.max(0.0))) / 2.0;
+    let [border_min_x, border_min_z, border_max_x, border_max_z] = g.border.geometry().bounds(0.0);
+    let (mut yaw, mut pitch, mut managed) = (g.yaw, g.pitch, false);
+    g.native_client_rotation_aim(&mut yaw, &mut pitch, &mut managed);
+    let managed_look = self::look(yaw, pitch);
+    let mut best = None;
+    let mut best_sq = f64::MAX;
+    for entity in living(g) {
+        let x = entity.position.x.floor();
+        let z = entity.position.z.floor();
+        if !(x + 1.0 > border_min_x
+            && x < border_max_x
+            && z + 1.0 > border_min_z
+            && z < border_max_z)
+            || !query.intersects(entity.bounds)
+        {
+            continue;
+        }
+        let Some(hit) = entity.bounds.clip(eye, end) else {
+            continue;
+        };
+        if super::spear_kill_ray::clip(g, eye, hit).is_none_or(|hit| !hit.0) {
+            continue;
+        }
+        let distance = (eye.distance_squared(hit).sqrt() - lunge).max(0.0);
+        if distance <= 0.0 {
+            continue;
+        }
+        let sq = distance * distance;
+        if sq >= best_sq {
+            continue;
+        }
+        let Some((miss, at)) =
+            super::spear_kill_ray::clip(g, eye, eye.add_vector(managed_look.scale(distance)))
+        else {
+            continue;
+        };
+        if !miss && at.distance_squared(eye) < sq {
+            continue;
+        }
+        best = Some((entity.id, distance));
+        best_sq = sq;
+    }
+    best
+}
