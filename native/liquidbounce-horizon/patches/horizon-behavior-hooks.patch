@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{
+    Game,
+    indicator::{self, Arrow, Entry, Primitive},
+};
+use horizon_client::{hud::HudBatch, mobs::Who, text::Text};
+use serde_json::{Value, json};
+impl Game<'_> {
+    fn client_tnt_timer_owner(&self, t: &super::tnt::PrimedTnt) -> Option<Text> {
+        match t.owner? {
+            Who::Player => {
+                if let Some(conn) = t.guest {
+                    return self
+                        .lan
+                        .as_ref()?
+                        .hub
+                        .guests
+                        .iter()
+                        .find(|g| g.conn == conn)
+                        .map(|g| Text::literal(&g.name));
+                }
+                Some(Text::literal(self.acting_player_name()))
+            }
+            Who::Mob(id) => {
+                if let Some(name) = self.remote_player_name(id) {
+                    return Some(Text::literal(name));
+                }
+                self.mobs
+                    .iter()
+                    .find(|m| m.id == id && !m.removed)
+                    .map(|m| m.command_name())
+            }
+        }
+        .map(|t| t.resolve_legacy())
+    }
+    pub(super) fn client_tnt_timer_glow(&self, fuse: i32) -> Option<u32> {
+        if !self.native_window() {
+            return None;
+        }
+        let mut output = String::new();
+        self.native_client_tnt_timer(
+            &json!({"action":"glow","fuse":fuse}).to_string(),
+            &mut output,
+        );
+        serde_json::from_str::<u32>(&output).ok()
+    }
+    pub(super) fn client_tnt_timer_submit(&self, batch: &mut HudBatch) {
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let Some(camera) = self.native_camera() else {
+            return;
+        };
+        let entities=self.tnts.iter().map(|t|{
+            let center=t.bounds().center();
+            json!({"id":t.id,"center":[center.x,center.y,center.z],"fuse":t.fuse,"owner":self.client_tnt_timer_owner(t).map(|t|t.component())})
+        }).collect::<Vec<_>>();
+        let mut output = String::new();
+        self.native_client_tnt_timer(
+            &json!({"action":"frame","camera":camera.position,"entities":entities}).to_string(),
+            &mut output,
+        );
+        let Ok(frame) = serde_json::from_str::<Value>(&output) else {
+            return;
+        };
+        for label in frame["labels"].as_array().into_iter().flatten() {
+            let Ok(position) = serde_json::from_value(label["position"].clone()) else {
+                continue;
+            };
+            let mut text = Text::literal(label["text"].as_str().unwrap_or_default());
+            if !label["owner"].is_null() {
+                text = text
+                    .append(" (")
+                    .append(horizon_client::scoreboard::comp_text(&label["owner"]))
+                    .append(")");
+            }
+            let width = self.gui.atlas.font.width_text(&text).ceil();
+            let scale = label["scale"].as_f64().unwrap_or(1.) as f32;
+            let color = label["color"].as_u64().unwrap_or(0) as u32;
+            indicator::submit(Entry {
+                position,
+                priority: label["priority"].as_i64().unwrap_or(0) as i32,
+                color,
+                visible: serde_json::from_value(label["visible"].clone()).unwrap_or([true, true]),
+                edge_inset: 0.,
+                style: Arrow::Triangle {
+                    width: 8.,
+                    height: 10.,
+                    notch: 0.,
+                },
+                in_view_style: Arrow::None,
+                bounds: [
+                    -width * 0.5 * scale,
+                    -4.5 * scale,
+                    width * 0.5 * scale,
+                    4.5 * scale,
+                ],
+                tag: vec![Primitive::Text {
+                    text,
+                    origin: [-(width as i32 / 2) as f32, -4.],
+                    scale,
+                    color,
+                    shadow: true,
+                }],
+            });
+        }
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/indicator.rs b/crates/horizon-client-render/src/gfx/indicator.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/indicator.rs
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use std::cell::{Cell, RefCell};
+use wgpu::util::DeviceExt;
+thread_local! {static PENDING:RefCell<Vec<Vertex>>=const{RefCell::new(Vec::new())};}
+thread_local! {static LAYER_END:Cell<u32>=const{Cell::new(0)};}
+#[repr(C)]
+#[derive(Clone, Copy, Debug, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct Vertex {
+    pub pos: [f32; 2],
+    pub local: [f32; 2],
+    pub size: [f32; 2],
+    pub color: [f32; 4],
+    pub notch: f32,
+}
+pub fn clear() {
+    PENDING.with_borrow_mut(Vec::clear);
+    LAYER_END.set(0);
+}
+pub fn finish_layer(vertices: usize) {
+    LAYER_END.set(vertices as u32);
+}
+pub fn submit(
+    origin: [f32; 2],
+    angle: f32,
+    size: [f32; 2],
+    notch: f32,
+    argb: u32,
+    viewport: [f32; 2],
+) {
+    if size[0] <= 0. || size[1] <= 0. || notch >= size[1] || argb >> 24 == 0 {
+        return;
+    }
+    let color = [
+        ((argb >> 16) & 255) as f32 / 255.,
+        ((argb >> 8) & 255) as f32 / 255.,
+        (argb & 255) as f32 / 255.,
+        (argb >> 24) as f32 / 255.,
+    ];
+    let local = [
+        [-size[0] * 0.5, 0.],
+        [-size[0] * 0.5, size[1]],
+        [size[0] * 0.5, size[1]],
+        [size[0] * 0.5, 0.],
+    ];
+    let quantized = size.map(|v| ((v * 32.).clamp(0., 32767.) + 0.5).floor() / 32.);
+    let (s, c) = (f64::from(angle).sin() as f32, f64::from(angle).cos() as f32);
+    let vertices: [Vertex; 4] = std::array::from_fn(|i| {
+        let p = local[i];
+        let at = [
+            origin[0] + c * p[0] - s * p[1],
+            origin[1] + s * p[0] + c * p[1],
+        ];
+        Vertex {
+            pos: [at[0] / viewport[0] * 2. - 1., 1. - at[1] / viewport[1] * 2.],
+            local: p,
+            size: quantized,
+            color,
+            notch: notch.max(0.),
+        }
+    });
+    PENDING.with_borrow_mut(|out| out.extend([0, 1, 2, 0, 2, 3].map(|i| vertices[i])));
+}
+pub struct IndicatorRenderer {
+    pipeline: super::hud_coverage::Pipeline,
+    pending: Option<(wgpu::Buffer, u32, u32)>,
+}
+impl IndicatorRenderer {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat, coverage: bool) -> Self {
+        let source = wgpu::ShaderSource::Wgsl(include_str!("indicator.wgsl").into());
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("LiquidBounce indicator SDF"),
+            source: source.clone(),
+        });
+        let attributes = wgpu::vertex_attr_array![0=>Float32x2,1=>Float32x2,2=>Float32x2,3=>Float32x4,4=>Float32];
+        let buffers = [Some(wgpu::VertexBufferLayout {
+            array_stride: 44,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &attributes,
+        })];
+        let desc = wgpu::RenderPipelineDescriptor {
+            label: Some("LiquidBounce indicator SDF"),
+            layout: None,
+            vertex: wgpu::VertexState {
+                module: &shader,
+                entry_point: Some("vertex"),
+                compilation_options: Default::default(),
+                buffers: &buffers,
+            },
+            primitive: wgpu::PrimitiveState {
+                cull_mode: None,
+                ..Default::default()
+            },
+            depth_stencil: None,
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &shader,
+                entry_point: Some("fragment"),
+                compilation_options: Default::default(),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format,
+                    blend: Some(wgpu::BlendState::ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+            }),
+            multiview_mask: None,
+            cache: None,
+        };
+        Self {
+            pipeline: super::hud_coverage::Pipeline::new(device, &desc, source, coverage)
+                .expect("indicator location0 permits HUD coverage"),
+            pending: None,
+        }
+    }
+    pub fn prepare(&mut self, device: &wgpu::Device, title: bool) {
+        self.pending = None;
+        let data = PENDING.with_borrow_mut(std::mem::take);
+        if title || data.is_empty() {
+            return;
+        }
+        self.pending = Some((
+            device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("LiquidBounce indicator arrows"),
+                contents: bytemuck::cast_slice(&data),
+                usage: wgpu::BufferUsages::VERTEX,
+            }),
+            data.len() as u32,
+            LAYER_END.get(),
+        ));
+    }
+    pub fn layer_end(&self) -> Option<u32> {
+        self.pending.as_ref().map(|(_, _, end)| *end)
+    }
+    pub fn draw(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        coverage: Option<&wgpu::TextureView>,
+    ) {
+        let Some((buffer, count, _)) = self.pending.as_ref() else {
+            return;
+        };
+        let mut attachments = vec![Some(super::hud_coverage::attachment(target))];
+        if let Some(view) = coverage {
+            attachments.push(Some(super::hud_coverage::attachment(view)));
+        }
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("LiquidBounce indicator arrows"),
+            color_attachments: &attachments,
+            ..Default::default()
+        });
+        pass.set_pipeline(self.pipeline.get(coverage.is_some()));
+        pass.set_vertex_buffer(0, buffer.slice(..));
+        pass.draw(0..*count, 0..1);
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/indicator.wgsl b/crates/horizon-client-render/src/gfx/indicator.wgsl
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/indicator.wgsl
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Original shaders/gui/arrow.fsh SDF, LiquidBounce ae0eb396.
+struct Out{@builtin(position)pos:vec4<f32>,@location(0)local:vec2<f32>,@location(1)size:vec2<f32>,@location(2)color:vec4<f32>,@location(3)notch:f32}
+@vertex fn vertex(@location(0)pos:vec2<f32>,@location(1)local:vec2<f32>,@location(2)size:vec2<f32>,@location(3)color:vec4<f32>,@location(4)notch:f32)->Out{return Out(vec4(pos,0.,1.),local,size,color,notch);}
+fn polygon_distance(p:vec2<f32>,a:vec2<f32>,b:vec2<f32>,c:vec2<f32>,d:vec2<f32>)->f32{
+ let vertices=array<vec2<f32>,4>(a,b,c,d);var closest=dot(p-a,p-a);var inside=1.;
+ for(var i=0u;i<4u;i++){
+  let previous=(i+3u)&3u;let edge=vertices[previous]-vertices[i];let offset=p-vertices[i];
+  let to_edge=offset-edge*clamp(dot(offset,edge)/dot(edge,edge),0.,1.);closest=min(closest,dot(to_edge,to_edge));
+  let crosses=vec3<bool>((p.y >= vertices[i].y),(p.y < vertices[previous].y),(edge.x*offset.y > edge.y*offset.x));
+  if all(crosses)||all(!crosses){inside=-inside;}
+ }
+ return inside*sqrt(closest);
+}
+@fragment fn fragment(v:Out)->@location(0)vec4<f32>{
