@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Real owning route searches used by the unchanged background search lifecycle.
+use super::{
+    destination::Destination,
+    flight::{FlyAbilities, FlyRoute, FlyRouteSearch},
+    geometry::{BlockPos, Vec3},
+    owned_search::OwnedTerrainSearch,
+    replanner::SearchGoal,
+    search::{Limits, Outcome},
+    simulation::block_grid::SimulationState,
+    staged_search::{SearchDestination, SharedLevel},
+    terrain::{Terrain, TerrainLevel, TerrainState},
+    walk::{route::Route, route_search::WalkRouteSearch},
+};
+pub type SharedDestination = SearchDestination<Box<dyn Fn(BlockPos) -> bool + Send + Sync>>;
+pub fn shared_destination<B: TerrainState, L: TerrainLevel<B> + Send + Sync + 'static>(
+    descriptor: SearchGoal,
+    level: SharedLevel<L>,
+) -> SharedDestination {
+    SearchDestination::new(
+        descriptor,
+        Box::new(move |pos| {
+            <SharedLevel<L> as TerrainLevel<B>>::is_known(&level, pos)
+                && <SharedLevel<L> as TerrainLevel<B>>::is_inside_border(
+                    &level,
+                    f64::from(pos.x) + 0.5,
+                    f64::from(pos.z) + 0.5,
+                )
+        }),
+    )
+}
+pub fn flight_search<B: TerrainState, L: TerrainLevel<B> + Send + Sync + 'static>(
+    terrain: Terrain<B, SharedLevel<L>>,
+    start: Vec3,
+    descriptor: SearchGoal,
+    abilities: FlyAbilities,
+    limits: Limits,
+) -> FlyRouteSearch<B, SharedLevel<L>, SharedDestination> {
+    let goal = shared_destination::<B, L>(descriptor, terrain.level().clone());
+    FlyRouteSearch::new(terrain, start, goal, abilities, limits)
+}
+impl<B: TerrainState, L: TerrainLevel<B>, D: Destination> OwnedTerrainSearch<Terrain<B, L>>
+    for FlyRouteSearch<B, L, D>
+{
+    type Route = FlyRoute;
+    fn terrain_mut(&mut self) -> &mut Terrain<B, L> {
+        self.problem.moves.terrain_mut()
+    }
+    fn advance(&mut self) -> Outcome<FlyRoute> {
+        FlyRouteSearch::advance(self).expect("flight search edge cost is valid")
+    }
+    fn preview(&mut self) -> Option<Vec<Vec3>> {
+        FlyRouteSearch::preview(self)
+    }
+}
+impl<B: SimulationState, L: TerrainLevel<B>, D: Destination> OwnedTerrainSearch<Terrain<B, L>>
+    for WalkRouteSearch<B, L, D>
+{
+    type Route = Route<B>;
+    fn terrain_mut(&mut self) -> &mut Terrain<B, L> {
+        &mut self.problem.terrain
+    }
+    fn advance(&mut self) -> Outcome<Route<B>> {
+        WalkRouteSearch::advance(self).expect("walk search edge cost is valid")
+    }
+    fn preview(&mut self) -> Option<Vec<Vec3>> {
+        WalkRouteSearch::preview(self)
+    }
+}
diff --git a/crates/horizon-client/src/navigation/search.rs b/crates/horizon-client/src/navigation/search.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/search.rs
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Minecraft Agent 0abf69ac route/AStarSearch, Limits, Outcome and Failure.
+use super::astar::{AStar,InvalidEdgeCost,WeightedEdge};
+use std::{cell::RefCell,hash::Hash,time::Instant};
+
+#[derive(Clone,Copy,Debug,PartialEq)]
+pub struct Limits{pub max_length:f64,pub max_waypoints:i32,pub max_visited_nodes:i32,pub visited_nodes_per_slice:i32,pub max_compute_nanos:i64}
+impl Limits{pub const fn new(max_length:f64)->Self{Self{max_length,max_waypoints:24,max_visited_nodes:8000,visited_nodes_per_slice:400,max_compute_nanos:150_000_000}}}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum Failure{InvalidDestination,TooFar,NoPath,TooComplex,TimedOut}
+#[derive(Clone,Debug,PartialEq)]
+pub enum Outcome<T>{Searching,AlreadyThere,Found(T),Failed(Failure)}
+pub enum Begin<N,T>{Outcome(Outcome<T>),SearchFrom{start:N,max_cost:f64}}
+impl<N,T> Begin<N,T>{pub fn from_start(start:N)->Self{Self::SearchFrom{start,max_cost:f64::INFINITY}}}
+pub trait SearchProblem<N:Clone+Eq+Hash,T>{
+    fn begin(&mut self)->Begin<N,T>;
+    fn is_goal(&mut self,node:&N)->bool;
+    fn neighbors(&mut self,node:&N)->Vec<WeightedEdge<N>>;
+    fn neighbors_with_context(&mut self,node:&N,_search:&AStar<N>)->Vec<WeightedEdge<N>>{self.neighbors(node)}
+    fn heuristic(&mut self,node:&N)->f64;
+    fn route(&mut self,nodes:Vec<N>)->Outcome<T>;
+    fn closest_or(&mut self,failure:Failure,_search:Option<&AStar<N>>)->Outcome<T>{Outcome::Failed(failure)}
+}
+#[derive(Clone,Debug)]
+pub struct AStarSearch<N,T>{pub limits:Limits,pub search:Option<AStar<N>>,compute_nanos:i64,result:Outcome<T>}
+impl<N:Clone+Eq+Hash,T:Clone> AStarSearch<N,T>{
+    pub fn new(limits:Limits)->Self{Self{limits,search:None,compute_nanos:0,result:Outcome::Searching}}
+    pub fn compute_nanos(&self)->i64{self.compute_nanos}
+    pub fn advance(&mut self,problem:&mut impl SearchProblem<N,T>)->Result<Outcome<T>,InvalidEdgeCost>{let began=Instant::now();self.advance_with_clock(problem,||began.elapsed().as_nanos()as i64)}
+    pub fn advance_with_clock(&mut self,problem:&mut impl SearchProblem<N,T>,mut nano_time:impl FnMut()->i64)->Result<Outcome<T>,InvalidEdgeCost>{
+        if !matches!(self.result,Outcome::Searching){return Ok(self.result.clone());}
+        let began=nano_time();
+        self.result=if let Some(search)=self.search.as_mut(){
+            let problem_cell=RefCell::new(&mut *problem);
+            let cap=self.limits.visited_nodes_per_slice.min(self.limits.max_visited_nodes.wrapping_sub(search.iterations));
+            let path=search.advance_with_context(cap,|node|problem_cell.borrow_mut().is_goal(node),|search,node|problem_cell.borrow_mut().neighbors_with_context(node,search),|node|problem_cell.borrow_mut().heuristic(node))?;
+            if let Some(path)=path{problem.route(path.nodes)}
+            else if search.is_finished(){problem.closest_or(Failure::NoPath,Some(search))}
+            else if search.iterations>=self.limits.max_visited_nodes{problem.closest_or(Failure::TooComplex,Some(search))}
+            else{Outcome::Searching}
+        }else{
+            match problem.begin(){
+                Begin::Outcome(outcome)=>outcome,
+                Begin::SearchFrom{start,max_cost}=>{let heuristic=problem.heuristic(&start);self.search=Some(AStar::new(start,heuristic,max_cost));Outcome::Searching}
+            }
+        };
+        self.compute_nanos=self.compute_nanos.wrapping_add(nano_time().wrapping_sub(began));
+        if matches!(self.result,Outcome::Searching)&&self.compute_nanos>self.limits.max_compute_nanos{self.result=problem.closest_or(Failure::TimedOut,self.search.as_ref());}
+        Ok(self.result.clone())
+    }
+}
+pub fn closest_nodes<N:Clone+Eq+Hash>(search:Option<&AStar<N>>,mut distance:impl FnMut(&N)->f64)->Option<Vec<N>>{
+    let nodes=search?.closest_path()?.nodes;
+    if nodes.len()<2||distance(nodes.first()?)-distance(nodes.last()?)<1.0{None}else{Some(nodes)}
+}
diff --git a/crates/horizon-client/src/navigation/simulation/block_colliders.rs b/crates/horizon-client/src/navigation/simulation/block_colliders.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/simulation/block_colliders.rs
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Minecraft Agent BlockColliders, including modern and 1.8 offsets.
+use super::super::{
+    aabb::{Aabb, Axis},
+    geometry::{BlockPos, Vec3, java_max, java_min},
+};
+use super::block_grid::ShapeGrid;
+use std::collections::HashMap;
+
+const EPSILON: f64 = 1.0e-7;
+#[derive(Default, Debug)]
+pub struct BlockColliders {
+    blocks: HashMap<i64, Vec<[f64; 6]>>,
+    colliders: Vec<[f64; 6]>,
+    moving: [f64; 6],
+    pub moved_x: f64,
+    pub moved_y: f64,
+    pub moved_z: f64,
+}
+impl BlockColliders {
+    fn boxes(&mut self, grid: &mut impl ShapeGrid, pos: BlockPos) -> &[[f64; 6]] {
+        self.blocks.entry(pos.packed()).or_insert_with(|| {
+            grid.shape(pos)
+                .aabbs()
+                .iter()
+                .map(|b| {
+                    [
+                        b.min.x + f64::from(pos.x),
+                        b.min.y + f64::from(pos.y),
+                        b.min.z + f64::from(pos.z),
+                        b.max.x + f64::from(pos.x),
+                        b.max.y + f64::from(pos.y),
+                        b.max.z + f64::from(pos.z),
+                    ]
+                })
+                .collect()
+        })
+    }
+    pub fn intersects(&mut self, grid: &mut impl ShapeGrid, pos: BlockPos, body: Aabb) -> bool {
+        self.boxes(grid, pos).iter().any(|b| {
+            b[0] < body.max.x
+                && b[3] > body.min.x
+                && b[1] < body.max.y
+                && b[4] > body.min.y
+                && b[2] < body.max.z
+                && b[5] > body.min.z
+        })
+    }
+    pub fn footing(
+        &mut self,
+        grid: &mut impl ShapeGrid,
+        pos: BlockPos,
+        x: f64,
+        z: f64,
+        half_width: f64,
+    ) -> f64 {
+        self.boxes(grid, pos).iter().fold(0.0, |best, b| {
+            let along_x = java_min(x + half_width - b[0], b[3] - (x - half_width));
+            let along_z = java_min(z + half_width - b[2], b[5] - (z - half_width));
+            java_max(best, java_min(along_x, along_z))
+        })
+    }
+    pub fn collect(&mut self, grid: &mut impl ShapeGrid, body: Aabb) {
+        self.colliders.clear();
+        for x in ((body.min.x - EPSILON).floor() as i32)..=((body.max.x + EPSILON).floor() as i32) {
+            for z in
+                ((body.min.z - EPSILON).floor() as i32)..=((body.max.z + EPSILON).floor() as i32)
+            {
+                for y in ((body.min.y - EPSILON).floor() as i32).wrapping_sub(1)
+                    ..=((body.max.y + EPSILON).floor() as i32)
+                {
+                    let boxes = self.boxes(grid, BlockPos::new(x, y, z)).to_vec();
+                    self.colliders.extend(boxes);
+                }
+            }
+        }
+    }
+    pub fn collide(&mut self, delta: Vec3, body: Aabb) {
+        if self.colliders.is_empty() {
+            self.moved_x = delta.x;
+            self.moved_y = delta.y;
+            self.moved_z = delta.z;
+            return;
+        }
+        self.set_moving(body);
+        self.moved_y = self.clip(1, delta.y);
+        if delta.x.abs() < delta.z.abs() {
+            self.moved_z = self.clip(2, delta.z);
+            self.moved_x = self.clip(0, delta.x);
+        } else {
+            self.moved_x = self.clip(0, delta.x);
+            self.moved_z = self.clip(2, delta.z);
+        }
+    }
+    pub fn offset(&mut self, axis: Axis, body: Aabb, movement: f64) -> f64 {
+        self.set_moving(body);
+        let axis = axis.index();
+        let a = (axis + 1) % 3;
+        let b = (axis + 2) % 3;
+        let mut moved = movement;
+        for collider in &self.colliders {
+            if collider[3 + a] <= self.moving[a]
+                || collider[a] >= self.moving[3 + a]
+                || collider[3 + b] <= self.moving[b]
+                || collider[b] >= self.moving[3 + b]
+            {
+                continue;
+            }
+            if moved > 0.0 && self.moving[3 + axis] <= collider[axis] {
+                moved = java_min(moved, collider[axis] - self.moving[3 + axis]);
+            } else if moved < 0.0 && self.moving[axis] >= collider[3 + axis] {
+                moved = java_max(moved, collider[3 + axis] - self.moving[axis]);
+            }
+        }
+        moved
+    }
+    pub fn step_heights(&self, body: Aabb, max_step: f32, skip: f32) -> Vec<f32> {
+        let mut candidates: Vec<f32> = Vec::with_capacity(4);
+        for collider in &self.colliders {
+            for face in [1, 4] {
+                let relative = (collider[face] - body.min.y) as f32;
+                if relative >= 0.0
+                    && relative != skip
+                    && relative <= max_step
+                    && !candidates.iter().any(|v| v.to_bits() == relative.to_bits())
+                {
+                    candidates.push(relative);
+                }
+            }
+        }
+        candidates.sort_unstable_by(f32::total_cmp);
+        candidates
+    }
+    fn set_moving(&mut self, body: Aabb) {
+        self.moving = [
+            body.min.x, body.min.y, body.min.z, body.max.x, body.max.y, body.max.z,
+        ];
+    }
+    fn clip(&mut self, axis: usize, movement: f64) -> f64 {
+        if movement.abs() < EPSILON {
+            return 0.0;
+        }
+        let mut moved = movement;
+        for collider in &self.colliders {
+            if self.overlaps(collider, (axis + 1) % 3) && self.overlaps(collider, (axis + 2) % 3) {
+                if moved > 0.0 {
+                    let gap = collider[axis] - self.moving[3 + axis];
+                    if gap > -EPSILON {
+                        moved = java_min(moved, gap);
+                    }
+                } else {
+                    let gap = collider[3 + axis] - self.moving[axis];
+                    if gap < EPSILON {
+                        moved = java_max(moved, gap);
+                    }
+                }
+            }
+            if moved.abs() < EPSILON {
+                moved = 0.0;
+                break;
+            }
+        }
+        self.moving[axis] += moved;
+        self.moving[3 + axis] += moved;
+        moved
+    }
+    fn overlaps(&self, collider: &[f64; 6], axis: usize) -> bool {
+        collider[3 + axis] - EPSILON > self.moving[axis]
+            && collider[axis] + EPSILON < self.moving[3 + axis]
+    }
+}
