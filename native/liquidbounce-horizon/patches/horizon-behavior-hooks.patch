+        let mesh = vertices(&frame, projection, camera, size);
+        let models=MODELS.with_borrow_mut(std::mem::take).into_iter().map(|v|{let mut clip=(projection*glam::Vec3::from_array(v.pos).extend(1.)).to_array();clip[1] = -clip[1];ModelVertex{clip,uv:v.uv,color:v.color}}).collect::<Vec<_>>();
+        if !models.is_empty(){self.model_pending=Some((device.create_buffer_init(&wgpu::util::BufferInitDescriptor{label:Some("BlockESP real model vertices"),contents:bytemuck::cast_slice(&models),usage:wgpu::BufferUsages::VERTEX}),models.len()as u32));}
+        if mesh.is_empty() && self.model_pending.is_none() {
+            return;
+        }
+        let count = mesh.len() as u32;
+        let mesh=if mesh.is_empty(){vec![Vertex{clip:[0.;4],color:[0.;4]}]}else{mesh};
+        let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Breadcrumbs mesh"),
+            contents: bytemuck::cast_slice(&mesh),
+            usage: wgpu::BufferUsages::VERTEX,
+        });
+        if frame.effect.is_some() && self.targets.as_ref().is_none_or(|t| t.size != size) {
+            let views = std::array::from_fn(|_| {
+                device
+                    .create_texture(&wgpu::TextureDescriptor {
+                        label: Some("LiquidBounce RGBA8 style target"),
+                        size: wgpu::Extent3d {
+                            width: size[0],
+                            height: size[1],
+                            depth_or_array_layers: 1,
+                        },
+                        mip_level_count: 1,
+                        sample_count: 1,
+                        dimension: wgpu::TextureDimension::D2,
+                        format: FORMAT,
+                        usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                            | wgpu::TextureUsages::TEXTURE_BINDING,
+                        view_formats: &[],
+                    })
+                    .create_view(&Default::default())
+            });
+            self.targets = Some(Targets { size, views });
+        }
+        self.pending = Some((frame, buffer, count));
+    }
+    pub fn draw(
+        &mut self,
+        device: &wgpu::Device,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        game_time: f32,
+        camera: DVec3,
+        view: Mat4,
+        fov: f32,
+        entity_group:&wgpu::BindGroup,
+    ) {
+        let Some((frame, buffer, count)) = self.pending.take() else {
+            return;
+        };
+        let pass = |encoder: &mut wgpu::CommandEncoder,
+                    target: &wgpu::TextureView,
+                    pipeline: &wgpu::RenderPipeline,
+                    group: Option<&wgpu::BindGroup>,
+                    mesh: bool,
+                    clear: bool| {
+            let mut p = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("LiquidBounce Breadcrumbs"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: target,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: if clear {
+                            wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT)
+                        } else {
+                            wgpu::LoadOp::Load
+                        },
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+            p.set_pipeline(pipeline);
+            if let Some(g) = group {
+                p.set_bind_group(0, g, &[]);
+            }
+            if mesh {
+                p.set_vertex_buffer(0, buffer.slice(..));
+                p.draw(0..count, 0..1);
+            } else {
+                p.draw(0..3, 0..1);
+            }
+        };
+        let Some(effect) = frame.effect else {
+            pass(encoder, target, &self.plain, None, true, false);
+            return;
+        };
+        let targets = self.targets.as_ref().unwrap();
+        let mut data = [0f32; 16];
+        data[..8].copy_from_slice(&effect.params);
+        data[8..12].copy_from_slice(&effect.accent);
+        data[12] = effect.range;
+        data[13] = effect.opacity;
+        let effect_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectData"),
+            contents: bytemuck::cast_slice(&data),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let blocks = camera.floor().as_ivec3();
+        let offset = blocks.as_dvec3() - camera;
+        let mut globals = [0u32; 12];
+        globals[0] = game_time.to_bits();
+        globals[4] = blocks.x as u32;
+        globals[5] = blocks.y as u32;
+        globals[6] = blocks.z as u32;
+        globals[8] = (offset.x as f32).to_bits();
+        globals[9] = (offset.y as f32).to_bits();
+        globals[10] = (offset.z as f32).to_bits();
+        let globals = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Globals"),
+            contents: bytemuck::cast_slice(&globals),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let inverse = view.inverse();
+        let right = inverse.x_axis;
+        let up = inverse.y_axis;
+        let forward = -inverse.z_axis;
+        let tangent = (fov.to_radians() / 2.).tan();
+        let axes = [
+            right.to_array(),
+            up.to_array(),
+            forward.to_array(),
+            [
+                tangent * targets.size[0] as f32 / targets.size[1] as f32,
+                tangent,
+                0.,
+                0.,
+            ],
+        ];
+        let axes = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectView"),
+            contents: bytemuck::cast_slice(&axes),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let group = |source: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("LiquidBounce ShaderLayer"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: effect_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: globals.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: axes.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::TextureView(source),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 4,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        pass(encoder, &targets.views[0], &self.capture, None, true, true);
+        if let Some((vertices,count))=self.model_pending.take(){let mut p=encoder.begin_render_pass(&wgpu::RenderPassDescriptor{label:Some("BlockESP real model silhouettes"),color_attachments:&[Some(wgpu::RenderPassColorAttachment{view:&targets.views[0],depth_slice:None,resolve_target:None,ops:wgpu::Operations{load:wgpu::LoadOp::Load,store:wgpu::StoreOp::Store}})],..Default::default()});p.set_pipeline(&self.model_pipeline);p.set_bind_group(0,entity_group,&[]);p.set_vertex_buffer(0,vertices.slice(..));p.draw(0..count,0..1);}
+        if effect.style==9{let group=group(&targets.views[0]);pass(encoder,&targets.views[3],&self.pipelines[11],Some(&group),false,true);}else{
+        for (i, pipeline) in [0, 1, effect.style + 2].into_iter().enumerate() {
+            let group = group(&targets.views[i]);
+            pass(
+                encoder,
+                &targets.views[i + 1],
+                &self.pipelines[pipeline],
+                Some(&group),
+                false,
+                true,
+            );
+        }
+        }
+        let group = group(&targets.views[3]);
+        pass(encoder, target, &self.composite, Some(&group), false, false);
+    }
+}
diff --git a/crates/horizon-client/src/game/liquidbounce_better_chat.rs b/crates/horizon-client/src/game/liquidbounce_better_chat.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/liquidbounce_better_chat.rs
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{Game, Screen};
+use horizon_client::{
+    chat::ChatSource,
+    hud::HudBatch,
+    text::{ClickEvent, Style, Text},
+};
+use serde_json::{Value, json};
+use winit::{event::MouseButton, keyboard::KeyCode};
+impl Game<'_> {
+    pub(super) fn client_better_chat_query(&self, input: Value) -> Value {
+        let mut output = String::new();
+        self.native_client_better_chat(&input.to_string(), &mut output);
+        serde_json::from_str(&output).unwrap_or(Value::Null)
+    }
+    pub(super) fn client_better_chat_policy(&mut self) -> Value {
+        let p = self.client_better_chat_query(json!({"action":"policy"}));
+        let running = p["running"] == true;
+        self.ui.chat.liquidbounce_policy(
+            running && p["infinite"] == true,
+            running && p["antiClear"] == true,
+        );
+        p
+    }
+    fn client_better_chat_translations(&mut self, result: &Value) {
+        for translation in result["translations"].as_array().into_iter().flatten() {
+            let Some(text) = translation["text"].as_str() else {
+                continue;
+            };
+            let copy = translation["copy"].as_str().unwrap_or(text);
+            let line = Text::literal(text).with_style(&Style {
+                click: Some(ClickEvent::CopyToClipboard(copy.into())),
+                ..Style::default()
+            });
+            let focused = self.screen == Screen::Chat;
+            self.ui.chat.add(
+                &self.gui.atlas,
+                line,
+                None,
+                ChatSource::Client,
+                self.visual_ticks(),
+                focused,
+            );
+        }
+    }
+    pub(super) fn client_better_chat_tick(&mut self) {
+        if !self.native_window() {
+            return;
+        }
+        self.client_better_chat_policy();
+        let result = self.client_better_chat_query(json!({"action":"poll"}));
+        self.client_better_chat_translations(&result);
+    }
+    pub(super) fn client_better_chat_outgoing(&self, message: &str) -> String {
+        if message.starts_with('/') {
+            return message.into();
+        }
+        self.client_better_chat_query(json!({"action":"outgoing","message":message}))["message"]
+            .as_str()
+            .unwrap_or(message)
+            .into()
+    }
+    /// Receives the undecorated component separately, as ChatReceiveEvent.textData does.
+    pub(super) fn client_better_chat_receive(
+        &mut self,
+        kind: usize,
+        plain: &str,
+        line: &Text,
+        source: ChatSource,
+    ) -> bool {
+        self.client_better_chat_policy();
+        let stripped = Text::literal(plain).strip_legacy().plain();
+        let result = self.client_better_chat_query(
+            json!({"action":"receive","kind":kind,"plain":stripped,"message":plain}),
+        );
+        self.client_better_chat_translations(&result);
+        if result["cancel"] == true {
+            return false;
+        }
+        if let Some(id) = result["stack"].as_str() {
+            let focused = self.screen == Screen::Chat;
+            self.ui.chat.liquidbounce_add_stack(
+                &self.gui.atlas,
+                line.clone(),
+                source,
+                self.visual_ticks(),
+                focused,
+                id.into(),
+            );
+            return false;
+        }
+        true
+    }
+    pub(super) fn client_better_chat_copy(&mut self, button: MouseButton) {
+        if self.screen != Screen::Chat {
+            return;
+        }
+        let p = self.client_better_chat_policy();
+        if p["running"] != true || p["copy"] != true {
+            return;
+        }
+        let height = self.renderer.as_ref().map_or(720., |r| {
+            HudBatch::new([r.config.width, r.config.height]).height
+        });
+        let Some(content) = self.ui.chat.liquidbounce_copy_at(
+            height as i32,
+            self.cursor.0 as f64,
+            self.cursor.1 as f64,
+        ) else {
+            return;
+        };
+        if button == MouseButton::Left && self.has_shift_down() {
+            use horizon_client::clipboard::Clipboard;
+            self.clipboard.set(&content);
+            if p["notify"] == true {
+                let _ = self.client_better_chat_query(json!({"action":"copied"}));
+                let message = match horizon_client::lang::code()
+                    .to_ascii_lowercase()
+                    .replace('-', "_")
+                    .as_str()
+                {
+                    "zh_cn" | "zh_sg" | "zh_hans" => "已复制这条消息",
+                    "zh_tw" | "zh_hk" | "zh_mo" | "zh_hant" => "已複製這則訊息",
+                    _ => "The line is copied",
+                };
+                self.titles.set_overlay(Text::literal(message), false);
+            }
+        } else if button == MouseButton::Right {
+            self.open_chat(&content, false);
+        }
+    }
+    pub(super) fn client_better_chat_highlight(&mut self, batch: &mut HudBatch) {
+        if self.screen != Screen::Chat {
+            return;
+        }
+        let p = self.client_better_chat_policy();
+        if p["running"] == true && p["copy"] == true && p["highlight"] == true {
+            self.ui.chat.liquidbounce_highlight(
+                batch,
+                &self.gui.atlas,
+                self.cursor.0 as f64,
+                self.cursor.1 as f64,
+            );
+        }
+    }
+    pub(super) fn client_better_chat_death_key(
+        &mut self,
+        key: KeyCode,
+        typed: Option<&str>,
+    ) -> bool {
+        if self.screen != Screen::Dead {
+            return false;
+        }
+        let p = self.client_better_chat_policy();
+        if p["running"] != true || p["keepAfterDeath"] != true {
+            return false;
+        }
+        let prefix = p["prefix"].as_str().unwrap_or(".");
+        let first = prefix.chars().next().map(String::from).unwrap_or_default();
+        let initial = if horizon_client::keybinds::key_code(self.settings.keys.get("key.chat"))
+            == Some(key)
+        {
+            Some(String::new())
+        } else if horizon_client::keybinds::key_code(self.settings.keys.get("key.command"))
+            == Some(key)
+        {
+            Some("/".into())
+        } else if !first.is_empty() && typed.is_some_and(|t| t.starts_with(&first)) {
+            Some(first)
+        } else {
+            None
+        };
+        if let Some(initial) = initial {
+            self.open_chat(&initial, false);
+            true
+        } else {
+            false
+        }
+    }
+}
diff --git a/crates/horizon-client-render/src/liquidbounce_better_chat.rs b/crates/horizon-client-render/src/liquidbounce_better_chat.rs
new file mode 100644
