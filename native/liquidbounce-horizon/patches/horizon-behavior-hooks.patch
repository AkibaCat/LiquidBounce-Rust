+// SPDX-License-Identifier: GPL-3.0-or-later
+// Candidate categories that must never be interpreted as a `mobs` index.
+const KILL_AURA_GUEST: u8 = 12;
+const KILL_AURA_DRAGON_PARENT: u8 = 13;
+const KILL_AURA_DRAGON_BODY: usize = 2;
+
+impl Game<'_> {
+    /// Extend the native pickable categories. The dragon parent is a tracked
+    /// LivingEntity, but only its parts belong in a natural entity ray.
+    fn kill_aura_extra_candidates(&self, out: &mut Vec<super::ClientReachCandidate>) {
+        if let Some(dragon) = self.dragon.as_ref() {
+            out.retain(|c| c.id as u32 != dragon.id);
+        }
+        let own = self
+            .remote
+            .as_ref()
+            .map(|r| r.entity_id)
+            .or_else(|| self.player.as_ref().map(|p| p.entity_id));
+        let root = self.riding.map(|r| self.client_reach_root_vehicle(r));
+        for guest in self
+            .lan
+            .iter()
+            .flat_map(|host| host.hub.guests.iter())
+            .filter(|guest| {
+                guest.placed
+                    && guest.dimension == self.dim.id()
+                    && !guest.spectator()
+                    && Some(guest.entity_id) != own
+            })
+        {
+            let Some(body) = guest.motion.as_deref() else {
+                continue;
+            };
+            // A host may also retain a render mirror in the mob list. The
+            // authoritative guest category must replace that mirror's index.
+            out.retain(|c| c.id != guest.entity_id);
+            let guest_root = guest
+                .vehicle
+                .map(|vehicle| self.client_reach_root_vehicle(vehicle))
+                .unwrap_or(guest.entity_id as u32);
+            let [x, y, z] = guest.position;
+            out.push(super::ClientReachCandidate {
+                kind: KILL_AURA_GUEST,
+                // This is deliberately not a mobs index. The action helper
+                // resolves the guest's connection again from its entity id.
+                index: 0,
+                id: guest.entity_id,
+                local_id: guest.entity_id as u32,
+                position: guest.position,
+                bounds: body.dimensions.bounds(Vec3::new(x, y, z)),
+                pick_radius: 0.0,
+                same_root_vehicle: root == Some(guest_root),
+                can_pick_inside: true,
+            });
+        }
+    }
+
+    /// AttackEntity receives either an actual ray target or the target
+    /// tracker's living entity. A dragon parent's network identity stays the
+    /// parent; its authoritative hurt is EnderDragon.hurtServer(BODY).
+    fn kill_aura_attack_candidate(&self, id: u32) -> Option<super::ClientReachCandidate> {
+        if let Some(dragon) = self.dragon.as_ref().filter(|d| d.id == id) {
+            return Some(super::ClientReachCandidate {
+                kind: KILL_AURA_DRAGON_PARENT,
+                index: KILL_AURA_DRAGON_BODY,
+                id: id as i32,
+                local_id: super::dragon::SPECIAL + KILL_AURA_DRAGON_BODY as u32,
+                position: [dragon.position.x, dragon.position.y, dragon.position.z],
+                bounds: dragon.whole_box(),
+                pick_radius: 0.0,
+                same_root_vehicle: false,
+                can_pick_inside: true,
+            });
+        }
+        self.kill_aura_candidates()
+            .into_iter()
+            .find(|c| c.id as u32 == id)
+    }
+}
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Local authoritative tails for targets kept outside Horizon's mob list.
+impl Game<'_> {
+    /// Called only after the caller's single AttackEntityEvent, carried-item
+    /// synchronization and scoped KeepSprint/implicit-swing setup. None means
+    /// the ordinary exact-category native attack path still owns this target.
+    fn kill_aura_extra_local_attack(&mut self, c: super::ClientReachCandidate) -> Option<bool> {
+        match c.kind {
+            KILL_AURA_GUEST => Some(self.kill_aura_attack_guest(c.id)),
+            KILL_AURA_DRAGON_PARENT => Some(self.kill_aura_attack_dragon_parent(c)),
+            _ => None,
+        }
+    }
+
+    fn kill_aura_attack_guest(&mut self, id: i32) -> bool {
+        let Some((conn, position)) = self
+            .lan
+            .iter()
+            .flat_map(|host| host.hub.guests.iter())
+            .find(|guest| guest.entity_id == id && guest.placed && guest.dimension == self.dim.id())
+            .map(|guest| (guest.conn, guest.position))
+        else {
+            return false;
+        };
+        self.native_client_attack(id as u32, true);
+        // This is the server hook, distinct from the client's already-fired
+        // AttackEntityEvent. A canceled authoritative hurt still consumes the
+        // attack packet, as guest_attack does.
+        let mut canceled = false;
+        self.native_attack_entity(id, "minecraft:player", position, &mut canceled);
+        if canceled {
+            return true;
+        }
+        // Keep the hub available while melee_damage / Criticals consult the
+        // actual target. Strike owns values, so no guest borrow crosses hooks.
+        let Some(strike) = self.pvp_strike() else {
+            return false;
+        };
+        let Some(mut host) = self.lan.take() else {
+            return false;
+        };
+        let victim = super::lan_pvp::Victim::Guest(conn);
+        let here = host
+            .hub
+            .guest(conn)
+            .is_some_and(|guest| guest.entity_id == id && host.hub.here(guest));
+        let landed = here && self.pvp_land(&mut host, victim, &strike);
+        let grounded = Self::pvp_victim_on_ground(&host, victim);
+        self.lan = Some(host);
+        if landed {
+            // The actual victim blocking, armor, teams/PVP, Thorns, sweep,
+            // criticals and kill credit were handled by pvp_land. This is the
+            // weapon/mace/exhaustion tail, with the normal KeepSprint gate.
+            let _ = self.pvp_hit_after(grounded, strike.stops_sprint());
+        }
+        true
+    }
+
+    fn kill_aura_attack_dragon_parent(&mut self, c: super::ClientReachCandidate) -> bool {
+        self.native_client_attack(c.id as u32, false);
+        let mut canceled = false;
+        self.native_attack_entity(c.id, "minecraft:ender_dragon", c.position, &mut canceled);
+        if canceled {
+            return true;
+        }
+        let Some((area, old_health)) = self
+            .dragon
+            .as_ref()
+            .filter(|dragon| dragon.id as i32 == c.id)
+            .map(|dragon| (dragon.whole_box(), dragon.health))
+        else {
+            return false;
+        };
+        let ((amount, scale, crit, magic), admitted) =
+            self.melee_damage_with_admission("minecraft:ender_dragon", true);
+        if !admitted {
+            self.attack_ticks = 0;
+            return true;
+        }
+        let (knockback, _) = self.extra_knockback("minecraft:ender_dragon", scale);
+        // EnderDragon.hurtServer delegates to BODY (2). Keep the network id
+        // and living critical-hit predicate of the parent; EnderDragonPart's
+        // non-living damage path would lose that predicate.
+        let hurt = self.hit_special(
+            c.local_id,
+            amount,
+            true,
+            horizon_client::mobs::DamageKind::PlayerAttack,
+            None,
+        );
+        let landed = matches!(hurt, super::dragon::Hurt::Landed { .. });
+        let new_health = self
+            .dragon
+            .as_ref()
+            .map_or(old_health, |dragon| dragon.health);
+        if landed {
+            if knockback > 0.0 {
+                let (x, z) = self.extra_knockback_direction();
+                let attacker = self.player.as_ref().map_or(0, |player| player.entity_id);
+                let _attacker = self.knockback_scope(attacker);
+                if let Some(dragon) = self.dragon.as_mut() {
+                    dragon.knockback(
+                        f64::from(knockback),
+                        x,
+                        z,
+                        horizon_client::health::HurtSource {
+                            damage_type: "minecraft:player_attack",
+                            causing: attacker,
+                            direct: attacker,
+                        },
+                    );
+                }
+            }
+            self.attack_effects(
+                area,
+                Some(c.id),
+                crit,
+                super::mace::Spared::Nothing,
+                magic.then_some(c.id),
+            );
+            if knockback > 0.0 {
+                self.stop_sprint_after_extra_knockback();
+            }
+            let actual = old_health - new_health;
+            self.award_custom_stat("damage_dealt", (actual * 10.0).round() as i32);
+            if actual > 2.0 {
+                let feet = area.bottom_center();
+                let at = [feet.x, feet.y + area.size().y * 0.5, feet.z];
+                let indicator = horizon_client::particles::ParticleOptions::simple(
+                    horizon_client::particles::ParticleType::DamageIndicator,
+                );
+                self.particles.send_particles(
+                    &indicator,
+                    at,
+                    [0.1, 0.0, 0.1],
+                    0.2,
+                    (actual * 0.5) as u32,
+                );
+                self.lan_send_particles(super::lan_particles::QueuedParticle {
+                    dimension: self.dim.id(),
+                    options: indicator,
+                    state: None,
+                    at,
+                    spread: [0.1, 0.0, 0.1],
+                    speed: [0.2; 3],
+                    count: (actual * 0.5) as u32 as i32,
+                    randomization: 0,
+                });
+            }
+            if let Some(stack) = self.held().cloned() {
+                self.native_hurt_enemy(&stack, c.id as u32, "minecraft:ender_dragon");
+                let smash = self.smash_attack();
+                if smash && let Some(fall) = self.mace_smash_self(false) {
+                    // The dragon never sets onGround (noPhysics). Horizon's
+                    // normal smash helper pushes nearby mobs, stands/players.
+                    self.smash_knockback(area.bottom_center(), super::mace::Spared::Nothing, fall);
+                }
+                if self.res.items().weapon_damage(&stack).is_some() {
+                    self.award_stat("used", &stack.item, 1);
+                }
+                self.post_attack_dragon_burst();
+                if smash && let Some(player) = self.player.as_mut() {
+                    player.fall_distance = 0.0;
+                }
+                self.weapon_wear(&stack);
+            }
+            self.pvp_exhaustion();
+        } else {
+            self.play_at_feet("minecraft:entity.player.attack.nodamage");
+        }
+        if let Some(player) = self.player.as_mut() {
+            if player.attack_log.len() >= 64 {
+                player.attack_log.remove(0);
+            }
+            player
+                .attack_log
+                .push(horizon_client::health::AttackRecord {
+                    game_time: player.health.game_time(),
+                    target: "minecraft:ender_dragon".into(),
+                    id: c.id as u32,
+                    killed: landed && new_health <= 0.0,
+                    amount,
+                    scale,
+                    crit,
+                    landed,
+                    dealt: old_health - new_health,
+                });
+        }
+        self.attack_ticks = 0;
+        true
+    }
+}
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Appended to game::kill_aura; original KillAuraFightBot at ae0eb396.
+mod fight_goal {
+    use super::Game;
+    use horizon_core::geometry::Vec3;
+    use horizon_world::{
+        block_collision_scan::BlockCollisionScan,
+        collision_context::{CollisionContext, CollisionEntity, CollisionItem, EntityContextKind},
+        entity_obstruction::EntityIdentity,
+    };
+    use serde_json::Value;
+    use std::cmp::Ordering;
+
+    type Point = [f64; 3];
+    #[derive(Clone, Copy)]
+    struct Opponent {
+        position: Point,
+        yaw: f32,
+        range: f32,
+        required_yaw: f32,
+        out_of_distance: bool,
+        out_of_danger: bool,
+    }
+    #[derive(Clone, Copy)]
+    struct Settings {
+        dangerous_yaw: f32,
+        runaway: bool,
+        leader: bool,
+        leader_radius: f32,
+    }
+    fn point(p: Vec3) -> Point {
+        [p.x, p.y, p.z]
+    }
+    fn distance_squared(a: Point, b: Point) -> f64 {
+        let x = a[0] - b[0];
+        let y = a[1] - b[1];
+        let z = a[2] - b[2];
+        x * x + y * y + z * z
+    }
+    fn wrap(mut angle: f32) -> f32 {
+        angle %= 360.;
+        if angle >= 180. {
+            angle -= 360.;
+        }
+        if angle < -180. {
+            angle += 360.;
+        }
+        angle
+    }
+    fn offset(at: Point, scale: f32, direction: Point) -> Point {
+        let scale = f64::from(scale);
+        std::array::from_fn(|i| scale.mul_add(direction[i], at[i]))
+    }
+    fn compare(a: f64, b: f64) -> Ordering {
+        match (a.is_nan(), b.is_nan()) {
+            (true, true) => Ordering::Equal,
+            (true, false) => Ordering::Greater,
+            (false, true) => Ordering::Less,
+            _ => a.total_cmp(&b),
+        }
+    }
+    fn closest(points: impl IntoIterator<Item = Point>, player: Point) -> Option<Point> {
+        let mut nearest = None;
+        for at in points {
+            if nearest.is_none_or(|old| {
+                compare(distance_squared(at, player), distance_squared(old, player))
+                    == Ordering::Less
+            }) {
+                nearest = Some(at);
+            }
+        }
+        nearest
+    }
+    // Pure source selection. Native calls supply vanilla directions and real
+    // contextual block collisions; the batch harness supplies exact fixtures.
+    fn select(
+        player: Point,
+        opponent: Option<Opponent>,
+        leader: Option<Point>,
+        settings: Settings,
+        will_click: bool,
+        direction: impl Fn(f32) -> Point,
+        mut collides: impl FnMut(Point) -> bool,
+    ) -> Option<(Point, bool)> {
+        let goal = if let Some(leader) = leader {
+            closest(
+                (-180..=180)
+                    .step_by(45)
+                    .map(|yaw| offset(leader, settings.leader_radius, direction(yaw as f32))),
+                player,
+            )
+            .unwrap_or(leader)
+        } else {
+            let target = opponent?;
+            if settings.runaway && !target.out_of_distance && !will_click {
+                offset(player, target.range, direction(target.required_yaw))
+            } else {
+                let looking_at = offset(target.position, target.range, direction(target.yaw));
+                let mut candidates = Vec::new();
+                for yaw in (-180..=180).step_by(10) {
+                    let yaw = yaw as f32;
+                    let at = offset(target.position, target.range, direction(yaw));
+                    // Source queries collision before rejecting dangerous angles.
+                    if collides(at) {
+                        continue;
+                    }
+                    if wrap(target.yaw - yaw).abs() <= settings.dangerous_yaw {
+                        continue;
+                    }
+                    candidates.push(at);
+                }
+                // Kotlin sortedBy is stable. Its order decides equal-distance
+                // minBy ties; reducing directly to the player's distance loses it.
+                candidates.sort_by(|a, b| {
+                    compare(
+                        distance_squared(*a, looking_at),
+                        distance_squared(*b, looking_at),
+                    )
+                });
+                closest(candidates, player).unwrap_or(looking_at)
+            }
+        };
+        let context_jump = opponent.is_some_and(|o| o.out_of_distance && !o.out_of_danger);
+        // Leader.running also assists combat movement when its named player was
+        // not found. Entity.closerThan uses strict distance < radius squared.
+        let leader_jump = settings.leader
+            && !(distance_squared(player, goal)
+                < f64::from(settings.leader_radius) * f64::from(settings.leader_radius));
+        Some((goal, context_jump || leader_jump))
+    }
+
+    // NATIVE_FIGHT_GOAL
+    impl Game<'_> {
+        /// Entity.doesNotCollideBelow() defaults to -64 even in dimensions with
+        /// another minimum build height. The queried entity supplies the full
+        /// collision context; using the local player changes powder snow and
+        /// scaffolding behavior for remote targets.
+        pub(in crate::game) fn kill_aura_ground_below(&self, id: i32, b: super::B) -> bool {
+            let Some(entity) = self.native_entity(id as u32) else {
+                return false;
+            };
+            let Some(position) = self.native_entity_position(entity) else {
+                return false;
+            };
+            if position[1] < -64. || b.lo.1 < -64. {
+                return false;
+            }
+            let living = self.native_living(entity);
+            let held = living.and_then(|e| {
+                self.native_living_hand_item(e, horizon_client::first_person::Hand::Main)
+            });
+            let boots = living.and_then(|e| {
+                self.native_living_equipment(e, horizon_client::mod_api::EquipmentSlot::Feet)
+            });
+            let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+            let mut descending = false;
+            let mut subject = None;
+            let kind = if id == local {
+                if let Some(player) = self.player.as_ref() {
+                    descending = player.shift_key_down;
+                    subject = Some(player.powder_snow_subject());
+                }
+                EntityContextKind::Player
+            } else if let Some(guest) = self
+                .lan
+                .iter()
+                .flat_map(|l| l.hub.guests.iter())
+                .find(|g| g.placed && g.entity_id == id && g.dimension == self.dim.id())
+            {
+                descending = guest.sneaking;
+                subject = guest.motion.as_ref().map(|p| p.powder_snow_subject());
+                EntityContextKind::Player
+            } else if let Some(mob) = self.mobs.iter().find(|m| m.id as i32 == id && !m.removed) {
+                descending = mob.extra.crouching;
+                subject = Some(horizon_client::collisions::PowderSnowSubject {
+                    fall_distance: mob.fall_distance,
+                    leather_boots: boots.as_ref().is_some_and(|stack| {
+                        stack.count > 0 && stack.item.as_ref() == "minecraft:leather_boots"
+                    }),
+                    walkable_type: self
+                        .res
+                        .mob_data()
+                        .entity_has("minecraft:powder_snow_walkable_mobs", &mob.kind.id),
+                    lava_walker: mob.kind.id.as_str() == "minecraft:strider",
+                    falling_block: false,
+                });
+                if horizon_client::command::args::normalize(&mob.kind.id) == "minecraft:player" {
+                    EntityContextKind::Player
+                } else if living.is_some() {
+                    EntityContextKind::Living
+                } else {
+                    EntityContextKind::Other
+                }
+            } else if living.is_some() {
+                EntityContextKind::Living
+            } else {
+                EntityContextKind::Other
+            };
+            let context = CollisionContext::for_entity(
+                CollisionEntity {
+                    identity: EntityIdentity(u64::from(id as u32)),
+                    kind,
+                    y: position[1],
+                    descending,
+                    main_hand: living.map(|_| {
+                        held.as_ref()
+                            .map_or(CollisionItem::EMPTY, |stack| CollisionItem {
+                                item: &stack.item,
+                                count: stack.count as i32,
+                            })
+                    }),
+                },
+                false,
+            );
+            let bounds = horizon_core::geometry::Aabb::new(
+                Vec3::new(b.lo.0, -64., b.lo.2),
+                Vec3::new(b.hi.0, b.hi.1, b.hi.2),
+            );
+            let mut scene = horizon_client::collisions::SceneCollisions {
+                world: &self.world,
+                binding: self.collision,
+                subject,
+            };
+            BlockCollisionScan::any_collision(&mut scene, context, bounds, false, usize::MAX)
+                .expect("FightBot target block collision column")
+        }
+        fn fight_goal_collides(&self, at: Point) -> bool {
+            let Some(player) = self.player.as_ref() else {
+                return false;
+            };
+            let bounds = player.bounds().move_by(Vec3::new(
+                at[0] - player.position.x,
+                at[1] - player.position.y,
+                at[2] - player.position.z,
+            ));
+            let held = self
+                .inventory
+                .get(self.client_hotbar_slot())
+                .and_then(Option::as_ref);
+            let context = CollisionContext::for_entity(
+                CollisionEntity {
+                    identity: EntityIdentity(
+                        self.remote
+                            .as_ref()
+                            .map_or(0, |r| r.entity_id as u32 as u64),
+                    ),
+                    kind: EntityContextKind::Player,
+                    y: player.position.y,
+                    descending: player.shift_key_down,
+                    main_hand: Some(held.map_or(CollisionItem::EMPTY, |stack| CollisionItem {
+                        item: &stack.item,
+                        count: stack.count as i32,
+                    })),
+                },
+                false,
+            );
+            let mut scene = horizon_client::collisions::SceneCollisions {
+                world: &self.world,
+                binding: self.collision,
+                subject: Some(player.powder_snow_subject()),
+            };
+            BlockCollisionScan::any_collision(&mut scene, context, bounds, false, usize::MAX)
+                .expect("FightBot actual target-position block collision")
+        }
+        fn fight_goal_leader(&self, username: &str) -> Option<Point> {
+            if username.is_empty() {
+                return None;
+            }
+            if self.own_profile_name() == username {
+                return self.player.as_ref().map(|p| point(p.position));
+            }
+            if let Some(mob) = self.mobs.iter().find(|m| {
+                !m.removed
+                    && horizon_client::command::args::normalize(&m.kind.id) == "minecraft:player"
+                    && self.remote_player_name(m.id) == Some(username)
+            }) {
+                return Some(point(mob.position));
+            }
+            self.lan
+                .iter()
+                .flat_map(|h| h.hub.guests.iter())
+                .find(|g| g.placed && g.dimension == self.dim.id() && g.name == username)
+                .map(|g| g.position)
+        }
+        pub(in crate::game) fn kill_aura_fight_goal(&self, value: &Value) -> Option<(Point, bool)> {
+            let player = point(self.player.as_ref()?.position);
+            let number =
+                |key: &str, default: f32| value[key].as_f64().map_or(default, |v| v as f32);
+            let settings = Settings {
+                dangerous_yaw: number("dangerousYaw", 55.),
+                runaway: value["runawayOnCooldown"].as_bool().unwrap_or(true),
+                leader: value["leader"] == true,
+                leader_radius: number("leaderRadius", 5.),
+            };
+            let opponent = value["targetId"].as_i64().and_then(|id| {
+                let id = id as i32;
+                let dragon = self
+                    .dragon
+                    .as_ref()
+                    .filter(|d| d.id as i32 == id || self.client_targeting_dragon_id() == id);
+                let (at, yaw) = if let Some(dragon) = dragon {
+                    (point(dragon.position), dragon.yaw)
+                } else {
+                    let entity = self.native_entity(id as u32)?;
+                    (
+                        self.native_entity_position(entity)?,
+                        self.native_entity_rotation(entity)?[0],
+                    )
+                };
+                let distance = distance_squared(player, at).sqrt();
+                let distance_float = distance as f32;
+                let interaction = number("range", 3.);
+                let range = if interaction.is_nan() || distance_float.is_nan() {
+                    f32::NAN
+                } else {
+                    interaction.min(distance_float)
+                };
+                // Rotation.lookingAt(player feet, target eye). Pitch is then
+                // overwritten to zero; target eye height does not enter its yaw.
+                let required_yaw = wrap(
+                    (horizon_core::jmath::atan2(player[2] - at[2], player[0] - at[0])
+                        * f64::from(horizon_core::geometry::trig::RAD_TO_DEG))
+                        as f32
+                        - 90.,
+                );
+                Some(Opponent {
+                    position: at,
+                    yaw,
+                    range,
+                    required_yaw,
+                    out_of_distance: distance > f64::from(number("opponentRange", 3.)),
+                    out_of_danger: wrap(required_yaw - yaw).abs() > settings.dangerous_yaw,
+                })
+            });
+            let leader = settings
+                .leader
+                .then(|| self.fight_goal_leader(value["username"].as_str().unwrap_or("")))
+                .flatten();
+            select(
+                player,
+                opponent,
+                leader,
+                settings,
+                value["willClick"] == true,
+                |yaw| point(Vec3::direction_from_rotation(0., yaw)),
+                |at| self.fight_goal_collides(at),
+            )
+        }
+    }
+}
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Appended to game::kill_aura. Replay actual input against an owned snapshot.
+impl Game<'_> {
+    fn kill_aura_local_future(&mut self, ticks: i32, yaw: f32) -> V {
+        use super::{
+            auto_walk_player::NativePlayer,
+            auto_walk_simulation::NativeSimulation,
+            auto_walk_world::{self as world, NativeLevel, NavigationRegistry},
+        };
+        use crate::navigation::{
+            input::Input,
+            walk_control::body::{SimulatedInput, WalkSimulation},
+        };
+        use horizon_client::actions::Action as M;
+        let held = |key| self.keys.held(key);
+        let input = Input {
+            forward: held(M::Forward),
+            backward: held(M::Back),
+            left: held(M::Left),
+            right: held(M::Right),
+            jump: held(M::Jump),
+            shift: held(M::Sneak),
+            sprint: held(M::Sprint),
+        };
+        world::with_scope(self, || {
+            let epoch = world::read(world::current_epoch);
+            let registry = world::read(NavigationRegistry::capture);
+            let player = NativePlayer::new(NativeLevel::new(registry, epoch));
+            let mut input = SimulatedInput::new(input);
+            input.force_stay_on_ground_surface =
+                horizon_client::navigation_physics::staying_on_surface(false);
+            let mut simulation = NativeSimulation::new(&player, input, yaw);
+            for _ in 0..ticks.clamp(0, 40) {
+                simulation.tick();
+            }
+            let eye = simulation.player().eye();
+            V(eye.x, eye.y, eye.z)
+        })
+    }
+}
