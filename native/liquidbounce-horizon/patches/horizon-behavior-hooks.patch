+ fn is_known(&self,p:NavPos)->bool{self.game(|game|p.y>=game.world.shape.min_y&&p.y<game.world.shape.min_y+game.world.shape.height&&game.world.chunks.contains_key(&(p.x>>4,p.z>>4)))}
