+++ b/crates/horizon-client-render/src/liquidbounce_better_chat.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#[path = "liquidbounce_better_chat_layout.rs"]
+mod liquidbounce_better_chat_layout;
+impl Chat {
+    pub fn liquidbounce_policy(&mut self, infinite: bool, anti_clear: bool) {
+        self.liquidbounce_infinite = infinite;
+        self.liquidbounce_anti_clear = anti_clear;
+    }
+    pub fn liquidbounce_force_clear(&mut self) {
+        let paused = self.liquidbounce_anti_clear;
+        self.liquidbounce_anti_clear = false;
+        self.clear();
+        self.liquidbounce_anti_clear = paused;
+    }
+    pub fn liquidbounce_add_stack(
+        &mut self,
+        atlas: &HudAtlas,
+        mut content: Text,
+        source: ChatSource,
+        ticks: u64,
+        focused: bool,
+        id: String,
+    ) {
+        let count = self
+            .messages
+            .iter()
+            .find(|m| m.liquidbounce_id.as_deref() == Some(&id))
+            .map_or(1, |m| m.liquidbounce_count.saturating_add(1));
+        let had = self
+            .messages
+            .iter()
+            .any(|m| m.liquidbounce_id.as_deref() == Some(&id));
+        if had {
+            self.messages
+                .retain(|m| m.liquidbounce_id.as_deref() != Some(&id));
+            self.rewrap(&atlas.font);
+        }
+        if count > 1 {
+            content = content.append(Text::literal(format!(" [{count}]")).with_color(text::GRAY));
+        }
+        self.push_message(
+            &atlas.font,
+            Message {
+                added: ticks,
+                time: (0, 0),
+                repeats: 1,
+                wrapped: 0,
+                content,
+                tag: None,
+                source,
+                signature: None,
+                client_id: None,
+                liquidbounce_id: Some(id),
+                liquidbounce_count: count,
+            },
+            focused,
+        );
+    }
+    fn liquidbounce_hover_bounds(&self, height: i32, x: f64, y: f64) -> Option<(usize, usize)> {
+        let index = liquidbounce_better_chat_layout::hit(
+            self.lines.len(),
+            self.scroll,
+            self.lines_per_page(true),
+            self.options.width_px(),
+            height,
+            self.options.scale,
+            self.options.line_height(),
+            x,
+            y,
+        )?;
+        let keys = self
+            .lines
+            .iter()
+            .map(|line| std::sync::Arc::as_ptr(&line.message))
+            .collect::<Vec<_>>();
+        liquidbounce_better_chat_layout::bounds(&keys, index)
+    }
+    pub fn liquidbounce_copy_at(&self, height: i32, x: f64, y: f64) -> Option<String> {
+        let (start, end) = self.liquidbounce_hover_bounds(height, x, y)?;
+        let mut out = String::new();
+        for line in self.lines[start..=end].iter().rev() {
+            out.push_str(&line.content.plain());
+        }
+        Some(out)
+    }
+    pub fn liquidbounce_highlight(&self, batch: &mut HudBatch, atlas: &HudAtlas, x: f64, y: f64) {
+        let Some(bounds) = self.liquidbounce_hover_bounds(batch.height as i32, x, y) else {
+            return;
+        };
+        let Some([left, top, right, bottom]) = liquidbounce_better_chat_layout::rect(
+            bounds,
+            self.scroll,
+            self.lines.len(),
+            self.lines_per_page(true),
+            self.options.width_px(),
+            batch.height as i32,
+            self.options.scale,
+            self.options.line_height(),
+        ) else {
+            return;
+        };
+        hud_layout::paint(
+            batch,
+            atlas,
+            &[hud_layout::fill(left, top, right, bottom, 0x4422aaff)],
+        );
+    }
+}
diff --git a/crates/horizon-client-render/src/liquidbounce_better_chat_layout.rs b/crates/horizon-client-render/src/liquidbounce_better_chat_layout.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/liquidbounce_better_chat_layout.rs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! BetterChat's foreground cursor hit test and clipped wrapped-message rectangle.
+pub fn bounds<T: PartialEq>(keys: &[T], index: usize) -> Option<(usize, usize)> {
+    let key = keys.get(index)?;
+    let mut start = index;
+    let mut end = index;
+    while start > 0 && &keys[start - 1] == key {
+        start -= 1;
+    }
+    while end + 1 < keys.len() && &keys[end + 1] == key {
+        end += 1;
+    }
+    Some((start, end))
+}
+pub fn hit(
+    total: usize,
+    scroll: usize,
+    page: usize,
+    width: i32,
+    height: i32,
+    scale: f64,
+    line_height: i32,
+    x: f64,
+    y: f64,
+) -> Option<usize> {
+    if scale <= 0. || line_height <= 0 {
+        return None;
+    }
+    let w = (f64::from(width) / scale).ceil();
+    let x = x / scale - 4.;
+    if x < 0. || x > w {
+        return None;
+    }
+    let bottom = (f64::from(height - 40) / scale).floor();
+    let local = bottom - y / scale;
+    if local < 0. {
+        return None;
+    }
+    let row = (local / f64::from(line_height)).floor() as usize;
+    let visible = total.saturating_sub(scroll).min(page);
+    (row < visible).then_some(scroll + row)
+}
+pub fn rect(
+    bounds: (usize, usize),
+    scroll: usize,
+    total: usize,
+    page: usize,
+    width: i32,
+    height: i32,
+    scale: f64,
+    line_height: i32,
+) -> Option<[i32; 4]> {
+    if scale <= 0. || line_height <= 0 {
+        return None;
+    }
+    let visible = total.saturating_sub(scroll).min(page);
+    if visible == 0 {
+        return None;
+    }
+    let start = bounds.0.max(scroll);
+    let end = bounds.1.min(scroll + visible - 1);
+    if start > end {
+        return None;
+    }
+    let w = (f64::from(width) / scale).ceil();
+    let bottom = (f64::from(height - 40) / scale).floor();
+    Some([
+        (4. * scale).floor() as i32,
+        ((bottom - (end - scroll + 1) as f64 * f64::from(line_height)) * scale).floor() as i32,
+        ((w + 4.) * scale).ceil() as i32,
+        ((bottom - (start - scroll) as f64 * f64::from(line_height)) * scale).ceil() as i32,
+    ])
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn wrapped_message_bounds_and_scaled_clipping() {
+        assert_eq!(bounds(&[9, 9, 8, 8, 8, 7], 3), Some((2, 4)));
+        assert_eq!(hit(20, 3, 4, 320, 240, 0.5, 9, 6., 195.), Some(4));
+        assert_eq!(
+            rect((2, 7), 3, 20, 4, 320, 240, 0.5, 9),
+            Some([2, 182, 322, 200])
+        );
+        assert_eq!(hit(20, 0, 4, 320, 240, 1., 9, 3., 195.), None);
+        assert_eq!(hit(20, 0, 4, 320, 240, 0., 9, 10., 195.), None);
+    }
+}
