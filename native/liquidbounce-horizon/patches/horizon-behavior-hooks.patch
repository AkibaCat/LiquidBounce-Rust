+pub fn bob_view_dank(state: &BobState, motion: f32, pose: &mut Mat4) {
+    let Some((walk, bob)) = state.player else { return; };
+    pose.translate(
+        trig::sin(f64::from(walk * PI)) * bob * 0.5,
+        -(trig::cos(f64::from(walk * PI)) * bob).abs(),
