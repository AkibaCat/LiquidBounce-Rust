--- /dev/null
+++ b/crates/horizon-client/src/navigation/glide/contacts.rs
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Original glide Contacts, retaining face/query and JVM HashSet callback order.
+use super::super::{
+    aabb::{Aabb, Direction},
+    geometry::{BlockPos, Vec3},
+    terrain::{TerrainLevel, TerrainState},
+};
+pub trait ContactPlayer {
+    fn is_fall_flying(&self) -> bool;
+    fn horizontal_collision(&self) -> bool;
+    fn vertical_collision(&self) -> bool;
+    fn vertical_collision_below(&self) -> bool;
+    fn bounding_box(&self) -> Aabb;
+}
+pub trait ContactBody {
+    type Player: ContactPlayer;
+    type State: TerrainState;
+    type Level: TerrainLevel<Self::State>;
+    fn player(&self) -> &Self::Player;
+    fn live_level(&self) -> Self::Level;
+    /// java.lang.Enum.hashCode of the host's Agent Direction entries, captured once.
+    fn direction_hash(&self, direction: Direction) -> i32;
+}
+pub trait ContactListener {
+    fn touched(&mut self, pos: BlockPos, direction: Direction);
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Touch {
+    pos: BlockPos,
+    direction: Direction,
+}
+#[derive(Default)]
+pub struct Contacts {
+    touching: Vec<Touch>,
+}
+impl Contacts {
+    pub fn tick(&mut self, body: &impl ContactBody, listener: &mut impl ContactListener) {
+        let player = body.player();
+        if !player.is_fall_flying()
+            || !player.horizontal_collision() && !player.vertical_collision()
+        {
+            self.touching.clear();
+            return;
+        }
+        let mut now = Vec::with_capacity(6);
+        for direction in [
+            Direction::Down,
+            Direction::Up,
+            Direction::North,
+            Direction::South,
+            Direction::West,
+            Direction::East,
+        ] {
+            let hit = match direction {
+                Direction::Down => player.vertical_collision_below(),
+                Direction::Up => player.vertical_collision() && !player.vertical_collision_below(),
+                _ => player.horizontal_collision(),
+            };
+            if hit {
+                let bbox = player.bounding_box();
+                if let Some(pos) = touched_block(body.live_level(), bbox, direction) {
+                    now.push(Touch { pos, direction });
+                }
+            }
+        }
+        // At most six entries: default JDK HashSet's table stays at capacity 16.
+        // Stable ordering retains insertion order within each collision chain.
+        now.sort_by_key(|touch| {
+            let p = touch.pos;
+            let hash =
+                p.y.wrapping_add(p.z.wrapping_mul(31))
+                    .wrapping_mul(31)
+                    .wrapping_add(p.x)
+                    .wrapping_mul(31)
+                    .wrapping_add(body.direction_hash(touch.direction));
+            let hash = hash as u32;
+            (hash ^ (hash >> 16)) & 15
+        });
+        for touch in &now {
+            if !self.touching.contains(touch) {
+                listener.touched(touch.pos, touch.direction);
+            }
+        }
+        self.touching = now;
+    }
+}
+pub fn touched_block<B: TerrainState, L: TerrainLevel<B>>(
+    level: L,
+    bbox: Aabb,
+    direction: Direction,
+) -> Option<BlockPos> {
+    let (x, y, z) = match direction {
+        Direction::Down => (0, -1, 0),
+        Direction::Up => (0, 1, 0),
+        Direction::North => (0, 0, -1),
+        Direction::South => (0, 0, 1),
+        Direction::West => (-1, 0, 0),
+        Direction::East => (1, 0, 0),
+    };
+    let probe = Vec3::new(
+        f64::from(x) * 1.0e-3,
+        f64::from(y) * 1.0e-3,
+        f64::from(z) * 1.0e-3,
+    );
+    let face = bbox.expand_towards(probe).intersect(bbox.moved(Vec3::new(
+        probe.x * 2.0,
+        probe.y * 2.0,
+        probe.z * 2.0,
+    )));
+    for x in face.min.x.floor() as i32..=face.max.x.floor() as i32 {
+        for y in face.min.y.floor() as i32..=face.max.y.floor() as i32 {
+            for z in face.min.z.floor() as i32..=face.max.z.floor() as i32 {
+                let pos = BlockPos::new(x, y, z);
+                let shape = level.block_state(pos).collision_shape(&level, pos);
+                if shape
+                    .aabbs()
+                    .iter()
+                    .any(|bounds| bounds.moved_block(pos).intersects(face))
+                {
+                    return Some(pos);
+                }
+            }
+        }
+    }
+    None
+}
diff --git a/crates/horizon-client/src/navigation/glide/cruise.rs b/crates/horizon-client/src/navigation/glide/cruise.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/glide/cruise.rs
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Original Cruise column sampling, rocket budget and Landing handover.
+use super::super::geometry::{Vec3, java_max};
+use super::{Controls, Steering, elytra_motion, landing::Landing, rockets::Rockets};
+pub trait ColumnHeights {
+    fn top(&mut self, x: i32, z: i32) -> Option<i32>;
+}
+pub struct Cruise<H, F> {
+    goal: Vec3,
+    heights: H,
+    rockets: Rockets,
+    ceiling: i32,
+    fallback: F,
+    altitude: f64,
+    ticks: i32,
+    landing: Option<Landing>,
+}
+impl<H: ColumnHeights, F: FnMut(Vec3) -> Option<Vec3>> Cruise<H, F> {
+    pub fn new(goal: Vec3, heights: H, rockets: Rockets, ceiling: i32, fallback: F) -> Self {
+        Self {
+            goal,
+            heights,
+            rockets,
+            ceiling,
+            fallback,
+            altitude: 0.0,
+            ticks: 0,
+            landing: None,
+        }
+    }
+    pub fn rockets(&self) -> &Rockets {
+        self.landing
+            .as_ref()
+            .map_or(&self.rockets, |landing| &landing.rockets)
+    }
+    fn land(&mut self, at: Vec3, position: Vec3, motion: Vec3) -> Controls {
+        let mut landing = Landing::new(at, self.rockets, 0.0);
+        let controls = landing.steer(position, motion);
+        self.landing = Some(landing);
+        controls
+    }
+}
+impl<H: ColumnHeights, F: FnMut(Vec3) -> Option<Vec3>> Steering for Cruise<H, F> {
+    fn target(&self) -> Vec3 {
+        self.landing.as_ref().map_or(self.goal, Steering::target)
+    }
+    fn steer(&mut self, position: Vec3, motion: Vec3) -> Controls {
+        if let Some(landing) = &mut self.landing {
+            return landing.steer(position, motion);
+        }
+        let dx = self.goal.x - position.x;
+        let dz = self.goal.z - position.z;
+        let distance = (dx * dx + dz * dz).sqrt();
+        if distance <= 64.0 {
+            return self.land(self.goal, position, motion);
+        }
+        if self.rockets.left() == 0 && self.rockets.boost_ticks() == 0 {
+            let at = (self.fallback)(position).unwrap_or(self.goal);
+            return self.land(at, position, motion);
+        }
+        let prior = self.ticks;
+        self.ticks = self.ticks.wrapping_add(1);
+        if prior % 20 == 0 {
+            self.altitude = cruise_altitude(position, self.goal, &mut self.heights)
+                .min(f64::from(self.ceiling.wrapping_sub(4)));
+        }
+        let below = self.altitude - position.y;
+        let fire = self.rockets.can_fire()
+            && ((motion.x * motion.x + motion.z * motion.z).sqrt() < 1.2 || below > 3.0);
+        if fire {
+            self.rockets.fire();
+        }
+        let boosted = self.rockets.tick();
+        Controls {
+            y_rot: elytra_motion::y_rot_towards(dx, dz),
+            x_rot: elytra_motion::x_rot_towards(below, 24.0).clamp(-40.0, 15.0),
+            should_fire_rocket: fire,
+            is_boosted: boosted,
+        }
+    }
+}
+pub fn cruise_altitude(from: Vec3, goal: Vec3, heights: &mut impl ColumnHeights) -> f64 {
+    let mut top = java_max(from.y, goal.y);
+    let mut unknown = false;
+    let dx = goal.x - from.x;
+    let dz = goal.z - from.z;
+    let samples = ((dx * dx + dz * dz).sqrt() / 4.0).ceil() as i32;
+    for i in 0..=samples {
+        let t = if samples == 0 {
+            0.0
+        } else {
+            f64::from(i) / f64::from(samples)
+        };
+        if let Some(column) = heights.top(
+            (from.x + dx * t).floor() as i32,
+            (from.z + dz * t).floor() as i32,
+        ) {
+            top = java_max(top, f64::from(column));
+        } else {
+            unknown = true;
+        }
+    }
+    top + 12.0 + if unknown { 24.0 } else { 0.0 }
+}
+pub fn rockets_needed(distance: f64, climb: f64, rocket_ticks: i32) -> i32 {
+    if rocket_ticks <= 0 {
+        return i32::MAX;
+    }
+    let per = f64::from(rocket_ticks) * 1.5 * 0.7;
+    let climb_per = f64::from(rocket_ticks) * 1.5 * 0.6;
+    ((distance / per).ceil() as i32)
+        .wrapping_add((java_max(climb, 0.0) / climb_per).ceil() as i32)
+        .wrapping_add(3)
+}
diff --git a/crates/horizon-client/src/navigation/glide/elytra_motion.rs b/crates/horizon-client/src/navigation/glide/elytra_motion.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/glide/elytra_motion.rs
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Original one-tick ElytraMotion, including the game's float direction table.
+use super::super::{
+    flight_math, geometry::Vec3, simulation::sine_table, walk_jump::java_math::fdlibm_atan2,
+};
+pub fn update(delta: Vec3, y_rot: f32, x_rot: f32, boosted: bool) -> Vec3 {
+    let y_angle = -y_rot * f32::from_bits(0x3c8e_fa35) - std::f32::consts::PI;
+    let x_angle = -x_rot * f32::from_bits(0x3c8e_fa35);
+    let y_cos = sine_table::cos(y_angle);
+    let y_sin = sine_table::sin(y_angle);
+    let x_cos = -sine_table::cos(x_angle);
+    let look = Vec3::new(
+        f64::from(y_sin * x_cos),
+        f64::from(sine_table::sin(x_angle)),
+        f64::from(y_cos * x_cos),
+    );
+    let lean = f64::from(x_rot) * 0.017453292519943295;
+    let look_horizontal = (look.x * look.x + look.z * look.z).sqrt();
+    let move_horizontal = (delta.x * delta.x + delta.z * delta.z).sqrt();
+    let lift = flight_math::cos(lean) * flight_math::cos(lean);
+    let mut x = delta.x;
+    let mut y = delta.y + 0.08 * (-1.0 + lift * 0.75);
+    let mut z = delta.z;
+    if look_horizontal > 0.0 {
+        if y < 0.0 {
+            let convert = y * -0.1 * lift;
+            x += look.x * convert / look_horizontal;
+            y += convert;
+            z += look.z * convert / look_horizontal;
+        }
+        if lean < 0.0 {
+            let convert = move_horizontal * -flight_math::sin(lean) * 0.04;
+            x -= look.x * convert / look_horizontal;
+            y += convert * 3.2;
+            z -= look.z * convert / look_horizontal;
+        }
+        x += (look.x / look_horizontal * move_horizontal - x) * 0.1;
+        z += (look.z / look_horizontal * move_horizontal - z) * 0.1;
+    }
+    x *= f64::from(0.99_f32);
+    y *= f64::from(0.98_f32);
+    z *= f64::from(0.99_f32);
+    if boosted {
+        x += look.x * 0.1 + (look.x * 1.5 - x) * 0.5;
+        y += look.y * 0.1 + (look.y * 1.5 - y) * 0.5;
+        z += look.z * 0.1 + (look.z * 1.5 - z) * 0.5;
+    }
+    Vec3::new(x, y, z)
+}
+pub fn y_rot_towards(dx: f64, dz: f64) -> f32 {
+    let mut wrapped = (fdlibm_atan2(-dx, dz) * 57.29577951308232) % 360.0;
+    if wrapped.is_nan() {
+        // HotSpot Math.atan2 returns its canonical positive NaN.
+        return f32::NAN;
+    }
+    if wrapped >= 180.0 {
+        wrapped -= 360.0;
+    }
+    if wrapped < -180.0 {
+        wrapped += 360.0;
+    }
+    wrapped as f32
+}
+pub fn x_rot_towards(up: f64, ahead: f64) -> f32 {
+    (-(fdlibm_atan2(up, ahead) * 57.29577951308232)) as f32
+}
diff --git a/crates/horizon-client/src/navigation/glide/gliding.rs b/crates/horizon-client/src/navigation/glide/gliding.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/glide/gliding.rs
@@ -0,0 +1,541 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete navigation/glide/Gliding.kt orchestration.
+use super::super::search::Outcome;
+use super::super::{
+    background::{BackgroundSearch, Executor, SearchFactory},
+    geometry::{BlockPos, Vec3},
+    input::Input,
+    owned_search::{OwnedTerrainSearch, SearchSlot, StoredLevel, StoredWorker},
+    replanner::ReplannerLevel,
+    terrain::{Terrain, TerrainLevel, TerrainState},
+    walk_jump::vector_yaw,
+};
+use super::{
+    Controls, Steering,
+    abilities::{GlideAbilities, GlideStack},
+    airways::{AirwayFactory, Airways},
+    body::{GlideBody, GlideHand, GlideLevel, GlideLook, GlidePlayer},
+    capture::{EquippedGlidePlayer, GlideInventory},
+    contacts::{ContactBody, ContactListener, ContactPlayer, Contacts},
+    cruise::{ColumnHeights, Cruise, cruise_altitude, rockets_needed},
+    landing::Landing,
+    passage::Passage,
+    rockets::Rockets,
+    roof_bounce::{directional_input, horizontal_distance, sub},
+    route_search::{Route, region},
+};
+use std::{marker::PhantomData, sync::Arc};
+
+pub trait GlideReport: ContactListener {
+    fn blocks_empty(&mut self);
+    /// TargetProgress remains tied to this mover in the host's progress registry.
+    fn following(&mut self, points: &[Vec3], landing: Vec3);
+}
+pub type GlideSearchFactory<T, S> =
+    Arc<dyn Fn(T, Vec3, Vec3, f64, GlideAbilities) -> S + Send + Sync>;
+type Search<T, S> = BackgroundSearch<(BlockPos, Vec3), SearchSlot<T, S>, StoredWorker, Route>;
+type WorldProvider<L> = Arc<dyn Fn() -> L>;
+type Fallback = Box<dyn FnMut(Vec3) -> Option<Vec3>>;
+struct LiveHeights<B, L> {
+    world: WorldProvider<L>,
+    marker: PhantomData<fn() -> B>,
+}
+impl<B: TerrainState, L: GlideLevel<B>> ColumnHeights for LiveHeights<B, L> {
+    fn top(&mut self, x: i32, z: i32) -> Option<i32> {
+        if (self.world)().has_column(x, z) {
+            Some((self.world)().column_height(x, z))
+        } else {
+            None
+        }
+    }
+}
+enum Control<B, L> {
+    Landing(Landing),
+    Cruise(Box<Cruise<LiveHeights<B, L>, Fallback>>),
+    Passage(Passage),
+}
+impl<B: TerrainState, L: GlideLevel<B>> Control<B, L> {
+    fn target(&self) -> Vec3 {
+        match self {
+            Self::Landing(x) => x.target(),
+            Self::Cruise(x) => x.target(),
+            Self::Passage(x) => x.target(),
+        }
+    }
+    fn steer(&mut self, position: Vec3, motion: Vec3, world: WorldProvider<L>) -> Controls {
+        match self {
+            Self::Landing(x) => x.steer(position, motion),
+            Self::Cruise(x) => x.steer(position, motion),
+            Self::Passage(x) => x.steer_with(|| Terrain::player(world()), position, motion),
+        }
+    }
+}
+struct Glide<B, L> {
+    goal: Vec3,
+    steering: Control<B, L>,
+    path: Option<Route>,
+    ticks: i32,
+    has_opened: bool,
+    pressed_at: i32,
+    jumped: bool,
+}
+impl<B: TerrainState, L: GlideLevel<B>> Glide<B, L> {
+    fn new(goal: Vec3, steering: Control<B, L>, path: Option<Route>) -> Self {
+        Self {
+            goal,
+            steering,
+            path,
+            ticks: 0,
+            has_opened: false,
+            pressed_at: -10,
+            jumped: false,
+        }
+    }
+    fn points(&self, position: Vec3) -> Vec<Vec3> {
+        if let Some(path) = &self.path {
+            return path.points.clone();
+        }
+        if let Control::Passage(p) = &self.steering
+            && p.route().len() > 1
+        {
+            return p.route().to_vec();
+        }
+        vec![position, self.steering.target()]
+    }
+    fn landing(&self) -> Vec3 {
+        self.path
+            .as_ref()
+            .map_or_else(|| self.steering.target(), |p| p.landing)
+    }
+}
+pub struct Gliding<T, S, AS, B, L> {
+    search: Search<T, S>,
+    create: GlideSearchFactory<T, S>,
+    airways: Airways<T, AS>,
+    contacts: Contacts,
+    glide: Option<Glide<B, L>>,
+    ticks: i32,
+    retry_at: i32,
+    should_fire_rocket: bool,
+    holds_rocket_slot: bool,
+    sprint: bool,
+    world: WorldProvider<L>,
+}
+impl<
+    T: Send + 'static,
+    S: OwnedTerrainSearch<T, Route = Route> + Send + 'static,
+    AS: OwnedTerrainSearch<T, Route = super::super::flight::FlyRoute> + Send + 'static,
+    B: TerrainState + 'static,
+    L: GlideLevel<B> + 'static,
+> Gliding<T, S, AS, B, L>
+{
+    pub fn new(
+        executor: Arc<dyn Executor>,
+        create: GlideSearchFactory<T, S>,
+        airway: AirwayFactory<T, AS>,
+        world: WorldProvider<L>,
+    ) -> Self {
+        Self {
+            search: BackgroundSearch::new(executor.clone()),
+            create,
+            airways: Airways::new(executor, airway),
+            contacts: Contacts::default(),
+            glide: None,
+            ticks: 0,
+            retry_at: 0,
+            should_fire_rocket: false,
+            holds_rocket_slot: false,
+            sprint: false,
+            world,
+        }
+    }
+    pub fn is_active(&self) -> bool {
+        self.glide.is_some()
+    }
+    pub fn sprint(&self) -> bool {
+        self.sprint
+    }
+    pub fn target(&self) -> Option<Vec3> {
+        self.glide.as_ref().map(Glide::landing)
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn navigate(
+        &mut self,
+        body: &mut impl GlideBody<State = B, Level = L>,
+        level: &mut impl ReplannerLevel<T>,
+        report: &mut impl GlideReport,
+        goal: Vec3,
+        radius: f64,
+        abilities: Option<GlideAbilities>,
+        direct: bool,
+        frame_y_rot: f32,
+    ) -> bool {
+        self.ticks = self.ticks.wrapping_add(1);
+        self.release_rocket_slot(body);
+        self.contacts.tick(&ContactAdapter(body), report);
+        if self.glide.is_some() {
+            self.retarget(body, goal, abilities)
+        } else {
+            self.glide = self.start(body, level, goal, radius, abilities, direct)
+        }
+        let Some(mut glide) = self.glide.take() else {
+            return false;
+        };
+        if !self.fly(body, report, &mut glide, frame_y_rot) {
+            return false;
+        }
+        if let Control::Passage(passage) = &mut glide.steering {
+            passage.lands_at_target = has_ground(body, goal);
+            self.airways.tick(
+                passage,
+                level,
+                goal,
+                radius,
+                || body.player().position(),
+                || body.glide_clearance(),
+            );
+        }
+        self.steer(body, &mut glide);
+        self.use_rocket(body);
+        self.glide = Some(glide);
+        true
+    }
+    pub fn halt(&mut self, body: &mut impl GlideBody) {
+        self.search.cancel();
+        self.airways.reset();
+        self.glide = None;
+        self.should_fire_rocket = false;
+        self.sprint = false;
+        self.release_rocket_slot(body);
+    }
+    pub fn block_changed(&mut self, pos: BlockPos) {
+        self.search.block_changed(pos);
+        self.airways.block_changed(pos)
+    }
+    pub fn level_changed(&mut self) {
+        self.search.level_changed();
+        self.airways.level_changed()
+    }
+    fn retarget(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        goal: Vec3,
+        abilities: Option<GlideAbilities>,
+    ) {
+        let glide = self.glide.as_ref().expect("active glide");
+        if abilities.is_none()
+            || body.player().on_ground()
+            || glide.goal.distance_sqr(goal) <= 1.5 * 1.5
+        {
+            return;
+        }
+        let opened = glide.has_opened;
+        self.glide = Some(self.passage(
+            body,
+            goal,
+            abilities.expect("checked glide equipment"),
+            opened,
+        ));
+    }
+    fn start(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        level: &mut impl ReplannerLevel<T>,
+        goal: Vec3,
+        radius: f64,
+        abilities: Option<GlideAbilities>,
+        direct: bool,
+    ) -> Option<Glide<B, L>> {
+        let Some(abilities) = abilities else {
+            self.search.cancel();
+            return None;
+        };
+        if !body.player().on_ground()
+            && self.ticks >= self.retry_at
+            && (body.player().is_fall_flying() || is_falling_far(body))
+        {
+            return Some(self.passage(body, goal, abilities, body.player().is_fall_flying()));
+        }
+        if body.player().is_fall_flying() {
+            return None;
+        }
+        let glide = self
+            .cruise(body, goal, abilities, direct)
+            .or_else(|| self.planned(body, level, goal, abilities));
+        if glide.is_none() {
+            self.plan_if_useful(body, level, goal, radius, abilities, direct)
+        }
+        glide
+    }
+    fn cruise(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        goal: Vec3,
+        abilities: GlideAbilities,
+        direct: bool,
+    ) -> Option<Glide<B, L>> {
+        if direct
+            || self.ticks < self.retry_at
+            || !body.player().on_ground()
+            || body.level().has_ceiling()
+        {
+            return None;
+        }
+        let start = body.player().position();
+        let distance = horizontal_distance(start, goal);
+        let loaded = body.level().has_chunk_at(BlockPos::containing(goal));
+        if distance < 16.0 || distance <= 192.0 && loaded {
+            return None;
+        }
+        let mut heights = LiveHeights::<B, L> {
+            world: self.world.clone(),
+            marker: PhantomData,
+        };
+        let climb = cruise_altitude(start, goal, &mut heights) - start.y;
+        if abilities.rockets < rockets_needed(distance, climb, abilities.rocket_ticks) {
+            return None;
+        }
+        self.search.cancel();
+        let rockets = Rockets::new(abilities.rockets, abilities.rocket_ticks);
+        let ceiling = body.level().max_y();
+        let world = self.world.clone();
+        let fallback: Fallback = Box::new(move |position| ground_near::<B, L>(&world, position));
+        Some(Glide::new(
+            goal,
+            Control::Cruise(Box::new(Cruise::new(
+                goal, heights, rockets, ceiling, fallback,
+            ))),
+            None,
+        ))
+    }
+    fn planned(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        level: &mut impl ReplannerLevel<T>,
+        goal: Vec3,
+        abilities: GlideAbilities,
+    ) -> Option<Glide<B, L>> {
+        match self.search.poll(&mut StoredLevel::new(level)) {
+            Outcome::Searching => None,
+            Outcome::Found(path) => {
+                self.search.cancel();
+                if body.player().on_ground()
+                    && path.start.distance_sqr(body.player().position()) < 1.0
+                {
+                    let rockets = Rockets::new(path.rockets, abilities.rocket_ticks);
+                    Some(Glide::new(
+                        goal,
+                        Control::Landing(Landing::new(goal, rockets, path.approach)),
+                        Some(path),
+                    ))
+                } else {
+                    None
+                }
+            }
+            Outcome::AlreadyThere | Outcome::Failed(_) => {
+                self.search.cancel();
+                self.retry_at = self.ticks.wrapping_add(40);
+                None
+            }
+        }
+    }
+    #[allow(clippy::too_many_arguments)]
+    fn plan_if_useful(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        level: &mut impl ReplannerLevel<T>,
+        goal: Vec3,
+        radius: f64,
+        abilities: GlideAbilities,
+        direct: bool,
+    ) {
+        if !self.search.is_idle()
+            || self.ticks < self.retry_at
+            || direct
+            || !body.player().on_ground()
+        {
+            return;
+        }
+        let start = body.player().position();
+        let distance = horizontal_distance(start, goal);
+        let drop = start.y - goal.y;
+        if distance < 16.0 || distance > 192.0 || drop < 6.0 && abilities.rockets == 0 {
+            return;
+        }
+        let create = self.create.clone();
+        let factory: SearchFactory<SearchSlot<T, S>, StoredWorker> = Arc::new(move |slot| {
+            slot.initialize(|terrain| create(terrain, start, goal, radius, abilities))
+        });
+        self.search.request(
+            &mut StoredLevel::new(level),
+            (BlockPos::containing(start), goal),
+            region(start, goal),
+            factory,
+        );
+    }
+    fn fly(
+        &mut self,
+        body: &mut impl GlideBody,
+        report: &mut impl GlideReport,
+        glide: &mut Glide<B, L>,
+        frame_y_rot: f32,
+    ) -> bool {
+        glide.ticks = glide.ticks.wrapping_add(1);
+        if body.player().is_fall_flying() && !body.player().on_ground() {
+            glide.has_opened = true
+        } else if glide.has_opened && body.player().on_ground()
+            || !glide.has_opened && glide.ticks > 24
+        {
+            if !glide.has_opened {
+                self.retry_at = self.ticks.wrapping_add(40)
+            }
+            self.halt(body);
+            return false;
+        }
+        let jump = if body.player().is_fall_flying() {
+            false
+        } else if body.player().on_ground() {
+            true
+        } else {
+            press_to_open(glide)
+        };
+        glide.jumped = jump;
+        let direction = if glide.has_opened {
+            Input::EMPTY
+        } else {
+            directional_input(sub(glide.goal, body.player().position()), frame_y_rot)
+        };
+        body.press(direction.with_keys(jump, false, false), true);
+        self.sprint = !glide.has_opened;
+        report.blocks_empty();
+        let points = glide.points(body.player().position());
+        report.following(&points, glide.landing());
+        true
+    }
+    fn steer(&mut self, body: &mut impl GlideBody, glide: &mut Glide<B, L>) {
+        if body.player().is_fall_flying() {
+            let input = glide.steering.steer(
+                body.player().position(),
+                body.player().delta_movement(),
+                self.world.clone(),
+            );
+            self.should_fire_rocket = input.should_fire_rocket;
+            body.look(input.y_rot, input.x_rot, GlideLook::Steer);
+        } else {
+            let offset = sub(glide.goal, body.player().position());
+            body.look(vector_yaw(offset.x, offset.z), 0.0, GlideLook::Movement);
+        }
+    }
+    fn use_rocket(&mut self, body: &mut impl GlideBody) {
+        if !self.should_fire_rocket {
+            return;
+        }
+        self.should_fire_rocket = false;
+        if body.player().offhand_item().is_firework_rocket() {
+            body.use_item(GlideHand::Off);
+            return;
+        }
+        let inventory = body.player().inventory();
+        let Some(slot) = (0..9).find(|&i| inventory.item(i).is_firework_rocket()) else {
+            return;
+        };
+        body.select_hotbar_slot(slot);
+        self.holds_rocket_slot = true;
+        body.use_item(GlideHand::Main);
+    }
+    fn release_rocket_slot(&mut self, body: &mut impl GlideBody) {
+        if self.holds_rocket_slot {
+            self.holds_rocket_slot = false;
+            body.release_hotbar_slot()
+        }
+    }
+    fn passage(
+        &mut self,
+        body: &impl GlideBody<State = B, Level = L>,
+        goal: Vec3,
+        abilities: GlideAbilities,
+        opened: bool,
+    ) -> Glide<B, L> {
+        self.search.cancel();
+        self.airways.reset();
+        let rockets = Rockets::new(abilities.rockets, abilities.rocket_ticks);
+        let clearance = body.glide_clearance();
+        let steering = Passage::new(goal, rockets, clearance, has_ground(body, goal));
+        let mut glide = Glide::new(goal, Control::Passage(steering), None);
+        glide.has_opened = opened;
+        glide
+    }
+}
+fn press_to_open<B: TerrainState, L: GlideLevel<B>>(glide: &mut Glide<B, L>) -> bool {
+    if glide.jumped || glide.ticks.wrapping_sub(glide.pressed_at) < 10 {
+        return false;
+    }
+    glide.pressed_at = glide.ticks;
+    true
+}
+fn has_ground<B: TerrainState, L: GlideLevel<B>>(
+    body: &impl GlideBody<State = B, Level = L>,
+    goal: Vec3,
+) -> bool {
+    Terrain::player(body.level()).is_standable(BlockPos::containing(goal))
+}
+fn is_falling_far(body: &impl GlideBody) -> bool {
+    if body.player().delta_movement().y >= 0.0 {
+        return false;
+    }
+    let feet = body.player().block_position();
+    for depth in 0..=body.safe_fall().wrapping_add(1) {
+        let pos = feet.offset(0, depth.wrapping_neg(), 0);
+        let level = body.level();
+        let state = level.block_state(pos);
+        if !state.collision_shape(&body.level(), pos).is_empty() || state.has_liquid() {
+            return false;
+        }
+    }
+    true
+}
+fn ground_near<B: TerrainState, L: GlideLevel<B>>(
+    world: &WorldProvider<L>,
+    position: Vec3,
+) -> Option<Vec3> {
+    let mut best = None;
+    let mut distance = f64::MAX;
+    let x0 = position.x.floor() as i32;
+    let z0 = position.z.floor() as i32;
+    let mut heights = LiveHeights::<B, L> {
+        world: world.clone(),
+        marker: PhantomData,
+    };
+    for dx in (-96_i32..=96).step_by(8) {
+        for dz in (-96_i32..=96).step_by(8) {
+            let Some(top) = heights.top(x0.wrapping_add(dx), z0.wrapping_add(dz)) else {
+                continue;
+            };
+            let squared = f64::from(dx * dx + dz * dz);
+            if top > world().min_y() && f64::from(top) < position.y && squared < distance {
+                best = Some(Vec3::new(
+                    f64::from(x0.wrapping_add(dx)) + 0.5,
+                    f64::from(top),
+                    f64::from(z0.wrapping_add(dz)) + 0.5,
+                ));
+                distance = squared
+            }
+        }
+    }
+    best
+}
+struct ContactAdapter<'a, B>(&'a B);
+impl<B: GlideBody> ContactBody for ContactAdapter<'_, B> {
+    type Player = B::Player;
+    type State = B::State;
+    type Level = B::Level;
+    fn player(&self) -> &Self::Player {
+        self.0.player()
+    }
+    fn live_level(&self) -> Self::Level {
+        self.0.level()
+    }
+    fn direction_hash(&self, d: super::super::aabb::Direction) -> i32 {
+        self.0.direction_hash(d)
+    }
+}
