+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::super::{aabb::Aabb, geometry::Vec3, input::Input, terrain::TerrainLevel};
+use super::{moves::RideState, vehicle::VehicleEntity};
+
+pub trait RideEntity: VehicleEntity + Clone {
