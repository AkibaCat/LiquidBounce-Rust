+++ b/crates/horizon-client-render/src/gfx/totem-effect.wgsl
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+override FRAME_LINEAR: bool = false;
+struct MeshOut{@builtin(position)position:vec4<f32>,@location(0)color:vec4<f32>,@location(1)uv:vec2<f32>,@location(2)inner_color:vec4<f32>,@location(3)@interpolate(flat)params:vec4<f32>}
+@vertex fn mesh(@location(0)clip:vec4<f32>,@location(1)color:vec4<f32>,@location(2)uv:vec2<f32>,@location(3)inner_color:vec4<f32>,@location(4)params:vec4<f32>)->MeshOut{return MeshOut(clip,color,uv,inner_color,params);}
+fn source_color(v:MeshOut)->vec4<f32>{
+    let dist=length(v.uv*2.-vec2(1.));let aa=max(fwidth(dist),0.0001);var color=v.color;
+    if u32(v.params.x+0.5)==2u{let inner=clamp(v.params.y,0.,1.);let outer_alpha=1.-smoothstep(-aa,0.,dist-1.);var inner_alpha=1.;if inner>0.{inner_alpha=1.-smoothstep(-aa,0.,inner-dist);}let t=clamp((dist-inner)/max(1.-inner,0.0001),0.,1.);color=mix(v.inner_color,v.color,t);color.a*=outer_alpha*inner_alpha;}return color;
+}
+@fragment fn capture(v:MeshOut)->@location(0)vec4<f32>{let color=source_color(v);if color.a<=0.001{discard;}return color;}
+@fragment fn plain(v:MeshOut)->@location(0)vec4<f32>{var color=source_color(v);if color.a<=0.001{discard;}if FRAME_LINEAR{color=vec4(pow(max(color.rgb,vec3(0.)),vec3(2.2)),color.a);}return color;}
+struct ScreenOut {@builtin(position) position:vec4<f32>,@location(0) uv:vec2<f32>}
+fn screen_vertex(i:u32)->ScreenOut{let p=array<vec2<f32>,3>(vec2(-1.0,-1.0),vec2(3.0,-1.0),vec2(-1.0,3.0))[i];var o:ScreenOut;o.position=vec4(p.x,-p.y,0.0,1.0);o.uv=p*0.5+0.5;return o;}
+@vertex fn screen(@builtin(vertex_index) i:u32)->ScreenOut{return screen_vertex(i);}
+@vertex fn composite_screen(@builtin(vertex_index) i:u32)->ScreenOut{var o=screen_vertex(i);o.position.y = -o.position.y;return o;}
+@group(0) @binding(3) var styled:texture_2d<f32>;
+@fragment fn composite(i:ScreenOut)->@location(0) vec4<f32>{let size=textureDimensions(styled);let p=clamp(vec2<i32>(i.uv*vec2<f32>(size)),vec2(0),vec2<i32>(size)-1);var c=textureLoad(styled,p,0);if FRAME_LINEAR{c=vec4(pow(max(c.rgb,vec3(0.0)),vec3(2.2)),c.a);}return c;}
+
+@fragment fn flip_capture(i:ScreenOut)->@location(0)vec4<f32>{let size=textureDimensions(styled);let p=clamp(vec2<i32>(i.uv*vec2<f32>(size)),vec2(0),vec2<i32>(size)-1);return textureLoad(styled,p,0);}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/aura.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/aura.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/aura.frag
@@ -0,0 +1,66 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+#define RADIUS Params0.x
+#define HEIGHT Params0.y
+#define SWAY Params0.z
+#define SCALE Params0.w
+#define SPEED Params1.x
+#define INTENSITY Params1.y
+#define HEAT Params1.z
+#define FILL Params1.w
+
+// World axes of the camera, and in Lens.xy the tangents of half its horizontal and vertical field of view
+layout(std140) uniform EffectView {
+    vec4 Right;
+    vec4 Up;
+    vec4 Forward;
+    vec4 Lens;
+};
+
+// Blocks after which the noise repeats, keeps its coordinates small
+const int WRAP = 256;
+
+// Screen heights a block of camera movement moves the noise, right for a silhouette about 4 blocks away
+const float PARALLAX = 0.18;
+
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    ivec2 size = textureSize(InSampler, 0);
+    vec2 pixel = texCoord * vec2(size);
+
+    vec4 own = texelFetch(InSampler, pixelAt(texCoord, size), 0);
+    if (fieldDistance(own) == 0.0) {
+        fragColor = glow(fieldColor(own), FILL * fieldStrength(own));
+        return;
+    }
+
+    // Noise stretched upwards and drifting up. Every pixel takes the glow from below it, as far down as the noise
+    // says, so the glow rises off the silhouette in tongues. The noise lies in the world, on a sphere around the
+    // camera that is one focal length wide in pixels, so turning and walking leave it where the silhouette is instead
+    // of dragging it over the screen.
+    vec2 ndc = texCoord * 2.0 - 1.0;
+    vec3 ray = normalize(Forward.xyz + Right.xyz * (ndc.x * Lens.x) + Up.xyz * (ndc.y * Lens.y));
+    vec3 camera = vec3(CameraBlockPos & (WRAP - 1)) - CameraOffset;
+    vec3 q = (ray * (0.5 / Lens.y) + camera * PARALLAX) * float(size.y) / SCALE;
+    q.y = q.y * 0.5 - Time * SPEED;
+    float lift = smoothstep(0.25, 0.75, fbm(q));
+    float sway = fbm(q + vec3(5.2, 1.3, 2.8)) * 2.0 - 1.0;
+    vec2 offset = vec2(sway * SWAY, -lift * HEIGHT);
+
+    vec4 field = texelFetch(InSampler, clamp(ivec2(pixel + offset), ivec2(0), size - 1), 0);
+    float dist = fieldDistance(field);
+    if (dist >= NONE) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    float k = 1.0 - clamp(edgeOf(dist) / RADIUS, 0.0, 1.0);
+    fragColor = glow(mix(fieldColor(field), vec3(1.0), HEAT * k * k * k), INTENSITY * k * k * fieldStrength(field));
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/chromatic.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/chromatic.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/chromatic.frag
@@ -0,0 +1,52 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+#define WIDTH Params0.x
+#define SPLIT Params0.y
+#define SPEED Params0.z
+#define TINT Params0.w
+#define GLOW_RADIUS Params1.x
+#define FILL Params1.y
+
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+ivec2 size;
+
+vec4 fieldAt(vec2 pixel) {
+    return texelFetch(InSampler, clamp(ivec2(pixel), ivec2(0), size - 1), 0);
+}
+
+float lineAt(vec2 pixel) {
+    float dist = fieldDistance(fieldAt(pixel));
+    if (dist <= 0.0 || dist >= NONE) {
+        return 0.0;
+    }
+
+    float edge = edgeOf(dist);
+    float t = max(edge - WIDTH, 0.0) / max(GLOW_RADIUS, 0.001);
+    return max(band(edge, WIDTH, 1.0), 0.5 * exp(-3.0 * t * t));
+}
+
+void main() {
+    size = textureSize(InSampler, 0);
+    vec2 pixel = texCoord * vec2(size);
+    vec2 offset = vec2(cos(Time * SPEED), sin(Time * SPEED)) * SPLIT;
+
+    vec4 center = fieldAt(pixel);
+    float centerDistance = fieldDistance(center);
+    if (centerDistance == 0.0) {
+        fragColor = glow(fieldColor(center), FILL * fieldStrength(center));
+        return;
+    }
+
+    vec3 split = vec3(lineAt(pixel + offset), lineAt(pixel), lineAt(pixel - offset));
+    float alpha = max(split.r, max(split.g, split.b));
+    bool inRange = centerDistance < NONE;
+    vec3 tint = mix(vec3(1.0), inRange ? fieldColor(center) : vec3(1.0), TINT);
+    fragColor = glow(split * tint / max(alpha, 0.0001), alpha * (inRange ? fieldStrength(center) : 1.0));
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/effect.glsl b/crates/horizon-client-render/src/gfx/totem-effect-shaders/effect.glsl
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/effect.glsl
@@ -0,0 +1,138 @@
+#include <minecraft:globals.glsl>
+
+layout(std140) uniform EffectData {
+    vec4 Params0;
+    vec4 Params1;
+    vec4 Accent;
+    float Range;
+    float Opacity;
+};
+
+// Seconds of game time, wrapping with the day
+#define Time (GameTime * 1200.0)
+
+// Distance of pixels farther than Range from every silhouette
+const float NONE = 1024.0;
+
+// The field target keeps sqrt(distance / FIELD_LIMIT), which leaves sub-pixel steps near the silhouettes in 8 bits
+const float FIELD_LIMIT = 128.0;
+
+// A field texel holds the nearest silhouette pixel: its color as 5-6-5 bits in rg, its alpha in b and the distance
+// to it in a
+
+const float TAU = 6.28318530718;
+
+ivec2 pixelAt(vec2 uv, ivec2 size) {
+    return clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
+}
+
+vec3 packSilhouette(vec4 silhouette) {
+    // Translucent geometry is blended into the target, which leaves its color premultiplied
+    ivec3 color = ivec3(clamp(silhouette.rgb / silhouette.a, 0.0, 1.0) * vec3(31.0, 63.0, 31.0) + 0.5);
+    // Antialiased edges of thin shapes only half cover their pixels and would weaken the effect drawn from them
+    float strength = min(silhouette.a * 2.0, 1.0);
+    return vec3(vec2((color.r << 3) | (color.g >> 3), ((color.g & 7) << 5) | color.b) / 255.0, strength);
+}
+
+vec3 fieldColor(vec4 texel) {
+    ivec2 bits = ivec2(texel.rg * 255.0 + 0.5);
+    return vec3(bits.x >> 3, ((bits.x & 7) << 3) | (bits.y >> 5), bits.y & 31) / vec3(31.0, 63.0, 31.0);
+}
+
+// Alpha of the nearest silhouette pixel, which geometry fades itself out with
+float fieldStrength(vec4 texel) {
+    return texel.b;
+}
+
+vec4 encodeField(vec3 silhouette, float dist) {
+    return dist >= NONE ? vec4(0.0, 0.0, 0.0, 1.0) : vec4(silhouette, min(sqrt(dist / FIELD_LIMIT), 254.0 / 255.0));
+}
+
+float fieldDistance(vec4 texel) {
+    return texel.a >= 1.0 ? NONE : texel.a * texel.a * FIELD_LIMIT;
+}
+
+// Field distances run between pixel centers, the silhouette edge lies half a pixel off the covered ones
+float edgeOf(float dist) {
+    return dist - 0.5;
+}
+
+// Coverage of a line from the silhouette edge out to width
+float band(float edge, float width, float softness) {
+    float half_soft = max(softness, 0.05) * 0.5;
+    return 1.0 - smoothstep(width - half_soft, width + half_soft, edge);
+}
+
+// The game blends the outline target onto the scene with straight alpha
+vec4 glow(vec3 color, float alpha) {
+    return vec4(color, clamp(alpha * Opacity, 0.0, 1.0));
+}
+
+vec3 hsv2rgb(vec3 c) {
+    vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
+    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
+}
+
+float hash12(vec2 p) {
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+float valueNoise(vec2 p) {
+    vec2 i = floor(p);
+    vec2 f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    return mix(
+        mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),
+        mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x),
+        u.y
+    );
+}
+
+float hash13(vec3 p) {
+    p = fract(p * 0.1031);
+    p += dot(p, p.zyx + 31.32);
+    return fract((p.x + p.y) * p.z);
+}
+
+float valueNoise(vec3 p) {
+    vec3 i = floor(p);
+    vec3 f = fract(p);
+    vec3 u = f * f * (3.0 - 2.0 * f);
+    return mix(
+        mix(
+            mix(hash13(i), hash13(i + vec3(1.0, 0.0, 0.0)), u.x),
+            mix(hash13(i + vec3(0.0, 1.0, 0.0)), hash13(i + vec3(1.0, 1.0, 0.0)), u.x),
+            u.y
+        ),
+        mix(
+            mix(hash13(i + vec3(0.0, 0.0, 1.0)), hash13(i + vec3(1.0, 0.0, 1.0)), u.x),
+            mix(hash13(i + vec3(0.0, 1.0, 1.0)), hash13(i + vec3(1.0, 1.0, 1.0)), u.x),
+            u.y
+        ),
+        u.z
+    );
+}
+
+float fbm(vec3 p) {
+    float value = 0.0;
+    float amplitude = 0.5;
+    for (int i = 0; i < 4; i++) {
+        value += amplitude * valueNoise(p);
+        p = p * 2.03 + vec3(17.0, 9.0, 13.0);
+        amplitude *= 0.5;
+    }
+    return value;
+}
+
+float fbm(vec2 p) {
+    float value = 0.0;
+    float amplitude = 0.5;
+    for (int i = 0; i < 4; i++) {
+        value += amplitude * valueNoise(p);
+        p = p * 2.03 + vec2(17.0, 9.0);
+        amplitude *= 0.5;
+    }
+    return value;
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_columns.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_columns.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_columns.frag
@@ -0,0 +1,54 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+// Output of field_rows
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+float rowDistance(vec4 texel) {
+    return texel.a >= 1.0 ? NONE : floor(texel.a * 255.0 + 0.5);
+}
+
+// The nearest covered pixel and the euclidean distance to it, see encodeField
+void main() {
+    ivec2 size = textureSize(InSampler, 0);
+    ivec2 p = pixelAt(texCoord, size);
+
+    vec4 center = texelFetch(InSampler, p, 0);
+    float centerDistance = rowDistance(center);
+    float best = centerDistance * centerDistance;
+    vec3 silhouette = center.rgb;
+
+    int range = int(ceil(Range));
+    for (int i = 1; i <= range; i++) {
+        float dy2 = float(i * i);
+        if (dy2 >= best) {
+            break;
+        }
+
+        if (p.y + i < size.y) {
+            vec4 up = texelFetch(InSampler, ivec2(p.x, p.y + i), 0);
+            float dx = rowDistance(up);
+            if (dx < NONE && dx * dx + dy2 < best) {
+                best = dx * dx + dy2;
+                silhouette = up.rgb;
+            }
+        }
+
+        if (p.y - i >= 0) {
+            vec4 down = texelFetch(InSampler, ivec2(p.x, p.y - i), 0);
+            float dx = rowDistance(down);
+            if (dx < NONE && dx * dx + dy2 < best) {
+                best = dx * dx + dy2;
+                silhouette = down.rgb;
+            }
+        }
+    }
+
+    float dist = sqrt(best);
+    fragColor = encodeField(silhouette, dist <= Range + 0.5 ? dist : NONE);
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_rows.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_rows.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/field_rows.frag
@@ -0,0 +1,43 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+// Silhouettes in their color, premultiplied where translucent geometry was blended in
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+// The nearest covered pixel in the same row as packSilhouette, its distance in whole pixels / 255 in alpha
+void main() {
+    ivec2 size = textureSize(InSampler, 0);
+    ivec2 p = pixelAt(texCoord, size);
+
+    vec4 center = texelFetch(InSampler, p, 0);
+    if (center.a > 0.0) {
+        fragColor = vec4(packSilhouette(center), 0.0);
+        return;
+    }
+
+    int range = int(ceil(Range));
+    for (int i = 1; i <= range; i++) {
+        if (p.x - i >= 0) {
+            vec4 left = texelFetch(InSampler, ivec2(p.x - i, p.y), 0);
+            if (left.a > 0.0) {
+                fragColor = vec4(packSilhouette(left), float(i) / 255.0);
+                return;
+            }
+        }
+
+        if (p.x + i < size.x) {
+            vec4 right = texelFetch(InSampler, ivec2(p.x + i, p.y), 0);
+            if (right.a > 0.0) {
+                fragColor = vec4(packSilhouette(right), float(i) / 255.0);
+                return;
+            }
+        }
+    }
+
+    fragColor = vec4(0.0, 0.0, 0.0, 1.0);
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/halftone.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/halftone.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/halftone.frag
@@ -0,0 +1,47 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+// Range: how far the dots reach
+#define CELL Params0.x
+#define DOT_SCALE Params0.y
+#define FILL Params0.z
+#define EDGE_WIDTH Params0.w
+
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+// Halftone screens sit at 45 degrees
+const mat2 SCREEN = mat2(0.70710678, -0.70710678, 0.70710678, 0.70710678);
+
+void main() {
+    ivec2 size = textureSize(InSampler, 0);
+    vec2 pixel = texCoord * vec2(size);
+
+    vec2 screen = SCREEN * pixel;
+    vec2 cellCenter = (floor(screen / CELL) + 0.5) * CELL;
+    vec4 cell = texelFetch(InSampler, clamp(ivec2(transpose(SCREEN) * cellCenter), ivec2(0), size - 1), 0);
+    vec4 own = texelFetch(InSampler, pixelAt(texCoord, size), 0);
+    float cellDistance = fieldDistance(cell);
+    float ownDistance = fieldDistance(own);
+
+    float strength = 0.0;
+    if (cellDistance == 0.0) {
+        strength = FILL;
+    } else if (cellDistance < NONE) {
+        float k = 1.0 - clamp(edgeOf(cellDistance) / Range, 0.0, 1.0);
+        strength = k * k;
+    }
+
+    float radius = 0.5 * CELL * DOT_SCALE * sqrt(strength);
+    float dotCoverage = 1.0 - smoothstep(radius - 0.6, radius + 0.6, length(screen - cellCenter));
+    bool outside = ownDistance > 0.0 && ownDistance < NONE;
+    float line = outside && EDGE_WIDTH > 0.0 ? band(edgeOf(ownDistance), EDGE_WIDTH, 1.0) : 0.0;
+
+    float alpha = max(dotCoverage * step(0.001, strength), line);
+    vec4 nearest = cellDistance < NONE ? cell : own;
+    fragColor = glow(fieldColor(nearest), alpha * fieldStrength(nearest));
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/hologram.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/hologram.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/hologram.frag
@@ -0,0 +1,42 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+// Accent: stripe color
+#define SPACING Params0.x
+#define DIRECTION Params0.yz
+#define SPEED Params0.w
+#define STRIPES Params1.x
+#define FILL Params1.y
+#define EDGE_WIDTH Params1.z
+#define FLICKER Params1.w
+
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    ivec2 size = textureSize(InSampler, 0);
+    vec4 field = texelFetch(InSampler, pixelAt(texCoord, size), 0);
+    float dist = fieldDistance(field);
+    if (dist >= NONE) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    float flicker = 1.0 - FLICKER * hash12(vec2(floor(Time * 12.0), 7.0));
+
+    if (dist == 0.0) {
+        vec2 pixel = texCoord * vec2(size);
+        float wave = 0.5 + 0.5 * sin((dot(pixel, DIRECTION) / SPACING - Time * SPEED) * TAU);
+        float stripe = pow(wave, 6.0) * STRIPES;
+        fragColor = glow(mix(fieldColor(field), Accent.rgb, stripe), (FILL + stripe) * flicker * fieldStrength(field));
+        return;
+    }
+
+    float edge = edgeOf(dist);
+    float alpha = max(band(edge, EDGE_WIDTH, 1.0), 0.35 * exp(-edge / 2.0));
+    fragColor = glow(fieldColor(field), alpha * flicker * fieldStrength(field));
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/neon.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/neon.frag
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/totem-effect-shaders/neon.frag
@@ -0,0 +1,42 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <liquidbounce:effect/effect.glsl>
+
+// Accent: core color
+#define CORE_WIDTH Params0.x
+#define BLOOM_RADIUS Params0.y
+#define BLOOM_INTENSITY Params0.z
+#define FILL Params0.w
+#define CORE_MIX Params1.x
+#define PULSE_SPEED Params1.y
+#define PULSE_AMOUNT Params1.z
+
+uniform sampler2D InSampler;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    vec4 field = texelFetch(InSampler, pixelAt(texCoord, textureSize(InSampler, 0)), 0);
+    float dist = fieldDistance(field);
+    if (dist >= NONE) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    float pulse = 1.0 - PULSE_AMOUNT * (0.5 + 0.5 * sin(Time * PULSE_SPEED * TAU));
+    if (dist == 0.0) {
+        fragColor = glow(fieldColor(field), FILL * pulse * fieldStrength(field));
+        return;
+    }
+
+    float edge = edgeOf(dist);
+    float core = band(edge, CORE_WIDTH, 1.0);
+    float bloom = clamp(BLOOM_INTENSITY * pulse * exp(-2.5 * edge / BLOOM_RADIUS), 0.0, 1.0) * (1.0 - core);
+
+    float alpha = core + bloom;
+    vec3 base = fieldColor(field);
+    vec3 color = (mix(base, Accent.rgb, CORE_MIX) * core + base * bloom) / max(alpha, 0.0001);
+    fragColor = glow(color, alpha * fieldStrength(field));
+}
diff --git a/crates/horizon-client-render/src/gfx/totem-effect-shaders/outline.frag b/crates/horizon-client-render/src/gfx/totem-effect-shaders/outline.frag
