--- /dev/null
+++ b/crates/horizon-client/src/game/target_renderer.rs
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::{
+    hud::{HudBatch, Rect},
+    text::Text,
+};
+use serde_json::{Value, json};
+thread_local! {static OVERLAY:std::cell::RefCell<Vec<Value>>=const{std::cell::RefCell::new(Vec::new())};}
+fn at(p: horizon_core::geometry::Vec3) -> [f64; 3] {
+    [p.x, p.y, p.z]
+}
+fn snapshot(
+    id: i32,
+    position: [f64; 3],
+    old: [f64; 3],
+    height: f64,
+    health: f32,
+    max: f32,
+    absorption: f32,
+    hurt: i32,
+    age: i32,
+    partial: f64,
+) -> Value {
+    json!({"id":id,"position":position,"interpolated":std::array::from_fn::<_,3,_>(|i|old[i]+(position[i]-old[i])*partial),"height":height,"health":health,"maxHealth":max,"absorption":absorption,"hurt":hurt,"age":age,"living":true})
+}
+fn native_color(argb: u32) -> u32 {
+    let [a, r, g, b] = argb.to_be_bytes();
+    u32::from_le_bytes([r, g, b, a])
+}
+fn line(
+    batch: &mut HudBatch,
+    atlas: &horizon_client::hud::HudAtlas,
+    a: [f32; 2],
+    b: [f32; 2],
+    color: u32,
+) {
+    let d = glam::Vec2::from_array(b) - glam::Vec2::from_array(a);
+    let n = glam::Vec2::new(-d.y, d.x).normalize_or_zero() * (0.5 / batch.scale);
+    let a = glam::Vec2::from_array(a);
+    let b = glam::Vec2::from_array(b);
+    batch.fill_quad(
+        atlas,
+        [
+            (a + n).to_array(),
+            (b + n).to_array(),
+            (b - n).to_array(),
+            (a - n).to_array(),
+        ],
+        native_color(color),
+    );
+}
+impl Game<'_> {
+    pub(super) fn client_target_renderer_errors(&mut self) {
+        if self.native_window() && self.native_client_slot_owner() {
+            if let Some(error) = horizon_client::gfx::target_renderer::take_error() {
+                horizon_client::mod_api::Host::chat(self, &error);
+            }
+        }
+    }
+    fn client_target_renderer_entity(&self, id: i32, partial: f64) -> Option<Value> {
+        if self.remote.as_ref().map_or(0, |r| r.entity_id) == id {
+            let p = self.player.as_ref()?;
+            return Some(snapshot(
+                id,
+                at(p.position),
+                at(self.previous_position),
+                f64::from(p.dimensions.height),
+                p.health.health(),
+                p.clone().attribute("minecraft:max_health").unwrap_or(20.) as f32,
+                p.health.absorption(),
+                p.health.hurt.hurt_time,
+                p.health.tick_count,
+                partial,
+            ));
+        }
+        if let Some(m) = self.mobs.iter().find(|m| !m.removed && m.id as i32 == id) {
+            return Some(snapshot(
+                id,
+                at(m.position),
+                at(m.previous),
+                f64::from(m.dims().1),
+                m.health,
+                horizon_client::mobs::finalize::max_health(m),
+                m.absorption,
+                m.hurt_time,
+                m.age as i32,
+                partial,
+            ));
+        }
+        if let Some(a) = self.armor_stands.iter().find(|a| a.id as i32 == id) {
+            return Some(snapshot(
+                id,
+                at(a.position),
+                at(a.previous),
+                if a.marker { 0. } else { a.probe_dimensions().1 },
+                a.health,
+                20.,
+                0.,
+                0,
+                a.liquidbounce_tick_count,
+                partial,
+            ));
+        }
+        if let Some(d) = self
+            .dragon
+            .as_ref()
+            .filter(|_| self.client_targeting_dragon_id() == id)
+        {
+            return Some(snapshot(
+                id,
+                at(d.position),
+                at(d.previous),
+                8.,
+                d.health,
+                200.,
+                0.,
+                d.hurt_time,
+                d.ticks,
+                partial,
+            ));
+        }
+        if let Some(g) = self
+            .lan
+            .iter()
+            .flat_map(|h| h.hub.guests.iter())
+            .find(|g| g.placed && g.dimension == self.dim.id() && g.entity_id == id)
+        {
+            let p = g.motion.as_ref()?;
+            return Some(snapshot(
+                id,
+                g.position,
+                g.previous_position,
+                f64::from(p.dimensions.height),
+                p.health.health(),
+                p.clone().attribute("minecraft:max_health").unwrap_or(20.) as f32,
+                p.health.absorption(),
+                p.health.hurt.hurt_time,
+                p.health.tick_count,
+                partial,
+            ));
+        }
+        None
+    }
+    pub(super) fn client_target_renderer_frame(&self, partial: f64) {
+        OVERLAY.with_borrow_mut(Vec::clear);
+        horizon_client::gfx::target_renderer::begin_frame("null");
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let mut ids = String::new();
+        self.native_client_target_renderer("{\"phase\":\"targets\"}", &mut ids);
+        let Ok(ids) = serde_json::from_str::<Vec<i32>>(&ids) else {
+            return;
+        };
+        let entities = ids
+            .into_iter()
+            .filter_map(|id| self.client_target_renderer_entity(id, partial))
+            .collect::<Vec<_>>();
+        let q = self.camera_orientation();
+        let right = q * glam::Vec3::X;
+        let up = q * glam::Vec3::Y;
+        let forward = q * glam::Vec3::NEG_Z;
+        let yaw = (-forward.x).atan2(forward.z).to_degrees();
+        let pitch = (-forward.y).clamp(-1., 1.).asin().to_degrees();
+        let input=json!({"phase":"frame","playerPosition":self.player.as_ref().map(|p|{let old=self.previous_position;[old.x+(p.position.x-old.x)*partial,old.y+(p.position.y-old.y)*partial,old.z+(p.position.z-old.z)*partial]}),"partial":partial,"entities":entities,"right":right.to_array(),"up":up.to_array(),"yaw":yaw,"pitch":pitch}).to_string();
+        let mut geometry = String::new();
+        self.native_client_target_renderer(&input, &mut geometry);
+        if let Ok(frame) = serde_json::from_str::<Value>(&geometry) {
+            OVERLAY.with_borrow_mut(|out| {
+                *out = frame["overlay"].as_array().cloned().unwrap_or_default()
+            });
+        }
+        horizon_client::gfx::target_renderer::begin_frame(&geometry);
+    }
+    pub(super) fn client_target_renderer_overlay(&self, batch: &mut HudBatch) {
+        let Some(camera) = self.native_camera() else {
+            return;
+        };
+        let matrix = glam::Mat4::from_cols_array(&camera.projection)
+            * glam::Mat4::from_cols_array(&camera.view);
+        OVERLAY.with_borrow(|overlays| {
+            for o in overlays {
+                let Ok(pos) = serde_json::from_value::<[f64; 3]>(o["position"].clone()) else {
+                    continue;
+                };
+                let clip = matrix
+                    * glam::Vec4::new(
+                        (pos[0] - camera.position[0]) as f32,
+                        (pos[1] - camera.position[1]) as f32,
+                        (pos[2] - camera.position[2]) as f32,
+                        1.,
+                    );
+                if !clip.is_finite() || clip.w <= 0. {
+                    continue;
+                }
+                let screen = [
+                    (clip.x / clip.w + 1.) * batch.width * 0.5,
+                    (-clip.y / clip.w + 1.) * batch.height * 0.5,
+                ];
+                let scale = o["scale"].as_f64().unwrap_or(1.) as f32;
+                let color = o["color"].as_i64().unwrap_or(-1) as u32;
+                if o["arrow"] == true {
+                    let [a, b, c] = [
+                        [screen[0] - 5. * scale, screen[1] - 10. * scale],
+                        screen,
+                        [screen[0] + 5. * scale, screen[1] - 10. * scale],
+                    ];
+                    if color >> 24 != 0 {
+                        batch.fill_quad(&self.gui.atlas, [a, b, c, c], native_color(color));
+                    }
+                    let outline = o["outline"].as_i64().unwrap_or(0) as u32;
+                    if outline >> 24 != 0 {
+                        for (a, b) in [(a, b), (b, c), (c, a)] {
+                            line(batch, &self.gui.atlas, a, b, outline);
+                        }
+                    }
+                    continue;
+                }
+                let (ascent, height) = self.gui.atlas.font.liquidbounce_target_metrics();
+                let shadow = o["shadow"] == true;
+                for (i, text) in o["text"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter_map(Value::as_str)
+                    .enumerate()
+                {
+                    let text = Text::literal(text).resolve_legacy();
+                    let glyphs = text
+                        .spans
+                        .iter()
+                        .flat_map(|span| span.text.chars().map(move |c| (c, &span.style)))
+                        .map(|(c, style)| {
+                            (
+                                self.gui
+                                    .atlas
+                                    .font
+                                    .liquidbounce_target_glyph(c, style.bold == Some(true)),
+                                style,
+                            )
+                        })
+                        .collect::<Vec<_>>();
+                    let width = glyphs.iter().map(|(g, _)| g.advance).sum::<f32>()
+                        + if shadow { 2. } else { 0. };
+                    let left = screen[0] - width * scale * 0.5;
+                    let baseline =
+                        screen[1] + i as f32 * height - height * scale * 0.5 + ascent * scale;
+                    for is_shadow in [true, false] {
+                        if is_shadow && !shadow {
+                            continue;
+                        }
+                        let mut x = left + if is_shadow { 2. * scale } else { 0. };
+                        let y = baseline + if is_shadow { 2. * scale } else { 0. };
+                        for (g, style) in &glyphs {
+                            let fill = if is_shadow {
+                                0x96000000
+                            } else {
+                                (color & 0xff000000) | style.color.unwrap_or(color & 0xffffff)
+                            };
+                            if let Some(Rect { u0, v0, u1, v1, .. }) = g.rect {
+                                let shear = if style.italic == Some(true) { 0.2 } else { 0. };
+                                let x0 = x + g.left * scale;
+                                let x1 = x + g.right * scale;
+                                let y0 = y + g.top * scale;
+                                let y1 = y + g.bottom * scale;
+                                let top = -g.top * scale * shear;
+                                let bottom = -g.bottom * scale * shear;
+                                batch.quad(
+                                    [
+                                        [x0 + top, y0],
+                                        [x1 + top, y0],
+                                        [x1 + bottom, y1],
+                                        [x0 + bottom, y1],
+                                    ],
+                                    [[u0, v0], [u1, v0], [u1, v1], [u0, v1]],
+                                    native_color(fill),
+                                );
+                            }
+                            if style.underlined == Some(true) {
+                                self.native_fill(
+                                    batch,
+                                    [x, y + 2. * scale, g.advance * scale, scale],
+                                    fill,
+                                );
+                            }
+                            if style.strikethrough == Some(true) {
+                                self.native_fill(
+                                    batch,
+                                    [x, y - ascent * scale * 0.4, g.advance * scale, scale],
+                                    fill,
+                                );
+                            }
+                            x += g.advance * scale;
+                        }
+                    }
+                }
+            }
+        });
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/target_renderer.rs b/crates/horizon-client-render/src/gfx/target_renderer.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/target_renderer.rs
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The frozen Hats texture pipeline, with immutable builtin PNGs and scene depth.
+use glam::{DVec3, Mat4};
+use std::cell::RefCell;
+use wgpu::util::DeviceExt;
+#[derive(Clone,Debug,serde::Deserialize)]
+pub struct Quad{pub corners:[[f64;3];4],pub colors:[[f32;4];4],pub uv:[[f32;2];4],pub shape:u32,pub inner:f32,pub inner_color:[f32;4],pub texture:String,pub depth:bool}
+#[derive(Default,Debug,serde::Deserialize)]pub struct Frame{pub quads:Vec<Quad>}
+thread_local! {static PENDING:RefCell<Option<Frame>>=const{RefCell::new(None)};}
+pub fn begin_frame(input: &str) {
+    PENDING.with_borrow_mut(|p| *p = serde_json::from_str(input).ok());
+}
+#[repr(C)]
+#[derive(Clone, Copy, Debug, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct Vertex{pub clip:[f32;4],pub color:[f32;4],pub uv:[f32;2],pub inner_color:[f32;4],pub params:[f32;4]}
+pub fn vertices(q:&Quad,projection:Mat4,camera:DVec3)->Vec<Vertex>{let v:[Vertex;4]=std::array::from_fn(|i|Vertex{clip:(projection*(DVec3::from_array(q.corners[i])-camera).as_vec3().extend(1.)).to_array(),color:q.colors[i],uv:q.uv[i],inner_color:q.inner_color,params:[q.shape as f32,q.inner,u8::from(q.depth)as f32,0.]});[0,1,2,0,2,3].into_iter().map(|i|v[i]).collect()}
+thread_local!{static IMAGE_ERROR:RefCell<Option<String>>=const{RefCell::new(None)};}
+pub fn take_error()->Option<String>{IMAGE_ERROR.with_borrow_mut(Option::take)}
+include!("target_renderer-textures.rs");
+pub struct TargetRenderer {
+    pipeline:[wgpu::RenderPipeline;2],
+    layout: wgpu::BindGroupLayout,
+    sampler: wgpu::Sampler,
+    textures:std::collections::BTreeMap<String,(wgpu::Texture,wgpu::BindGroup)>,
+    selected_custom:Option<String>,
+    loading:Option<(String,std::sync::mpsc::Receiver<Result<(u32,u32,Vec<u8>),String>>)>,
+    custom_last:Option<String>,
+    pending: Vec<(String, wgpu::Buffer, u32, bool)>,
+}
+impl TargetRenderer {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat, linear: bool) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("TargetRenderer textures"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("TargetRenderer"),
+            bind_group_layouts: &[Some(&layout)],
+            ..Default::default()
+        });
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("TargetRenderer"),
+            source: wgpu::ShaderSource::Wgsl(include_str!("target_renderer.wgsl").into()),
+        });
+        let attrs = wgpu::vertex_attr_array![0=>Float32x4,1=>Float32x4,2=>Float32x2,3=>Float32x4,4=>Float32x4];
+        let constants = [(
+            "FRAME_LINEAR",
+            f64::from(u8::from(
+                linear && format == wgpu::TextureFormat::Rgba16Float,
+            )),
+        )];
+        let pipeline=std::array::from_fn(|depth|device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("TargetRenderer"),
+            layout: Some(&pipeline_layout),
+            vertex: wgpu::VertexState {
+                module: &shader,
+                entry_point: Some("mesh"),
+                compilation_options: Default::default(),
+                buffers: &[Some(wgpu::VertexBufferLayout {
+                    array_stride: 72,
+                    step_mode: wgpu::VertexStepMode::Vertex,
+                    attributes: &attrs,
+                })],
+            },
+            primitive: wgpu::PrimitiveState {
+                cull_mode: None,
+                ..Default::default()
+            },
+            depth_stencil:Some(wgpu::DepthStencilState{format:wgpu::TextureFormat::Depth32Float,depth_write_enabled:Some(depth==1),depth_compare:Some(if depth==1{wgpu::CompareFunction::GreaterEqual}else{wgpu::CompareFunction::Always}),stencil:Default::default(),bias:Default::default()}),
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &shader,
+                entry_point: Some("image_fragment"),
+                compilation_options: wgpu::PipelineCompilationOptions {
+                    constants: &constants,
+                    ..Default::default()
+                },
+                targets: &[Some(wgpu::ColorTargetState {
+                    format,
+                    blend: Some(wgpu::BlendState::ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+            }),
+            multiview_mask: None,
+            cache: None,
+        }));
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            address_mode_u: wgpu::AddressMode::ClampToEdge,
+            address_mode_v: wgpu::AddressMode::ClampToEdge,
+            ..Default::default()
+        });
+        Self {
+            pipeline,
+            layout,
+            sampler,
+            textures:Default::default(),selected_custom:None,loading:None,custom_last:None,
+            pending: vec![],
+        }
+    }
+    pub fn pending(&self) -> bool {
+        !self.pending.is_empty()
+    }
+    pub fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        projection: Mat4,
+        camera: DVec3,
+        title: bool,
+    ) {
+        self.pending.clear();
+        let Some(frame) = PENDING.with_borrow_mut(Option::take).filter(|_| !title) else {
+            return;
+        };
+        if let Some(path)=frame.quads.iter().find(|q|q.shape==1&&!q.texture.starts_with("builtin:")).map(|q|&q.texture){
+            if self.selected_custom.as_ref()!=Some(path){self.selected_custom=Some(path.clone());if std::path::Path::new(path).is_file(){let(tx,rx)=std::sync::mpsc::channel();self.loading=Some((path.clone(),rx));let load=path.clone();std::thread::spawn(move||{let decoded=std::fs::read(&load).map_err(|e|e.to_string()).and_then(|b|if b.starts_with(&[0xff,0xd8]){crate::hud::decode_image_bytes(&b)}else{crate::hud::decode_bytes(&b)}.map_err(|e|e.to_string()));let _=tx.send(decoded);});}}
+        }
+        let ready=self.loading.as_ref().and_then(|(path,rx)|rx.try_recv().ok().map(|v|(path.clone(),v)));
+        if let Some((path,result))=ready{self.loading=None;match result{Ok((w,h,data))=>{self.upload(device,queue,path.clone(),w,h,&data);self.custom_last=Some(path);},Err(error)=>IMAGE_ERROR.with_borrow_mut(|v|*v=Some(format!("Failed to load texture from '{}' for TargetRenderer Image ({error})",std::path::Path::new(&path).file_name().unwrap_or_default().to_string_lossy())))}}
+        for q in frame.quads{
+            let mut path=if q.shape==1{q.texture.clone()}else{"builtin:White".into()};
+            if path.starts_with("builtin:")&&!self.textures.contains_key(&path){let decoded=match path.as_str(){"builtin:White"=>Some((1,1,vec![255;4])),_=>{let index=match path.as_str(){"builtin:Marker1"=>0,"builtin:Marker2"=>1,"builtin:Glow"=>2,_=>continue};crate::skins::base64_decode(PNGS[index]).and_then(|b|crate::hud::decode_bytes(&b).ok())}};if let Some((w,h,data))=decoded{self.upload(device,queue,path.clone(),w,h,&data);}}
+            if !path.starts_with("builtin:"){if let Some(last)=&self.custom_last{path=last.clone();}else{continue;}}else if !self.textures.contains_key(&path){continue;}
+            let v=vertices(&q,projection,camera);let buffer=device.create_buffer_init(&wgpu::util::BufferInitDescriptor{label:Some("TargetRenderer mesh"),contents:bytemuck::cast_slice(&v),usage:wgpu::BufferUsages::VERTEX});self.pending.push((path,buffer,v.len()as u32,q.depth));
+        }
+    }
+    fn upload(&mut self,device:&wgpu::Device,queue:&wgpu::Queue,path:String,width:u32,height:u32,data:&[u8]){
+        let texture=device.create_texture(&wgpu::TextureDescriptor{label:Some("TargetRenderer original texture"),size:wgpu::Extent3d{width,height,depth_or_array_layers:1},mip_level_count:1,sample_count:1,dimension:wgpu::TextureDimension::D2,format:wgpu::TextureFormat::Rgba8Unorm,usage:wgpu::TextureUsages::TEXTURE_BINDING|wgpu::TextureUsages::COPY_DST,view_formats:&[]});
+        queue.write_texture(wgpu::TexelCopyTextureInfo{texture:&texture,mip_level:0,origin:wgpu::Origin3d::ZERO,aspect:wgpu::TextureAspect::All},data,wgpu::TexelCopyBufferLayout{offset:0,bytes_per_row:Some(width*4),rows_per_image:Some(height)},wgpu::Extent3d{width,height,depth_or_array_layers:1});
+        let view=texture.create_view(&Default::default());let group=device.create_bind_group(&wgpu::BindGroupDescriptor{label:Some("TargetRenderer texture"),layout:&self.layout,entries:&[wgpu::BindGroupEntry{binding:0,resource:wgpu::BindingResource::TextureView(&view)},wgpu::BindGroupEntry{binding:1,resource:wgpu::BindingResource::Sampler(&self.sampler)}]});if !path.starts_with("builtin:"){self.textures.retain(|key,_|key.starts_with("builtin:"));}self.textures.insert(path,(texture,group));
+    }
+    pub fn draw(
+        &mut self,
+        device: &wgpu::Device,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        depth: &wgpu::TextureView,
+    ) {
+        if self.pending.is_empty() {
+            return;
+        }
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("TargetRenderer"),
+            color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                view: target,
+                depth_slice: None,
+                resolve_target: None,
+                ops: wgpu::Operations {
+                    load: wgpu::LoadOp::Load,
+                    store: wgpu::StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment:Some(wgpu::RenderPassDepthStencilAttachment{view:depth,depth_ops:Some(wgpu::Operations{load:wgpu::LoadOp::Load,store:wgpu::StoreOp::Store}),stencil_ops:None}),
+            ..Default::default()
+        });
+        for (texture, buffer, count, depth) in &self.pending {
+            pass.set_pipeline(&self.pipeline[usize::from(*depth)]);
+            if let Some((_, group)) = self.textures.get(texture) {
+                pass.set_bind_group(0, group, &[]);
+                pass.set_vertex_buffer(0, buffer.slice(..));
+                pass.draw(0..*count, 0..1);
+            }
+        }
+        drop(pass);
+        self.pending.clear();
+    }
+}
