+            return;
+        };
+        let mesh = vertices(&frame, projection, camera, size);
+        if mesh.is_empty() {
+            return;
+        }
+        let count = mesh.len() as u32;
+        let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Breadcrumbs mesh"),
+            contents: bytemuck::cast_slice(&mesh),
