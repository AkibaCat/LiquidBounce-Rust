+// SPDX-License-Identifier: GPL-3.0-or-later
+//! BedDefender uses real default collision, chest classes, bed parts and armor RGB.
+use super::Game;
+use serde_json::{Value,json};
+impl Game<'_>{
+    fn bed_defender_beds(&self,radius:f32)->Option<Vec<Value>>{
+        let eye=self.eye_position()?;let radius=f64::from(radius);let lo=eye.map(|v|(v-radius).floor()as i32);let hi=eye.map(|v|(v+radius).floor()as i32);let mut beds=vec![];
+        let min=self.world.shape.min_y;let max=self.world.shape.max_y()-1;
+        for sx in lo[0]>>4..=hi[0]>>4{for sz in lo[2]>>4..=hi[2]>>4{for sy in(lo[1]>>4).max(min>>4)..=(hi[1]>>4).min(max>>4){for y in lo[1].max(sy<<4)..=hi[1].min((sy<<4)+15){for z in lo[2].max(sz<<4)..=hi[2].min((sz<<4)+15){for x in lo[0].max(sx<<4)..=hi[0].min((sx<<4)+15){
+            let state=self.world.block(x,y,z);let facts=self.res.facts().get(state);if !facts.has_class("BedBlock"){continue;}
+            let properties=&self.pack.assets.registry.state(state)?.properties;let mut facing=match properties.get("facing").map(String::as_str){Some("north")=>[0,0,-1],Some("east")=>[1,0,0],Some("west")=>[-1,0,0],_=>[0,0,1]};
+            // searchBedLayer starts by walking away from the opposite part.
+            if properties.get("part").is_some_and(|p|p=="foot"){facing=facing.map(|v|-v);}
+            let name=facts.name.strip_prefix("minecraft:").unwrap_or(&facts.name).strip_suffix("_bed").unwrap_or("white");let dye=horizon_client::block_entity_render::DYES.iter().position(|(s,_)|*s==name).unwrap_or(0);
+            beds.push(json!({"pos":[x,y,z],"facing":facing,"item":facts.item.as_ref(),"dye":dye,"outline":0,"surrounding":[]}));
+        }}}}}}Some(beds)
+    }
+    pub(super) fn bed_defender_query(&self,text:&str)->Option<String>{
+        let q:Value=serde_json::from_str(text).ok()?;
+        match q["op"].as_str()?{
+            "slots"=>{let slots=std::iter::once(40).chain(0..9).filter_map(|index|{let stack=self.stack_in(index).filter(|s|s.count>0)?;let facts=self.scaffold_block_facts(stack)?;let b=self.res.behaviours();let binding=b.item_binding(&stack.item)?;let chest=b.block_data(binding.block).is(horizon_world::level::classes::Class::AbstractChest);Some(json!({"index":index,"count":stack.count as i32,"hardness":facts.hardness,"full":facts.full_cube,"chest":chest}))}).collect::<Vec<_>>();Some(json!({"selected":self.client_hotbar_slot(),"slots":slots}).to_string())},
+            "status"=>Some(json!({"sneaking":self.player.as_ref()?.shift_key_down}).to_string()),
+            "targets"=>{let armor:[Option<u32>;4]=std::array::from_fn(|i|{let stack=self.armor[i].as_ref()?;let view=horizon_client::item_render::stack_view(stack);let components=self.pack.item_renderer.models.components_view(&view);let color=components.get("minecraft:dyed_color")?;color.as_i64().or_else(||color["rgb"].as_i64()).map(|v|v as u32|0xff000000)});Some(json!({"eye":self.eye_position()?,"sneaking":self.player.as_ref()?.shift_key_down,"armor":armor,"beds":self.bed_defender_beds(q["radius"].as_f64()?as f32)?}).to_string())},_=>None
+        }
+    }
+    fn bed_defender_event(&self,input:Value)->Value{let mut output=String::new();self.native_client_bed_defender(&input.to_string(),&mut output);serde_json::from_str(&output).unwrap_or(Value::Null)}
+    pub(super) fn bed_defender_position(&self,raw:[f64;3]){if let Some(p)=self.player.as_ref(){self.bed_defender_event(json!({"action":"position","old":[p.position.x,p.position.y,p.position.z],"raw":raw}));}}
+    pub(super) fn bed_defender_key(&self,key:winit::keyboard::KeyCode,pressed:bool){
+        if !pressed||!self.native_window(){return;}let Some(name)=horizon_client::keybinds::key_name(key)else{return;};let options=self.bed_defender_event(json!({"action":"options"}));if options["mode"]!="Manual"||options["track"]!=name&&options["untrack"]!=name{return;}
+        let beds=if options["track"]==name{self.bed_defender_beds(16.).unwrap_or_default().into_iter().map(|b|b["pos"].clone()).collect::<Vec<_>>()}else{vec![]};
+        self.bed_defender_event(json!({"action":"key","key":name,"eye":self.eye_position(),"beds":beds}));
+    }
+}
diff --git a/crates/horizon-client/src/game/liquidbounce_debug.rs b/crates/horizon-client/src/game/liquidbounce_debug.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/liquidbounce_debug.rs
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{Game, Screen};
+use horizon_client::{
+    actions::Action,
+    hud::{HudBatch, Rect, rgba},
+    world_primitives::{PrimitiveShape, WorldPrimitives},
+};
+use serde_json::{Value, json};
+fn num(v: &Value) -> f32 {
+    v.as_f64().unwrap_or(0.) as f32
+}
+fn argb(v: &Value, fallback: u32) -> u32 {
+    v.as_u64()
+        .map(|v| v as u32)
+        .or_else(|| v.as_i64().map(|v| v as u32))
+        .unwrap_or(fallback)
+}
+fn tint(c: u32, alpha: f32) -> u32 {
+    rgba(
+        (c >> 16) as u8,
+        (c >> 8) as u8,
+        c as u8,
+        ((c >> 24) as f32 * alpha.clamp(0., 1.)) as u8,
+    )
+}
+impl Game<'_> {
+    pub(super) fn client_debug_query(&self, input: Value) -> Value {
+        let mut output = String::new();
+        self.native_client_debug(&input.to_string(), &mut output);
+        serde_json::from_str(&output).unwrap_or(Value::Null)
+    }
+    pub(super) fn client_debug_tick(&mut self) {
+        if !self.native_window() {
+            return;
+        }
+        let policy = self.client_debug_query(json!({"action":"policy"}));
+        if policy["running"] != true {
+            return;
+        }
+        let mut predicted = Vec::new();
+        if policy["simulation"] == true && self.client_smart_eat_player() {
+            let ticks = policy["ticks"].as_i64().unwrap_or(20).clamp(5, 100) as i32;
+            let raw = horizon_client::reverse_step_bridge::keys();
+            let keys = horizon_client::sprint::Keys {
+                forward: raw[0],
+                backward: raw[1],
+                left: raw[2],
+                right: raw[3],
+                jump: raw[4],
+                shift: raw[5],
+                sprint: raw[6],
+                analog: None,
+            };
+            let _ = super::falling_forecast::visit_with_keys(self, ticks, 0., keys, |p, _| {
+                predicted.push([p.position.x,p.position.y,p.position.z]);
+                false
+            });
+        }
+        let parameters=self.player.as_ref().map(|p|json!({"Tick":p.health.tick_count,"Position":[p.position.x,p.position.y,p.position.z],"Velocity":[p.velocity.x,p.velocity.y,p.velocity.z],"Rotation":[p.yaw,p.pitch],"OnGround":p.ground.on_ground,"Chunks":self.world.chunks.len(),"Entities":self.mobs.len()})).unwrap_or_else(||json!({"Player":false}));
+        self.client_debug_query(
+            json!({"action":"tick","parameters":parameters,"predicted":predicted}),
+        );
+    }
+    pub(super) fn client_debug_scroll(&self, amount: f64, cursor: [f32; 2]) -> bool {
+        self.screen == Screen::Chat
+            && self.client_debug_query(
+                json!({"action":"scroll","chat":true,"amount":amount,"cursor":cursor}),
+            ) == true
+    }
+    fn client_debug_frame(&self) -> Value {
+        let (width, height) = self.gui_size();
+        self.client_debug_query(json!({"action":"frame","width":width,"height":height,"tab":self.keys.held(Action::Playerlist)}))
+    }
+    pub(super) fn client_debug_overlay(&self, batch: &mut HudBatch) {
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let frame = self.client_debug_frame();
+        let bottom = num(&frame["bottom"]);
+        for card in frame["cards"].as_array().into_iter().flatten() {
+            let x = num(&card["x"]);
+            let y = num(&card["y"]);
+            let width = num(&card["width"]);
+            let height = num(&card["height"]);
+            if y + height <= 22. || y >= bottom {
+                continue;
+            }
+            batch.fill(
+                &self.gui.atlas,
+                x,
+                y.max(22.),
+                width,
+                (y + height).min(bottom) - y.max(22.),
+                tint(0x96000000, 1.),
+            );
+            let inner = width - 4.;
+            let max_name = card["rows"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter(|r| r["type"] == "item")
+                .map(|r| {
+                    self.client_debug_width(r["name"].as_str().unwrap_or(""))
+                        + if r["indent"] == true { 6. } else { 0. }
+                })
+                .fold(0., f32::max);
+            let col = (max_name + 4.).min(inner * 0.55);
+            for (i, row) in card["rows"].as_array().into_iter().flatten().enumerate() {
+                let top = y + 2. + i as f32 * 8.;
+                if top < 22. || top + 8. > bottom {
+                    continue;
+                }
+                match row["type"].as_str() {
+                    Some("header") => {
+                        batch.fill(&self.gui.atlas, x, top, width, 8., tint(0x18ffffff, 1.));
+                        self.client_debug_text(
+                            batch,
+                            row["text"].as_str().unwrap_or(""),
+                            [x + 2., top],
+                            inner,
+                            0xffffaa00,
+                            1.,
+                        );
+                    }
+                    Some("subheader") => self.client_debug_text(
+                        batch,
+                        row["text"].as_str().unwrap_or(""),
+                        [x + 2., top],
+                        inner,
+                        0xff55ffff,
+                        1.,
+                    ),
+                    _ => {
+                        let indent = if row["indent"] == true { 6. } else { 0. };
+                        let alpha = num(&row["alpha"]);
+                        self.client_debug_text(
+                            batch,
+                            row["name"].as_str().unwrap_or(""),
+                            [x + 2. + indent, top],
+                            col - indent - 4.,
+                            0xffaaaaaa,
+                            alpha,
+                        );
+                        self.client_debug_text(
+                            batch,
+                            row["value"].as_str().unwrap_or(""),
+                            [x + 2. + col, top],
+                            inner - col,
+                            argb(&row["color"], u32::MAX),
+                            alpha,
+                        );
+                    }
+                }
+            }
+        }
+        if frame["overflow"] == true {
+            let width = num(&frame["contentRight"]) - 120.;
+            batch.fill(
+                &self.gui.atlas,
+                120.,
+                bottom,
+                width,
+                8.,
+                tint(0x96000000, 1.),
+            );
+            let text = frame["status"].as_str().unwrap_or("");
+            self.client_debug_text(batch, text, [122., bottom], width - 4., 0xff808080, 1.);
+        }
+        if let Some(graph) = frame.get("graph").filter(|g| !g.is_null()) {
+            self.client_debug_text(
+                batch,
+                frame["graphLabel"].as_str().unwrap_or("Graph"),
+                [300., 500.],
+                180.,
+                u32::MAX,
+                1.,
+            );
+            for p in graph["samples"].as_array().into_iter().flatten() {
+                batch.fill(
+                    &self.gui.atlas,
+                    300. + num(&p[0]),
+                    500. - num(&p[1]),
+                    1.,
+                    1.,
+                    tint(0xff00ff00, 1.),
+                );
+            }
+            for p in graph["curve"].as_array().into_iter().flatten() {
+                batch.fill(
+                    &self.gui.atlas,
+                    298. + num(&p[0]),
+                    498. - num(&p[1]),
+                    4.,
+                    4.,
+                    u32::MAX,
+                );
+            }
+        }
+    }
+    fn client_debug_width(&self, text: &str) -> f32 {
+        let (_, h) = self.gui.atlas.font.liquidbounce_target_metrics();
+        text.chars()
+            .map(|c| {
+                self.gui
+                    .atlas
+                    .font
+                    .liquidbounce_target_glyph(c, false)
+                    .advance
+            })
+            .sum::<f32>()
+            * 7.2
+            / h
+    }
+    fn client_debug_text(
+        &self,
+        batch: &mut HudBatch,
+        text: &str,
+        at: [f32; 2],
+        max: f32,
+        color: u32,
+        alpha: f32,
+    ) {
+        if max <= 0. {
+            return;
+        }
+        let mut text = text.to_string();
+        if self.client_debug_width(&text) > max {
+            while !text.is_empty() && self.client_debug_width(&(text.clone() + "…")) > max {
+                text.pop();
+            }
+            text.push('…');
+            if self.client_debug_width(&text) > max {
+                return;
+            }
+        }
+        let (ascent, height) = self.gui.atlas.font.liquidbounce_target_metrics();
+        let scale = 7.2 / height;
+        let mut x = at[0];
+        let y = at[1] + 0.5 + ascent * scale;
+        for c in text.chars() {
+            let g = self.gui.atlas.font.liquidbounce_target_glyph(c, false);
+            if let Some(Rect { u0, v0, u1, v1, .. }) = g.rect {
+                let (x0, x1, y0, y1) = (
+                    x + g.left * scale,
+                    x + g.right * scale,
+                    y + g.top * scale,
+                    y + g.bottom * scale,
+                );
+                batch.quad(
+                    [[x0, y0], [x1, y0], [x1, y1], [x0, y1]],
+                    [[u0, v0], [u1, v0], [u1, v1], [u0, v1]],
+                    tint(color, alpha),
+                );
+            }
+            x += g.advance * scale;
+        }
+    }
+    pub(super) fn client_debug_geometry(&self, out: &mut WorldPrimitives) {
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let frame = self.client_debug_frame();
+        let predicted =
+            serde_json::from_value::<Vec<[f64; 3]>>(frame["predicted"].clone()).unwrap_or_default();
+        for points in predicted.windows(2) {
+            out.line(points[0], points[1], 0xff0000ff, 1.);
+        }
+        for geometry in frame["geometry"].as_array().into_iter().flatten() {
+            Self::client_debug_shape(out, geometry);
+        }
+    }
+    fn client_debug_shape(out: &mut WorldPrimitives, g: &Value) {
+        let color = argb(&g["color"], u32::MAX);
+        match g["type"].as_str() {
+            Some("collection") => {
+                for shape in g["geometry"].as_array().into_iter().flatten() {
+                    Self::client_debug_shape(out, shape);
+                }
+            }
+            Some("segment") => {
+                if let (Ok(a), Ok(b)) = (
+                    serde_json::from_value::<[f64; 3]>(g["from"].clone()),
+                    serde_json::from_value::<[f64; 3]>(g["to"].clone()),
+                ) {
+                    out.line(a, b, color, 1.);
+                }
+            }
+            Some("line") => {
+                if let (Ok(p), Ok(d)) = (
+                    serde_json::from_value::<[f64; 3]>(g["position"].clone()),
+                    serde_json::from_value::<[f64; 3]>(g["direction"].clone()),
+                ) {
+                    let length = d.iter().map(|v| v * v).sum::<f64>().sqrt();
+                    if length > 0. {
+                        out.line(
+                            std::array::from_fn(|i| p[i] - 100. * d[i] / length),
+                            std::array::from_fn(|i| p[i] + 100. * d[i] / length),
+                            color,
+                            1.,
+                        );
+                    }
+                } else if let (Ok(a), Ok(b)) = (
+                    serde_json::from_value::<[f64; 3]>(g["from"].clone()),
+                    serde_json::from_value::<[f64; 3]>(g["to"].clone()),
+                ) {
+                    out.line(a, b, color, 1.);
+                }
+            }
+            Some("triangle") => {
+                if let Ok(p) = serde_json::from_value::<[[f64; 3]; 3]>(g["points"].clone()) {
+                    out.push(PrimitiveShape::LiquidBounceQuad {
+                        corners: [p[0], p[1], p[2], p[2]],
+                        colors: [color; 4],
+                    });
+                }
+            }
+            Some("box") => {
+                if let (Ok(a), Ok(b)) = (
+                    serde_json::from_value::<[f64; 3]>(g["min"].clone()),
+                    serde_json::from_value::<[f64; 3]>(g["max"].clone()),
+                ) {
+                    out.filled_box(a, b, color);
+                }
+            }
+            Some("point") => {
+                if let Ok(p) = serde_json::from_value::<[f64; 3]>(g["position"].clone()) {
+                    let half = g["size"].as_f64().unwrap_or(0.2) * 0.5;
+                    out.filled_box(p.map(|v| v - half), p.map(|v| v + half), color);
+                }
+            }
+            _ => {}
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/block_esp.rs b/crates/horizon-client/src/game/block_esp.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/block_esp.rs
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::chunk::Section;
+use horizon_world::registry::BlockStateId;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::{Arc, Weak},
+};
+#[derive(Default)]
+pub(super) struct State {
+    targets: BTreeSet<String>,
+    sections: BTreeMap<(i32, i32, i32), (Weak<Section>, Vec<[i32; 3]>)>,
+}
+impl Game<'_> {
+    fn client_block_esp_query(&self, input: Value) -> Value {
+        let mut output = String::new();
+        self.native_client_block_esp(&input.to_string(), &mut output);
+        serde_json::from_str(&output).unwrap_or(Value::Null)
+    }
+    pub(super) fn client_block_esp_frame(&self, camera: glam::DVec3) {
+        horizon_client::gfx::block_esp::begin_frame("null");
+        if !self.native_window() || self.player.is_none() {
+            *self.client_block_esp.borrow_mut() = Default::default();
+            return;
+        }
+        let policy = self.client_block_esp_query(json!({"action":"policy"}));
+        if policy["running"] != true {
+            *self.client_block_esp.borrow_mut() = Default::default();
+            return;
+        }
+        let targets = serde_json::from_value::<BTreeSet<String>>(policy["targets"].clone())
+            .unwrap_or_default();
+        let mut cache = self.client_block_esp.borrow_mut();
+        if cache.targets != targets {
+            cache.targets = targets;
+            cache.sections.clear();
+        }
+        let wanted = |state: BlockStateId| {
+            !self.res.facts().is_air(state)
+                && cache
+                    .targets
+                    .contains(self.res.facts().get(state).name.as_ref())
+        };
+        let mut present = BTreeSet::new();
+        let mut changed = Vec::new();
+        for (&(cx, cz), chunk) in &self.world.chunks {
+            for (sy, section) in chunk.sections.iter().enumerate() {
+                let key = (cx, chunk.min_y() + sy as i32 * 16, cz);
+                present.insert(key);
+                let weak = Arc::downgrade(section);
+                if cache
+                    .sections
+                    .get(&key)
+                    .is_some_and(|(previous, _)| Weak::ptr_eq(previous, &weak))
+                {
+                    continue;
+                }
+                let mut positions = Vec::new();
+                if section.blocks.maybe_has(|id| wanted(BlockStateId(id))) {
+                    for i in 0..4096 {
+                        if wanted(BlockStateId(section.get(i))) {
+                            positions.push([
+                                cx.wrapping_mul(16).wrapping_add((i & 15) as i32),
+                                key.1 + (i >> 8) as i32,
+                                cz.wrapping_mul(16).wrapping_add((i >> 4 & 15) as i32),
+                            ]);
+                        }
+                    }
+                }
+                changed.push((key, weak, positions));
+            }
+        }
+        for (key, weak, positions) in changed {
+            cache.sections.insert(key, (weak, positions));
+        }
+        cache.sections.retain(|key, _| present.contains(key));
+        let positions = cache
+            .sections
+            .values()
+            .flat_map(|(_, p)| p.iter().copied())
+            .collect::<Vec<_>>();
+        drop(cache);
+        let blocks=positions.into_iter().filter_map(|position|{let state=self.world.block(position[0],position[1],position[2]);if self.res.facts().is_air(state){return None;}let facts=self.res.facts().get(state);let map=self.native_block_map_color(state).map(|(_,rgb)|rgb).unwrap_or(0);Some(json!({"position":position,"name":facts.name.as_ref(),"mapColor":map,"boxes":self.outline_boxes(position)}))}).collect::<Vec<_>>();
+        let frame = self.client_block_esp_query(
+            json!({"action":"frame","camera":camera.to_array(),"blocks":blocks}),
+        );
+        horizon_client::gfx::block_esp::begin_frame(&frame.to_string());
+    }
+}
