+// SPDX-License-Identifier: GPL-3.0-or-later
+// Source-derived heart.fsh, gradient_circle.fsh and rounded_rect.fsh.
+override FRAME_LINEAR:bool=false;
+struct Vertex{@builtin(position)clip:vec4<f32>,@location(0)color:vec4<f32>,@location(1)uv:vec2<f32>,@location(2)inner_color:vec4<f32>,@location(3)@interpolate(flat)params:vec4<f32>}
+@vertex fn mesh(@location(0)clip:vec4<f32>,@location(1)color:vec4<f32>,@location(2)uv:vec2<f32>,@location(3)inner_color:vec4<f32>,@location(4)params:vec4<f32>)->Vertex{return Vertex(clip,color,uv,inner_color,params);}
+@group(0)@binding(0)var image:texture_2d<f32>;
+@group(0)@binding(1)var image_sampler:sampler;
+fn sd_heart(input:vec2<f32>)->f32{let p=vec2(abs(input.x),input.y);if p.x+p.y>1.{let q=p-vec2(0.25,0.75);return sqrt(dot(q,q))-sqrt(2.)/4.;}let a=p-vec2(0.,1.);let b=p-vec2(0.5*max(p.x+p.y,0.));return sqrt(min(dot(a,a),dot(b,b)))*sign(p.x-p.y);}
+@fragment fn image_fragment(v:Vertex)->@location(0)vec4<f32>{
+ var color=v.color;
+ // Sample unconditionally: implicit texture derivatives remain uniform.
+ let texel=textureSample(image,image_sampler,v.uv);
+ let shape=u32(v.params.x+0.5);
+ let dist=length(v.uv*2.-vec2(1.));let aa=max(fwidth(dist),0.0001);
+ let heart=sd_heart((v.uv*2.-vec2(1.))*vec2(0.6035534,0.5517767)*1.02+vec2(0.,0.5517767));let heart_aa=max(fwidth(heart),0.0001)*1.5;
+ if shape==1u{color*=texel;}
+ if shape==2u{let inner=clamp(v.params.y,0.,1.);let outer_alpha=1.-smoothstep(-aa,0.,dist-1.);var inner_alpha=1.;if inner>0.{inner_alpha=1.-smoothstep(-aa,0.,inner-dist);}let t=clamp((dist-inner)/max(1.-inner,0.0001),0.,1.);color=mix(v.inner_color,v.color,t);color.a*=outer_alpha*inner_alpha;}
+ if shape==3u{let d=dist-1.;let width=2.*aa;color.a*=(1.-smoothstep(-aa,0.,d))*smoothstep(-width-aa,-width+aa,d);}
+ if shape==4u{color.a*=1.-smoothstep(-heart_aa,0.,heart);}
+ if color.a<=0.001{discard;}
+ if FRAME_LINEAR{color=vec4(pow(color.rgb,vec3(2.2)),color.a);}return color;
+}
diff --git a/crates/horizon-client-render/src/target-renderer-font.rs b/crates/horizon-client-render/src/target-renderer-font.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/target-renderer-font.rs
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// This is included in native Font's module to use its real glyph atlas and cache.
+include!("target-renderer-font-data.rs");
+include!("target-renderer-font-registry.rs");
+fn target_font_scale(font: &ab_glyph::FontVec) -> ab_glyph::PxScale {
+    ab_glyph::PxScale::from(43. * font.height_unscaled() / font.units_per_em().unwrap_or(1000.))
+}
+impl Font {
+    pub fn liquidbounce_target_metrics(&self) -> (f32, f32) {
+        let (font, _) = target_font(false);
+        let f = font.as_scaled(target_font_scale(&font));
+        (
+            f.ascent().ceil(),
+            f.ascent().ceil() + (-f.descent()).ceil() + f.line_gap().ceil(),
+        )
+    }
+    pub fn liquidbounce_target_glyph(&self, c: char, bold: bool) -> Glyph {
+        let key = if bold {
+            "liquidbounce:target_bold"
+        } else {
+            "liquidbounce:target"
+        };
+        let mut cache = self.cache.borrow_mut();
+        let Cache { sets, region, .. } = &mut *cache;
+        let index = if let Some(i) = sets.iter().position(|(id, _)| id == key) {
+            i
+        } else {
+            sets.push((
+                key.into(),
+                FontSet {
+                    providers: vec![],
+                    glyphs: Default::default(),
+                    non_fishy: Default::default(),
+                    by_width: None,
+                },
+            ));
+            sets.len() - 1
+        };
+        if let Some(g) = sets[index].1.glyphs.get(&c) {
+            return *g;
+        }
+        let (mut font, mut embolden) = target_font(bold);
+        let mut id = font.glyph_id(c);
+        if id.0 == 0 {
+            for cjk in [false, true] {
+                if let Some(fallback) = target_fallback(bold, cjk) {
+                    if fallback.glyph_id(c).0 != 0 {
+                        font = fallback;
+                        id = font.glyph_id(c);
+                        embolden = false;
+                        break;
+                    }
+                }
+            }
+        }
+        let scaled = font.as_scaled(target_font_scale(&font));
+        let bold_width = if embolden { 2 } else { 0 };
+        let advance = scaled.h_advance(id) + bold_width as f32;
+        let mut result = Glyph {
+            advance,
+            offset: 2.,
+            ..Glyph::default()
+        };
+        if !self.metrics_only {
+            if let Some(outline) = font.outline_glyph(
+                id.with_scale_and_position(target_font_scale(&font), ab_glyph::point(0., 0.)),
+            ) {
+                let bounds = outline.px_bounds();
+                let (w, h) = (bounds.width() as u32 + bold_width, bounds.height() as u32);
+                if w > 0 && h > 0 {
+                    let mut pixels = vec![0u8; (w * h * 4) as usize];
+                    outline.draw(|x, y, a| {
+                        for dx in 0..=bold_width {
+                            let i = ((y * w + x + dx) * 4) as usize;
+                            pixels[i..i + 3].fill(255);
+                            pixels[i + 3] = pixels[i + 3].max((a * 255.).round() as u8);
+                        }
+                    });
+                    if let Some((x, y)) = region.place(w, h, pixels, self.atlas, self.region) {
+                        result.rect = Some(glyph_rect(x, y, w, h, self.atlas));
+                        result.left = bounds.min.x;
+                        result.top = bounds.min.y;
+                        result.right = bounds.max.x + bold_width as f32;
+                        result.bottom = bounds.max.y;
+                    } else {
+                        return self.missing;
+                    }
+                }
+            }
+        }
+        sets[index].1.glyphs.insert(c, result);
+        result
+    }
+}
diff --git a/crates/horizon-client-render/src/target-renderer-font-registry.rs b/crates/horizon-client-render/src/target-renderer-font-registry.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/target-renderer-font-registry.rs
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// FontManager.themeFontFace: actual loaded SFNT names, active theme then included theme.
+use sha2::Digest as _;
+#[derive(Clone)]
+struct TargetFontFace {
+    name: String,
+    font: Arc<ab_glyph::FontVec>,
+    hash: [u8; 32],
+    bold: bool,
+}
+struct TargetFontRegistry {
+    faces: HashMap<String, TargetFontFace>,
+    primary: String,
+    generation: u64,
+}
+fn target_face(bytes: Vec<u8>) -> Result<TargetFontFace, String> {
+    let parsed = ttf_parser::Face::parse(&bytes, 0)
+        .map_err(|e| format!("Invalid TrueType/OpenType face: {e:?}"))?;
+    let bold = parsed.is_bold();
+    let name = parsed
+        .names()
+        .into_iter()
+        .filter(|n| n.name_id == ttf_parser::name_id::FULL_NAME)
+        .filter_map(|n| {
+            let text = n.to_string().or_else(|| {
+                n.name
+                    .is_ascii()
+                    .then(|| String::from_utf8_lossy(n.name).into_owned())
+            })?;
+            Some((
+                (
+                    u8::from(n.language_id == 0x409),
+                    u8::from(n.platform_id == ttf_parser::PlatformId::Windows),
+                ),
+                text,
+            ))
+        })
+        .max_by_key(|(score, _)| *score)
+        .map(|(_, name)| name)
+        .ok_or_else(|| "Font has no readable full face name".to_owned())?;
+    let hash = sha2::Sha256::digest(&bytes).into();
+    let font = ab_glyph::FontVec::try_from_vec(bytes)
+        .map_err(|e| format!("Unsupported font face: {e:?}"))?;
+    Ok(TargetFontFace {
+        name,
+        font: Arc::new(font),
+        hash,
+        bold,
+    })
+}
+fn target_registry() -> &'static std::sync::RwLock<TargetFontRegistry> {
+    static FONTS: std::sync::OnceLock<std::sync::RwLock<TargetFontRegistry>> =
+        std::sync::OnceLock::new();
+    FONTS.get_or_init(|| {
+        let faces = TARGET_FONTS
+            .iter()
+            .map(|encoded| {
+                target_face(crate::skins::base64_decode(encoded).expect("included font bytes"))
+                    .expect("pinned included TrueType font")
+            })
+            .map(|f| (f.name.clone(), f))
+            .collect();
+        std::sync::RwLock::new(TargetFontRegistry {
+            faces,
+            primary: "Inter Medium".into(),
+            generation: 1,
+        })
+    })
+}
+fn target_font_generation() -> u64 {
+    target_registry()
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .generation
+}
+fn target_font_signature(registry: &TargetFontRegistry) -> (Option<[u8; 32]>, Option<[u8; 32]>) {
+    (
+        registry.faces.get(&registry.primary).map(|f| f.hash),
+        (registry.primary == "Inter Medium")
+            .then(|| registry.faces.get("Inter Bold").map(|f| f.hash))
+            .flatten(),
+    )
+}
+/// The browser passes the real active theme root, including custom local themes.
+/// The names come from each font's name table, never from its file name.
+pub fn liquidbounce_load_theme_fonts(root: &Path) -> Result<(), String> {
+    let metadata: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(root.join("metadata.json")).map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| e.to_string())?;
+    let mut loaded = Vec::new();
+    for name in metadata["fonts"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(serde_json::Value::as_str)
+    {
+        let relative = Path::new(name);
+        if relative
+            .components()
+            .any(|p| !matches!(p, std::path::Component::Normal(_)))
+        {
+            eprintln!("[LiquidBounce] Invalid theme font resource: {name}");
+            continue;
+        }
+        match std::fs::read(root.join("fonts").join(relative))
+            .map_err(|e| e.to_string())
+            .and_then(target_face)
+        {
+            Ok(face) => loaded.push(face),
+            Err(e) => eprintln!("[LiquidBounce] Failed to load theme font {name}: {e}"),
+        }
+    }
+    let mut registry = target_registry()
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let previous = target_font_signature(&registry);
+    for face in loaded {
+        if registry
+            .faces
+            .get(&face.name)
+            .is_none_or(|old| old.hash != face.hash)
+        {
+            registry.faces.insert(face.name.clone(), face);
+        }
+    }
+    let primary = metadata["nativeFont"]
+        .as_str()
+        .filter(|name| registry.faces.contains_key(*name))
+        .unwrap_or("Inter Medium")
+        .to_owned();
+    registry.primary = primary;
+    let current = target_font_signature(&registry);
+    if previous != current {
+        registry.generation = registry.generation.wrapping_add(1);
+    }
+    Ok(())
+}
+pub fn liquidbounce_theme_font_info() -> serde_json::Value {
+    let registry = target_registry()
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut faces = registry.faces.keys().cloned().collect::<Vec<_>>();
+    faces.sort();
+    serde_json::json!({"primary":registry.primary,"generation":registry.generation,"faces":faces})
+}
+fn target_font(bold: bool) -> (Arc<ab_glyph::FontVec>, bool) {
+    let registry = target_registry()
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let face = &registry.faces[&registry.primary];
+    // Preserve the included theme's established bold face; local faces derive bold.
+    if bold && registry.primary == "Inter Medium" {
+        if let Some(bold) = registry.faces.get("Inter Bold") {
+            return (Arc::clone(&bold.font), false);
+        }
+    }
+    (Arc::clone(&face.font), bold && !face.bold)
+}
+fn target_fallback(bold: bool, cjk: bool) -> Option<Arc<ab_glyph::FontVec>> {
+    type Slot = std::sync::OnceLock<Option<Arc<ab_glyph::FontVec>>>;
+    static COMMON: Slot = Slot::new();
+    static COMMON_BOLD: Slot = Slot::new();
+    static CJK: Slot = Slot::new();
+    static CJK_BOLD: Slot = Slot::new();
+    let slot = match (cjk, bold) {
+        (false, false) => &COMMON,
+        (false, true) => &COMMON_BOLD,
+        (true, false) => &CJK,
+        (true, true) => &CJK_BOLD,
+    };
+    slot.get_or_init(|| {
+        let windows = std::env::var_os("WINDIR")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from("C:/Windows"));
+        let name = match (cjk, bold) {
+            (false, false) => "segoeui.ttf",
+            (false, true) => "segoeuib.ttf",
+            (true, false) => "msyh.ttc",
+            (true, true) => "msyhbd.ttc",
+        };
+        let paths = if cfg!(target_os = "windows") {
+            vec![windows.join("Fonts").join(name)]
+        } else if cfg!(target_os = "macos") {
+            vec![PathBuf::from(if cjk {
+                "/System/Library/Fonts/PingFang.ttc"
+            } else {
+                "/System/Library/Fonts/Helvetica.ttc"
+            })]
+        } else {
+            vec![PathBuf::from(if cjk {
+                "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
+            } else if bold {
+                "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
+            } else {
+                "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
+            })]
+        };
+        paths.into_iter().find_map(|p| {
+            std::fs::read(p)
+                .ok()
+                .and_then(|b| ab_glyph::FontVec::try_from_vec(b).ok())
+                .map(Arc::new)
+        })
+    })
+    .clone()
+}
