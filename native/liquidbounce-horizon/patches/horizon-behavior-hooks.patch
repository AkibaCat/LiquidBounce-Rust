diff --git a/crates/horizon-client/src/game/placement_use.rs b/crates/horizon-client/src/game/placement_use.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/placement_use.rs
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Shared BlockExtensions.doPlacement. Result callbacks observe real dispatch/swing phases.
+use super::*;
+
+impl Game<'_> {
+    /// Caller verifies the hit and selects the silent slot before this call.
+    /// Return true only for the source's onPlacementSuccess/onItemUseSuccess callback.
+    /// Interaction swing has no Punch packet; HideForServer equals DoNotHide.
+    pub(super) fn client_do_placement(
+        &mut self,
+        hit: Hit,
+        rotation: [f32; 2],
+        hand: Hand,
+        swing_mode: &str,
+        mut on_success: impl FnMut(&mut Self, bool) -> bool,
+    ) -> bool {
+        let previous_hit = self.forced_hit.replace(hit);
+        let previous_guest = self.guest_use;
+        // 0: no predicted swing (including CONSUME), 1: predicted SUCCESS,
+        // -1: SUCCESS_SERVER. The action bool alone cannot distinguish these.
+        let previous_capture = self.client_placement_result.replace(0);
+        let before = self.with_hand(hand, |g| g.held().cloned());
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            self.native_with_item_rotation(rotation[0], rotation[1], |g| {
+                g.remote_send_carried();
+                g.use_failed = false;
+                let ended = if g.remote.is_some() {
+                    g.remote_use_item_on_at(hand, Some(hit))
+                } else {
+                    g.guest_use = Some(GuestUse::OnBlock(hand));
+                    g.with_hand(hand, |g| g.use_hand(Some(&hit)))
+                        .unwrap_or_else(|_| {
+                            g.use_failed = true;
+                            true
+                        })
+                };
+                if ended {
+                    let after = g.with_hand(hand, |g| g.held().map(|s| s.count));
+                    let stack_used = before
+                        .as_ref()
+                        .is_some_and(|s| s.count > 0 && (after != Some(s.count) || g.creative));
+                    let callback =
+                        !g.use_failed && g.client_placement_result.is_some_and(|v| v >= 0);
+                    if callback {
+                        let swing = on_success(g, false);
+                        if swing && !matches!(swing_mode, "HideForBoth" | "HideForClient") {
+                            let animation = g.auto_rod_animation(hand);
+                            g.swing_hand(hand, animation);
+                        }
+                        if stack_used {
+                            g.heights.item_used(hand);
+                        }
+                    }
+                    return callback;
+                }
+                // PASS alone permits Item.use; FAIL/CONSUME have ended above.
+                if before
+                    .as_ref()
+                    .is_none_or(|s| s.count <= 0 || &*s.item == "minecraft:air")
+                {
+                    return false;
+                }
+                g.client_placement_result = Some(0);
+                let used = if g.remote.is_some() {
+                    g.remote_use_item_rotated(hand, rotation[0], rotation[1])
+                } else {
+                    g.guest_use = previous_guest;
+                    g.with_hand(hand, |g| g.client_use_item_only(false))
+                        .unwrap_or(false)
+                        && !g.use_failed
+                };
+                let predicted = used && g.client_placement_result == Some(1);
+                if predicted {
+                    let swing = on_success(g, true);
+                    if swing && !matches!(swing_mode, "HideForBoth" | "HideForClient") {
+                        let animation = g.auto_rod_animation(hand);
+                        g.swing_hand(hand, animation);
+                    }
+                }
+                if used && matches!(g.client_placement_result, Some(1 | -1)) {
+                    g.heights.item_used(hand);
+                }
+                predicted
+            })
+        }));
+        self.forced_hit = previous_hit;
+        self.guest_use = previous_guest;
+        self.client_placement_result = previous_capture;
+        let accepted = match outcome {
+            Ok(v) => v,
+            Err(e) => std::panic::resume_unwind(e),
+        };
+        accepted
+    }
+}
diff --git a/crates/horizon-client/src/game/client_extinguish.rs b/crates/horizon-client/src/game/client_extinguish.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/client_extinguish.rs
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleExtinguish: real buckets, body replay, placement context and verified click.
+use super::{
+    auto_walk_player::NativePlayer,
+    auto_walk_simulation::NativeSimulation,
+    auto_walk_world::{self as world, NativeLevel, NavigationRegistry},
+};
+use super::{
+    block_placement::{self as placement, Target},
+    *,
+};
+use crate::navigation::{
+    input::Input,
+    walk_control::body::{SimulatedInput, WalkSimulation},
+};
+use serde_json::{Value, json};
+const REQUESTER: u64 = 0x4558_5449_4e47_5549;
+fn nearest(game: &Game<'_>, item: &str) -> Option<usize> {
+    let selected = game.client_hotbar_slot();
+    std::iter::once(40usize)
+        .chain(0..9)
+        .filter(|slot| {
+            game.stack_in(*slot)
+                .is_some_and(|s| s.count > 0 && &*s.item == item)
+        })
+        .min_by_key(|slot| {
+            if *slot == selected {
+                i32::MIN
+            } else if *slot == 40 {
+                i32::MIN + 1
+            } else {
+                (*slot as i32 - selected as i32).abs()
+            }
+        })
+}
+fn write_target(t: &Target, slot: usize) -> Value {
+    json!({"interacted":t.interacted,"placed":t.placed,"direction":t.direction,"point":t.point,"minY":t.min_y,"rotation":t.rotation,"slot":slot})
+}
+fn read_target(v: &Value) -> Option<Target> {
+    Some(Target {
+        interacted: serde_json::from_value(v["interacted"].clone()).ok()?,
+        placed: serde_json::from_value(v["placed"].clone()).ok()?,
+        direction: serde_json::from_value(v["direction"].clone()).ok()?,
+        point: serde_json::from_value(v["point"].clone()).ok()?,
+        min_y: v["minY"].as_f64()?,
+        rotation: serde_json::from_value(v["rotation"].clone()).ok()?,
+    })
+}
+impl Game<'_> {
+    pub(super) fn extinguish_query(&mut self, text: &str) -> Option<String> {
+        if !self.native_client_slot_owner() {
+            return None;
+        }
+        let q: Value = serde_json::from_str(text).ok()?;
+        match q["op"].as_str()? {
+            "facts" => {
+                let p = self.player.as_ref()?;
+                Some(json!({"onFire":p.fire_ticks>0,"fireResistance":p.status.fire_resistance,"evaporates":self.dimension_type().water_evaporates}).to_string())
+            }
+            "plan" => {
+                let pickup: Option<[i32; 3]> = serde_json::from_value(q["pickup"].clone()).ok();
+                let slot = nearest(
+                    self,
+                    if pickup.is_some() {
+                        "minecraft:bucket"
+                    } else {
+                        "minecraft:water_bucket"
+                    },
+                )?;
+                let stack = self.stack_in(slot)?.clone();
+                let predicted = if pickup.is_some() {
+                    None
+                } else {
+                    Some(world::with_scope(self, || {
+                        let epoch = world::read(world::current_epoch);
+                        let registry = world::read(NavigationRegistry::capture);
+                        let player = NativePlayer::new(NativeLevel::new(registry, epoch));
+                        let key = |i: usize| q["keys"][i] == true;
+                        let mut input = SimulatedInput::new(Input {
+                            forward: key(0),
+                            backward: key(1),
+                            left: key(2),
+                            right: key(3),
+                            jump: key(4),
+                            shift: key(5),
+                            sprint: key(6),
+                        });
+                        input.force_stay_on_ground_surface =
+                            horizon_client::navigation_physics::staying_on_surface(false);
+                        let mut sim = NativeSimulation::new(
+                            &player,
+                            input,
+                            q["movementYaw"].as_f64().unwrap_or(0.) as f32,
+                        );
+                        for tick in 0..=20 {
+                            if tick != 0 {
+                                sim.tick();
+                            }
+                            if sim.player().on_ground() {
+                                return Some(
+                                    sim.player()
+                                        .read(|p| [p.position.x, p.position.y, p.position.z]),
+                                );
+                            }
+                        }
+                        None
+                    })?)
+                };
+                let pos = pickup.or_else(|| predicted.map(|p| p.map(|v| v.floor() as i32)))?;
+                let rotation = serde_json::from_value(q["serverRotation"].clone()).ok()?;
+                let location = placement::capture_location(self, predicted, rotation)?;
+                let mut options = placement::Options::center(&stack, location);
+                let target = placement::find(self, pos, &mut options)?;
+                Some(write_target(&target, slot).to_string())
+            }
+            "execute" => {
+                let plan = &q["plan"];
+                let target = read_target(plan)?;
+                let rotation: [f32; 2] = serde_json::from_value(q["rotation"].clone()).ok()?;
+                let range = self.block_reach.max(self.entity_reach);
+                let hit = placement::verify(
+                    self,
+                    &target,
+                    rotation,
+                    range,
+                    placement::ClickTrace::World,
+                    placement::FailedClick::Nothing,
+                )?;
+                let slot = plan["slot"].as_u64()? as usize;
+                if slot != 40
+                    && !self
+                        .native_client_select_slot_silently(REQUESTER, slot as i32, 1)
+                        .ok()?
+                {
+                    return Some("false".into());
+                }
+                let hand = if slot == 40 { Hand::Off } else { Hand::Main };
+                let placed = target.placed;
+                let accepted =
+                    self.client_do_placement(hit, rotation, hand, "DoNotHide", |g, _| {
+                        g.native_client_extinguish_success(placed);
+                        true
+                    });
+                Some(json!(accepted).to_string())
+            }
+            _ => None,
+        }
+    }
+}
