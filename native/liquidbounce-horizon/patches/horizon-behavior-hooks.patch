@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! PlaceWater's real world planning and vanilla predicted bucket actions.
+use super::*;
+use horizon_client::no_web_model as model;
+#[path = "no_web_wire.rs"]
+mod wire;
+use serde_json::{Value, json};
+use std::cell::RefCell;
+pub(super) const REQUESTER: u64 = 0x4e4f_5745_42;
+struct NativeWorld<'a, 'r>(RefCell<&'a mut Game<'r>>);
+impl model::World for NativeWorld<'_, '_> {
+    fn block(&self, pos: model::Pos) -> model::Block {
+        let mut g = self.0.borrow_mut();
+        let state = g.world.block(pos[0], pos[1], pos[2]);
+        let facts = g.res.facts().get(state);
+        let web = &*facts.name == "minecraft:cobweb";
+        let air = g.res.facts().is_air(state);
+        let replaceable = facts.replaceable;
+        let fluid = facts.fluid;
+        let source = g
+            .fluid_height_of(pos[0], pos[1], pos[2], None)
+            .is_some_and(|(_, source)| source);
+        let outline = g
+            .outline_boxes(pos)
+            .iter()
+            .map(|b| std::array::from_fn(|i| b[i] - pos[i % 3] as f64))
+            .collect();
+        let center_support = g.with_level(|b, level, ticks| {
+            b.no_web_center_support(
+                level,
+                ticks,
+                horizon_core::position::BlockPos::new(pos[0], pos[1], pos[2]),
+            )
+        });
+        model::Block {
+            web,
+            air,
+            replaceable,
+            lava_source: source && fluid == Fluid::Lava,
+            water_source: source && fluid == Fluid::Water,
+            center_support,
+            outline,
+        }
+    }
+}
+fn now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |t| t.as_millis() as u64)
+}
+fn nearest(g: &Game<'_>, item: &str) -> Option<i32> {
+    let selected = g.client_hotbar_slot() as i32;
+    std::iter::once(40)
+        .chain(0..9)
+        .filter(|slot| {
+            if *slot == 40 {
+                g.offhand.as_ref()
+            } else {
+                g.inventory[*slot as usize].as_ref()
+            }
+            .is_some_and(|s| s.count > 0 && &*s.item == item)
+        })
+        .min_by_key(|slot| {
+            if *slot == selected {
+                i32::MIN
+            } else if *slot == 40 {
+                i32::MIN + 1
+            } else {
+                (*slot - selected).abs()
+            }
+        })
+}
+impl Game<'_> {
+    pub(super) fn no_web_plan(&mut self, value: &str) -> Option<String> {
+        if !self.native_client_slot_owner() {
+            return None;
+        }
+        let value: Value = serde_json::from_str(value).ok()?;
+        let mut state = model::NoWeb::default();
+        wire::read_state(&value, &mut state);
+        let eyes = self.eye_position()?;
+        let look = horizon_world::view_direction::view_vector(self.pitch, self.yaw);
+        let player = model::Player {
+            eyes,
+            look: [look.x, look.y, look.z],
+            reach: self.block_reach,
+            evaporates: self.dimension_type().water_evaporates,
+            water_slot: nearest(self, "minecraft:water_bucket"),
+            bucket_slot: nearest(self, "minecraft:bucket"),
+        };
+        let world = NativeWorld(RefCell::new(self));
+        let action = state.plan(&world, player, now());
+        Some(json!({"state":wire::state(&state),"action":action.map(wire::action),"rotation":action.map(|a|a.rotation(eyes))}).to_string())
+    }
+    fn no_web_trace(&self, rotation: [f32; 2], fluid: bool) -> Option<model::Hit> {
+        let eyes = self.eye_position()?;
+        let start = Vec3::new(eyes[0], eyes[1], eyes[2]);
+        let dir = horizon_world::view_direction::view_vector(rotation[1], rotation[0]);
+        let result = horizon_world::world_ray::clip_world(
+            &mut super::no_web_ray::NoWebRay(self),
+            start,
+            start.add_vector(dir.scale(self.block_reach)),
+            horizon_world::world_ray::RayBlockMode::Outline,
+            if fluid {
+                horizon_world::world_ray::RayFluidMode::SourceOnly
+            } else {
+                horizon_world::world_ray::RayFluidMode::None
+            },
+            256,
+        )
+        .ok()?;
+        if result.miss {
+            return None;
+        }
+        use horizon_core::geometry::Direction as D;
+        let h = result.hit;
+        Some(model::Hit {
+            pos: [h.block.x, h.block.y, h.block.z],
+            point: [h.location.x, h.location.y, h.location.z],
+            face: match h.direction {
+                D::Down => [0, -1, 0],
+                D::Up => [0, 1, 0],
+                D::North => [0, 0, -1],
+                D::South => [0, 0, 1],
+                D::West => [-1, 0, 0],
+                D::East => [1, 0, 0],
+            },
+        })
+    }
+    pub(super) fn no_web_execute(&mut self, value: &str) -> Option<String> {
+        if !self.native_client_slot_owner() {
+            return None;
+        }
+        let value: Value = serde_json::from_str(value).ok()?;
+        let action = wire::read_action(&value["action"])?;
+        let rotation = [
+            value["rotation"][0].as_f64()? as f32,
+            value["rotation"][1].as_f64()? as f32,
+        ];
+        let Some(hit) = action.resolve(
+            self.no_web_trace(rotation, false),
+            self.no_web_trace(rotation, true),
+        ) else {
+            return Some(json!({"attempted":false}).to_string());
+        };
+        if action.slot != 40
+            && !self
+                .native_client_select_slot_silently(REQUESTER, action.slot, 1)
+                .ok()?
+        {
+            return Some(json!({"attempted":true,"success":false}).to_string());
+        }
+        self.remote_send_carried();
+        let hand = if action.slot == 40 {
+            horizon_client::first_person::Hand::Off
+        } else {
+            horizon_client::first_person::Hand::Main
+        };
+        let old = self.forced_hit;
+        self.forced_hit = Some(Hit {
+            pos: hit.pos,
+            face: hit.face,
+            point: hit.point,
+        });
+        let used = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            self.native_with_item_rotation(rotation[0], rotation[1], |g| {
+                if g.remote_use_item_on(hand) {
+                    true
+                } else {
+                    let used = g.remote_use_item_rotated(hand, rotation[0], rotation[1]);
+                    if used {
+                        g.heights.item_used(hand);
+                    }
+                    used
+                }
+            })
+        }));
+        self.forced_hit = old;
+        let used = match used {
+            Ok(v) => v,
+            Err(e) => std::panic::resume_unwind(e),
+        };
+        let mut state = model::NoWeb::default();
+        wire::read_state(&value["state"], &mut state);
+        if used {
+            let world = NativeWorld(RefCell::new(self));
+            state.success(action, hit, now(), &world);
+        }
+        Some(json!({"attempted":true,"success":used,"state":wire::state(&state)}).to_string())
+    }
+}
diff --git a/crates/horizon-client/src/game/no_web_wire.rs b/crates/horizon-client/src/game/no_web_wire.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/no_web_wire.rs
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::model::{Action, ActionKind, Hit, NoWeb};
+use serde_json::{Value, json};
+pub fn hit(h: Hit) -> Value {
+    json!({"pos":h.pos,"face":h.face,"point":h.point})
+}
+fn pos(v: &Value) -> Option<[i32; 3]> {
+    Some([
+        v[0].as_i64()? as i32,
+        v[1].as_i64()? as i32,
+        v[2].as_i64()? as i32,
+    ])
+}
+pub fn read_hit(v: &Value) -> Option<Hit> {
+    Some(Hit {
+        pos: pos(&v["pos"])?,
+        face: pos(&v["face"])?,
+        point: [
+            v["point"][0].as_f64()?,
+            v["point"][1].as_f64()?,
+            v["point"][2].as_f64()?,
+        ],
+    })
+}
+pub fn action(a: Action) -> Value {
+    let kind = match a.kind {
+        ActionKind::Top { web, target, min_y } => {
+            json!({"type":"top","web":web,"target":target,"minY":min_y})
+        }
+        ActionKind::Directional { web, side } => {
+            json!({"type":"directional","web":web,"side":side})
+        }
+        ActionKind::Pickup { pos } => json!({"type":"pickup","pos":pos}),
+    };
+    json!({"slot":a.slot,"hit":hit(a.hit),"kind":kind})
+}
+pub fn read_action(v: &Value) -> Option<Action> {
+    let k = &v["kind"];
+    Some(Action {
+        slot: v["slot"].as_i64()? as i32,
+        hit: read_hit(&v["hit"])?,
+        kind: match k["type"].as_str()? {
+            "top" => ActionKind::Top {
+                web: pos(&k["web"])?,
+                target: pos(&k["target"])?,
+                min_y: k["minY"].as_f64()?,
+            },
+            "directional" => ActionKind::Directional {
+                web: pos(&k["web"])?,
+                side: pos(&k["side"])?,
+            },
+            "pickup" => ActionKind::Pickup {
+                pos: pos(&k["pos"])?,
+            },
+            _ => return None,
+        },
+    })
+}
+pub fn state(s: &NoWeb) -> Value {
+    json!({"webs":s.webs,"pickups":s.pickups,"last":s.last_success,"pickup":s.settings.pickup,"span":s.settings.pickup_span})
+}
+pub fn read_state(v: &Value, s: &mut NoWeb) {
+    s.webs = v["webs"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(pos)
+        .collect();
+    s.pickups = v["pickups"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|v| Some((pos(&v[0])?, v[1].as_u64()?)))
+        .collect();
+    s.last_success = pos(&v["last"][0]).zip(v["last"][1].as_u64());
+    s.settings.pickup = v["pickup"].as_bool().unwrap_or(true);
+    if let (Some(a), Some(b)) = (v["span"][0].as_f64(), v["span"][1].as_f64()) {
+        s.settings.pickup_span = [a as f32, b as f32];
+    }
+}
diff --git a/crates/horizon-client/src/game/no_web_ray.rs b/crates/horizon-client/src/game/no_web_ray.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/no_web_ray.rs
@@ -0,0 +1,87 @@
+//! BoatItem's server POV clip; deliberately separate from renderer/mining picks.
+use super::{Fluid, Game};
+use horizon_core::{
+    geometry::{Aabb, ShapeOp, Vec3, VoxelShape},
+    position::BlockPos,
+};
+use horizon_world::{
+    registry::BlockStateId,
+    world_ray::{RayBlockMode, RayFluidMode, RayWorld, clip_world},
+};
+use std::io;
+
+pub(super) struct NoWebRay<'a, 'r>(pub(super) &'a Game<'r>);
+impl RayWorld for NoWebRay<'_, '_> {
+    type Error = io::Error;
+    type Block = BlockStateId;
+    type Fluid = Option<(f32, bool, Fluid)>;
+    fn block_state(&mut self, p: BlockPos) -> io::Result<BlockStateId> {
+        Ok(self.0.world.block(p.x, p.y, p.z))
+    }
+    fn fluid_state(&mut self, p: BlockPos) -> io::Result<Self::Fluid> {
+        Ok(self
+            .0
+            .fluid_height_of(p.x, p.y, p.z, None)
+            .map(|(h, source)| {
+                (
+                    h,
+                    source,
+                    self.0
+                        .res
+                        .facts()
+                        .get(self.0.world.block(p.x, p.y, p.z))
+                        .fluid,
+                )
+            }))
+    }
+    fn block_shape(
+        &mut self,
+        state: BlockStateId,
+        p: BlockPos,
+        _: RayBlockMode,
+    ) -> io::Result<VoxelShape> {
+        // LiquidBlock.getShape is empty. Waterlogged blocks retain their outline.
+        if matches!(
+            &*self.0.res.facts().get(state).name,
+            "minecraft:water" | "minecraft:lava" | "minecraft:bubble_column"
+        ) {
+            return Ok(VoxelShape::empty());
+        }
+        let mut shape = VoxelShape::empty();
+        for b in self.0.outline_boxes([p.x, p.y, p.z]) {
+            let b: [f64; 6] = std::array::from_fn(|i| b[i] - f64::from([p.x, p.y, p.z][i % 3]));
+            let part = VoxelShape::from_box(Aabb::new(
+                Vec3::new(b[0], b[1], b[2]),
+                Vec3::new(b[3], b[4], b[5]),
+            ))
+            .map_err(|e| io::Error::other(format!("{e:?}")))?;
+            shape = shape
+                .join(&part, ShapeOp::OR)
+                .map_err(|e| io::Error::other(format!("{e:?}")))?;
+        }
+        Ok(shape)
+    }
+    fn interaction_shape(&mut self, _: BlockStateId, _: BlockPos) -> io::Result<VoxelShape> {
+        // Pinned vanilla's registered interaction shapes are all empty;
+        // interaction_shapes::InteractionShapes validates that same table.
+        Ok(VoxelShape::empty())
+    }
+    fn fluid_is_source(&mut self, s: Self::Fluid) -> io::Result<bool> {
+        Ok(s.is_some_and(|s| s.1))
+    }
+    fn fluid_is_empty(&mut self, s: Self::Fluid) -> io::Result<bool> {
+        Ok(s.is_none())
+    }
+    fn fluid_is_water(&mut self, s: Self::Fluid) -> io::Result<bool> {
+        Ok(s.is_some_and(|s| s.2 == Fluid::Water))
+    }
+    fn fluid_shape(&mut self, s: Self::Fluid, _: BlockPos) -> io::Result<VoxelShape> {
+        match s {
+            None => Ok(VoxelShape::empty()),
+            Some((h, _, _)) => {
+                VoxelShape::from_box(Aabb::new(Vec3::ZERO, Vec3::new(1.0, f64::from(h), 1.0)))
+                    .map_err(|e| io::Error::other(format!("{e:?}")))
+            }
+        }
+    }
+}
