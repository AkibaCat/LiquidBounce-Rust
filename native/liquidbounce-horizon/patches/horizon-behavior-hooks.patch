+            .into_iter()
+            .enumerate()
+        {
+            q[i].clip = (p + Vec4::new(n.x * sign * p.w, n.y * sign * p.w, 0., 0.)).to_array();
+        }
+        for i in [0, 1, 2, 0, 2, 3] {
+            out.push(q[i]);
+        }
+    }
