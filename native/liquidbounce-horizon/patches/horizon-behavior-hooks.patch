+}
+impl horizon_client::anti_hunger_bridge::ClientPacketPlayer for AntiHungerPacketPlayer<'_, '_, '_> {
+    fn snapshot(&self) -> horizon_client::anti_hunger_bridge::Snapshot {
+        let world = self.world.borrow();
+        let p = &world.player;
+        horizon_client::anti_hunger_bridge::Snapshot {
+            swimming: p.swimming,
+            passenger: self.passenger,
+            destroying: self.destroying,
+            in_water: p.fluids.was_touching_water,
+            under_water: p.is_under_water(),
+            fall_distance: p.fall_distance,
+        }
+    }
+    fn liquid_walk_context(&self)->Option<([bool;4],bool)>{let world=self.world.borrow();Some((horizon_client::liquid_walk_native::context(world.scene,world.player,world.collision_binding),world.player.fluids.was_touching_water))}
+    fn criticals_snapshot(&self)->Option<serde_json::Value>{
+        let mut v=self.criticals.clone()?;let world=self.world.borrow();let p=&world.player;
+        let no_liquid_walk=!(horizon_world::liquid_walk::mode().is_some()&&horizon_client::liquid_walk_native::row(world.scene,world.collision_binding,p.bounds(),0.01));
+        let allows=v["staticAllows"].as_bool().unwrap_or(false)&&!p.fluids.was_touching_water&&!p.is_in_lava()&&!p.on_climbable&&!p.flying&&no_liquid_walk;
+        v["allowsCritical"]=serde_json::json!(allows);v["onGround"]=serde_json::json!(p.ground.on_ground);v["sprinting"]=serde_json::json!(p.sprinting);v["fallDistance"]=serde_json::json!(p.fall_distance);v["y"]=serde_json::json!(p.position.y);v["oldY"]=serde_json::json!(p.old_position.y);v["tickCount"]=serde_json::json!(p.health.tick_count);Some(v)
+    }
+    fn no_slow_block_air(&self,pos:[i32;3])->Option<bool>{
+        let world=self.world.borrow();let state=world.scene.block(pos[0],pos[1],pos[2]);
+        Some(world.assets.registry.state(state).is_none_or(|v|matches!(v.name.as_str(),"minecraft:air"|"minecraft:cave_air"|"minecraft:void_air")))
+    }
+    fn anti_void_dead(&self)->Option<bool>{Some(self.world.borrow().player.health.dead_or_dying())}
+    fn jump_from_ground(&self) {
+        if let Err(error) = self.world.borrow_mut().jump_from_ground() {
+            eprintln!("[LiquidBounce] AntiHunger jump: {error}");
+        }
+    }
+}
+impl Game<'_> {
+    pub(super) fn native_send_with_anti_hunger(&mut self, packet: S) {
+        horizon_client::no_slow_bridge::set_context(self.no_slow_context());
+        let owner = self.native_window()
+            && self.lan_acting_uuid.is_none()
+            && self.lan_acting.is_none()
+            && self
+                .player
+                .as_ref()
+                .is_some_and(|p| p.client_side && p.native_client_queries_allowed());
+        let Some(remote) = self.remote.as_ref() else {
+            return;
+        };
+        if !owner {
+            remote.session.send(packet);
+            return;
+        }
+        self.native_client_fake_lag_capture();
+        let mut criticals=self.native_client_criticals_context();
+        if let Some(v)=criticals.as_mut(){v["staticAllows"]=serde_json::json!(!self.hands_busy()&&self.riding.is_none()&&!self.client_crosshair_in_web()&&!["levitation","blindness","slow_falling"].into_iter().any(|id|self.potions.effects.get(id).is_some()));}
+        let passenger = self.riding.is_some();
+        let destroying = remote.is_destroying;
+        let Some(player) = self.player.as_mut() else {
+            return;
+        };
+        player.client_high_jump_owner = true;
+        let live = AntiHungerPacketPlayer {
+            world: std::cell::RefCell::new(horizon_client::motion::MotionWorld {step_sender:None,
+                entities: &[],
+                player,
+                scene: &mut self.world,
+                assets: &self.pack.assets,
+                collision_binding: self.collision,
+                resources: self.motion,
+                health: &self.health_resources,
+            }),
+            passenger,
+            destroying,
+            criticals,
+        };
+        remote.session.send_with_client_player(packet, &live);
+    }
+}
