+++ b/crates/horizon-world/src/no_slow_policy.rs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Policy shared with the world crate, active only inside real local-player calls.
+use std::cell::Cell;
+use std::marker::PhantomData;
+use std::rc::Rc;
+use std::sync::RwLock;
+static POLICY: RwLock<[f64; 12]> = RwLock::new([-1.; 12]);
+thread_local! {static OWNER:Cell<bool>=const{Cell::new(false)};}
+/// The scope is thread-bound and restores the enclosing owner even on early return.
+/// A nested server/replay call explicitly installs false instead of inheriting true.
+pub struct OwnerScope {
+    previous: bool,
+    _thread: PhantomData<Rc<()>>,
+}
+impl Drop for OwnerScope {
+    fn drop(&mut self) {
+        OWNER.with(|owner| owner.set(self.previous));
+    }
+}
+pub fn owner_scope(active: bool) -> OwnerScope {
+    OwnerScope {
+        previous: OWNER.with(|owner| owner.replace(active)),
+        _thread: PhantomData,
+    }
+}
+fn owned() -> bool {
+    OWNER.with(Cell::get)
+}
+pub fn configure(values: [f64; 12]) {
+    *POLICY.write().expect("NoSlow policy") = values;
+}
+pub fn get() -> [f64; 12] {
+    *POLICY.read().expect("NoSlow policy")
+}
+pub fn running() -> bool {
+    owned() && get()[0] == 1.
+}
+pub fn factor(index: usize) -> Option<f32> {
+    let p = get();
+    (owned() && p[0] == 1. && p[index] >= 0.).then_some(p[index] as f32)
+}
+pub fn block_factor(name: &str, original: f32) -> f32 {
+    match name {
+        "minecraft:soul_sand" => factor(2),
+        "minecraft:slime_block" => factor(3),
+        "minecraft:honey_block" => factor(4),
+        _ => None,
+    }
+    .unwrap_or(original)
+}
+pub fn friction(name: &str, original: f32) -> f32 {
+    if name == "minecraft:slime_block" && factor(3).is_some() {
+        0.6
+    } else {
+        original
+    }
+}
+pub fn fluid_push() -> bool {
+    let p = get();
+    !owned() || p[0] != 1. || p[6] != 1.
+}
+pub fn fluid_collision() -> bool {
+    let p = get();
+    !owned() || p[0] != 1. || p[6] != 1. || p[7] == 1.
+}
diff --git a/crates/horizon-client/src/no_slow_bridge.rs b/crates/horizon-client/src/no_slow_bridge.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/no_slow_bridge.rs
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+pub use horizon_world::no_slow_policy::{configure, get, running};
+use std::cell::{Cell, RefCell};
+thread_local! {static LIVE:RefCell<Option<[f64;15]>>=const{RefCell::new(None)};static UNTRACKED:Cell<u32>=const{Cell::new(0)};static RECURSION:Cell<u32>=const{Cell::new(0)};}
+pub fn context() -> Option<[f64; 15]> {
+    LIVE.with(|v| *v.borrow())
+}
+pub fn set_context(value: Option<[f64; 15]>) {
+    LIVE.with(|v| *v.borrow_mut() = value);
+}
+pub fn untracked() -> bool {
+    UNTRACKED.with(|v| v.get() != 0)
+}
+pub fn without_tracking<T>(f: impl FnOnce() -> T) -> T {
+    struct Guard;
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            UNTRACKED.with(|v| v.set(v.get() - 1));
+        }
+    }
+    UNTRACKED.with(|v| v.set(v.get() + 1));
+    let _guard = Guard;
+    f()
+}
+// The original nested Intave send reaches the same packet listener. End the
+// recursion after the replacement reaches its fixed point (block centre).
+pub fn intave_nested<T>(f: impl FnOnce() -> T) -> Option<T> {
+    if RECURSION.with(|v| v.get() != 0) {
+        return None;
+    }
+    struct Guard;
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            RECURSION.with(|v| v.set(v.get() - 1));
+        }
+    }
+    RECURSION.with(|v| v.set(v.get() + 1));
+    let _guard = Guard;
+    Some(f())
+}
+pub fn modify_input(
+    input: [f32; 2],
+    item: Option<f32>,
+    sneak: Option<f32>,
+    shift: bool,
+    owner: bool,
+) -> [f32; 2] {
+    if !owner {
+        return crate::input::modify_input(input, item, sneak);
+    }
+    let p = get();
+    if p[0] != 1. {
+        return crate::input::modify_input(input, item, sneak);
+    }
+    let sneak = sneak.map(|v| {
+        if shift && p[1] >= 0. {
+            v.max(p[1] as f32)
+        } else {
+            v
+        }
+    });
+    crate::input::modify_input_axes(
+        input,
+        item.map(|v| {
+            [
+                if p[10] >= 0. { p[10] as f32 } else { v },
+                if p[9] >= 0. { p[9] as f32 } else { v },
+            ]
+        }),
+        sneak,
+    )
+}
diff --git a/crates/horizon-client/src/game/no_slow.rs b/crates/horizon-client/src/game/no_slow.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/no_slow.rs
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::*;
+use horizon_client::no_slow_bridge as bridge;
+use horizon_protocol::packets::play::{self, Serverbound as S};
+impl Game<'_> {
+    fn no_slow_action(&self, stack: Option<&ItemStack>) -> u8 {
+        let Some(stack) = stack else {
+            return 0;
+        };
+        if let Some(cons) = self.consumable(stack) {
+            use horizon_world::consumable::UseAnimation as A;
+            return match cons.animation {
+                A::None => 0,
+                A::Eat => 1,
+                A::Drink => 2,
+                A::Block => 3,
+                A::Spyglass => 4,
+                A::TootHorn => 5,
+                A::Brush => 6,
+                A::Bow => 7,
+                A::Trident => 8,
+                A::Crossbow => 9,
+                A::Bundle => 10,
+                A::Spear => 11,
+            };
+        }
+        if self.blocks_attacks(stack).is_some() {
+            return 3;
+        }
+        match &*stack.item {
+            "minecraft:spyglass" => 4,
+            "minecraft:goat_horn" => 5,
+            "minecraft:brush" => 6,
+            "minecraft:bow" => 7,
+            "minecraft:trident" => 8,
+            "minecraft:crossbow" => 9,
+            name if name.ends_with("bundle") => 10,
+            name if horizon_client::spear::Kinetic::of(name).is_some() => 11,
+            _ => 0,
+        }
+    }
+    pub(super) fn no_slow_context(&self) -> Option<[f64; 15]> {
+        if !self.native_client_slot_owner() {
+            return None;
+        }
+        let p = self.player.as_ref()?;
+        let used = self.using.and_then(|(slot, _)| self.stack_in(slot));
+        let action = self.no_slow_action(used);
+        let ticks = self.using.map_or(0, |(_, t)| t as i32);
+        let block = self
+            .using
+            .and_then(|(slot, t)| {
+                let component = self.blocks_attacks(self.stack_in(slot)?)?;
+                Some(t as i32 >= (component.delay_seconds * 20.).round() as i32)
+            })
+            .unwrap_or(false);
+        Some([
+            f64::from(u8::from(self.using.is_some())),
+            f64::from(action),
+            f64::from(u8::from(matches!(self.used_hand(), Some(Hand::Off)))),
+            f64::from(ticks),
+            f64::from((self.use_duration - ticks).max(0)),
+            f64::from(u8::from(block)),
+            f64::from(u8::from(p.move_vector != [0., 0.])),
+            self.selected as f64,
+            f64::from(u8::from(p.shift_key_down)),
+            f64::from(
+                self.no_slow_action(self.inventory.get(self.selected).and_then(Option::as_ref)),
+            ),
+            f64::from(self.no_slow_action(self.offhand.as_ref())),
+            f64::from(u8::from(action == 3)),
+            f64::from(self.yaw),
+            f64::from(self.pitch),
+            f64::from(u8::from(used.is_some_and(|s| self.consumable(s).is_some()))),
+        ])
+    }
+    pub(super) fn no_slow_send(&mut self, text: &str) {
+        if !self.native_client_slot_owner() {
+            return;
+        }
+        let Ok(actions) = serde_json::from_str::<Vec<serde_json::Value>>(text) else {
+            return;
+        };
+        for action in actions {
+            let send = |g: &mut Self| {
+                match action["kind"].as_str().unwrap_or("") {
+                    "carried" => {
+                        g.send(S::SetCarriedItem(play::SetCarriedItem {
+                            slot: action["slot"].as_i64().unwrap_or(0) as i16,
+                        }));
+                    }
+                    "use" => {
+                        if g.remote.is_none() {
+                            return;
+                        }
+                        let sequence = if action["predict"] == true {
+                            g.next_sequence()
+                        } else {
+                            0
+                        };
+                        g.send(S::UseItem(play::UseItem {
+                            hand: action["hand"].as_i64().unwrap_or(0) as i32,
+                            sequence,
+                            yaw: g.yaw,
+                            pitch: g.pitch,
+                        }));
+                    }
+                    "release" => {
+                        let pos = if action["player"] == true {
+                            g.player
+                                .as_ref()
+                                .map(|p| {
+                                    [
+                                        p.position.x.floor() as i32,
+                                        p.position.y.floor() as i32,
+                                        p.position.z.floor() as i32,
+                                    ]
+                                })
+                                .unwrap_or([0; 3])
+                        } else {
+                            [0; 3]
+                        };
+                        g.send(S::PlayerAction(play::PlayerAction {
+                            action: 5,
+                            pos,
+                            direction: if action["player"] == true { 1 } else { 0 },
+                            sequence: 0,
+                        }));
+                    }
+                    "stop" => {
+                        if let Some((slot, ticks)) = g.using
+                            && let Some(stack) = g.stack_in(slot).cloned()
+                        {
+                            g.release_used_item(&stack, ticks, false);
+                        }
+                    }
+                    // The pinned target has no ViaFabricPlus connection. Original helpers
+                    // intentionally emit nothing without it; the mode still shows its warning.
+                    "legacySneak" => {}
+                    _ => {}
+                }
+            };
+            if action["untracked"] == true {
+                bridge::without_tracking(|| send(self));
+            } else {
+                send(self);
+            }
+        }
+    }
+    pub(super) fn no_slow_slowness(&mut self, multiplier: f32) {
+        if !self.native_client_slot_owner() {
+            return;
+        }
+        let Some(level) = self.potions.effects.amplifier("slowness") else {
+            return;
+        };
+        let Some(p) = self.player.as_mut() else {
+            return;
+        };
+        use horizon_world::attributes::{Modifier, Operation};
+        let Some(key) = p.attributes.key("minecraft:movement_speed") else {
+            return;
+        };
+        let Ok(Some(handle)) = p.attributes.get_instance(Some(key)) else {
+            return;
+        };
+        let Ok(modifier) = Modifier::new(
+            "minecraft:effect.slowness",
+            -f64::from(multiplier) * (f64::from(level) + 1.),
+            Operation::AddMultipliedTotal,
+        ) else {
+            return;
+        };
+        let _ = p.attributes.edit(&handle, |value, observer| {
+            value.add_or_update_transient(modifier, observer)
+        });
+    }
+}
