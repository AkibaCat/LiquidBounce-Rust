+// SPDX-License-Identifier: GPL-3.0-or-later
+//! AutoMobHeal reads the actual render mobs, stack components and client result.
+use super::{Game, Hand, InteractTarget, Screen};
+use horizon_client::items::ItemStack;
+use horizon_core::geometry::Vec3;
+use serde_json::{Value, json};
+fn kind(id: &str) -> Option<&'static str> {
+    Some(match id {
+        "minecraft:iron_golem" => "IronGolem",
+        "minecraft:wolf" => "Wolf",
+        "minecraft:cat" => "Cat",
+        "minecraft:horse" | "minecraft:donkey" | "minecraft:mule" => "HorseFamily",
+        "minecraft:zombie_horse" => "ZombieHorse",
+        "minecraft:llama" | "minecraft:trader_llama" => "Llama",
+        "minecraft:camel" => "Camel",
+        "minecraft:camel_husk" => "CamelHusk",
+        "minecraft:nautilus" | "minecraft:zombie_nautilus" => "Nautilus",
+        _ => return None,
+    })
+}
+impl Game<'_> {
+    pub(super) fn auto_mob_heal_query(&mut self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else { return "null".into(); };
+        if q["op"] == "interact" {
+            let Some(id) = q["id"].as_i64().and_then(|id| i32::try_from(id).ok()) else { return "false".into(); };
+            let Some(i) = self.mobs.iter().position(|m| m.id as i32 == id && !m.removed) else { return "false".into(); };
+            let at = self.mobs[i].position;
+            if !self.border.contains(at.x.floor(), at.z.floor()) { return "false".into(); }
+            let hand = if q["offhand"] == true { Hand::Off } else { Hand::Main };
+            self.remote_send_carried();
+            let hide = q["swingMode"] == "HideForClient";
+            // Interaction swings are client animation only; no Punch packet.
+            let consumed = if self.remote.is_some() {
+                self.send(horizon_protocol::packets::play::Serverbound::Interact(horizon_protocol::packets::play::Interact {
+                    id, hand: if hand == Hand::Off { 1 } else { 0 }, location: [0.; 3], secondary: self.remote_shift_down(),
+                }));
+                let takes = self.remote_mob_takes(i, hand);
+                if takes {
+                    self.remote_feed_particles(i, hand);
+                    if !hide && self.remote_mob_swings(i, hand) {
+                        self.swing_hand(hand, self.auto_rod_animation(hand));
+                    }
+                }
+                takes
+            } else {
+                let previous = self.client_auto_rod_swing.replace(hide);
+                let result = self.with_hand(hand, |g| g.interact_entity(Some(InteractTarget { id, location: [0.; 3] }))).unwrap_or(false);
+                self.client_auto_rod_swing = previous;
+                result
+            };
+            return json!(consumed).to_string();
+        }
+        if q["op"] != "facts" { return "null".into(); }
+        let entity_range = self.interaction_range("minecraft:entity_interaction_range", 3., 5.);
+        let Some(eye) = self.eye_position().map(|p| Vec3::new(p[0], p[1], p[2])) else { return "null".into(); };
+        let owner = self.acting_uuid();
+        let entities = self.mobs.iter().filter(|m| !m.removed).filter_map(|m| {
+            let kind = kind(&m.kind.id)?;
+            let mut armor = m.extra.body.as_ref().map(|id| ItemStack::new(id.as_ref(), 1));
+            if let Some(armor) = armor.as_mut() {
+                armor.damage = m.extra.body_damage.max(0) as u32;
+                armor.extra = m.extra.body_extra.clone();
+            }
+            let slots = std::iter::once(40).chain(0..9).filter_map(|index| {
+                let stack = self.stack_in(index).filter(|s| s.count > 0 && &*s.item != "minecraft:air")?;
+                let view = horizon_client::item_render::stack_view(stack);
+                let components = self.pack.item_renderer.models.components_view(&view);
+                let repairs = armor.as_ref().is_some_and(|a| horizon_client::stations::is_valid_repair_item(&self.stations().enchantments, self.items(), a, stack));
+                Some(json!({"index":index,"item":stack.item.as_ref(),"nutrition":components.get("minecraft:food").and_then(|f| f["nutrition"].as_i64()),"wolfFood":self.items().item_in_tag("minecraft:wolf_food", &stack.item),"catFood":self.items().item_in_tag("minecraft:cat_food", &stack.item),"repairsArmor":repairs}))
+            }).collect::<Vec<_>>();
+            let target_eye = Vec3::new(m.position.x, m.position.y + m.eye_height(), m.position.z);
+            let visible = super::spear_kill_ray::clip(self, eye, target_eye).is_some_and(|hit| hit.0);
+            Some(json!({"id":m.id,"kind":kind,"alive":m.alive(),"visible":visible,"health":m.health,"maxHealth":m.attrs.max_health,"distanceSquared":m.bounds().distance_squared_to_point(eye),"baby":m.is_baby(),"tame":m.extra.tame,"owned":m.extra.owner==Some(owner),"sitting":m.extra.sitting_pose,"wearingBodyArmor":armor.is_some(),"armorEmpty":armor.as_ref().is_none_or(|a| a.count==0||&*a.item=="minecraft:air"),"armorMaxDamage":armor.as_ref().map_or(0,|a| self.items().stack_max_damage(a)),"armorDamage":m.extra.body_damage,"slots":slots}))
+        }).collect::<Vec<_>>();
+        json!({"entities":entities,"selected":self.client_hotbar_slot(),"entityRange":entity_range,"secondaryUse":self.player.as_ref().is_some_and(|p| p.shift_key_down),"usingItem":self.using.is_some(),"screenOpen":self.screen!=Screen::Playing}).to_string()
+    }
+}
diff --git a/crates/horizon-client/src/game/logoff_spot.rs b/crates/horizon-client/src/game/logoff_spot.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/logoff_spot.rs
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// LiquidBounce ae0eb396 ModuleLogoffSpot: real, client-owned RemotePlayer equivalents.
+use super::Game;
+use horizon_client::mobs::Mob;
+use serde_json::{Value, json};
+pub(super) struct LoggedOffPlayer {
+    pub id: u32,
+    pub original_id: i32,
+    pub original_join: u64,
+    pub name: String,
+    pub _time: std::time::SystemTime,
+}
+impl Game<'_> {
+    fn client_logoff_options(&mut self) -> bool {
+        let mut out = String::new();
+        self.native_client_logoff_spot(r#"{"action":"options"}"#, &mut out);
+        serde_json::from_str::<Value>(&out).is_ok_and(|v| v["running"] == true)
+    }
+    fn client_logoff_sync(&mut self) {
+        let ids: Vec<i32> = self
+            .client_logoff_spots
+            .values()
+            .map(|p| p.id as i32)
+            .collect();
+        self.native_client_logoff_spot(
+            &json!({"action":"ids","ids":ids}).to_string(),
+            &mut String::new(),
+        );
+    }
+    fn client_logoff_message(&mut self, kind: &str, args: Value) {
+        self.native_client_logoff_spot(
+            &json!({"action":"message","kind":kind,"args":args}).to_string(),
+            &mut String::new(),
+        );
+    }
+    fn client_logoff_remove(&mut self, id: u32) {
+        self.mobs.retain(|m| m.id != id);
+        self.persist.uuids.remove(&id);
+        self.client_logoff_remove_identity(id as i32);
+    }
+    pub(super) fn client_logoff_clear(&mut self) {
+        let old = std::mem::take(&mut self.client_logoff_spots);
+        for p in old.into_values() {
+            self.client_logoff_remove(p.id);
+        }
+        self.native_client_logoff_spot(r#"{"action":"reset"}"#, &mut String::new());
+    }
+    fn client_logoff_health(&self, name: &str, native: f32) -> f32 {
+        let Some(o) = self.score.board.display_objective("below_name") else {
+            return native;
+        };
+        if !["❤", "HP", "Health", "Здоровья", "Здоровье"]
+            .iter()
+            .any(|s| o.display_text().plain().contains(s))
+        {
+            return native;
+        }
+        self.score
+            .board
+            .score(name, &o.name)
+            .map_or(native, |s| s.value as f32)
+    }
+    // Called before RemoveEntities erases its profile maps, and on direct client removals.
+    // The origin's join token suppresses the second call for the same removal.
+    pub(super) fn client_logoff_capture(&mut self, ids: &[i32]) {
+        // All playable windows, including single player/LAN, are remote clients of
+        // their server. Never insert these into an authoritative server Game.
+        if !self.native_window() || self.remote.is_none() || self.lan_acting_uuid.is_some() {
+            return;
+        }
+        if !self.client_logoff_options() {
+            self.client_logoff_clear();
+            return;
+        }
+        for &original_id in ids {
+            if self.native_client_blink_dummy() == Some(original_id)
+                || self
+                    .client_logoff_spots
+                    .values()
+                    .any(|p| p.id == original_id as u32)
+            {
+                continue;
+            }
+            let Some(source) = self
+                .mobs
+                .iter()
+                .find(|m| m.id == original_id as u32 && &*m.kind.id == "minecraft:player")
+                .cloned()
+            else {
+                continue;
+            };
+            let Some(profile) = self.remote_player_uuid(source.id) else {
+                continue;
+            };
+            let uuid = self
+                .persist
+                .uuids
+                .get(&source.id)
+                .map_or(profile, |u| horizon_client::lan::playerdata::ints_uuid(*u));
+            let join = source.join.get();
+            if self
+                .client_logoff_spots
+                .get(&uuid)
+                .is_some_and(|p| p.original_id == original_id && p.original_join == join)
+            {
+                continue;
+            }
+            let Some(name) = self.remote_player_name(source.id).map(str::to_owned) else {
+                continue;
+            };
+            let Some(kind) = self.res.player_type().clone() else {
+                continue;
+            };
+            static NEXT: std::sync::atomic::AtomicI32 =
+                std::sync::atomic::AtomicI32::new(-1_000_000_000);
+            let id = loop {
+                let id = NEXT.fetch_sub(1, std::sync::atomic::Ordering::Relaxed) as u32;
+                if self.native_entity(id).is_none() {
+                    break id;
+                }
+            };
+            let mut fake = Mob::new(id, kind, source.position, source.yaw);
+            super::remote_mob_data::client_defaults(&mut fake);
+            fake.previous = source.position;
+            fake.head_yaw = source.head_yaw;
+            fake.previous_head_yaw = source.head_yaw;
+            fake.head_pitch = source.head_pitch;
+            fake.previous_head_pitch = source.head_pitch;
+            fake.health = self.client_logoff_health(&name, source.health);
+            fake.skin = source.skin.clone();
+            fake.slim = source.slim;
+            fake.skin_3d = source.skin_3d.clone();
+            fake.cape = source.cape.clone();
+            // Fresh player defaults; copy inventory without stale pose/effects/hurt state.
+            let gear = source.equipment_stacks();
+            fake.extra.set_main_hand_stack(gear[0].clone());
+            fake.extra.off_hand = source.extra.off_hand.clone();
+            fake.extra.head = source.extra.head.clone();
+            fake.extra.chest = source.extra.chest.clone();
+            fake.extra.legs = source.extra.legs.clone();
+            fake.extra.feet = source.extra.feet.clone();
+            fake.extra.armor = source.extra.armor.clone();
+            self.persist
+                .uuids
+                .insert(id, horizon_client::save::random_uuid());
+            self.client_logoff_add_identity(original_id, id as i32, profile, name.clone());
+            self.mobs.push(fake);
+            self.client_logoff_spots.insert(
+                uuid,
+                LoggedOffPlayer {
+                    id,
+                    original_id,
+                    original_join: join,
+                    name: name.clone(),
+                    _time: std::time::SystemTime::now(),
+                },
+            );
+            self.client_logoff_message(
+                "disappeared",
+                json!([
+                    name,
+                    source.position.x.floor() as i32,
+                    source.position.y.floor() as i32,
+                    source.position.z.floor() as i32
+                ]),
+            );
+        }
+        self.client_logoff_sync();
+    }
+    pub(super) fn client_logoff_tick(&mut self) {
+        if !self.native_window() {
+            return;
+        }
+        if !self.client_logoff_options() {
+            self.client_logoff_clear();
+            return;
+        }
+        let mut removed = vec![];
+        for (&uuid, p) in &self.client_logoff_spots {
+            let unloaded = self.mobs.iter().find(|m| m.id == p.id).is_none_or(|m| {
+                !self
+                    .world
+                    .loaded(m.position.x.floor() as i32, m.position.z.floor() as i32)
+            });
+            // Profile UUIDs are kept for skin lookup; exclude the random-UUID fakes.
+            let reappeared = self
+                .mobs
+                .iter()
+                .filter(|m| !m.removed && &*m.kind.id == "minecraft:player")
+                .any(|m| {
+                    self.persist
+                        .uuids
+                        .get(&m.id)
+                        .is_some_and(|u| horizon_client::lan::playerdata::ints_uuid(*u) == uuid)
+                });
+            if unloaded || reappeared {
+                removed.push((uuid, if unloaded { "unloaded" } else { "reappeared" }));
+            }
+        }
+        for (uuid, kind) in removed {
+            if let Some(p) = self.client_logoff_spots.remove(&uuid) {
+                self.client_logoff_remove(p.id);
+                self.client_logoff_message(kind, json!([p.name]));
+            }
+        }
+        self.client_logoff_sync();
+    }
+}
diff --git a/crates/horizon-client/src/game/inventory_tracker_native.rs b/crates/horizon-client/src/game/inventory_tracker_native.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/inventory_tracker_native.rs
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Client-side RemotePlayer inventories and ItemStack object references.
+//! A handle names one received stack object, never a value-based item key.
+use super::{Game, ItemStack};
+use horizon_client::mobs::Mob;
+use serde_json::{Value, json};
+use std::collections::{HashMap, HashSet};
+
+pub(super) const SCREEN: &str = "liquidbounce:invsee";
+pub(super) const SLOTS: [&str; 8] = [
+    "mainhand", "offhand", "feet", "legs", "chest", "head", "body", "saddle",
+];
+
+#[derive(Clone)]
+pub(super) struct Player {
+    pub token: u64,
+    pub id: i32,
+    pub uuid: String,
+    pub name: String,
+    pub current: bool,
+    pub saved: bool,
+    pub tracked: bool,
+    pub inventory: [u64; 36],
+    pub equipment: [u64; 8],
+    pub crafting: [u64; 5],
+    pub carried: u64,
+    pub model: Option<Mob>,
+}
+impl Player {
+    fn new(token: u64, id: i32, uuid: String, name: String) -> Self {
+        Self {
+            token,
+            id,
+            uuid,
+            name,
+            current: true,
+            saved: false,
+            tracked: false,
+            inventory: [0; 36],
+            equipment: [0; 8],
+            crafting: [0; 5],
+            carried: 0,
+            model: None,
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct State {
+    pub players: HashMap<u64, Player>,
+    pub stacks: HashMap<u64, ItemStack>,
+    pub viewed: Option<String>,
+    pub pending_open: Option<String>,
+    pub tooltip: Option<u64>,
+    pub completion_signature: Option<String>,
+    pub completion_owned: bool,
+}
+impl State {
+    fn allocate(&mut self, stack: Option<&ItemStack>) -> u64 {
+        let Some(stack) = stack.filter(|s| s.count > 0 && &*s.item != "minecraft:air") else {
+            return 0;
+        };
+        let handle = stack.object_identity();
+        self.stacks.insert(handle, stack.clone());
+        handle
+    }
+    fn same_or_new(&mut self, old: u64, stack: Option<&ItemStack>) -> u64 {
+        let _ = old;
+        self.allocate(stack)
+    }
+    pub fn stack(&self, handle: u64) -> Option<&ItemStack> {
+        self.stacks.get(&handle)
+    }
+    pub fn item(&self, handle: u64) -> Value {
+        self.stack(handle).map_or(Value::Null, |s| {
+            // ItemEnchantments is a map: its equality does not depend on
+            // the order components happened to arrive in the packet.
+            let enchantments: std::collections::BTreeMap<&str, u32> = s
+                .enchantments()
+                .iter()
+                .map(|(id, level)| (&**id, *level))
+                .collect();
+            json!({"handle":handle,"item":s.item.as_ref(),"count":s.count,"enchantments":enchantments})
+        })
+    }
+    pub fn resolve(&self, uuid: &str) -> Option<&Player> {
+        self.players
+            .values()
+            .find(|p| p.uuid == uuid && p.current)
+            .or_else(|| self.players.values().find(|p| p.uuid == uuid && p.saved))
+    }
+    fn reset(&mut self) {
+        let tracked: HashSet<String> = self
+            .players
+            .values()
+            .filter(|p| p.tracked)
+            .map(|p| p.uuid.clone())
+            .collect();
+        for p in self.players.values_mut() {
+            if p.current && tracked.contains(&p.uuid) {
+                p.inventory[1..].fill(0);
+            }
+            p.saved = false;
+            p.tracked = false;
+        }
+        self.players.retain(|_, p| p.current);
+        let live: HashSet<u64> = self
+            .players
+            .values()
+            .flat_map(|p| {
+                p.inventory
+                    .into_iter()
+                    .chain(p.equipment)
+                    .chain(p.crafting)
+                    .chain([p.carried])
+            })
+            .collect();
+        self.stacks.retain(|id, _| live.contains(id));
+        // CommandInvsee.viewedPlayer is deliberately not reset.
+    }
+}
+
+impl Game<'_> {
+    pub(super) fn client_inventory_tracker_world_refresh(&mut self) {
+        if self.client_inventory_tracker_world_pending.replace(false) {
+            let viewed = self.client_inventory_tracker.viewed.take();
+            self.client_inventory_tracker = State {
+                viewed,
+                ..Default::default()
+            };
+        }
+    }
+    /// Render the exact received stacks, including an off-hand stack whose
+    /// components the base client's mob mirror does not otherwise retain.
+    pub(super) fn client_inventory_tracker_held_stack(
+        &self,
+        mob: &Mob,
+        off: bool,
+    ) -> Option<ItemStack> {
+        if self.native_mod_screen() != Some(SCREEN) {
+            return None;
+        }
+        let p = self
+            .client_inventory_tracker
+            .viewed
+            .as_deref()
+            .and_then(|uuid| self.client_inventory_tracker.resolve(uuid))?;
+        if !p.model.as_ref().is_some_and(|m| m.join == mob.join) {
+            return None;
+        }
+        self.client_inventory_tracker
+            .stack(p.equipment[usize::from(off)])
+            .cloned()
+    }
+    pub(super) fn client_inventory_tracker_model(&self, p: &Player) -> Option<Mob> {
+        let mut m = p.model.clone()?;
+        let stack = |slot| {
+            self.client_inventory_tracker
+                .stack(p.equipment[slot])
+                .cloned()
+        };
+        m.extra.set_main_hand_stack(stack(0));
+        m.extra.off_hand = stack(1).map(|s| s.item);
+        for (slot, index) in [(2, 3), (3, 2), (4, 1), (5, 0)] {
+            m.extra.armor[index] = stack(slot);
+        }
+        m.extra.feet = stack(2).map(|s| s.item);
+        m.extra.legs = stack(3).map(|s| s.item);
+        m.extra.chest = stack(4).map(|s| s.item);
+        m.extra.head = stack(5).map(|s| s.item);
+        Some(m)
+    }
+    /// Refresh entity object membership without manufacturing equipment events.
+    /// Mob.join is Horizon's actual object identity and changes when an id is reused.
+    pub(super) fn client_inventory_tracker_refresh(&mut self) {
+        let rows = self.client_anti_bot_world()["players"]
+            .as_array()
+            .cloned()
+            .unwrap_or_default();
+        for p in self.client_inventory_tracker.players.values_mut() {
+            p.current = false;
+        }
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+        for row in rows {
+            let (Some(token), Some(id), Some(uuid), Some(name)) = (
+                row["token"].as_u64(),
+                row["id"].as_i64().and_then(|v| i32::try_from(v).ok()),
+                row["uuid"].as_str(),
+                row["name"].as_str(),
+            ) else {
+                continue;
+            };
+            let model = if id == local {
+                self.player_model.clone()
+            } else {
+                self.mobs
+                    .iter()
+                    .find(|m| m.id as i32 == id && !m.removed)
+                    .cloned()
+            };
+            let p = self
+                .client_inventory_tracker
+                .players
+                .entry(token)
+                .or_insert_with(|| Player::new(token, id, uuid.into(), name.into()));
+            p.id = id;
+            p.uuid = uuid.into();
+            p.name = name.into();
+            p.current = true;
+            if model.is_some() {
+                p.model = model;
+            }
+            if id == local {
+                let inventory = self.inventory.clone();
+                let armor = self.armor.clone();
+                let off = self.offhand.clone();
+                let selected = self.selected;
+                let crafting = (self.craft_size == 2).then(|| self.craft_grid.clone());
+                let result = (self.craft_size == 2)
+                    .then(|| self.craft_result())
+                    .flatten();
+                let carried = self.carried.clone();
+                let s = &mut self.client_inventory_tracker;
+                let mut p = s.players.remove(&token).expect("current local player");
+                for i in 0..36 {
+                    p.inventory[i] =
+                        s.same_or_new(p.inventory[i], inventory.get(i).and_then(Option::as_ref));
+                }
+                p.equipment[0] = p.inventory.get(selected).copied().unwrap_or(0);
+                p.equipment[1] = s.same_or_new(p.equipment[1], off.as_ref());
+                for (slot, index) in [(2, 3), (3, 2), (4, 1), (5, 0)] {
+                    p.equipment[slot] = s.same_or_new(p.equipment[slot], armor[index].as_ref());
+                }
+                p.crafting[0] = s.same_or_new(p.crafting[0], result.as_ref());
+                for i in 0..4 {
+                    p.crafting[i + 1] = s.same_or_new(
+                        p.crafting[i + 1],
+                        crafting
+                            .as_ref()
+                            .and_then(|g| g.get(i))
+                            .and_then(Option::as_ref),
+                    );
+                }
+                p.carried = s.same_or_new(p.carried, carried.as_ref());
+                s.players.insert(token, p);
+            }
+        }
+    }
+
+    /// Client RemotePlayer.setItemSlot HEAD: each accepted assignment is heard,
+    /// including equal-valued replacement stacks and updates while disabled.
+    pub(super) fn client_inventory_tracker_equipment(
+        &mut self,
+        id: i32,
+        slot: u8,
+        stack: Option<&ItemStack>,
+    ) {
+        if !self.client_auto_tool_player() || slot as usize >= SLOTS.len() {
+            return;
+        }
+        self.client_inventory_tracker_world_refresh();
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+        if id == local {
+            return;
+        }
+        let Some(player) = self.client_anti_bot_player(id) else {
+            return;
+        };
+        let Some(token) = player["token"].as_u64() else {
+            return;
+        };
+        let (Some(uuid), Some(name)) = (player["uuid"].as_str(), player["name"].as_str()) else {
+            return;
+        };
+        let anti_bot = self.client_anti_bot_query(id);
+        let time = Self::client_inventory_tracker_time();
+        let model = self
+            .mobs
+            .iter()
+            .find(|m| m.id as i32 == id && !m.removed)
+            .cloned();
+        let s = &mut self.client_inventory_tracker;
+        s.players
+            .entry(token)
+            .or_insert_with(|| Player::new(token, id, uuid.into(), name.into()));
+        let handle = s.allocate(stack);
+        let mut hands = [
+            s.players[&token].equipment[0],
+            s.players[&token].equipment[1],
+        ];
+        if slot <= 1 {
+            hands[slot as usize] = handle;
+        }
+        let input = json!({"kind":"equipment","uuid":uuid,"name":name,"playerToken":token,
+            "remote":true,"slot":SLOTS[slot as usize],"new":s.item(handle),"main":s.item(hands[0]),
+            "off":s.item(hands[1]),"time":time,"antiBot":anti_bot})
+        .to_string();
+        let mut output = String::new();
+        self.native_client_inventory_tracker(&input, &mut output);
+        let answer = serde_json::from_str::<Value>(&output).unwrap_or(Value::Null);
+        let s = &mut self.client_inventory_tracker;
+        {
+            let p = s.players.get_mut(&token).expect("equipment player");
+            p.current = true;
+            p.equipment[slot as usize] = handle;
+            if slot == 0 {
+                p.inventory[0] = handle;
+            }
+        }
+        if answer["reset"] == true {
+            s.reset();
+        }
+        if answer["clearSaved"] == true {
+            for p in s.players.values_mut() {
+                p.saved = false;
+            }
+        }
+        if answer["track"] == true && answer["save"] == true {
+            for p in s.players.values_mut().filter(|p| p.uuid == uuid) {
+                p.saved = false;
+            }
+        }
+        let projection = answer["projection"]
+            .as_array()
+            .filter(|v| v.len() == 36)
+            .and_then(|v| {
+                v.iter()
+                    .map(|v| {
+                        if v.is_null() {
+                            Some(0)
+                        } else {
+                            v.as_u64()
+                                .filter(|id| *id == 0 || s.stacks.contains_key(id))
+                        }
+                    })
+                    .collect::<Option<Vec<_>>>()
+            });
+        let p = s.players.get_mut(&token).expect("equipment player");
+        p.current = true;
+        p.name = name.into();
+        if model.is_some() {
+            p.model = model;
+        }
+        if answer["running"] == true && answer["track"] == true {
+            if answer["save"] == true {
+                p.saved = true;
+            }
+            p.tracked = true;
+            if let Some(projection) = projection {
+                p.inventory.copy_from_slice(&projection);
+            }
+        }
+    }
+
+    pub(super) fn client_inventory_tracker_tick(&mut self) {
+        self.client_inventory_tracker_world_refresh();
+        if !self.client_auto_tool_player() {
+            return;
+        }
+        self.client_inventory_tracker_refresh();
+        if let Some(uuid) = self.client_inventory_tracker.pending_open.take() {
+            if self.client_inventory_tracker.resolve(&uuid).is_some() {
+                // Minecraft.schedule { setScreen(...) } replaces the current
+                // screen after the command returns, including in-bed chat.
+                self.screen = super::Screen::Playing;
+                self.native_mod_screen = None;
+                if self.native_mod_screen_open(SCREEN) {
+                    self.client_inventory_tracker.viewed = Some(uuid);
+                }
+            }
+        }
+        if self.native_mod_screen() == Some(SCREEN)
+            && self
+                .client_inventory_tracker
+                .viewed
+                .as_deref()
+                .and_then(|uuid| self.client_inventory_tracker.resolve(uuid))
+                .is_none()
+        {
+            self.native_mod_screen_close(SCREEN);
+        }
+    }
+
+    pub(super) fn client_inventory_tracker_query(&mut self, request: &str) -> String {
+        self.client_inventory_tracker_world_refresh();
+        let Ok(q) = serde_json::from_str::<Value>(request) else {
+            return "null".into();
+        };
+        if matches!(q["op"].as_str(), Some("reset" | "clearSaved")) {
+            if q["op"] == "reset" {
+                self.client_inventory_tracker.reset();
+            } else {
+                for p in self.client_inventory_tracker.players.values_mut() {
+                    p.saved = false;
+                }
+            }
+            return "true".into();
+        }
+        if !self.client_auto_tool_player() {
+            return "null".into();
+        }
+        self.client_inventory_tracker_refresh();
+        let out = match q["op"].as_str() {
+            Some("world") => {
+                let players=self.client_inventory_tracker.players.values().filter(|p|p.current||p.saved)
+                    .map(|p|json!({"uuid":p.uuid,"name":p.name,"playerToken":p.token,"current":p.current,"saved":p.saved})).collect::<Vec<_>>();
+                json!({"players":players,"online":self.client_anti_bot_online()})
+            }
+            Some("open") => {
+                let uuid = q["uuid"]
+                    .as_str()
+                    .filter(|uuid| self.client_inventory_tracker.resolve(uuid).is_some());
+                if let Some(uuid) = uuid {
+                    self.client_inventory_tracker.pending_open = Some(uuid.into());
+                    json!(true)
+                } else {
+                    json!(false)
+                }
+            }
+            Some("clearSaved") => {
+                for p in self.client_inventory_tracker.players.values_mut() {
+                    p.saved = false;
+                }
+                json!(true)
+            }
+            Some("reset") => {
+                self.client_inventory_tracker.reset();
+                json!(true)
+            }
+            _ => Value::Null,
+        };
+        out.to_string()
+    }
+
+    pub(super) fn client_inventory_tracker_time() -> i64 {
+        match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
+            Ok(d) => d.as_millis().min(i64::MAX as u128) as i64,
+            Err(e) => -(e.duration().as_millis().min(i64::MAX as u128) as i64),
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/inventory_tracker_screen.rs b/crates/horizon-client/src/game/inventory_tracker_screen.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/inventory_tracker_screen.rs
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ViewedInventoryScreen is a read-only Screen, not a network container menu.
+use super::{Game, inventory_tracker_native::SCREEN};
+use horizon_client::{
+    hud::{HudBatch, rgba},
+    text::Text,
+};
+use serde_json::{Value, json};
+use winit::keyboard::KeyCode;
+
+impl Game<'_> {
+    fn client_inventory_tracker_item(
+        &self,
+        batch: &mut HudBatch,
+        stack: &super::ItemStack,
+        x: f32,
+        y: f32,
+        seed: i32,
+    ) {
+        let owner = self.player_owner(Some(stack));
+        let state = self.resolve_item(
+            stack,
+            horizon_assets::item_model::DisplayContext::Gui,
+            Some(&owner),
+            seed,
+        );
+        horizon_client::item_render::gui::draw(
+            &state,
+            &self.pack.item_renderer,
+            &self.gui.atlas.sprites,
+            &self.item_host(),
+            batch,
+            x,
+            y,
+            self.glint_frame.millis / 1000.,
+            self.glint_frame.speed,
+            self.glint_frame.alpha,
+        );
+    }
+    /// Uses the live chat's native pending suggestions, with the same Tab,
+    /// click, narration and input range handling as ordinary completions.
+    pub(super) fn client_inventory_tracker_complete(&mut self) {
+        self.client_inventory_tracker_world_refresh();
+        let Some(screen) = self.ui.chat_screen.as_ref() else {
+            self.client_inventory_tracker.completion_signature = None;
+            self.client_inventory_tracker.completion_owned = false;
+            return;
+        };
+        let input =
+            json!({"kind":"completion","text":screen.input.value,"cursor":screen.input.cursor,
+            "online":self.client_anti_bot_online()})
+            .to_string();
+        let mut output = String::new();
+        self.native_client_inventory_tracker(&input, &mut output);
+        let signature = format!("{input}\0{output}");
+        if self.client_inventory_tracker.completion_signature.as_ref() == Some(&signature) {
+            return;
+        }
+        self.client_inventory_tracker.completion_signature = Some(signature);
+        let v = serde_json::from_str::<Value>(&output).unwrap_or(Value::Null);
+        let handled = v["handled"] == true;
+        let previous = self.client_inventory_tracker.completion_owned;
+        self.client_inventory_tracker.completion_owned = handled;
+        if !handled && !previous {
+            return;
+        }
+        let range = if handled {
+            let Some(start) = v["range"][0].as_u64().and_then(|n| usize::try_from(n).ok()) else {
+                return;
+            };
+            let Some(len) = v["range"][1].as_u64().and_then(|n| usize::try_from(n).ok()) else {
+                return;
+            };
+            let Some(end) = start.checked_add(len) else {
+                return;
+            };
+            (start, end)
+        } else {
+            (0, 0)
+        };
+        let suggestions = if handled {
+            v["suggestions"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|s| s.as_str().map(str::to_owned))
+                .collect()
+        } else {
+            Vec::new()
+        };
+        let measure = horizon_client::screen_draw::Measure(&self.gui.atlas.font);
+        if let Some(screen) = self.ui.chat_screen.as_mut() {
+            screen.liquidbounce_inventory_suggestions(&measure, range, suggestions);
+        }
+    }
+    pub(super) fn client_inventory_tracker_key(&mut self, raw: KeyCode) -> bool {
+        if self.native_mod_screen() != Some(SCREEN) {
+            return false;
+        }
+        if raw == KeyCode::Escape
+            || self
+                .settings
+                .keys
+                .translate_all(raw)
+                .contains(&Ok(KeyCode::KeyE))
+        {
+            self.native_mod_screen_close(SCREEN);
+        }
+        // ViewedInventoryScreen.keyPressed always returns true.
+        true
+    }
+    pub(super) fn client_inventory_tracker_lore(&mut self, lines: &mut Vec<(Text, u32)>) {
+        if self.native_mod_screen() != Some(SCREEN) {
+            return;
+        }
+        let Some(handle) = self.client_inventory_tracker.tooltip else {
+            return;
+        };
+        let input =
+            json!({"kind":"lore","handle":handle,"time":Self::client_inventory_tracker_time()})
+                .to_string();
+        let mut output = String::new();
+        self.native_client_inventory_tracker(&input, &mut output);
+        let v = serde_json::from_str::<Value>(&output).unwrap_or(Value::Null);
+        if let Some(lore) = v["lore"].as_str() {
+            lines.push((Text::literal(lore), rgba(170, 170, 170, 255)));
+        }
+    }
+    pub(super) fn client_inventory_tracker_draw(&mut self, batch: &mut HudBatch) {
+        if self.native_mod_screen() != Some(SCREEN) {
+            return;
+        }
+        self.client_inventory_tracker_world_refresh();
+        let Some(p) = self
+            .client_inventory_tracker
+            .viewed
+            .as_deref()
+            .and_then(|uuid| self.client_inventory_tracker.resolve(uuid))
+            .cloned()
+        else {
+            return;
+        };
+        let (ox, oy) = (
+            ((batch.width - 176.) / 2.).floor(),
+            ((batch.height - 166.) / 2.).floor(),
+        );
+        self.render_transparent_background("mod", batch);
+        if let Some(mut r) = self
+            .gui
+            .atlas
+            .sprites
+            .get("gui/container/inventory")
+            .copied()
+        {
+            let du = (r.u1 - r.u0) / r.w as f32;
+            let dv = (r.v1 - r.v0) / r.h as f32;
+            r.u1 = r.u0 + 176. * du;
+            r.v1 = r.v0 + 166. * dv;
+            batch.rect_uv(ox, oy, 176., 166., r, u32::MAX);
+        }
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+        if p.id == local && p.current {
+            self.draw_player_preview(batch, ox + 26., oy + 8., ox + 75., oy + 78., 30., 0.0625);
+        } else if let Some(model) = self.client_inventory_tracker_model(&p) {
+            self.client_inventory_tracker_preview(batch, &model, &p.uuid, &p.name, ox, oy);
+        }
+        let mut slots = vec![(p.crafting[0], 154., 28., None)];
+        for i in 0..4 {
+            slots.push((
+                p.crafting[i + 1],
+                98. + 18. * (i % 2) as f32,
+                18. + 18. * (i / 2) as f32,
+                None,
+            ));
+        }
+        for (i, icon) in ["helmet", "chestplate", "leggings", "boots"]
+            .into_iter()
+            .enumerate()
+        {
+            slots.push((p.equipment[5 - i], 8., 8. + 18. * i as f32, Some(icon)));
+        }
+        for i in 9..36 {
+            slots.push((
+                p.inventory[i],
+                8. + 18. * ((i - 9) % 9) as f32,
+                84. + 18. * ((i - 9) / 9) as f32,
+                None,
+            ));
+        }
+        for i in 0..9 {
+            slots.push((p.inventory[i], 8. + 18. * i as f32, 142., None));
+        }
+        slots.push((p.equipment[1], 77., 62., Some("shield")));
+        let mut hovered = None;
+        for (handle, x, y, icon) in slots {
+            if let Some(stack) = self.client_inventory_tracker.stack(handle) {
+                self.client_inventory_tracker_item(
+                    batch,
+                    stack,
+                    ox + x,
+                    oy + y,
+                    x as i32 + y as i32 * 176,
+                );
+                self.draw_item_decorations(batch, stack, ox + x, oy + y, None);
+            } else if let Some(icon) = icon {
+                batch.sprite(
+                    &self.gui.atlas,
+                    &format!("gui/sprites/container/slot/{icon}"),
+                    ox + x,
+                    oy + y,
+                );
+            }
+            let (mx, my) = (self.cursor.0 - ox, self.cursor.1 - oy);
+            if mx >= x - 1. && mx < x + 17. && my >= y - 1. && my < y + 17. {
+                hovered = Some(handle);
+                batch.fill(
+                    &self.gui.atlas,
+                    ox + x,
+                    oy + y,
+                    16.,
+                    16.,
+                    rgba(255, 255, 255, 128),
+                );
+            }
+        }
+        if let Some(stack) = self.client_inventory_tracker.stack(p.carried) {
+            self.draw_item_model(batch, stack, self.cursor.0 - 8., self.cursor.1 - 8.);
+            self.draw_item_decorations(batch, stack, self.cursor.0 - 8., self.cursor.1 - 8., None);
+        } else if let Some((handle, stack)) = hovered.and_then(|id| {
+            self.client_inventory_tracker
+                .stack(id)
+                .cloned()
+                .map(|s| (id, s))
+        }) {
+            let prior = self.client_inventory_tracker.tooltip.replace(handle);
+            self.draw_stack_tooltip(batch, &stack, self.cursor.0, self.cursor.1);
+            self.client_inventory_tracker.tooltip = prior;
+        }
+    }
+}
