@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent Overshoot.kt.
+use super::{body::WalkPlayer, path_points::StepControl};
+use crate::navigation::{
+    geometry::{Vec3, java_max},
+    walk::route::Step,
+};
+#[derive(Default)]
+pub struct Overshoot {
+    count: i32,
+    reversing: bool,
+}
+impl Overshoot {
+    pub fn count(&self) -> i32 {
+        self.count
+    }
+    pub fn forward_aim(
+        &mut self,
+        player: &impl WalkPlayer,
+        position: Vec3,
+        aim: Vec3,
+        step: &Step,
+        mut point_ahead: impl FnMut(Vec3, f64) -> Option<Vec3>,
+    ) -> Vec3 {
+        self.forward_aim_tagged(player, position, (aim, ()), (), step, |p, d| {
+            point_ahead(p, d).map(|point| (point, ()))
+        })
+        .0
+    }
+    /// Carries source object provenance through the same decisions. Follower
+    /// needs Kotlin reference identity, which coordinate equality cannot model.
+    #[allow(clippy::too_many_arguments)]
+    pub fn forward_aim_tagged<T>(
+        &mut self,
+        player: &impl WalkPlayer,
+        position: Vec3,
+        aim: (Vec3, T),
+        position_tag: T,
+        step: &Step,
+        mut point_ahead: impl FnMut(Vec3, f64) -> Option<(Vec3, T)>,
+    ) -> (Vec3, T) {
+        let motion = player.delta_movement();
+        let speed = (motion.x * motion.x + motion.z * motion.z).sqrt();
+        let ahead = (aim.0.x - position.x) * motion.x + (aim.0.z - position.z) * motion.z;
+        let reverses = speed > 0.3 && ahead < 0.0;
+        if reverses && !self.reversing {
+            self.count = self.count.wrapping_add(1);
+        }
+        self.reversing = reverses;
+        if !reverses || !step.is_plain() {
+            return aim;
+        }
+        let point = point_ahead(position, java_max(speed * 3.0, 1.0));
+        if let Some(point) = point
+            .filter(|p| (p.0.x - position.x) * motion.x + (p.0.z - position.z) * motion.z >= 0.0)
+        {
+            point
+        } else if player.on_ground() {
+            aim
+        } else {
+            (position, position_tag)
+        }
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk_control/path_points.rs b/crates/horizon-client/src/navigation/walk_control/path_points.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_control/path_points.rs
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Agent PathPoints.kt geometry. Exact body simulations live in floor_prediction.
+use super::{SHORTCUT_STEPS, directional_input, distance_segment, horizontal, subtract};
+use crate::navigation::{
+    geometry::{Vec3, java_min},
+    input::Input,
+    walk::{
+        WalkState,
+        route::{Move, Route, Step},
+    },
+    walk_jump::{vector_yaw, wrap_degrees},
+};
+pub trait StepControl {
+    fn builds(&self) -> bool;
+    fn is_level_walk(&self) -> bool;
+    fn is_rising_bridge(&self) -> bool;
+    fn is_plain(&self) -> bool;
+    fn past_edge(&self, position: Vec3) -> f64;
+    fn outward(&self, velocity: Vec3) -> f64;
+    fn hold_back(&self, position: Vec3, velocity: Vec3, frame_y_rot: f32) -> Input;
+}
+impl StepControl for Step {
+    fn builds(&self) -> bool {
+        !self.breaks.is_empty() || !self.places.is_empty()
+    }
+    fn is_level_walk(&self) -> bool {
+        matches!(self.movement, Move::Traverse | Move::Diagonal) && !self.shift && !self.edge
+    }
+    fn is_rising_bridge(&self) -> bool {
+        self.movement == Move::Ascend
+            && self.breaks.is_empty()
+            && self.opens.is_empty()
+            && self.jump.is_none()
+            && self.places.len() == 2
+            && self.places[0] == self.to.offset(0, -2, 0)
+            && self.places[1] == self.to.offset(0, -1, 0)
+    }
+    fn is_plain(&self) -> bool {
+        self.is_level_walk()
+            && self.jump.is_none()
+            && !self.builds()
+            && self.opens.is_empty()
+            && !self.is_under_water
+    }
+    fn past_edge(&self, position: Vec3) -> f64 {
+        let dx = self.to.x.wrapping_sub(self.from.x);
+        let dz = self.to.z.wrapping_sub(self.from.z);
+        let from = Vec3::bottom_center(self.from);
+        let edge = Vec3::new(
+            from.x + f64::from(dx) * 0.5,
+            from.y,
+            from.z + f64::from(dz) * 0.5,
+        );
+        (position.x - edge.x) * f64::from(dx) + (position.z - edge.z) * f64::from(dz)
+    }
+    fn outward(&self, velocity: Vec3) -> f64 {
+        velocity.x * f64::from(self.to.x.wrapping_sub(self.from.x))
+            + velocity.z * f64::from(self.to.z.wrapping_sub(self.from.z))
+    }
+    fn hold_back(&self, position: Vec3, velocity: Vec3, frame_y_rot: f32) -> Input {
+        let past = self.past_edge(position);
+        if past <= 0.0 || self.outward(velocity) <= 0.0 && past < 0.3 {
+            return Input::EMPTY;
+        }
+        directional_input(
+            Vec3::new(
+                f64::from(self.from.x.wrapping_sub(self.to.x)),
+                f64::from(self.from.y.wrapping_sub(self.to.y)),
+                f64::from(self.from.z.wrapping_sub(self.to.z)),
+            ),
+            frame_y_rot,
+        )
+    }
+}
+pub fn run_end(steps: &[Step], start: usize) -> usize {
+    let mut end = start;
+    while end < steps.len() && steps[end].is_bridge() {
+        end += 1;
+    }
+    end
+}
+pub fn continues_straight(step: &Step, next: &Step) -> bool {
+    next.to.x.wrapping_sub(next.from.x) == step.to.x.wrapping_sub(step.from.x)
+        && next.to.z.wrapping_sub(next.from.z) == step.to.z.wrapping_sub(step.from.z)
+        && (step.to.x != step.from.x || step.to.z != step.from.z)
+}
+pub fn has_passed(step: &Step, position: Vec3) -> bool {
+    let from = Vec3::bottom_center(step.from);
+    let dx = step.feet.x - from.x;
+    let dz = step.feet.z - from.z;
+    let length = (dx * dx + dz * dz).sqrt();
+    if length == 0.0 || (position.y - step.feet.y).abs() >= 1.25 {
+        return false;
+    }
+    let along = ((position.x - from.x) * dx + (position.z - from.z) * dz) / length;
+    let beside = ((position.x - from.x) * dz - (position.z - from.z) * dx).abs() / length;
+    along >= length && beside <= 0.6
+}
+pub trait RouteControl {
+    fn is_off_path(&self, index: usize, position: Vec3) -> bool;
+    fn join_index(&self, position: Vec3) -> Option<usize>;
+    fn look_ahead(&self, index: usize, target: Vec3, position: Vec3, distance: f64)
+    -> Option<Vec3>;
+    fn point_ahead(&self, index: usize, position: Vec3, distance: f64) -> Vec3;
+    fn turn_ahead(&self, index: usize, position: Vec3, distance: f64) -> f32;
+}
+impl<B: WalkState> RouteControl for Route<B> {
+    fn is_off_path(&self, index: usize, position: Vec3) -> bool {
+        let Some(step) = self.steps().get(index) else {
+            return false;
+        };
+        let points = self.points();
+        let from = points[index];
+        if position.y < java_min(from.y, step.feet.y) - 0.9 {
+            return true;
+        }
+        if step
+            .jump
+            .as_ref()
+            .is_some_and(|jump| distance_segment(position, jump.run_up, from) <= 1.5)
+        {
+            return false;
+        }
+        for i in index..(points.len() - 1).min(index + SHORTCUT_STEPS) {
+            if distance_segment(position, points[i], points[i + 1]) <= 1.5 {
+                return false;
+            }
+            if !self.steps()[i].is_plain() {
+                break;
+            }
+        }
+        true
+    }
+    fn join_index(&self, position: Vec3) -> Option<usize> {
+        let mut best = None;
+        let mut best_distance = f64::MAX;
+        for index in 0..self.points().len().min(8) {
+            if index > 0 && self.steps()[index - 1].builds() {
+                break;
+            }
+            let point = self.points()[index];
+            let distance = horizontal(position, point);
+            if distance <= 1.0 && (position.y - point.y).abs() <= 1.0 && distance < best_distance {
+                best = Some(index);
+                best_distance = distance;
+            }
+        }
+        best
+    }
+    fn look_ahead(
+        &self,
+        index: usize,
+        target: Vec3,
+        position: Vec3,
+        distance: f64,
+    ) -> Option<Vec3> {
+        let points = self.points();
+        let end = points.len().min(index + 1 + SHORTCUT_STEPS);
+        let from = (index + 1..end)
+            .find(|&i| points[i] == target)
+            .unwrap_or(index + 1);
+        (from..points.len().min(from + 4)).find_map(|i| {
+            let dx = points[i].x - position.x;
+            let dz = points[i].z - position.z;
+            (dx * dx + dz * dz >= distance * distance).then_some(points[i])
+        })
+    }
+    fn point_ahead(&self, index: usize, position: Vec3, distance: f64) -> Vec3 {
+        point_ahead_tagged(self, index, position, distance).0
+    }
+    fn turn_ahead(&self, index: usize, position: Vec3, distance: f64) -> f32 {
+        let mut from = position;
+        let mut left = distance;
+        let mut heading = f32::NAN;
+        let mut sharpest = 0.0_f32;
+        for i in index + 1..self.points().len() {
+            let to = self.points()[i];
+            let length = horizontal(from, to);
+            if length > 0.3 {
+                let way = subtract(to, from);
+                let y_rot = vector_yaw(way.x, way.z);
+                if !heading.is_nan() {
+                    let angle = wrap_degrees(y_rot - heading).abs();
+                    sharpest = if sharpest.is_nan() {
+                        sharpest
+                    } else if angle.is_nan() {
+                        angle
+                    } else {
+                        sharpest.max(angle)
+                    };
+                }
+                heading = y_rot;
+            }
+            left -= length;
+            if left <= 0.0 {
+                break;
+            }
+            from = to;
+        }
+        sharpest
+    }
+}
+
+/// The tag is Some(step index) only for an existing feet object returned by
+/// the source. Interpolation constructs a new Vec3 even at share zero or one.
+pub fn point_ahead_tagged<B: WalkState>(
+    route: &Route<B>,
+    index: usize,
+    position: Vec3,
+    distance: f64,
+) -> (Vec3, Option<usize>) {
+    let mut from = position;
+    let mut left = distance;
+    for i in index + 1..route.points().len() {
+        let to = route.points()[i];
+        let climbs = matches!(
+            route.steps()[i - 1].movement,
+            Move::ClimbUp | Move::ClimbDown
+        );
+        let length = if climbs {
+            from.distance(to)
+        } else {
+            horizontal(from, to)
+        };
+        if length >= left {
+            let share = left / length;
+            return (
+                Vec3::new(
+                    from.x + share * (to.x - from.x),
+                    from.y + share * (to.y - from.y),
+                    from.z + share * (to.z - from.z),
+                ),
+                None,
+            );
+        }
+        left -= length;
+        from = to;
+    }
+    (
+        *route.points().last().expect("route has start point"),
+        route.steps().len().checked_sub(1),
+    )
+}
diff --git a/crates/horizon-client/src/navigation/walk_control/planning.rs b/crates/horizon-client/src/navigation/walk_control/planning.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_control/planning.rs
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent walk/Planning.kt over the real owning Replanner lifecycle.
+use super::{
+    ability_capture::{CaptureHost, capture_walk},
+    body::{ControlState, WalkPlayer},
+    break_times::BreakState,
+    follower::{Follower, FollowerHost},
+    path_points::RouteControl,
+    stuck_spots::StuckSpots,
+};
+use crate::navigation::{
+    background::Executor,
+    destination::NearDestination,
+    geometry::{BlockPos, Vec3},
+    owned_search::{OwnedTerrainSearch, SearchSlot, StoredLevel, StoredWorker},
+    replanner::{Replanner, ReplannerLevel, RouteFactory, SearchGoal},
+    search::{Limits, Outcome},
+    simulation::player_motion::MotionPlayer,
+    walk::{abilities::WalkAbilities, route::Route},
+};
+use std::{collections::HashSet, sync::Arc};
+
+pub trait PlanningHost: CaptureHost + FollowerHost {
+    /// options().maxLength, including its separate live options read.
+    fn max_length(&self) -> f64;
+    fn following_path_debug(&mut self, steps: usize, end: Vec3);
+    fn route_found(&mut self, path: &Arc<Route<<Self::Player as WalkPlayer>::State>>);
+    fn route_searching(&mut self, start: Vec3, goal: Vec3, radius: f64);
+}
+pub type WalkSearchFactory<B, T, S> =
+    Arc<dyn Fn(T, Vec3, SearchGoal, WalkAbilities<B>, Limits) -> S + Send + Sync>;
+type Routes<B, T, S> = Replanner<i32, SearchSlot<T, S>, StoredWorker, Route<B>>;
+pub struct Planning<B: ControlState, T, S> {
+    routes: Routes<B, T, S>,
+    create: WalkSearchFactory<B, T, S>,
+    stuck_spots: StuckSpots,
+    failures: i32,
+    stuck: bool,
+    new_stuck_spot: bool,
+    was_off_path: bool,
+    settled_at: Option<i32>,
+}
+impl<
+        B: ControlState + BreakState + 'static,
+        T: Send + 'static,
+        S: OwnedTerrainSearch<T, Route = Route<B>> + Send + 'static,
+    > Planning<B, T, S>
+{
+    pub fn new(executor: Arc<dyn Executor>, create: WalkSearchFactory<B, T, S>) -> Self {
+        Self {
+            routes: Replanner::new(16, executor),
+            create,
+            stuck_spots: StuckSpots::default(),
+            failures: 0,
+            stuck: false,
+            new_stuck_spot: false,
+            was_off_path: false,
+            settled_at: None,
+        }
+    }
+    pub fn is_searching(&self) -> bool {
+        self.routes.is_searching()
+    }
+    pub fn failed(&self) -> bool {
+        self.routes.failed()
+    }
+    pub fn preview(&self) -> Option<&[Vec3]> {
+        self.routes.preview()
+    }
+    pub fn is_settled(&self) -> bool {
+        self.settled_at.is_some()
+    }
+    pub fn tick(&mut self, goal: Vec3) {
+        self.routes.tick();
+        self.stuck_spots.tick(goal);
+    }
+    pub fn stuck_at(&mut self, pos: BlockPos) {
+        self.new_stuck_spot = self.stuck_spots.add(pos) || self.new_stuck_spot;
+        self.stuck = true;
+    }
+    pub fn drop_route(&mut self) {
+        self.routes.reset();
+        self.stuck = false;
+        self.new_stuck_spot = false;
+    }
+    pub fn reset(&mut self) {
+        self.routes.reset();
+        self.failures = 0;
+        self.stuck = false;
+        self.new_stuck_spot = false;
+        self.was_off_path = false;
+        self.settled_at = None;
+    }
+    pub fn forget_stuck_spots(&mut self) {
+        self.stuck_spots.clear();
+    }
+    pub fn block_changed(&mut self, pos: BlockPos) {
+        self.routes.block_changed(pos);
+    }
+    pub fn level_changed(&mut self) {
+        self.routes.level_changed();
+    }
+    pub fn collect<H: PlanningHost>(
+        &mut self,
+        host: &mut H,
+        follower: &mut Follower<B>,
+        level: &mut impl ReplannerLevel<T>,
+        position: Vec3,
+    ) where
+        H::Player: WalkPlayer<State = B>,
+    {
+        match self.routes.poll(&mut StoredLevel::new(level)) {
+            Outcome::Searching => {}
+            Outcome::AlreadyThere => {
+                follower.clear();
+                self.settled_at = Some(self.routes.ticks());
+            }
+            Outcome::Found(path) => self.accept(host, follower, Arc::new(path), position),
+            Outcome::Failed(_) => {
+                self.failures = self.failures.wrapping_add(1);
+                if follower.is_finished() {
+                    follower.clear();
+                }
+            }
+        }
+    }
+    fn accept<H: PlanningHost>(
+        &mut self,
+        host: &mut H,
+        follower: &mut Follower<B>,
+        path: Arc<Route<B>>,
+        position: Vec3,
+    ) where
+        H::Player: WalkPlayer<State = B>,
+    {
+        self.failures = 0;
+        self.stuck = false;
+        if path.steps().is_empty() {
+            follower.clear();
+            self.settled_at = Some(self.routes.ticks());
+            return;
+        }
+        let Some(start_index) = path.join_index(position) else {
+            self.routes.forget();
+            return;
+        };
+        self.routes
+            .route_ends(path.steps().last().expect("nonempty path").to);
+        self.settled_at = None;
+        follower.follow(path.clone(), start_index);
+        host.following_path_debug(path.steps().len(), path.end());
+        host.route_found(&path);
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn plan_if_needed<H: PlanningHost>(
+        &mut self,
+        host: &mut H,
+        follower: &Follower<B>,
+        level: &mut impl ReplannerLevel<T>,
+        unbreakable: &HashSet<i64>,
+        goal: Vec3,
+        radius: f64,
+        position: Vec3,
+    ) where
+        H::Player: WalkPlayer<State = B>,
+    {
+        let path = follower.path();
+        let off_path = follower.is_off_path(host);
+        let left_path = off_path && !self.was_off_path;
+        self.was_off_path = off_path;
+        let finished_short = path.is_some() && follower.is_finished();
+        let near_stage = path.is_some()
+            && self.routes.ends_at_stage()
+            && host.player().on_ground()
+            && super::horizontal(position, path.expect("checked path").end()) < 12.0;
+        let settled = self
+            .settled_at
+            .is_some_and(|at| self.routes.ticks().wrapping_sub(at) < 100);
+        let needed = path.is_none() && !settled
+            || self.routes.has_goal_moved(goal)
+            || off_path
+            || finished_short
+            || self.stuck
+            || near_stage;
+        if needed && self.routes.is_due(self.new_stuck_spot || left_path) {
+            self.request(host, follower, level, unbreakable, goal, radius, position);
+            self.stuck = false;
+            self.new_stuck_spot = false;
+        }
+    }
+    #[allow(clippy::too_many_arguments)]
+    fn request<H: PlanningHost>(
+        &mut self,
+        host: &mut H,
+        follower: &Follower<B>,
+        level: &mut impl ReplannerLevel<T>,
+        unbreakable: &HashSet<i64>,
+        goal: Vec3,
+        radius: f64,
+        start: Vec3,
+    ) where
+        H::Player: WalkPlayer<State = B>,
+    {
+        if self.routes.is_new_goal(goal) {
+            self.failures = 0;
+        }
+        let max_length = host.max_length() * f64::from(1_i32 << self.failures.min(2));
+        let abilities = capture_walk(host, &self.stuck_spots.blocks, unbreakable);
+        let limits = Limits {
+            visited_nodes_per_slice: 5_000,
+            ..if abilities.can_parkour {
+                Limits {
+                    max_visited_nodes: 40_000,
+                    max_compute_nanos: 2_000_000_000,
+                    ..Limits::new(max_length)
+                }
+            } else {
+                Limits::new(max_length)
+            }
+        };
+        let create = self.create.clone();
+        let search: RouteFactory<SearchSlot<T, S>, StoredWorker> =
+            Arc::new(move |slot, descriptor| {
+                slot.initialize(|terrain| create(terrain, start, descriptor, abilities.clone(), limits))
+            });
+        self.routes.request(
+            &mut StoredLevel::new(level),
+            start,
+            NearDestination::new(goal, radius),
+            max_length,
+            self.stuck_spots.version(),
+            max_length * 0.75,
+            search,
+        );
+        if follower.path().is_none() && !self.routes.failed() {
+            host.route_searching(start, goal, radius);
+        }
+    }
+    /// Original private orchestration state, useful to source-oracle adapters.
+    pub fn diagnostics(&self) -> (i32, bool, bool, bool, Option<i32>) {
+        (
+            self.failures,
+            self.stuck,
+            self.new_stuck_spot,
+            self.was_off_path,
+            self.settled_at,
+        )
+    }
+    pub fn stuck_spots(&self) -> &StuckSpots {
+        &self.stuck_spots
+    }
+}
