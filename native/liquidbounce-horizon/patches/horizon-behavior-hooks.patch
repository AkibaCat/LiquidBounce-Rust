+pub(super) fn shape(shape:&horizon_core::geometry::VoxelShape)->NavShape{NavShape::new(shape.boxes().iter().map(|b|{let a=b.min_position();let z=b.max_position();[a.x,a.y,a.z,z.x,z.y,z.z]}).collect())}
