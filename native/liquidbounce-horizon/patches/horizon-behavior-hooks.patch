new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/inventory_move_model.rs
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! InventoryMove policies from LiquidBounce ae0eb396. Shared by the native adapter.
+pub const BEHAVIORS: [&str; 4] = ["Normal", "Safe", "Undetectable", "StopOnAction"];
+pub const SPRINT: [&str; 3] = ["DoNotChange", "ForceSprint", "ForceNoSprint"];
+pub const SNEAK: [&str; 3] = ["DoNotChange", "ForceSneak", "ForceNoSneak"];
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Settings {
+    pub behavior: u8,
+    pub passthrough_sneak: bool,
+    pub sprint_control: bool,
+    pub client_sprint: u8,
+    pub server_sprint: u8,
+    pub sneak_control: bool,
+    pub client_sneak: u8,
+    pub timer: bool,
+    pub speed: f32,
+    pub blink: bool,
+    pub maximum_time: i32,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            behavior: 0,
+            passthrough_sneak: false,
+            sprint_control: false,
+            client_sprint: 0,
+            server_sprint: 0,
+            sneak_control: false,
+            client_sneak: 0,
+            timer: false,
+            speed: 1.,
+            blink: false,
+            maximum_time: 10000,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Screen {
+    pub open: bool,
+    pub container: bool,
+    pub inventory: bool,
+    pub editing: bool,
+}
+impl Settings {
+    pub fn handles(self, running: bool, screen: Screen, key: usize) -> bool {
+        if !running {
+            return false;
+        }
+        if !screen.open {
+            return true;
+        }
+        if key > 6 || (key == 5 && !self.passthrough_sneak) || screen.editing {
+            return false;
+        }
+        match self.behavior {
+            1 => !screen.container || screen.inventory,
+            2 => !screen.container,
+            _ => true,
+        }
+    }
+    pub fn handled_screen(screen: Screen, server_open: bool) -> bool {
+        screen.container || server_open
+    }
+    fn force(mode: u8, moving: bool, old: bool) -> bool {
+        match mode {
+            1 if moving => true,
+            2 => false,
+            _ => old,
+        }
+    }
+    pub fn sprint(
+        self,
+        running: bool,
+        screen: Screen,
+        server_open: bool,
+        source: u8,
+        moving: bool,
+        old: bool,
+    ) -> bool {
+        if !running || !self.sprint_control || !Self::handled_screen(screen, server_open) {
+            return old;
+        }
+        let v = if source != 2 {
+            Self::force(self.client_sprint, moving, old)
+        } else {
+            old
+        };
+        if source != 1 {
+            Self::force(self.server_sprint, moving, v)
+        } else {
+            v
+        }
+    }
+    pub fn sneak(self, running: bool, screen: Screen, server_open: bool, old: bool) -> bool {
+        if !running || !self.sneak_control || !Self::handled_screen(screen, server_open) {
+            return old;
+        }
+        match self.client_sneak {
+            1 => true,
+            2 => false,
+            _ => old,
+        }
+    }
+    pub fn safe_click(
+        self,
+        running: bool,
+        screen: Screen,
+        container: i32,
+        pressed: [bool; 6],
+    ) -> bool {
+        running
+            && self.behavior == 1
+            && container == 0
+            && (0..6).any(|i| pressed[i] && self.handles(running, screen, i))
+    }
+}
+#[derive(Default)]
+pub struct State {
+    pub settings: Settings,
+    pub running: bool,
+    pub screen: Screen,
+    pub server_open: bool,
+    pub pressed: [bool; 6],
+    pub input: [bool; 7],
+    pub serial: Option<u64>,
+    pub started: i64,
+}
+impl State {
+    pub fn configure(&mut self, running: bool, s: Settings, server_open: bool) {
+        self.running = running;
+        self.settings = s;
+        self.server_open = server_open;
+    }
+    pub fn keyboard(&mut self, key: usize, pressed: bool) -> bool {
+        if !self.running || self.settings.behavior != 1 || key >= 6 {
+            return false;
+        }
+        let pressed = pressed && self.settings.handles(self.running, self.screen, key);
+        self.pressed[key] = pressed;
+        pressed && self.screen.inventory && self.server_open
+    }
+    pub fn observe(&mut self, screen: Screen, serial: u64, now: i64) -> bool {
+        let replaced = self.serial != Some(serial) || self.screen.container != screen.container;
+        self.serial = Some(serial);
+        self.screen = screen;
+        if replaced && self.running && self.settings.blink && screen.container {
+            self.started = now;
+            return true;
+        }
+        false
+    }
+    pub fn expired(&self, now: i64) -> bool {
+        self.running
+            && self.settings.blink
+            && self.screen.container
+            && now.wrapping_sub(self.started) >= i64::from(self.settings.maximum_time)
+    }
+    pub fn blink(&self, container_packet: bool) -> u8 {
+        if self.running && self.settings.blink && self.screen.container {
+            if container_packet { 1 } else { 2 }
+        } else {
+            0
+        }
+    }
+    pub fn stop_packet(&self) -> bool {
+        self.running && self.settings.behavior == 3 && self.input.iter().any(|v| *v)
+    }
+}
diff --git a/crates/horizon-client/src/inventory_move.rs b/crates/horizon-client/src/inventory_move.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/inventory_move.rs
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use crate::inventory_move_model::{Screen, Settings, State};
+use horizon_protocol::packets::play::Serverbound as S;
+use std::sync::{
+    Mutex, OnceLock,
+    atomic::{AtomicBool, Ordering},
+};
+#[derive(Default)]
+struct Bridge {
+    model: State,
+    delayed: Vec<(u64, S)>,
+    scheduled: Vec<(u64, S)>,
+    start_notice: bool,
+}
+fn state() -> &'static Mutex<Bridge> {
+    static STATE: OnceLock<Mutex<Bridge>> = OnceLock::new();
+    STATE.get_or_init(Default::default)
+}
+pub static SEARCH_FOCUSED: AtomicBool = AtomicBool::new(false);
+pub fn configure(running: bool, v: [i32; 11], server_open: bool) {
+    let s = Settings {
+        behavior: v[0] as u8,
+        passthrough_sneak: v[1] != 0,
+        sprint_control: v[2] != 0,
+        client_sprint: v[3] as u8,
+        server_sprint: v[4] as u8,
+        sneak_control: v[5] != 0,
+        client_sneak: v[6] as u8,
+        timer: v[7] != 0,
+        speed: f32::from_bits(v[8] as u32),
+        blink: v[9] != 0,
+        maximum_time: v[10],
+    };
+    let mut b = state().lock().expect("InventoryMove");
+    if b.model.running && !running {
+        b.delayed.clear();
+    } // onDisabled clears only unscheduled work
+    b.model.configure(running, s, server_open);
+}
+pub fn observe(mut screen: Screen, serial: u64, now: i64) {
+    screen.editing |= SEARCH_FOCUSED.load(Ordering::Acquire);
+    let mut b = state().lock().expect("InventoryMove");
+    if b.model.observe(screen, serial, now) {
+        b.start_notice = true;
+    }
+}
+pub fn snapshot() -> (Screen, bool, bool, f32, bool, i32) {
+    let mut b = state().lock().expect("InventoryMove");
+    let m = &b.model;
+    let out = (
+        m.screen,
+        m.running,
+        m.settings.timer,
+        m.settings.speed,
+        b.start_notice,
+        m.settings.maximum_time,
+    );
+    b.start_notice = false;
+    out
+}
+pub fn keyboard(key: usize, pressed: bool) -> bool {
+    state()
+        .lock()
+        .expect("InventoryMove")
+        .model
+        .keyboard(key, pressed)
+}
+pub fn handles(key: usize) -> bool {
+    let b = state().lock().expect("InventoryMove");
+    b.model
+        .settings
+        .handles(b.model.running, b.model.screen, key)
+}
+pub fn safe_click(container: i32) -> bool {
+    let b = state().lock().expect("InventoryMove");
+    let m = &b.model;
+    m.settings
+        .safe_click(m.running, m.screen, container, m.pressed)
+}
+pub fn sprint(source: u8, moving: bool, old: bool) -> bool {
+    let b = state().lock().expect("InventoryMove");
+    let m = &b.model;
+    m.settings
+        .sprint(m.running, m.screen, m.server_open, source, moving, old)
+}
+pub fn movement_sprint(moving: bool, old: i8) -> i8 {
+    let b = state().lock().expect("InventoryMove");
+    let m = &b.model;
+    if !m.running
+        || !m.settings.sprint_control
+        || !Settings::handled_screen(m.screen, m.server_open)
+    {
+        return old;
+    }
+    match m.settings.client_sprint {
+        1 if moving => 1,
+        2 => 0,
+        _ => old,
+    }
+}
+pub fn sneak(old: bool) -> bool {
+    let b = state().lock().expect("InventoryMove");
+    let m = &b.model;
+    m.settings.sneak(m.running, m.screen, m.server_open, old)
+}
+pub fn expired(now: i64) -> bool {
+    state().lock().expect("InventoryMove").model.expired(now)
+}
+pub fn container_packet(p: &S) -> bool {
+    matches!(
+        p,
+        S::ContainerClick(_)
+            | S::ContainerButtonClick(_)
+            | S::SetCreativeModeSlot(_)
+            | S::ContainerSlotStateChanged(_)
+            | S::ContainerClose(_)
+    )
+}
+pub fn blink(container: bool) -> u8 {
+    state()
+        .lock()
+        .expect("InventoryMove")
+        .model
+        .blink(container)
+}
+pub fn delay(session: u64, packet: &S) -> bool {
+    if !container_packet(packet) {
+        return false;
+    }
+    let mut b = state().lock().expect("InventoryMove");
+    if !b.model.stop_packet() {
+        return false;
+    }
+    b.delayed.push((session, packet.clone()));
+    true
+}
+/// Invoked once at the end of MovementInputEvent. Scheduled packets run at the next idle turn.
+pub fn final_input(mut input: [bool; 7]) -> [bool; 7] {
+    let mut b = state().lock().expect("InventoryMove");
+    if b.model.running && !b.delayed.is_empty() {
+        let pending = std::mem::take(&mut b.delayed);
+        b.scheduled.extend(pending);
+        input[..6].fill(false);
+    }
+    b.model.input = input;
+    input
+}
+pub fn next_loop() -> Vec<(u64, S)> {
+    std::mem::take(&mut state().lock().expect("InventoryMove").scheduled)
+}
+pub fn clear() {
+    let mut b = state().lock().expect("InventoryMove");
+    b.delayed.clear();
+    b.scheduled.clear();
+    b.model.input.fill(false);
+    b.model.serial = None;
+    b.model.screen = Screen::default();
+    b.start_notice = false;
+}
diff --git a/crates/horizon-client/src/game/anti_void_native.rs b/crates/horizon-client/src/game/anti_void_native.rs
