--- /dev/null
+++ b/crates/horizon-client/src/game/fake_lag.rs
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{Game, Screen};
+use horizon_core::geometry::{Aabb, Vec3};
+use serde_json::{Value, json};
+fn cube(at: Vec3, r: f64) -> Aabb {
+    Aabb::new(
+        Vec3::new(at.x - r, at.y - r, at.z - r),
+        Vec3::new(at.x + r, at.y + r, at.z + r),
+    )
+}
+impl Game<'_> {
+    pub(super) fn fake_lag_query(&self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        let Some(p) = self.player.as_ref() else {
+            return "null".into();
+        };
+        let old = serde_json::from_value::<[f64; 3]>(q["old"].clone())
+            .ok()
+            .map(|a| Vec3::new(a[0], a[1], a[2]));
+        let range: [f32; 2] = serde_json::from_value(q["range"].clone()).unwrap_or([2., 5.]);
+        let eye = Vec3::new(
+            p.position.x,
+            p.position.y + f64::from(p.dimensions.eye_height),
+            p.position.z,
+        );
+        let radius = f64::from(range[1]);
+        let high = f64::from(range[1] * range[1]);
+        let low = f64::from(range[0] * range[0]);
+        let all = super::auto_bow::entities(self);
+        let targets = super::criticals_target::candidates(self, f32::MAX, false);
+        let entities = all
+            .into_iter()
+            .filter_map(|e| {
+                let target = targets
+                    .iter()
+                    .find(|t| t["id"].as_i64() == Some(i64::from(e.id)))?["target"]
+                    .clone();
+                let nearby = cube(eye, radius).intersects(e.bounds)
+                    && (low..=high).contains(&e.bounds.distance_squared_to_point(eye));
+                let in_range = old.is_some_and(|at| {
+                    cube(at, radius).intersects(e.bounds)
+                        && e.bounds.distance_squared_to_point(at) <= radius * radius
+                });
+                Some(
+                    json!({"id":e.id,"target":target,"nearby":nearby,"inRange":in_range,
+                "intersects":old.is_some_and(|at|e.bounds.intersects(p.dimensions.bounds(at))),
+                "serverDistance":old.map(|at|e.position.distance_squared(at).sqrt()),
+                "clientDistance":e.position.distance_squared(p.position).sqrt()}),
+                )
+            })
+            .collect::<Vec<_>>();
+        let using_consumable = self
+            .using
+            .and_then(|(slot, _)| self.stack_in(slot))
+            .is_some_and(|s| {
+                self.pack
+                    .item_renderer
+                    .models
+                    .components_view(&horizon_client::item_render::stack_view(s))
+                    .contains_key("minecraft:consumable")
+            });
+        let screen = self.screen != Screen::Playing
+            || self.title.is_some()
+            || self.dialog_open()
+            || self.book.is_some()
+            || self.sign_edit.is_some()
+            || self
+                .remote
+                .as_ref()
+                .is_some_and(|r| r.level_load.is_active());
+        json!({"dead":p.health.dead_or_dying(),"water":p.fluids.was_touching_water,"screen":screen,"usingConsumable":using_consumable,"entities":entities}).to_string()
+    }
+}
diff --git a/crates/horizon-client/src/game/aimbot.rs b/crates/horizon-client/src/game/aimbot.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/aimbot.rs
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Aimbot's real zero-tick hitboxes, crystal ordering and OUTLINE/player ray.
+use super::{
+    Game, Screen,
+    auto_bow_math::{self as math, B, V},
+};
+use horizon_core::geometry::Vec3;
+use horizon_world::world_ray::{RayBlockMode, RayFluidMode};
+use serde_json::{Value, json};
+fn v(p: Vec3) -> V {
+    V(p.x, p.y, p.z)
+}
+fn p(v: V) -> Vec3 {
+    Vec3::new(v.0, v.1, v.2)
+}
+fn bounds(b: horizon_core::geometry::Aabb) -> B {
+    B {
+        lo: v(b.min_position()),
+        hi: v(b.max_position()),
+    }
+}
+fn outline(g: &Game<'_>, from: V, to: V) -> bool {
+    super::client_ghost_hand::clip(
+        g,
+        &mut super::no_web_ray::NoWebRay(g),
+        p(from),
+        p(to),
+        RayBlockMode::Outline,
+        RayFluidMode::None,
+        4096,
+    )
+    .is_ok_and(|h| h.miss)
+}
+impl Game<'_> {
+    pub(super) fn aimbot_query(&mut self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        if q["op"] == "facts" {
+            let mut facts =
+                serde_json::from_str::<Value>(&self.auto_rod_query("{\"op\":\"facts\"}"))
+                    .unwrap_or(Value::Null);
+            if !facts.is_object() {
+                return "null".into();
+            }
+            let Some(player) = self.player.as_ref() else {
+                return "null".into();
+            };
+            let Some(eye) = self.eye_position().map(|e| V(e[0], e[1], e[2])) else {
+                return "null".into();
+            };
+            let view = v(Vec3::direction_from_rotation(player.pitch, player.yaw));
+            let mut crystals=self.crystals.iter().enumerate().map(|(index,c)| {
+                let b=bounds(c.bounds());let at=c.position;
+                let section=[(at.x.floor() as i32)>>4,(at.z.floor()as i32)>>4,(at.y.floor()as i32)>>4];
+                (section,index,json!({"id":c.id as i32,"distance":b.distance(eye),"cosine":math::max_cos(eye,view,b)}))
+            }).collect::<Vec<_>>();
+            crystals.sort_by_key(|(section, index, _)| (*section, *index));
+            let main = self.stack_in(self.client_hotbar_slot());
+            facts["emptyHand"] =
+                json!(main.is_none_or(|s| s.count == 0 || s.item.as_ref() == "minecraft:air"));
+            facts["screen"] = json!(self.screen != Screen::Playing);
+            facts["useKey"] = json!(self.settings.keys.get("key.use"));
+            facts["crystals"] = json!(
+                crystals
+                    .into_iter()
+                    .map(|(_, _, value)| value)
+                    .collect::<Vec<_>>()
+            );
+            return facts.to_string();
+        }
+        let Some(player) = self.player.as_ref() else {
+            return "null".into();
+        };
+        let Some(eye) = self.eye_position().map(|e| V(e[0], e[1], e[2])) else {
+            return "null".into();
+        };
+        if q["op"] == "raytrace" {
+            let Some(a) = serde_json::from_value::<[f64; 6]>(q["bounds"].clone()).ok() else {
+                return "null".into();
+            };
+            let Some(point) = serde_json::from_value::<[f64; 3]>(q["point"].clone()).ok() else {
+                return "null".into();
+            };
+            return super::aimbot_ray::raytrace(
+                eye,
+                B::from_array(a),
+                V(point[0], point[1], point[2]),
+                q["range"].as_f64().unwrap_or(0.),
+                q["walls"].as_f64().unwrap_or(0.),
+                |a, b| outline(self, a, b),
+            )
+            .map_or_else(|| "null".into(), |r| json!(r).to_string());
+        }
+        let id = q["id"].as_i64().unwrap_or(i64::MIN);
+        let entities = super::auto_bow::entities(self);
+        let (id, b, pickable) = if let Some(e) = entities.iter().find(|e| i64::from(e.id) == id) {
+            let pickable = if let Some(m) = self.mobs.iter().find(|m| m.id as i32 == e.id) {
+                !m.removed && !m.extra.spectator && m.alive()
+            } else if let Some(a) = self.armor_stands.iter().find(|a| a.id as i32 == e.id) {
+                !a.marker
+            } else {
+                true
+            };
+            (e.id, bounds(e.bounds), pickable)
+        } else if let Some(c) = self.crystals.iter().find(|c| i64::from(c.id as i32) == id) {
+            (c.id as i32, bounds(c.bounds()), true)
+        } else {
+            return "null".into();
+        };
+        let b = b.inflate(self.client_pick_margin(id, 0.));
+        if q["op"] == "point" {
+            return json!({"eye":eye.array(),"bounds":[b.lo.0,b.lo.1,b.lo.2,b.hi.0,b.hi.1,b.hi.2]})
+                .to_string();
+        }
+        if q["op"] == "lazy" {
+            if !pickable {
+                return "false".into();
+            }
+            let range = q["range"].as_f64().unwrap_or(0.);
+            let walls = q["walls"].as_f64().unwrap_or(0.);
+            let end =
+                eye.add(v(Vec3::direction_from_rotation(player.pitch, player.yaw)).scale(range));
+            let hit = if b.contains(eye) {
+                Some(eye)
+            } else {
+                let shared_root = self.riding.is_some_and(|r| {
+                    self.client_reach_root_vehicle(r) == self.client_reach_root_vehicle(id as u32)
+                });
+                if shared_root {
+                    None
+                } else {
+                    b.clip(eye, end)
+                        .filter(|hit| hit.sub(eye).len2() < range * range)
+                }
+            };
+            return json!(hit.is_some_and(|hit| {
+                let d = hit.sub(eye).len2();
+                d <= walls * walls
+                    || d <= range * range
+                        && super::spear_kill_ray::clip(self, p(eye), p(hit)).is_some_and(|h| h.0)
+            }))
+            .to_string();
+        }
+        "null".into()
+    }
+    /// WorldRender is emitted after camera extraction, before the 3D HUD. The
+    /// source snapshots old angles and yBob then writes normalized local look.
+    pub(super) fn client_aimbot_frame(&mut self, partial: f32) {
+        if !self.native_window() || !self.native_client_slot_owner() {
+            return;
+        }
+        let (mut yaw, mut pitch, mut apply) = (self.yaw, self.pitch, false);
+        self.native_client_aimbot_render(
+            partial,
+            self.screen != Screen::Playing,
+            matches!(self.screen, Screen::Inventory | Screen::Creative),
+            &mut yaw,
+            &mut pitch,
+            &mut apply,
+        );
+        if !apply {
+            return;
+        }
+        let old = (self.yaw, self.pitch);
+        self.rope_rot_old = old;
+        self.sway.reset_yaw(old.0);
+        if yaw.is_finite() {
+            self.yaw = yaw
+        }
+        if pitch.is_finite() {
+            self.pitch = horizon_client::packet_bridge::set_x_rot(pitch)
+        }
+        if let Some(player) = self.player.as_mut() {
+            player.yaw = self.yaw;
+            player.pitch = self.pitch;
+        }
+        if let Some(model) = self.player_model.as_mut() {
+            model.previous_yaw = old.0;
+            model.yaw = self.yaw;
+            model.previous_head_pitch = old.1;
+            model.head_pitch = self.pitch;
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/aimbot_ray.rs b/crates/horizon-client/src/game/aimbot_ray.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/aimbot_ray.rs
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! RotationFinding.raytraceBox with LeastDifferenceToLastPoint, exact strict
+//! range checks, visible-before-hidden preference and all surface samples.
+use super::auto_bow_math::{self as math, B, V};
+pub fn first_hit(b: B, from: V, to: V) -> Option<V> {
+    if b.contains(from) {
+        b.clip(to, from)
+    } else {
+        b.clip(from, to)
+    }
+}
+fn difference(base: [f32; 2], angle: [f32; 2]) -> f32 {
+    let y = math::wrap(angle[0] - base[0]);
+    let p = angle[1] - base[1];
+    y * y + p * p
+}
+pub fn raytrace(
+    eyes: V,
+    b: B,
+    point: V,
+    range: f64,
+    walls: f64,
+    mut visible: impl FnMut(V, V) -> bool,
+) -> Option<[f32; 2]> {
+    let range = range * range;
+    let walls = walls * walls;
+    if let Some(hit) = first_hit(b, eyes, point) {
+        let distance = hit.sub(eyes).len2();
+        let seen = visible(eyes, hit);
+        if distance < if seen { range } else { walls } {
+            return Some(math::rotation(hit.sub(eyes)));
+        }
+    }
+    let base = math::rotation(point.sub(eyes));
+    let mut best: [Option<([f32; 2], f32)>; 2] = [None, None];
+    let mut consider = |spot: V| {
+        let Some(hit) = first_hit(b, eyes, eyes.fma(2., spot.sub(eyes))) else {
+            return;
+        };
+        let distance = hit.sub(eyes).len2();
+        let seen = visible(eyes, hit);
+        if !(distance < if seen { range } else { walls }) {
+            return;
+        }
+        let angle = math::rotation(spot.sub(eyes));
+        let score = difference(base, angle);
+        let i = usize::from(!seen);
+        if best[i].is_none_or(|(_, old)| java_float_compare(old, score).is_gt()) {
+            best[i] = Some((angle, score));
+        }
+    };
+    consider(point);
+    let nearest = V(
+        eyes.0.clamp(b.lo.0, b.hi.0),
+        eyes.1.clamp(b.lo.1, b.hi.1),
+        eyes.2.clamp(b.lo.2, b.hi.2),
+    );
+    consider(nearest);
+    if !b.contains(eyes) {
+        for p in math::projected_points_limit(eyes, b, 256) {
+            consider(p)
+        }
+    } else {
+        // Direction.entries: DOWN, UP, NORTH, SOUTH, WEST, EAST.
+        for (axis, high) in [
+            (1, false),
+            (1, true),
+            (2, false),
+            (2, true),
+            (0, false),
+            (0, true),
+        ] {
+            let mut lo = b.lo.array();
+            let mut hi = b.hi.array();
+            let c = if high { hi[axis] } else { lo[axis] };
+            lo[axis] = c;
+            hi[axis] = c;
+            let dims = std::array::from_fn::<_, 3, _>(|i| hi[i] - lo[i]);
+            let (a, z) = if dims[0] == 0. {
+                (1, 2)
+            } else if dims[1] == 0. {
+                (0, 2)
+            } else {
+                (0, 1)
+            };
+            let area = dims[0] * dims[1] + dims[1] * dims[2] + dims[0] * dims[2];
+            let spacing = 0.1f64.max((area / 100.).sqrt());
+            let na = (dims[a] / spacing).ceil().max(1.) as i32;
+            let nz = (dims[z] / spacing).ceil().max(1.) as i32;
+            for x in 0..na {
+                for y in 0..nz {
+                    let mut p = lo;
+                    p[a] = dims[a].mul_add((f64::from(x) + 0.5) / f64::from(na), lo[a]);
+                    p[z] = dims[z].mul_add((f64::from(y) + 0.5) / f64::from(nz), lo[z]);
+                    consider(V(p[0], p[1], p[2]));
+                }
+            }
+        }
+    }
+    best[0].or(best[1]).map(|(r, _)| r)
+}
+fn java_float_compare(a: f32, b: f32) -> std::cmp::Ordering {
+    if a < b {
+        return std::cmp::Ordering::Less;
+    }
+    if a > b {
+        return std::cmp::Ordering::Greater;
+    }
+    let bits = |v: f32| {
+        if v.is_nan() {
+            0x7fc00000i32
+        } else {
+            v.to_bits() as i32
+        }
+    };
+    bits(a).cmp(&bits(b))
+}
diff --git a/crates/horizon-client/src/game/chest_stealer.rs b/crates/horizon-client/src/game/chest_stealer.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/chest_stealer.rs
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::*;
+use serde_json::{Value, json};
+impl Game<'_> {
+    pub(super) fn chest_stealer_context(&self) -> Option<String> {
+        let mut v: Value = self
+            .native_client_chest_cleaner_context()
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_else(|| json!({}));
+        v["abstract"] = json!(matches!(self.screen, Screen::Inventory | Screen::Creative));
+        v["inventory"] =
+            json!(self.screen == Screen::Inventory && self.client_inventory_player_menu());
+        Some(v.to_string())
+    }
+    pub(super) fn client_chest_stealer_options(&self) -> Value {
+        self.client_better_inventory_query(json!({"kind":"chestStealerQuery"}))
+    }
+    pub(super) fn client_chest_stealer_hidden(&self) -> bool {
+        self.client_chest_stealer_options()["hidden"] == true
+    }
+    pub(super) fn native_client_chest_stealer_screen(&mut self, screen: Screen) -> Screen {
+        let previous = self.screen;
+        self.screen = screen;
+        let mut value = self
+            .chest_stealer_context()
+            .and_then(|s| serde_json::from_str::<Value>(&s).ok())
+            .unwrap_or_else(|| json!({"abstract":false}));
+        self.screen = previous;
+        value["kind"] = json!("chestStealerScreen");
+        self.client_better_inventory_query(value);
+        screen
+    }
+    pub(super) fn client_chest_stealer_sent(&self, p: &horizon_protocol::packets::play::UseItemOn) {
+        let mut positions = vec![p.pos];
+        if let Some((other, _)) = self.chest_partner((p.pos[0], p.pos[1], p.pos[2])) {
+            positions.push([other.0, other.1, other.2]);
+        }
+        self.client_better_inventory_query(
+            json!({"kind":"chestStealerUseOn","positions":positions,"cancelled":false}),
+        );
+    }
+    pub(super) fn chest_stealer_use_on(&mut self, payload: &str) -> bool {
+        if !self.native_client_slot_owner() {
+            return false;
+        }
+        let Ok(v) = serde_json::from_str::<Value>(payload) else {
+            return false;
+        };
+        let Ok(pos) = serde_json::from_value::<[i32; 3]>(v["target"]["pos"].clone()) else {
+            return false;
+        };
+        let Ok(rotation) = serde_json::from_value::<[f32; 2]>(v["rotation"].clone()) else {
+            return false;
+        };
+        let Some(range) = v["range"].as_f64() else {
+            return false;
+        };
+        let Some(hit) = self
+            .auto_deposit_rotation_hit(pos, rotation, range)
+            .filter(|h| h.pos == pos)
+        else {
+            return false;
+        };
+        self.client_chest_stealer_result = Some(false);
+        self.client_chest_stealer_hide_swing = v["hideSwing"] == true;
+        if self.remote.is_some() {
+            self.remote_use_item_on_at(horizon_client::first_person::Hand::Main, Some(hit));
+        } else {
+            let previous_use = self.guest_use;
+            self.guest_use = Some(GuestUse::OnBlock(horizon_client::first_person::Hand::Main));
+            let _ = self.with_hand(horizon_client::first_person::Hand::Main, |g| {
+                g.use_hand(Some(&hit))
+            });
+            self.guest_use = previous_use;
+        }
+        self.client_chest_stealer_hide_swing = false;
+        self.client_chest_stealer_result.take().unwrap_or(false)
+    }
+    pub(super) fn client_chest_stealer_animation(
+        &self,
+    ) -> horizon_client::first_person::SwingAnimation {
+        use horizon_client::first_person::SwingAnimation;
+        let Some(stack) = self.held() else {
+            return SwingAnimation::DEFAULT;
+        };
+        let view = horizon_client::item_render::stack_view(stack);
+        let components = self.pack.item_renderer.models.components_view(&view);
+        let Some(v) = components.get("minecraft:interact_animation") else {
+            return SwingAnimation::DEFAULT;
+        };
+        SwingAnimation {
+            kind: match v["type"].as_str().unwrap_or("whack") {
+                "none" => 0,
+                "stab" => 2,
+                _ => 1,
+            },
+            duration: v["duration"].as_i64().unwrap_or(6) as i32,
+        }
+    }
+    pub(super) fn client_chest_stealer_tag(&mut self, batch: &mut HudBatch) {
+        let options = self.client_chest_stealer_options();
+        if options["hidden"] != true || options["draw"] != true {
+            return;
+        }
+        let Ok(pos) = serde_json::from_value::<[i32; 3]>(options["pos"].clone()) else {
+            return;
+        };
+        let Ok(offset) = serde_json::from_value::<[f64; 3]>(options["offset"].clone()) else {
+            return;
+        };
+        let Some(camera) = self.native_camera() else {
+            return;
+        };
+        let mut center = pos.map(|v| f64::from(v) + 0.5);
+        if let Some((other, _)) = self.chest_partner((pos[0], pos[1], pos[2])) {
+            for (i, p) in [other.0, other.1, other.2].into_iter().enumerate() {
+                center[i] = (center[i] + f64::from(p) + 0.5) * 0.5;
+            }
+        }
+        for i in 0..3 {
+            center[i] += offset[i];
+        }
+        let matrix = glam::Mat4::from_cols_array(&camera.projection)
+            * glam::Mat4::from_cols_array(&camera.view);
+        let p = matrix
+            * glam::Vec4::new(
+                (center[0] - camera.position[0]) as f32,
+                (center[1] - camera.position[1]) as f32,
+                (center[2] - camera.position[2]) as f32,
+                1.,
+            );
+        if !p.is_finite() || p.w <= 0. {
+            return;
+        }
+        let (cx, cy) = (
+            (p.x / p.w + 1.) * batch.width * 0.5,
+            (-p.y / p.w + 1.) * batch.height * 0.5,
+        );
+        let slots = self
+            .client_inventory_mapping(false)
+            .into_iter()
+            .filter(|slot| slot.is_none_or(|i| !(i < 36 || (500..=504).contains(&i))))
+            .map(|slot| slot.and_then(|i| self.slot_view(i)))
+            .collect::<Vec<_>>();
+        if slots.is_empty() {
+            return;
+        }
+        let title = if options["title"] == true {
+            self.chest_stealer_context()
+                .and_then(|s| serde_json::from_str::<Value>(&s).ok())
+                .and_then(|v| v["title"].as_str().map(str::to_owned))
+        } else {
+            None
+        };
+        let scale=options["scale"].as_f64().unwrap_or(1.5)as f32;
+        self.client_item_stack_list(batch,super::item_stack_list::List{
+            stacks:slots,title:title.map(horizon_client::text::Text::literal),title_color:u32::MAX,
+            row_length:9,center:[cx,cy],scale,background:options,renderer:None,
+        },false);
+    }
+
+}
diff --git a/crates/horizon-client/src/game/item_tags.rs b/crates/horizon-client/src/game/item_tags.rs
