+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete TerrainSpeed groups and handlers, LiquidBounce ae0eb396.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ClimbMode {
+    #[default]
+    Motion,
+    Clip,
+}
+impl ClimbMode {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Motion => "Motion",
+            Self::Clip => "Clip",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct FastClimb {
+    pub enabled: bool,
+    pub mode: ClimbMode,
+    pub motion: f32,
+}
+impl Default for FastClimb {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            mode: ClimbMode::Motion,
+            motion: 0.2872,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct IceSpeed {
+    pub enabled: bool,
+    pub slipperiness: f32,
+    pub motion_enabled: bool,
+    pub horizontal_motion: f32,
+}
+impl Default for IceSpeed {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            slipperiness: 0.6,
+            motion_enabled: false,
+            horizontal_motion: 0.5,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WaterSpeed {
+    pub enabled: bool,
+    pub auto_swim: bool,
+    pub base_horizontal: f32,
+    pub base_vertical: f32,
+    pub sprint_enabled: bool,
+    pub sprint_horizontal: f32,
+    pub sprint_vertical: f32,
+}
+impl Default for WaterSpeed {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            auto_swim: true,
+            base_horizontal: 0.44,
+            base_vertical: 0.44,
+            sprint_enabled: true,
+            sprint_horizontal: 1.0,
+            sprint_vertical: 1.0,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct TerrainSpeed {
+    pub fast_climb: FastClimb,
+    pub ice_speed: IceSpeed,
+    pub water_speed: WaterSpeed,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Direction {
+    North,
+    South,
+    West,
+    East,
+    Up,
+    Down,
+}
+pub trait ClimbWorld {
+    type Error;
+    fn horizontal_collision(&self) -> bool;
+    fn on_climbable(&mut self) -> Result<bool, Self::Error>;
+    fn forward_key(&self) -> bool;
+    fn position(&self) -> [f64; 3];
+    fn block_position(&self) -> [i32; 3];
+    /// Class identity LadderBlock or VineBlock, rather than climbable tags.
+    fn ladder_or_vine(&mut self, position: [i32; 3]) -> Result<bool, Self::Error>;
+    fn direction(&self) -> Direction;
+    fn abs_snap_to(&mut self, position: [f64; 3]) -> Result<(), Self::Error>;
+}
+impl FastClimb {
+    /// Original PlayerMoveEvent handler has no MoverType or on-ground guard.
+    pub fn move_event<W: ClimbWorld>(
+        self,
+        running: bool,
+        world: &mut W,
+        movement: &mut [f64; 3],
+    ) -> Result<(), W::Error> {
+        if !running || !self.enabled {
+            return Ok(());
+        }
+        match self.mode {
+            ClimbMode::Motion => {
+                if world.horizontal_collision() && world.on_climbable()? {
+                    movement[1] = f64::from(self.motion);
+                }
+            }
+            ClimbMode::Clip => {
+                if world.on_climbable()? && world.forward_key() {
+                    let start = world.position();
+                    let mut block = world.block_position();
+                    for y in 1..=8 {
+                        block[1] = block[1].wrapping_add(1);
+                        if world.ladder_or_vine(block)? {
+                            world.abs_snap_to([start[0], start[1] + f64::from(y), start[2]])?;
+                        } else {
+                            let (x, z) = match world.direction() {
+                                Direction::North => (0., -1.),
+                                Direction::South => (0., 1.),
+                                Direction::West => (-1., 0.),
+                                Direction::East => (1., 0.),
+                                Direction::Up | Direction::Down => break,
+                            };
+                            world.abs_snap_to([
+                                start[0] + x,
+                                start[1] + f64::from(y) + 1.,
+                                start[2] + z,
+                            ])?;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+impl IceSpeed {
+    /// The event is global: its subject need not be the local player.
+    pub fn block_friction(
+        self,
+        running: bool,
+        block: &str,
+        friction: f32,
+        local_velocity: &mut [f64; 3],
+    ) -> f32 {
+        if running
+            && self.enabled
+            && matches!(
+                block,
+                "minecraft:ice"
+                    | "minecraft:blue_ice"
+                    | "minecraft:frosted_ice"
+                    | "minecraft:packed_ice"
+            )
+        {
+            if self.motion_enabled {
+                let motion = f64::from(self.horizontal_motion);
+                local_velocity[0] *= motion;
+                local_velocity[1] *= 1.0;
+                local_velocity[2] *= motion;
+            }
+            self.slipperiness
+        } else {
+            friction
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default)]
+pub struct WaterContext {
+    pub in_water: bool,
+    pub physical_sprint: bool,
+    pub physical_jump: bool,
+    pub physical_sneak: bool,
+    pub moving: bool,
+    /// Untransformed directional flags: forward=1, backward=2, left=4, right=8.
+    pub input: u8,
+    pub yaw: f32,
+}
+impl WaterSpeed {
+    pub fn movement_input(
+        self,
+        running: bool,
+        in_water: bool,
+        physical_sneak: bool,
+        jump: &mut bool,
+    ) {
+        if running && self.enabled && self.auto_swim && in_water && !physical_sneak {
+            *jump = true;
+        }
+    }
+    /// PlayerTickEvent uses physical keys, independently of event.jump/shift.
+    pub fn player_tick(
+        self,
+        running: bool,
+        context: WaterContext,
+        velocity: &mut [f64; 3],
+        java_sin_cos: impl FnOnce(f64) -> [f64; 2],
+    ) {
+        if !running || !self.enabled || !context.in_water {
+            return;
+        }
+        let sprint = context.physical_sprint && self.sprint_enabled;
+        let horizontal = f64::from(if sprint {
+            self.sprint_horizontal
+        } else {
+            self.base_horizontal
+        });
+        let vertical = f64::from(if sprint {
+            self.sprint_vertical
+        } else {
+            self.base_vertical
+        });
+        if context.moving {
+            if (context.input & 1 != 0) == (context.input & 2 != 0)
+                && (context.input & 4 != 0) == (context.input & 8 != 0)
+            {
+                velocity[0] = 0.;
+                velocity[2] = 0.;
+            } else {
+                let angle = f64::from(crate::strafe::movement_direction(
+                    context.yaw,
+                    context.input,
+                ))
+                .to_radians();
+                let [sin, cos] = java_sin_cos(angle);
+                // withStrafe's default strength still multiplies the previous
+                // components by zero, preserving its IEEE exceptional behavior.
+                velocity[0] = velocity[0] * 0.0 - sin * (horizontal * 1.0);
+                velocity[2] = velocity[2] * 0.0 + cos * (horizontal * 1.0);
+            }
+        }
+        if context.physical_jump {
+            velocity[1] = vertical;
+        } else if context.physical_sneak {
+            velocity[1] = -vertical;
+        }
+    }
+}
diff --git a/crates/horizon-client/src/terrain_speed_bridge.rs b/crates/horizon-client/src/terrain_speed_bridge.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/terrain_speed_bridge.rs
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Window-thread scope for global Block.getFriction callbacks.
+//!
+//! Non-player entity solvers do not hold the local player's storage. Each
+//! callback queues its individual multiplication, which Game drains before
+//! returning from that solver or entering another player-observing callback.
+//! Never combine multipliers: doing so changes rounding and signed zero.
+use crate::terrain_speed::{FastClimb, TerrainSpeed};
+use crate::terrain_speed_order::Selection;
+use horizon_core::geometry::Vec3;
+use std::cell::RefCell;
+use std::collections::HashSet;
+
+#[derive(Clone, Copy, Debug)]
+pub struct Snapshot {
+    pub settings: TerrainSpeed,
+    pub forward: bool,
+    pub sprint: bool,
+    pub jump: bool,
+    pub sneak: bool,
+    /// Last installed untransformed ClientInput, before this tick reads keys.
+    pub input: u8,
+}
+#[derive(Default)]
+struct Context {
+    snapshot: Option<Snapshot>,
+    pending: Vec<f64>,
+    selection: Selection,
+    driven: HashSet<u32>,
+    old_position: Option<Vec3>,
+}
+thread_local! {static CONTEXT:RefCell<Context>=RefCell::new(Context::default());}
+pub struct Scope(Option<Context>);
+pub fn enter(snapshot: Option<Snapshot>) -> Scope {
+    Scope(Some(CONTEXT.with(|c| {
+        c.replace(Context {
+            snapshot,
+            ..Default::default()
+        })
+    })))
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        CONTEXT.with(|c| {
+            let previous = self.0.take().unwrap();
+            let current = c.replace(previous);
+            debug_assert!(
+                current.pending.is_empty(),
+                "unflushed global TerrainSpeed friction callbacks"
+            );
+            debug_assert!(
+                current.old_position.is_none(),
+                "unflushed TerrainSpeed absSnapTo history"
+            );
+        });
+    }
+}
+pub fn snapshot() -> Option<Snapshot> {
+    CONTEXT.with(|c| c.borrow().snapshot)
+}
+pub fn selection() -> Selection {
+    CONTEXT.with(|c|c.borrow().selection)
+}
+pub fn selected(id:u32)->bool {selection().includes(id)}
+pub fn ancillary()->bool {selection().ancillary()}
+pub fn ordered()->bool {snapshot().is_some()}
+pub struct SelectionScope(Selection);
+pub fn select(selection:Selection)->SelectionScope {
+    SelectionScope(CONTEXT.with(|c|std::mem::replace(&mut c.borrow_mut().selection,selection)))
+}
+impl Drop for SelectionScope {
+    fn drop(&mut self){CONTEXT.with(|c|c.borrow_mut().selection=self.0);}
+}
+pub fn mark_driven(id:u32){CONTEXT.with(|c|{c.borrow_mut().driven.insert(id);});}
+pub fn was_driven(id:u32)->bool{CONTEXT.with(|c|c.borrow().driven.contains(&id))}
+pub fn climb() -> Option<(FastClimb, bool)> {
+    snapshot().map(|s| (s.settings.fast_climb, s.forward))
+}
+pub fn record_snap(position: Vec3) {
+    CONTEXT.with(|c| c.borrow_mut().old_position = Some(position));
+}
+pub fn take_snap() -> Option<Vec3> {
+    CONTEXT.with(|c| c.borrow_mut().old_position.take())
+}
+pub fn flush(velocity: &mut Vec3) {
+    CONTEXT.with(|c| {
+        for factor in c.borrow_mut().pending.drain(..) {
+            velocity.x *= factor;
+            velocity.y *= 1.0;
+            velocity.z *= factor;
+        }
+    });
+}
+pub fn discard_pending() {
+    CONTEXT.with(|c| {
+        let mut c = c.borrow_mut();
+        c.pending.clear();
+    });
+}
+/// Exact event point for an arbitrary queried block, including non-player bodies.
+pub fn friction(block: &str, base: f32) -> f32 {
+    query_friction(block, base)
+}
+pub fn friction_for(_entity: u32, block: &str, base: f32) -> f32 {
+    query_friction(block, base)
+}
+fn query_friction(block: &str, base: f32) -> f32 {
+    CONTEXT.with(|c| {
+        let mut c = c.borrow_mut();
+        let Some(s) = c.snapshot else { return base };
+        let ice = s.settings.ice_speed;
+        if !ice.enabled
+            || !matches!(
+                block,
+                "minecraft:ice"
+                    | "minecraft:blue_ice"
+                    | "minecraft:frosted_ice"
+                    | "minecraft:packed_ice"
+            )
+        {
+            return base;
+        }
+        if ice.motion_enabled {
+            c.pending.push(f64::from(ice.horizontal_motion));
+        }
+        ice.slipperiness
+    })
+}
+/// A local-player solver already owns its velocity, so apply synchronously here.
+pub fn player_friction(block: &str, base: f32, velocity: &mut Vec3) -> f32 {
+    flush(velocity);
+    let Some(s) = snapshot() else { return base };
+    let mut raw = [velocity.x, velocity.y, velocity.z];
+    let friction = s
+        .settings
+        .ice_speed
+        .block_friction(true, block, base, &mut raw);
+    *velocity = Vec3::new(raw[0], raw[1], raw[2]);
+    friction
+}
