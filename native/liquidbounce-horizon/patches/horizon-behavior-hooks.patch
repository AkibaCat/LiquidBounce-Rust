diff --git a/crates/horizon-client/src/game/client_clip.rs b/crates/horizon-client/src/game/client_clip.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/client_clip.rs
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::blocks::Fluid;
+use horizon_client::collisions::SceneCollisions;
+use horizon_core::geometry::Direction;
+use horizon_world::{
+    block_support::{BlockSupportRegistry, SupportType},
+    registry::BlockTableFile,
+};
+use std::{cell::RefCell, path::PathBuf};
+type Support = (PathBuf, usize, Option<BlockSupportRegistry<'static>>);
+thread_local! { static SUPPORT: RefCell<Option<Support>> = const { RefCell::new(None) }; }
+impl Game<'_> {
+    pub(super) fn clip_context(&self) -> Option<String> {
+        if !self.native_window() || self.lan_acting.is_some() || self.lan_acting_uuid.is_some() {
+            return None;
+        }
+        let p = self
+            .player
+            .as_ref()
+            .filter(|p| p.native_client_queries_allowed())?;
+        use horizon_client::actions::Action;
+        Some(serde_json::json!({"position":[p.position.x,p.position.y,p.position.z],"yaw":self.yaw,
+            "collision":p.collision.horizontal,"keys":([Action::Forward,Action::Back,Action::Left,Action::Right,Action::Sneak,Action::Jump].map(|key|self.keys.held(key)))}).to_string())
+    }
+    pub(super) fn clip_snap(&mut self, position: [f64; 3], reset: bool) {
+        if self.clip_context().is_none() || !position.iter().all(|v| v.is_finite()) {
+            return;
+        }
+        let at = horizon_core::geometry::Vec3::new(position[0], position[1], position[2]);
+        if let Some(p) = self.player.as_mut() {
+            p.position = at;
+            if reset {
+                p.velocity = horizon_core::geometry::Vec3::ZERO;
+            }
+        }
+        self.previous_position = at;
+    }
+    pub(super) fn clip_target(
+        &self,
+        direction: i32,
+        length: i32,
+        liquids: u32,
+        stand: bool,
+    ) -> Option<[f64; 3]> {
+        if !(0..6).contains(&direction) || self.clip_context().is_none() {
+            return None;
+        }
+        let p = self.player.as_ref()?;
+        let start = [
+            p.position.x.floor() as i32,
+            p.position.y.floor() as i32,
+            p.position.z.floor() as i32,
+        ];
+        let registry = self.res.collision().registry();
+        SUPPORT.with(|cache| {
+            let mut cache = cache.borrow_mut();
+            let key = registry as *const _ as usize;
+            if cache
+                .as_ref()
+                .is_none_or(|(root, id, _)| *root != self.options.resources || *id != key)
+            {
+                let support = (|| {
+                    let file = BlockTableFile::open(
+                        &self.options.resources.join("cached-support.nbt"),
+                        registry,
+                    )
+                    .ok()?;
+                    BlockSupportRegistry::from_table(file.table("support").ok()?).ok()
+                })();
+                *cache = Some((self.options.resources.clone(), key, support));
+            }
+            let support = cache.as_ref().and_then(|(_, _, s)| s.as_ref());
+            let target = super::client_clip_logic::find_target(
+                start,
+                direction as usize,
+                length,
+                |pos, need_stand| {
+                    let loaded =
+                        |p: [i32; 3]| self.world.chunks.contains_key(&(p[0] >> 4, p[2] >> 4));
+                    let above = [pos[0], pos[1].wrapping_add(1), pos[2]];
+                    if !loaded(pos) || !loaded(above) {
+                        return false;
+                    }
+                    if stand && need_stand {
+                        let below = [pos[0], pos[1].wrapping_sub(1), pos[2]];
+                        if !loaded(below) {
+                            return false;
+                        }
+                        let Some(support) = support else {
+                            return false;
+                        };
+                        let mut world = SceneCollisions {
+                            world: &self.world,
+                            binding: self.collision,
+                            subject: None,
+                        };
+                        if !support
+                            .is_face_sturdy(
+                                &mut world,
+                                self.world.block(below[0], below[1], below[2]),
+                                below,
+                                Direction::Up,
+                                SupportType::Center,
+                            )
+                            .unwrap_or(false)
+                        {
+                            return false;
+                        }
+                    }
+                    let state = self.world.block(pos[0], pos[1], pos[2]);
+                    let above = self.world.block(above[0], above[1], above[2]);
+                    let facts = self.res.facts().get(state);
+                    let top = self.res.facts().get(above);
+                    let air = |id| self.res.facts().is_air(id);
+                    (air(state) && air(above))
+                        || ((liquids & 1 != 0 && facts.fluid == Fluid::Water)
+                            || (liquids & 2 != 0 && facts.fluid == Fluid::Lava))
+                            && (air(above) || facts.fluid == top.fluid)
+                },
+            );
+            target.map(|[x, y, z]| [f64::from(x) + 0.5, f64::from(y), f64::from(z) + 0.5])
+        })
+    }
+}
diff --git a/crates/horizon-client/src/game/client_clip_logic.rs b/crates/horizon-client/src/game/client_clip_logic.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/client_clip_logic.rs
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleClip at ae0eb396: wall-first search, input priority and coroutine wait.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Clip {
+    pub mode: u8,
+    pub horizontal: i32,
+    pub vertical: i32,
+    pub liquids: u32,
+    pub requires_stand_on: bool,
+    pub old_horizontal: f32,
+    pub old_vertical: f32,
+    pub reset_velocity: bool,
+    pub possible: [bool; 2],
+    ticket: u64,
+    wait: Option<(u64, i32)>,
+}
+impl Default for Clip {
+    fn default() -> Self {
+        Self {
+            mode: 0,
+            horizontal: 0,
+            vertical: 5,
+            liquids: 0,
+            requires_stand_on: true,
+            old_horizontal: 0.0,
+            old_vertical: 5.0,
+            reset_velocity: true,
+            possible: [false; 2],
+            ticket: 0,
+            wait: None,
+        }
+    }
+}
+pub const DIRECTIONS: [[i32; 3]; 6] = [
+    [0, 1, 0],
+    [0, -1, 0],
+    [0, 0, 1],
+    [-1, 0, 0],
+    [0, 0, -1],
+    [1, 0, 0],
+];
+pub fn find_target(
+    start: [i32; 3],
+    direction: usize,
+    length: i32,
+    mut valid: impl FnMut([i32; 3], bool) -> bool,
+) -> Option<[i32; 3]> {
+    let offset = DIRECTIONS[direction];
+    let mut pos = start;
+    let mut wall = false;
+    for _ in 0..length.max(0) {
+        for i in 0..3 {
+            pos[i] = pos[i].wrapping_add(offset[i]);
+        }
+        if valid(pos, direction != 0) {
+            if wall {
+                return Some(pos);
+            }
+        } else {
+            wall = true;
+        }
+    }
+    None
+}
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Input {
+    pub horizontal_collision: bool,
+    pub keys: [bool; 6], // forward, backward, left, right, sneak, jump
+    pub yaw: f32,
+}
+pub fn movement_direction(c: Input) -> Option<usize> {
+    let facing = ((c.yaw / 90.0 + 0.5).floor() as i32).rem_euclid(4) as usize;
+    if c.horizontal_collision {
+        let offset = c.keys[..4]
+            .iter()
+            .position(|v| *v)
+            .map(|i| [0, 2, 3, 1][i])?;
+        Some(2 + (facing + offset) % 4)
+    } else if c.keys[4] {
+        Some(1)
+    } else if c.keys[5] {
+        Some(0)
+    } else {
+        None
+    }
+}
+impl Clip {
+    pub fn cancel(&mut self) {
+        self.wait = None;
+        self.possible = [false; 2];
+    }
+    pub fn busy(&self) -> bool {
+        self.wait.is_some()
+    }
+    pub fn register_wait(&mut self) -> u64 {
+        self.ticket = self.ticket.wrapping_add(1);
+        self.wait = Some((self.ticket, 5));
+        self.ticket
+    }
+    /// false finishes this callback; ready allows its body to resume this tick.
+    pub fn advance(&mut self, id: u64, running: bool) -> (bool, bool) {
+        let Some((ticket, remaining)) = self.wait.as_mut() else {
+            return (false, false);
+        };
+        if *ticket != id {
+            return (false, false);
+        }
+        if !running || self.mode != 0 {
+            self.cancel();
+            return (false, false);
+        }
+        *remaining -= 1;
+        if *remaining > 0 {
+            return (true, false);
+        }
+        self.wait = None;
+        (false, true)
+    }
+    pub fn old_offset(&self, yaw: f32) -> [f64; 3] {
+        // Kotlin Float.toRadians performs Float arithmetic before widening.
+        let yaw = (yaw * (std::f32::consts::PI / 180.0)) as f64;
+        [
+            -yaw.sin() * f64::from(self.old_horizontal),
+            f64::from(self.old_vertical),
+            yaw.cos() * f64::from(self.old_horizontal),
+        ]
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn wall_input_and_five_tick_smoke() {
+        assert_eq!(
+            find_target([0, 0, 0], 0, 5, |p, stand| {
+                assert!(!stand);
+                p[1] != 2
+            }),
+            Some([0, 3, 0])
+        );
+        assert_eq!(find_target([0, 0, 0], 1, 5, |_, _| true), None);
+        assert_eq!(
+            movement_direction(Input {
+                horizontal_collision: true,
+                keys: [false, false, true, false, true, true],
+                yaw: 0.
+            }),
+            Some(5)
+        );
+        assert_eq!(
+            movement_direction(Input {
+                keys: [false, false, false, false, true, true],
+                ..Input::default()
+            }),
+            Some(1)
+        );
+        let mut s = Clip::default();
+        let id = s.register_wait();
+        for _ in 0..4 {
+            assert_eq!(s.advance(id, true), (true, false));
+        }
+        assert_eq!(s.advance(id, true), (false, true));
+        assert!(!s.busy());
+        let id = s.register_wait();
+        assert_eq!(s.advance(id, false), (false, false));
+        assert!(!s.busy());
+        assert_eq!(s.old_offset(0.), [0., 5., 0.]);
+    }
+}
