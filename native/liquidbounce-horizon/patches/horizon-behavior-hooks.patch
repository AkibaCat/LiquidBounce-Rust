+pub(super) fn native_client_spear_kill_context(&self) -> Option<[f64; 7]> {
+    if !self.native_client_slot_owner() {
+        return None;
+    }
+    let used = self
+        .using
+        .and_then(|(slot, ticks)| self.stack_in(slot).map(|s| (s, ticks)));
