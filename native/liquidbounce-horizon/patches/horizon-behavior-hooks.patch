+++ b/crates/horizon-client/src/game/indicator.rs
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::{hud::HudBatch, text::Text};
+use std::cell::RefCell;
+#[path = "indicator_math.rs"]
+mod math;
+pub(super) enum Arrow {
+    None,
+    Triangle { width: f32, height: f32, notch: f32 },
+    Atlas { size: f32, uv: [[f32; 2]; 4] },
+}
+impl Arrow {
+    fn length(&self) -> f32 {
+        match self {
+            Self::None => 0.,
+            Self::Triangle { height, .. } => *height,
+            Self::Atlas { size, .. } => *size,
+        }
+    }
+}
+pub(super) enum Primitive {
+    Item{stack:horizon_client::items::ItemStack,origin:[f32;2],scale:f32},
+    LiquidBounceText{text:Text,origin:[f32;2],scale:f32,color:u32,shadow:bool},
+    Text {
+        text: Text,
+        origin: [f32; 2],
+        scale: f32,
+        color: u32,
+        shadow: bool,
+    },
+    Quad {
+        corners: [[f32; 2]; 4],
+        uv: [[f32; 2]; 4],
+        color: u32,
+    },
+}
+pub(super) struct Entry {
+    pub position: [f64; 3],
+    pub priority: i32,
+    pub color: u32,
+    pub visible: [bool; 2],
+    pub edge_inset: f32,
+    pub style: Arrow,
+    pub in_view_style: Arrow,
+    pub bounds: [f32; 4],
+    pub tag: Vec<Primitive>,
+}
+thread_local! {static SUBMITTED:RefCell<Vec<Entry>>=const{RefCell::new(Vec::new())};}
+pub(super) fn clear() {
+    SUBMITTED.with_borrow_mut(Vec::clear);
+    horizon_client::gfx::indicator::clear();
+}
+pub(super) fn submit(entry: Entry) {
+    SUBMITTED.with_borrow_mut(|v| v.push(entry));
+}
+fn native_color(argb: u32) -> u32 {
+    let [a, r, g, b] = argb.to_be_bytes();
+    u32::from_le_bytes([r, g, b, a])
+}
+impl Game<'_> {
+    pub(super) fn client_indicator_overlay(&self, batch: &mut HudBatch) {
+        let mut entries = SUBMITTED.with_borrow_mut(std::mem::take);
+        let Some(camera) = self.native_camera() else {
+            return;
+        };
+        let Some(window) = self.native_physical_window_size() else {
+            return;
+        };
+        let matrix = glam::Mat4::from_cols_array(&camera.projection)
+            * glam::Mat4::from_cols_array(&camera.view);
+        entries.sort_by_key(|v| v.priority);
+        for entry in entries {
+            let clip = matrix
+                * glam::Vec4::new(
+                    (entry.position[0] - camera.position[0]) as f32,
+                    (entry.position[1] - camera.position[1]) as f32,
+                    (entry.position[2] - camera.position[2]) as f32,
+                    1.,
+                );
+            let projected = math::project(clip.to_array(), window.map(|v| v as f32), batch.scale);
+            let Some(layout) = math::layout(
+                projected,
+                [batch.width, batch.height],
+                entry.bounds,
+                entry.edge_inset,
+                entry.visible,
+                entry.style.length(),
+                entry.in_view_style.length(),
+            ) else {
+                continue;
+            };
+            for primitive in entry.tag {
+                self.client_indicator_primitive(batch,primitive,layout.tag);
+            }
+            let style = if layout.in_view {
+                entry.in_view_style
+            } else {
+                entry.style
+            };
+            match style {
+                Arrow::None => {}
+                Arrow::Triangle {
+                    width,
+                    height,
+                    notch,
+                } => horizon_client::gfx::indicator::submit(
+                    layout.arrow_origin,
+                    layout.angle,
+                    [width, height],
+                    notch,
+                    entry.color,
+                    [batch.width, batch.height],
+                ),
+                Arrow::Atlas { size, uv } => batch.quad(
+                    math::arrow_quad(layout.arrow_origin, layout.angle, size, size),
+                    uv,
+                    native_color(entry.color),
+                ),
+            }
+        }
+        horizon_client::gfx::indicator::finish_layer(batch.vertices.len());
+    }
+}
+
+impl Game<'_>{
+    pub(super) fn client_indicator_primitive(&self,batch:&mut HudBatch,primitive:Primitive,at:[f32;2]){
+                match primitive {
+                    Primitive::Item{stack,origin,scale}=>{
+                        let owner=self.player_owner(Some(&stack));
+                        let state=self.resolve_item(&stack,horizon_assets::item_model::DisplayContext::Gui,Some(&owner),0);
+                        let first=batch.vertices.len();
+                        horizon_client::item_render::gui::draw(&state,&self.pack.item_renderer,&self.gui.atlas.sprites,&self.item_host(),batch,origin[0],origin[1],self.glint_frame.millis/1000.,self.glint_frame.speed,self.glint_frame.alpha);
+                        for v in &mut batch.vertices[first..]{v.pos=[at[0]+v.pos[0]*scale,at[1]+v.pos[1]*scale];}
+                    }
+                    Primitive::LiquidBounceText{text,origin,scale,color,shadow}=>{
+                        use horizon_client::hud::Rect;
+                        let(ascent,_)=self.gui.atlas.font.liquidbounce_target_metrics();
+                        for is_shadow in[true,false]{if is_shadow&&!shadow{continue;}let offset=if is_shadow{2.*scale}else{0.};let mut x=at[0]+origin[0]+offset;let y=at[1]+origin[1]+ascent*scale+offset;
+                            for span in &text.spans{for c in span.text.chars(){let g=self.gui.atlas.font.liquidbounce_target_glyph(c,span.style.bold==Some(true));
+                                let fill=native_color(if is_shadow{let a=(color>>24).min(150);(a<<24)}else{color});
+                                if let Some(Rect{u0,v0,u1,v1,..})=g.rect{let x0=x+g.left*scale;let x1=x+g.right*scale;let y0=y+g.top*scale;let y1=y+g.bottom*scale;batch.quad([[x0,y0],[x1,y0],[x1,y1],[x0,y1]],[[u0,v0],[u1,v0],[u1,v1],[u0,v1]],fill);}x+=g.advance*scale;
+                            }}
+                        }
+                    }
+
+                    Primitive::Text {
+                        text,
+                        origin,
+                        scale,
+                        color,
+                        shadow,
+                    } => {
+                        let first = batch.vertices.len();
+                        batch.text_styled(
+                            &self.gui.atlas,
+                            &text,
+                            origin[0],
+                            origin[1],
+                            native_color(color),
+                            shadow,
+                        );
+                        for v in &mut batch.vertices[first..] {
+                            v.pos = [
+                                at[0] + v.pos[0] * scale,
+                                at[1] + v.pos[1] * scale,
+                            ];
+                        }
+                    }
+                    Primitive::Quad { corners, uv, color } => batch.quad(
+                        corners.map(|p| [p[0] + at[0], p[1] + at[1]]),
+                        uv,
+                        native_color(color),
+                    ),
+                }
+    }
+}
diff --git a/crates/horizon-client/src/game/indicator_math.rs b/crates/horizon-client/src/game/indicator_math.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/indicator_math.rs
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// IndicatorRenderer/IndicatorGeometry/WorldToScreen, LiquidBounce ae0eb396.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Projected {
+    pub screen: Option<[f32; 2]>,
+    pub offset: Option<[f32; 2]>,
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Layout {
+    pub in_view: bool,
+    pub anchor: [f32; 2],
+    pub outward: [f32; 2],
+    pub tag: [f32; 2],
+    pub arrow_origin: [f32; 2],
+    pub angle: f32,
+    pub length: f32,
+}
+pub fn project(clip: [f32; 4], framebuffer: [f32; 2], gui_scale: f32) -> Projected {
+    let [x, y, z, w] = clip;
+    let mul = 0.5 / gui_scale;
+    let screen = (clip.iter().all(|v| v.is_finite()) && w > 0.).then(|| {
+        [
+            (x / w + 1.) * mul * framebuffer[0],
+            (-y / w + 1.) * mul * framebuffer[1],
+        ]
+    });
+    let offset = (x.is_finite() && y.is_finite() && w.is_finite() && w != 0.).then(|| {
+        let sign = if w < 0. { -1. } else { 1. };
+        [
+            x / w * sign * mul * framebuffer[0],
+            -y / w * sign * mul * framebuffer[1],
+        ]
+    });
+    let _ = z;
+    Projected { screen, offset }
+}
+pub fn border_point(x: f32, y: f32, hw: f32, hh: f32, margin: f32) -> [f32; 2] {
+    let lx = (hw - margin).max(0.);
+    let ly = (hh - margin).max(0.);
+    let scale = (if x == 0. { f32::INFINITY } else { lx / x.abs() }).min(if y == 0. {
+        f32::INFINITY
+    } else {
+        ly / y.abs()
+    });
+    if scale.is_finite() {
+        [x * scale, y * scale]
+    } else {
+        [0., 0.]
+    }
+}
+pub fn clamp_to_border(x: f32, y: f32, hw: f32, hh: f32, margin: f32) -> [f32; 2] {
+    if x.abs() <= (hw - margin).max(0.) && y.abs() <= (hh - margin).max(0.) {
+        [x, y]
+    } else {
+        border_point(x, y, hw, hh, margin)
+    }
+}
+pub fn fit_inside(min: f32, max: f32, extent: f32) -> f32 {
+    if min < 0. {
+        -min
+    } else if max > extent {
+        extent - max
+    } else {
+        0.
+    }
+}
+#[allow(clippy::too_many_arguments)]
+pub fn layout(
+    projected: Projected,
+    viewport: [f32; 2],
+    tag: [f32; 4],
+    edge_inset: f32,
+    visible: [bool; 2],
+    style_length: f32,
+    in_view_style_length: f32,
+) -> Option<Layout> {
+    let center = viewport.map(|v| v * 0.5);
+    let offset = projected
+        .screen
+        .map(|v| [v[0] - center[0], v[1] - center[1]]);
+    let in_view = offset.is_some_and(|v| v[0].abs() <= center[0] && v[1].abs() <= center[1]);
+    if !visible[usize::from(!in_view)] {
+        return None;
+    }
+    let inset = edge_inset.clamp(0., 0.9);
+    let hw = center[0] * (1. - inset);
+    let hh = center[1] * (1. - inset);
+    let normalize = |v: [f32; 2]| {
+        let length = (v[0] * v[0] + v[1] * v[1]).sqrt();
+        [v[0] / length, v[1] / length]
+    };
+    let (anchor, outward) = if let Some(offset) = offset {
+        (
+            clamp_to_border(offset[0], offset[1], hw, hh, 1.),
+            if offset[0] * offset[0] + offset[1] * offset[1] == 0. {
+                [0., 1.]
+            } else {
+                normalize(offset)
+            },
+        )
+    } else {
+        let direction = projected.offset?;
+        if direction[0] * direction[0] + direction[1] * direction[1] == 0. {
+            return None;
+        }
+        let direction = normalize(direction);
+        (
+            border_point(direction[0], direction[1], hw, hh, 1.),
+            direction,
+        )
+    };
+    let anchor = [anchor[0] + center[0], anchor[1] + center[1]];
+    let length = if in_view {
+        in_view_style_length
+    } else {
+        style_length
+    };
+    let [xmin, ymin, xmax, ymax] = tag;
+    let side_x = if outward[0] > 0.1 {
+        -xmax
+    } else if outward[0] < -0.1 {
+        -xmin
+    } else {
+        0.
+    };
+    let side_y = if outward[1] > 0.1 {
+        -ymax
+    } else if outward[1] < -0.1 {
+        -ymin
+    } else {
+        0.
+    };
+    let base = [
+        anchor[0] - outward[0] * (length + 2.) + side_x,
+        anchor[1] - outward[1] * (length + 2.) + side_y,
+    ];
+    Some(Layout {
+        in_view,
+        anchor,
+        outward,
+        tag: [
+            base[0] + fit_inside(base[0] + xmin, base[0] + xmax, viewport[0]),
+            base[1] + fit_inside(base[1] + ymin, base[1] + ymax, viewport[1]),
+        ],
+        arrow_origin: [
+            anchor[0] - outward[0] * length,
+            anchor[1] - outward[1] * length,
+        ],
+        angle: (-outward[0]).atan2(outward[1]),
+        length,
+    })
+}
+pub fn transform(origin: [f32; 2], angle: f32, p: [f32; 2]) -> [f32; 2] {
+    let (s, c) = (f64::from(angle).sin() as f32, f64::from(angle).cos() as f32);
+    [
+        origin[0] + c * p[0] - s * p[1],
+        origin[1] + s * p[0] + c * p[1],
+    ]
+}
+pub fn arrow_quad(origin: [f32; 2], angle: f32, width: f32, height: f32) -> [[f32; 2]; 4] {
+    [
+        [-width * 0.5, 0.],
+        [width * 0.5, 0.],
+        [width * 0.5, height],
+        [-width * 0.5, height],
+    ]
+    .map(|p| transform(origin, angle, p))
+}
diff --git a/crates/horizon-client/src/game/tnt_timer.rs b/crates/horizon-client/src/game/tnt_timer.rs
