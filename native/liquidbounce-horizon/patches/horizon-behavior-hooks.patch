+}
+fn direction(info: Trajectory, target: V, source: V, t: f64) -> V {
+    let r = info.drag;
+    let power = r.powf(t);
+    let d = target.sub(source);
+    let den = info.velocity * (power - 1.);
+    V(
+        d.0 * (r - 1.) / den,
+        d.1 * (r - 1.) / den
+            + info.gravity * (power - r * t + t - 1.) / (info.velocity * (r - 1.) * (power - 1.)),
+        d.2 * (r - 1.) / den,
+    )
+}
+fn minimum(mut a: f64, mut b: f64, mut f: impl FnMut(f64) -> f64) -> (f64, f64) {
+    while b - a > 1e-4 {
+        let m = a + (b - a) * 0.5;
+        let m = if m.is_infinite() {
+            a * 0.5 + b * 0.5
+        } else {
+            m
+        };
+        if m == a || m == b {
+            break;
+        }
+        if f(a + (m - a) * 0.5) < f(m + (b - m) * 0.5) {
+            b = m;
+        } else {
+            a = m;
+        }
+    }
+    let t = a + (b - a) * 0.5;
+    (t, f(t))
+}
+// JOML defaults to cosFromSin and ordinary, nested f32 products (useMathFma=false).
+fn sin_cos(angle: f32) -> (f32, f32) {
+    let sin = f64::from(angle).sin() as f32;
+    let mut cos = f64::from(1.0f32 - sin * sin).sqrt() as f32;
+    let shifted = angle + 1.5707964f32;
+    let mut wrapped = shifted - (shifted / 6.2831855f32) as i32 as f32 * 6.2831855f32;
+    if wrapped < 0. {
+        wrapped += 6.2831855f32;
+    }
+    if wrapped >= 3.1415927f32 {
+        cos = -cos;
+    }
+    (sin, cos)
+}
+fn matrix_y(angle: f32) -> [f32; 9] {
+    let (s, c) = sin_cos(angle);
+    [c, 0., -s, 0., 1., 0., s, 0., c]
+}
+fn matrix_z(angle: f32) -> [f32; 9] {
+    let (s, c) = sin_cos(angle);
+    [c, s, 0., -s, c, 0., 0., 0., 1.]
+}
+fn matrix_mul(a: [f32; 9], b: [f32; 9]) -> [f32; 9] {
+    std::array::from_fn(|i| {
+        let (column, row) = (i / 3, i % 3);
+        a[row] * b[column * 3] + (a[3 + row] * b[column * 3 + 1] + a[6 + row] * b[column * 3 + 2])
+    })
+}
+fn rotate(v: V, yaw: f32, pitch: f32, back: bool) -> V {
+    let m = if back {
+        matrix_mul(matrix_z(-pitch), matrix_y(yaw))
+    } else {
+        matrix_mul(matrix_y(-yaw), matrix_z(pitch))
+    };
+    let x = v.0 as f32;
+    let y = v.1 as f32;
+    let z = v.2 as f32;
+    let (x, y, z) = (
+        m[0] * x + (m[3] * y + m[6] * z),
+        m[1] * x + (m[4] * y + m[7] * z),
+        m[2] * x + (m[5] * y + m[8] * z),
+    );
+    V(f64::from(x), f64::from(y), f64::from(z))
+}
+pub fn projected_points(eye: V, b: B) -> Vec<V> { projected_points_limit(eye,b,128) }
+pub fn projected_points_limit(eye: V, b: B, maximum: i32) -> Vec<V> {
+    if b.contains(eye) {
+        return vec![];
+    }
+    let line = b.center().sub(eye);
+    let vertices = b.vertices();
+    let mut origin = eye;
+    let mut best = f64::INFINITY;
+    for p in vertices {
+        let near = eye.fma(p.sub(eye).dot(line) / line.len2(), line);
+        let dist = near.sub(eye).len2();
+        if dist < best {
+            best = dist;
+            origin = near;
+        }
+    }
+    origin = origin.lerp(eye, 0.1);
+    let len = line.len2();
+    let normal = if (len - 1.).abs() < 1e-4 {
+        line
+    } else {
+        line.normalize()
+    };
+    let yaw = normal.2.atan2(normal.0) as f32;
+    let pitch = normal
+        .1
+        .atan2((normal.0 * normal.0 + normal.2 * normal.2).sqrt()) as f32;
+    let mut lo_y = 0f32;
+    let mut hi_y = 0f32;
+    let mut lo_z = 0f32;
+    let mut hi_z = 0f32;
+    for p in vertices {
+        let d = p.sub(eye);
+        let e = d.dot(normal);
+        if e.abs() < 1e-5 {
+            continue;
+        }
+        let phi = (origin.dot(normal) - eye.dot(normal)) / e;
+        let projected = eye.fma(phi, d).sub(origin);
+        let v = rotate(projected, yaw, pitch, true);
+        lo_y = lo_y.min(v.1 as f32);
+        hi_y = hi_y.max(v.1 as f32);
+        lo_z = lo_z.min(v.2 as f32);
+        hi_z = hi_z.max(v.2 as f32);
+    }
+    // Vector3f.add(Vec3) also rounds the frame origin to float before the add.
+    let base = rotate(V(0., f64::from(lo_y), f64::from(lo_z)), yaw, pitch, false);
+    let base = V(
+        f64::from(base.0 as f32 + origin.0 as f32),
+        f64::from(base.1 as f32 + origin.1 as f32),
+        f64::from(base.2 as f32 + origin.2 as f32),
+    );
+    let dy = rotate(V(0., f64::from(hi_y - lo_y), 0.), yaw, pitch, false);
+    let dz = rotate(V(0., 0., f64::from(hi_z - lo_z)), yaw, pitch, false);
+    let zero_y = dy.len2().abs() < 1e-5;
+    let zero_z = dz.len2().abs() < 1e-5;
+    let (ny, nz) = match (zero_y, zero_z) {
+        (true, true) => (1, 1),
+        (true, false) => (1, maximum),
+        (false, true) => (maximum, 1),
+        (false, false) => {
+            let n = ((f64::from(maximum) / (dz.len() / dy.len())).sqrt().floor() as i32).clamp(1, maximum);
+            (n, (maximum / n).max(1))
+        }
+    };
+    let mut points = vec![];
+    for y in 0..ny {
+        for z in 0..nz {
+            let p = base
+                .fma((f64::from(y) + 0.5) / f64::from(ny), dy)
+                .fma((f64::from(z) + 0.5) / f64::from(nz), dz);
+            if let Some(hit) = b.clip(eye, p.lerp(eye, -100.)) {
+                points.push(hit);
+            }
+        }
+    }
+    points
+}
+pub fn visible_point(eye: V, b: B, mut visible: impl FnMut(V, V) -> bool) -> Option<V> {
+    let mut points = projected_points(eye, b);
+    let center = b.center();
+    points.sort_by(|a, b| a.sub(center).len2().total_cmp(&b.sub(center).len2()));
+    for spot in points {
+        let vec = spot.sub(eye);
+        let target = eye.fma(2., vec);
+        let hit = if b.contains(eye) {
+            b.clip(target, eye)
+        } else {
+            b.clip(eye, target)
+        };
+        let Some(hit) = hit else {
+            continue;
+        };
+        let length = vec.len2();
+        let offset = if length.abs() < 1e-5 {
+            V::default()
+        } else {
+            vec.scale(5. / length.sqrt())
+        };
+        if visible(hit.sub(offset), hit) {
+            return Some(hit);
+        }
+    }
+    None
+}
+pub fn calculate(
+    info: Trajectory,
+    source: V,
+    dimensions: [f32; 2],
+    mut position: impl FnMut(f64) -> V,
+    visible: impl FnMut(V, V) -> bool,
+) -> Option<[f32; 2]> {
+    let base = position(0.);
+    let distance = base.sub(source).len();
+    if distance < 5. {
+        let target = position(distance / info.velocity).sub(source);
+        let h = (target.0 * target.0 + target.2 * target.2).sqrt();
+        let v = 1.5f64;
+        let g = 0.03;
+        let d = v.powi(4) - g * (g * h * h + 2. * target.1 * v * v);
+        if d < 0. {
+            return None;
+        }
+        return Some([
+            (-target.0).atan2(target.2) as f32 * (180. / std::f32::consts::PI),
+            wrap(
+                (-((v * v - d.sqrt()) / (g * h)).atan() * f64::from(180. / std::f32::consts::PI))
+                    as f32,
+            ),
+        ]);
+    }
+    let offset = V(
+        f64::from(dimensions[0]) * 0.5,
+        f64::from(dimensions[1]) * 0.5,
+        f64::from(dimensions[0]) * 0.5,
+    );
+    let (t, delta) = minimum(0., distance / info.velocity * 1.75, |t| {
+        (direction(info, position(t).add(offset), source, t).len() - 1.).abs()
+    });
+    if delta > 0.1 {
+        return None;
+    }
+    let at = position(t);
+    let initial = direction(info, at.add(offset), source, t);
+    let r = info.drag;
+    let power = r.powf(t);
+    let log = r.ln();
+    let f = r - 1.;
+    let impact = V(
+        initial.0 * power * log * info.velocity / f,
+        (initial.1 * f * power * log * info.velocity - info.gravity * (power * log - r + 1.))
+            / f.powi(2),
+        initial.2 * power * log * info.velocity / f,
+    )
+    .normalize();
+    let virtual_eye = source.add(V(0., impact.1 * -at.sub(source).len(), 0.));
+    let half = f64::from(dimensions[0]) * 0.5;
+    let b = B {
+        lo: at.add(V(-half, 0., -half)),
+        hi: at.add(V(half, f64::from(dimensions[1]), half)),
+    }
+    .inflate(info.radius);
+    let target = visible_point(virtual_eye, b, visible)?;
+    Some(rotation(direction(
+        info,
+        target,
+        source,
+        t.round_ties_even(),
+    )))
+}
diff --git a/crates/horizon-client/src/game/elytra_target.rs b/crates/horizon-client/src/game/elytra_target.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/elytra_target.rs
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_core::geometry::Vec3;
+use horizon_protocol::packets::play::{self,Serverbound as S};
+use serde_json::{Value,json};
+impl Game<'_>{
+ pub(super) fn elytra_target_query(&mut self,text:&str)->String{
+  let Ok(q)=serde_json::from_str::<Value>(text)else{return "null".into();};
+  if q["op"]=="safe"{
+   let Some(player)=self.player.as_ref()else{return "false".into();};
+   let bounds=player.bounds().move_by(player.velocity);let entities=self.player_entity_collisions();
+   let mut motion=horizon_client::motion::MotionWorld{step_sender:None,entities:&entities,player:self.player.as_mut().unwrap(),scene:&mut self.world,assets:&self.pack.assets,collision_binding:self.collision,resources:self.motion,health:&self.health_resources};
+   let blocked=motion.no_player_collision(bounds).is_ok_and(|v|!v);
+   if blocked{motion.player.velocity.y+=0.1;}
+   return json!(blocked).to_string();
+  }
+  if q["op"]=="restartGlide"{
+   if let Some(p)=self.player.as_mut(){if p.flying{return "false".into();}p.fall_flying=true;}
+   if let Some(r)=self.remote.as_ref(){r.session.send(S::PlayerCommand(play::PlayerCommand{id:r.entity_id,action:6,data:0}));}
+   return "true".into();
+  }
+  if q["op"]=="packetUse"{
+   let slot=q["slot"].as_u64().unwrap_or(255)as usize;
+   if !(slot<9||slot==40)||self.stack_in(slot).is_none_or(|s|s.count==0||s.item.as_ref()!="minecraft:firework_rocket"){return "false".into();}
+   let previous=self.selected;let change=slot<9&&slot!=previous;
+   if change{self.selected=slot;self.send(S::SetCarriedItem(play::SetCarriedItem{slot:slot as i16}));}
+   if self.remote.is_some(){let sequence=self.next_sequence();self.send(S::UseItem(play::UseItem{hand:if slot==40{1}else{0},sequence,yaw:self.yaw,pitch:self.pitch}));}
+   else{let _=self.native_client_use_item(if slot==40{1}else{0},self.yaw,self.pitch);}
+   if change{self.selected=previous;self.send(S::SetCarriedItem(play::SetCarriedItem{slot:previous as i16}));}
+   return "true".into();
+  }
+  if q["op"]!="facts"{return "null".into();}
+  let Ok(mut facts)=serde_json::from_str::<Value>(&self.auto_rod_query("{\"op\":\"facts\"}"))else{return "null".into();};
+  let Some(player)=self.player.as_ref()else{return "null".into();};
+  let position=player.position;
+  facts["position"]=json!([position.x,position.y,position.z]);facts["gliding"]=json!(player.fall_flying);facts["flying"]=json!(player.flying);
+  facts["rockets"]=json!((0..9).chain(std::iter::once(40)).filter(|&slot|self.stack_in(slot).is_some_and(|s|s.count>0&&s.item.as_ref()=="minecraft:firework_rocket")).collect::<Vec<_>>());
+  let entities=super::auto_bow::entities(self);
+  if let Some(rows)=facts["candidates"].as_array_mut(){for row in rows{
+   let Some(id)=row["id"].as_i64().map(|v|v as i32)else{continue;};let Some(e)=entities.iter().find(|e|e.id==id)else{continue;};
+   let (eye,gliding)=if let Some(m)=self.mobs.iter().find(|m|m.id as i32==id){(Vec3::new(m.position.x,m.position.y+m.eye_height(),m.position.z),m.extra.fall_flying)}
+    else if let Some(a)=self.armor_stands.iter().find(|a|a.id as i32==id){(Vec3::new(a.position.x,a.position.y+if a.marker{0.}else{a.probe_dimensions().2},a.position.z),false)}
+    else if self.dragon.as_ref().is_some_and(|d|d.id as i32==id){(Vec3::new(e.position.x,e.position.y+6.8,e.position.z),false)}
+    else if let Some(g)=self.lan.iter().flat_map(|l|l.hub.guests.iter()).find(|g|g.entity_id==id){(Vec3::new(e.position.x,e.position.y+g.motion.as_ref().map_or(1.62,|p|f64::from(p.dimensions.eye_height)),e.position.z),g.fall_flying)}
+    else{continue;};
+   row["position"]=json!([e.position.x,e.position.y,e.position.z]);row["velocity"]=json!([e.velocity.x,e.velocity.y,e.velocity.z]);row["eyes"]=json!([eye.x,eye.y,eye.z]);row["height"]=json!(e.bounds.max_position().y-e.bounds.min_position().y);row["gliding"]=json!(gliding);
+  }}
+  facts.to_string()
+ }
+}
diff --git a/crates/horizon-client/src/game/auto_pearl.rs b/crates/horizon-client/src/game/auto_pearl.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/auto_pearl.rs
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Raw pearl spawn facts and real collision-backed trajectory continuations.
+use super::{
+    Game,
+    auto_bow_math::{self as math, B, Trajectory, V},
+};
+use horizon_core::geometry::{Aabb, Vec3};
+use serde_json::{Value, json};
+thread_local! {static SPAWNS:std::cell::RefCell<Vec<Value>>=const{std::cell::RefCell::new(Vec::new())};}
+fn v(p: Vec3) -> V {
+    V(p.x, p.y, p.z)
+}
+fn p(v: V) -> Vec3 {
+    Vec3::new(v.0, v.1, v.2)
+}
+fn b(a: Aabb) -> B {
+    B {
+        lo: v(a.min_position()),
+        hi: v(a.max_position()),
+    }
+}
+fn vector(q: &Value) -> Option<V> {
+    let q = q.as_array()?;
+    Some(V(
+        q.first()?.as_f64()?,
+        q.get(1)?.as_f64()?,
+        q.get(2)?.as_f64()?,
+    ))
+}
+const GENERIC: Trajectory = Trajectory {
+    velocity: 1.5,
+    gravity: 0.03,
+    drag: 0.99,
+    water_drag: 0.8,
+    radius: 0.25,
+    copies_velocity: true,
+};
+impl Game<'_> {
+    pub(super) fn auto_pearl_spawn(&self, owner: Option<i32>, position: Vec3, velocity: Vec3) {
+        if !self.native_window() {
+            return;
+        }
+        let Some(player) = self.player.as_ref() else {
+            return;
+        };
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+        // Resolve once at receipt, as ThrowableProjectile.recreateFromPacket does.
+        let owner = owner.filter(|id| *id == local || self.native_entity(*id as u32).is_some());
+        let eye = V(
+            player.position.x,
+            player.position.y + f64::from(player.dimensions.eye_height),
+            player.position.z,
+        );
+        let view = v(Vec3::direction_from_rotation(player.pitch, player.yaw));
+        let bounds = B {
+            lo: V(position.x - 0.125, position.y, position.z - 0.125),
+            hi: V(position.x + 0.125, position.y + 0.25, position.z + 0.125),
+        };
+        let canonical = self.native_client_slot_owner();
+        let target = owner.filter(|_| canonical).map(|id| {
+            serde_json::from_str::<Value>(&self.native_client_targeting_entity(id))
+                .unwrap_or(Value::Null)
+        });
+        let epoch = self
+            .remote
+            .as_ref()
+            .and_then(|r| r.native_epoch())
+            .or_else(|| self.native_lifecycle.epoch())
+            .map(|epoch| epoch.get());
+        let spawn = json!({"epoch":epoch,"owner":owner,"self":owner==Some(local),"target":target,"deferred":!canonical,"cosine":canonical.then(||math::max_cos(eye,view,bounds)),"position":v(position).array(),"velocity":v(velocity).array()});
+        SPAWNS.with_borrow_mut(|q| q.push(spawn));
+    }
+    fn auto_pearl_simulate(&self, position: V, velocity: V, owner: i32) -> Option<V> {
+        let boxes = self
+            .auto_pearl_collision_boxes(owner)
+            .into_iter()
+            .map(b)
+            .collect::<Vec<_>>();
+        super::auto_pearl_model::simulate(
+            position,
+            velocity,
+            f64::from(self.world.shape.min_y),
+            &boxes,
+            |a, z| {
+                super::auto_pearl_ray::clip(self, p(a), p(z), owner, false)
+                    .map(|(miss, hit)| (miss, v(hit)))
+            },
+            |at| {
+                let state = self.world.block(
+                    at.0.floor() as i32,
+                    at.1.floor() as i32,
+                    at.2.floor() as i32,
+                );
+                self.res.facts().get(state).fluid != horizon_client::blocks::Fluid::None
+            },
+        )
+    }
+    pub(super) fn auto_pearl_rotation(&self, destination: V, feet: bool) -> Option<[f32; 2]> {
+        let player = self.player.as_ref()?;
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id);
+        math::calculate(
+            GENERIC,
+            if feet {
+                v(player.position)
+            } else {
+                V(
+                    player.position.x,
+                    player.position.y + f64::from(player.dimensions.eye_height),
+                    player.position.z,
+                )
+            },
+            [1., 0.],
+            |_| destination,
+            |a, z| super::auto_pearl_ray::clip(self, p(a), p(z), local, false).is_some_and(|h| h.0),
+        )
+    }
+    fn auto_pearl_local_hit(&self, rotation: [f32; 2], freeze: bool) -> Option<V> {
+        let player = self.player.as_ref()?;
+        // Projectile.setVelocity uses Kotlin Float radians followed by Math.sin/cos.
+        let yaw = rotation[0] * std::f32::consts::PI / 180.;
+        let pitch = rotation[1] * std::f32::consts::PI / 180.;
+        let (sy, cy) = ((f64::from(yaw).sin() as f32), (f64::from(yaw).cos() as f32));
+        let (sp, cp) = (
+            (f64::from(pitch).sin() as f32),
+            (f64::from(pitch).cos() as f32),
+        );
+        let mut velocity = V(
+            -f64::from(sy) * f64::from(cp),
+            -f64::from(sp),
+            f64::from(cy) * f64::from(cp),
+        )
+        .normalize()
+        .scale(1.5);
+        if !freeze {
+            velocity = velocity.add(V(
+                player.velocity.x,
+                if player.ground.on_ground {
+                    0.
+                } else {
+                    player.velocity.y
+                },
+                player.velocity.z,
+            ));
+        }
+        let pos = V(
+            player.position.x,
+            player.position.y + f64::from(player.dimensions.eye_height) - 0.10000000149011612,
+            player.position.z,
+        );
+        self.auto_pearl_simulate(
+            pos,
+            velocity,
+            self.remote.as_ref().map_or(0, |r| r.entity_id),
+        )
+    }
+    pub(super) fn auto_pearl_query(&self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        if q["op"] == "clear" {
+            SPAWNS.with_borrow_mut(Vec::clear);
+            return "null".into();
+        }
+        let Some(player) = self.player.as_ref() else {
+            SPAWNS.with_borrow_mut(Vec::clear);
+            return "null".into();
+        };
+        if q["op"] == "spawns" {
+            return json!({"slot":self.native_client_middle_click_pearl_slot(),"player":v(player.position).array(),"spawns":SPAWNS.with_borrow_mut(|spawns|{let epoch=serde_json::to_value(self.remote.as_ref().and_then(|r|r.native_epoch()).or_else(||self.native_lifecycle.epoch()).map(|epoch|epoch.get())).unwrap_or(Value::Null);std::mem::take(spawns).into_iter().filter(|s|s["epoch"]==epoch).map(|mut s|{if s["deferred"]==true{if let Some(at)=vector(&s["position"]){let bounds=B{lo:V(at.0-0.125,at.1,at.2-0.125),hi:V(at.0+0.125,at.1+0.25,at.2+0.125)};let eye=V(player.position.x,player.position.y+f64::from(player.dimensions.eye_height),player.position.z);s["cosine"]=json!(math::max_cos(eye,v(Vec3::direction_from_rotation(player.pitch,player.yaw)),bounds));}s["target"]=s["owner"].as_i64().map(|id|serde_json::from_str::<Value>(&self.native_client_targeting_entity(id as i32)).unwrap_or(Value::Null)).unwrap_or(Value::Null);}s}).collect::<Vec<_>>()})}).to_string();
+        }
+        if q["op"] == "slot" {
+            return json!(self.native_client_middle_click_pearl_slot()).to_string();
+        }
+        if q["op"] == "angle" {
+            let read = |s: &str| {
+                q[s].as_array()
+                    .filter(|a| a.len() == 2)
+                    .map(|a| {
+                        [
+                            a[0].as_f64().unwrap_or(0.) as f32,
+                            a[1].as_f64().unwrap_or(0.) as f32,
+                        ]
+                    })
+                    .unwrap_or([0.; 2])
+            };
+            let a = read("rotation");
+            let z = read("target");
+            let a = Vec3::direction_from_rotation(a[1], a[0]);
+            let z = Vec3::direction_from_rotation(z[1], z[0]);
+            return json!(
+                (a.cross(z).length().atan2(a.dot(z))
+                    * f64::from(horizon_core::geometry::trig::RAD_TO_DEG)) as f32
+            )
+            .to_string();
+        }
+        if q["op"] == "solve" {
+            let (Some(position), Some(velocity)) = (vector(&q["position"]), vector(&q["velocity"]))
+            else {
+                return "null".into();
+            };
+            let owner = q["owner"].as_i64().map_or_else(
+                || self.remote.as_ref().map_or(0, |r| r.entity_id),
+                |id| id as i32,
+            );
+            let Some(destination) = self.auto_pearl_simulate(position, velocity, owner) else {
+                return "null".into();
+            };
+            let Some(rotation) = self.auto_pearl_rotation(destination, false) else {
+                return "null".into();
+            };
+            let hit = self.auto_pearl_local_hit(rotation, q["freeze"] == true);
+            return json!({"destination":destination.array(),"rotation":rotation,"hit":hit.map(V::array)}).to_string();
+        }
+        "null".into()
+    }
+       fn auto_pearl_collision_boxes(&self, owner:i32) -> Vec<Aabb> {
+        let mut candidates = vec![];
+        let root = self.client_reach_root_vehicle(owner as u32);
+        let local = self.remote.as_ref().map_or(0, |r| r.entity_id) as u32;
+        let mut offer = |_kind: u8,
+                         _index: usize,
+                         id: u32,
+                         _local_id: u32,
+                         _position: [f64; 3],
+                         bounds: Aabb,
+                         _pick_radius: f64| {
+            if id != owner as u32 && root != self.client_reach_root_vehicle(id) {
+                candidates.push(bounds);
+            }
+        };
+        for (i, m) in self
+            .mobs
+            .iter()
+            .enumerate()
+            .filter(|(_, m)| !m.removed && !m.extra.spectator && m.alive())
+        {
+            offer(
+                0,
+                i,
+                m.id,
+                m.id,
+                [m.position.x, m.position.y, m.position.z],
+                m.bounds(),
+                0.0,
+            );
+        }
+        let box_of = |(lo, hi): ([f64; 3], [f64; 3])| {
+            Aabb::new(
+                Vec3::new(lo[0], lo[1], lo[2]),
+                Vec3::new(hi[0], hi[1], hi[2]),
+            )
+        };
+        for (i, p) in self.paintings.iter().enumerate() {
+            let (lo, hi) = p.bounds();
+            offer(
+                1,
+                i,
+                p.id,
+                p.id,
+                std::array::from_fn(|a| (lo[a] + hi[a]) * 0.5),
+                box_of((lo, hi)),
+                0.0,
+            );
+        }
+        for (i, p) in self.item_frames.iter().enumerate() {
+            let (lo, hi) = p.bounds();
+            offer(
+                2,
+                i,
+                p.id,
+                p.id,
+                std::array::from_fn(|a| (lo[a] + hi[a]) * 0.5),
+                box_of((lo, hi)),
+                0.0,
+            );
+        }
+        for (i, p) in self
+            .armor_stands
+            .iter()
+            .enumerate()
+            .filter(|(_, p)| !p.marker)
+        {
+            offer(
+                3,
+                i,
+                p.id,
+                p.id,
+                [p.position.x, p.position.y, p.position.z],
+                p.bounds(),
+                0.0,
+            );
+        }
+        for (i, p) in self.cushions.iter().enumerate() {
+            offer(
+                4,
+                i,
+                p.id,
+                p.id,
+                [p.position.x, p.position.y, p.position.z],
+                box_of(p.bounds()),
+                0.0,
+            );
+        }
+        for (i, p) in self.boats.iter().enumerate() {
+            offer(
+                5,
+                i,
+                p.id,
+                p.id,
+                [p.position.x, p.position.y, p.position.z],
+                p.bounds(),
+                0.0,
+            );
+        }
+        for (i, p) in self.carts.iter().enumerate() {
+            offer(
+                6,
+                i,
+                p.id,
+                p.id,
+                [p.position.x, p.position.y, p.position.z],
+                p.bounds(),
+                0.0,
+            );
+        }
+        for (i, (&id, p)) in self.interactions.iter().enumerate() {
+            offer(
+                7,
+                i,
+                id as u32,
+                id as u32,
+                [p.position.x, p.position.y, p.position.z],
+                p.bounds(),
+                0.0,
+            );
+        }
+        for (i, p) in self
+            .creatures
+            .projectiles
+            .iter()
+            .enumerate()
+            .filter(|(_, p)| super::deflect::attackable(p))
+        {
+            let radius = if matches!(
+                p.kind,
+                horizon_client::projectiles::ProjectileKind::ShulkerBullet { .. }
+            ) {
+                0.0
+            } else {
+                1.0
+            };
+            offer(
+                8,
+                i,
+                p.id,
+                p.id,
+                [p.position.x, p.position.y, p.position.z],
+                p.bounds(),
+                radius,
+            );
+        }
+        for (i, (&id, &block)) in self.remote_knots.iter().enumerate() {
+            let knot = horizon_client::mobs::leash::knot_state(block);
+            let p = knot.position;
+            let half = knot.width * 0.5;
+            offer(
+                9,
+                i,
+                id,
+                id,
+                [p.x, p.y, p.z],
+                Aabb::new(
+                    Vec3::new(p.x - half, p.y, p.z - half),
+                    Vec3::new(p.x + half, p.y + knot.height, p.z + half),
+                ),
+                0.0,
+            );
+        }
+        for (i, p) in self.crystals.iter().enumerate() {
+            let pos = p.position;
+            offer(
+                10,
+                i,
+                p.id,
+                super::dragon::CRYSTAL_IDS + i as u32,
+                [pos.x, pos.y, pos.z],
+                Aabb::new(
+                    Vec3::new(pos.x - 1.0, pos.y, pos.z - 1.0),
+                    Vec3::new(pos.x + 1.0, pos.y + 2.0, pos.z + 1.0),
+                ),
+                0.0,
+            );
+        }
+        if let Some(d) = self.dragon.as_ref().filter(|d| d.alive()) {
+            for i in 0..8 {
+                let p = d.parts[i].0;
+                offer(
+                    11,
+                    i,
+                    d.id + 1 + i as u32,
+                    super::dragon::SPECIAL + i as u32,
+                    [p.x, p.y, p.z],
+                    d.part_box(i),
+                    0.0,
+                );
+            }
+        }
+
+        for guest in self
+            .lan
+            .iter()
+            .flat_map(|l| l.hub.guests.iter())
+            .filter(|g| g.placed && g.dimension == self.dim.id() && g.entity_id as u32 != local)
+        {
+            if let Some(p) = guest.motion.as_ref().filter(|p| !p.health.dead_or_dying()) {
+                let at = Vec3::new(guest.position[0], guest.position[1], guest.position[2]);
+                offer(
+                    0,
+                    0,
+                    guest.entity_id as u32,
+                    guest.entity_id as u32,
+                    guest.position,
+                    p.dimensions.bounds(at),
+                    0.,
+                );
+            }
+        }
+        drop(offer);
+        if owner as u32!=local && root!=self.client_reach_root_vehicle(local) {
+            if let Some(p)=self.player.as_ref().filter(|p|!p.spectator&&!p.health.dead_or_dying()){
+                candidates.push(p.dimensions.bounds(p.position));
+            }
+        }
+        candidates
+    }
+}
diff --git a/crates/horizon-client/src/game/auto_pearl_ray.rs b/crates/horizon-client/src/game/auto_pearl_ray.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/auto_pearl_ray.rs
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Pearl owner COLLIDER/OUTLINE rays with real equipment and powder-snow context.
+use super::Game;
+use horizon_client::collisions::SceneCollisions;
+use horizon_core::{
+    geometry::{Aabb, ShapeOp, Vec3, VoxelShape},
+    position::BlockPos,
+};
+use horizon_world::{
+    collision_context::{CollisionContext, CollisionEntity, CollisionItem, EntityContextKind},
+    entity_obstruction::EntityIdentity,
+    registry::BlockStateId,
+    world_ray::{RayBlockMode, RayFluidMode, RayWorld},
+};
+struct Ray<'a, 'r, 'c> {
+    game: &'a Game<'r>,
+    scene: SceneCollisions<'a, 'r>,
+    context: CollisionContext<'c>,
+}
+impl RayWorld for Ray<'_, '_, '_> {
+    type Error = std::io::Error;
+    type Block = BlockStateId;
+    type Fluid = ();
+    fn block_state(&mut self, p: BlockPos) -> Result<BlockStateId, Self::Error> {
+        Ok(self.scene.world.block(p.x, p.y, p.z))
+    }
+    fn fluid_state(&mut self, _: BlockPos) -> Result<(), Self::Error> {
+        Ok(())
+    }
+    fn block_shape(
+        &mut self,
+        state: BlockStateId,
+        p: BlockPos,
+        mode: RayBlockMode,
+    ) -> Result<VoxelShape, Self::Error> {
+        if mode == RayBlockMode::Outline {
+            if matches!(
+                self.game.res.facts().get(state).name.as_ref(),
+                "minecraft:water" | "minecraft:lava" | "minecraft:bubble_column"
+            ) {
+                return Ok(VoxelShape::empty());
+            }
+            let mut shape = VoxelShape::empty();
+            for bounds in self.game.outline_boxes([p.x, p.y, p.z]) {
+                let bounds: [f64; 6] =
+                    std::array::from_fn(|i| bounds[i] - f64::from([p.x, p.y, p.z][i % 3]));
+                let part = VoxelShape::from_box(Aabb::new(
+                    Vec3::new(bounds[0], bounds[1], bounds[2]),
+                    Vec3::new(bounds[3], bounds[4], bounds[5]),
+                ))
+                .map_err(|e| std::io::Error::other(format!("{e:?}")))?;
+                shape = shape
+                    .join(&part, ShapeOp::OR)
+                    .map_err(|e| std::io::Error::other(format!("{e:?}")))?;
+            }
+            return Ok(shape);
+        }
+        let binding = self.scene.binding;
+        binding
+            .collision_shape_with_context(&mut self.scene, state, p, &self.context)
+            .map_err(|e| std::io::Error::other(format!("{e:?}")))
+    }
+    fn interaction_shape(
+        &mut self,
+        _: BlockStateId,
+        _: BlockPos,
+    ) -> Result<VoxelShape, Self::Error> {
+        Ok(VoxelShape::empty())
+    }
+    fn fluid_is_source(&mut self, _: ()) -> Result<bool, Self::Error> {
+        Ok(false)
+    }
+    fn fluid_is_empty(&mut self, _: ()) -> Result<bool, Self::Error> {
+        Ok(true)
+    }
+    fn fluid_is_water(&mut self, _: ()) -> Result<bool, Self::Error> {
+        Ok(false)
+    }
+    fn fluid_shape(&mut self, _: (), _: BlockPos) -> Result<VoxelShape, Self::Error> {
+        Ok(VoxelShape::empty())
+    }
+}
+pub(super) fn clip(
+    game: &Game<'_>,
+    start: Vec3,
+    end: Vec3,
+    owner: i32,
+    outline: bool,
+) -> Option<(bool, Vec3)> {
+    let p = game.player.as_ref()?;
+    let local = game.remote.as_ref().map_or(0, |r| r.entity_id);
+    let entity = game.native_entity(owner as u32);
+    let living = entity.and_then(|e| game.native_living(e));
+    let held = living
+        .and_then(|e| game.native_living_hand_item(e, horizon_client::first_person::Hand::Main));
+    let boots = living.and_then(|e| {
+        game.native_living_equipment(e, horizon_client::mod_api::EquipmentSlot::Feet)
+    });
+    let mut y = entity
+        .and_then(|e| game.native_entity_position(e))
+        .map_or(p.position.y, |a| a[1]);
+    let mut descending = false;
+    let mut subject = None;
+    let kind = if owner == local {
+        y = p.position.y;
+        descending = p.shift_key_down;
+        subject = Some(p.powder_snow_subject());
+        EntityContextKind::Player
+    } else if let Some(g) = game
+        .lan
+        .iter()
+        .flat_map(|l| l.hub.guests.iter())
+        .find(|g| g.placed && g.entity_id == owner)
+    {
+        descending = g.sneaking;
+        if let Some(body) = g.motion.as_ref() {
+            subject = Some(body.powder_snow_subject());
+        }
+        EntityContextKind::Player
+    } else if let Some(m) = game
+        .mobs
+        .iter()
+        .find(|m| m.id as i32 == owner && !m.removed)
+    {
+        y = m.position.y;
+        descending = m.extra.crouching;
+        subject = Some(horizon_client::collisions::PowderSnowSubject {
+            fall_distance: m.fall_distance,
+            leather_boots: boots
+                .as_ref()
+                .is_some_and(|s| s.count > 0 && s.item.as_ref() == "minecraft:leather_boots"),
+            walkable_type: game
+                .res
+                .mob_data()
+                .entity_has("minecraft:powder_snow_walkable_mobs", &m.kind.id),
+            lava_walker: m.kind.id.as_str() == "minecraft:strider",
+            falling_block: false,
+        });
+        if horizon_client::command::args::normalize(&m.kind.id) == "minecraft:player" {
+            EntityContextKind::Player
+        } else {
+            EntityContextKind::Living
+        }
+    } else if living.is_some() {
+        EntityContextKind::Living
+    } else {
+        EntityContextKind::Other
+    };
+    let mut ray = Ray {
+        game,
+        scene: SceneCollisions {
+            world: &game.world,
+            binding: game.collision,
+            subject,
+        },
+        context: CollisionContext::for_entity(
+            CollisionEntity {
+                identity: EntityIdentity(u64::from(owner as u32)),
+                kind,
+                y,
+                descending,
+                main_hand: living.map(|_| {
+                    held.as_ref()
+                        .map_or(CollisionItem::EMPTY, |s| CollisionItem {
+                            item: &s.item,
+                            count: s.count as i32,
+                        })
+                }),
+            },
+            false,
+        ),
+    };
+    super::client_ghost_hand::clip(
+        game,
+        &mut ray,
+        start,
+        end,
+        if outline {
+            RayBlockMode::Outline
+        } else {
+            RayBlockMode::Collider
+        },
+        RayFluidMode::None,
+        4096,
+    )
+    .ok()
+    .map(|h| (h.miss, h.hit.location))
+}
diff --git a/crates/horizon-client/src/game/auto_pearl_model.rs b/crates/horizon-client/src/game/auto_pearl_model.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/auto_pearl_model.rs
@@ -0,0 +1,68 @@
+use super::auto_bow_math::{B,V};
+pub fn simulate(
+    mut pos: V,
+    mut velocity: V,
+    min_y: f64,
+    entities: &[B],
+    mut block: impl FnMut(V, V) -> Option<(bool, V)>,
+    mut fluid: impl FnMut(V) -> bool,
+) -> Option<V> {
+    let physics = |pos: V, velocity: V, fluid: &mut dyn FnMut(V) -> bool| {
+        velocity
+            .scale(if fluid(pos) { 0.8 } else { 0.99 })
+            .sub(V(0., 0.03, 0.))
+    };
+    velocity = physics(pos, velocity, &mut fluid);
+    for _ in 1..240 {
+        if pos.1 < min_y {
+            return None;
+        }
+        let before = pos;
+        pos = pos.add(velocity);
+        let (miss, hit) = block(before, pos)?;
+        if !miss {
+            return Some(hit);
+        }
+        let broad = B {
+            lo: V(before.0 - 0.25, before.1 - 0.25, before.2 - 0.25),
+            hi: V(before.0 + 0.25, before.1 + 0.25, before.2 + 0.25),
+        };
+        let expanded = B {
+            lo: V(
+                broad.lo.0 + velocity.0.min(0.),
+                broad.lo.1 + velocity.1.min(0.),
+                broad.lo.2 + velocity.2.min(0.),
+            ),
+            hi: V(
+                broad.hi.0 + velocity.0.max(0.),
+                broad.hi.1 + velocity.1.max(0.),
+                broad.hi.2 + velocity.2.max(0.),
+            ),
+        }
+        .inflate(1.);
+        let mut closest = before.sub(pos).len2();
+        let mut entity_hit = None;
+        for b in entities {
+            if !b.intersects(expanded) {
+                continue;
+            }
+            let at = if b.contains(before) {
+                Some(before)
+            } else {
+                b.clip(before, pos)
+            };
+            if let Some(at) = at {
+                let d = before.sub(at).len2();
+                if d < closest || closest == 0. {
+                    closest = d;
+                    entity_hit = Some(at);
+                }
+            }
+        }
+        if entity_hit.is_some() {
+            return entity_hit;
+        }
+        velocity = physics(pos, velocity, &mut fluid);
+    }
+    None
+}
diff --git a/crates/horizon-client/src/game/easy_pearl.rs b/crates/horizon-client/src/game/easy_pearl.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/easy_pearl.rs
@@ -0,0 +1,273 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Real Player.pick OUTLINE/Fluid.NONE, feet-origin projectile solve and original overlay.
+use super::Game;
+use horizon_client::{
+    hud::{HudBatch, Rect},
+    world_primitives::{PrimitiveShape, WorldPrimitives},
+};
+use horizon_core::geometry::Vec3;
+use serde_json::{Value, json};
+thread_local! {static OVERLAY:std::cell::RefCell<Option<([f64;3],String,u32)>>=const{std::cell::RefCell::new(None)};}
+thread_local! {static LOCAL_PREUSED:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};}
+fn native_color(c: u32) -> u32 {
+    u32::from_le_bytes([(c >> 16) as u8, (c >> 8) as u8, c as u8, (c >> 24) as u8])
+}
+fn color(reachable: bool, alpha: u8) -> u32 {
+    (u32::from(alpha) << 24) | if reachable { 0x20c206 } else { 0xd70909 }
+}
+impl Game<'_> {
+    fn client_easy_pearl_holding(&self) -> bool {
+        let pearl = |s: Option<&horizon_client::items::ItemStack>| {
+            s.is_some_and(|s| s.count > 0 && s.item.as_ref() == "minecraft:ender_pearl")
+        };
+        pearl(self.stack_in(self.client_hotbar_slot())) || pearl(self.offhand.as_ref())
+    }
+    fn client_easy_pearl_options(&self) -> Value {
+        if !self.native_window() || !self.native_client_slot_owner() || self.player.is_none() {
+            return Value::Null;
+        }
+        let mut output = String::new();
+        self.native_client_easy_pearl("{\"phase\":\"options\"}", &mut output);
+        serde_json::from_str(&output).unwrap_or(Value::Null)
+    }
+    fn client_easy_pearl_hit(&self, partial: f32) -> Option<(bool, Vec3)> {
+        let player = self.player.as_ref()?;
+        let old = self.previous_position;
+        let t = f64::from(partial);
+        let eye = Vec3::new(
+            old.x + (player.position.x - old.x) * t,
+            old.y + (player.position.y - old.y) * t + f64::from(player.dimensions.eye_height),
+            old.z + (player.position.z - old.z) * t,
+        );
+        let [yaw, pitch] = if partial == 1. {
+            [player.yaw, player.pitch]
+        } else {
+            [
+                self.rope_rot_old.0 + (player.yaw - self.rope_rot_old.0) * partial,
+                self.rope_rot_old.1 + (player.pitch - self.rope_rot_old.1) * partial,
+            ]
+        };
+        let direction = Vec3::direction_from_rotation(pitch, yaw);
+        super::auto_pearl_ray::clip(
+            self,
+            eye,
+            eye.add_vector(direction.scale(1000.)),
+            self.remote.as_ref().map_or(0, |r| r.entity_id),
+            true,
+        )
+    }
+    pub(super) fn client_easy_pearl_query(&self, text: &str) -> String {
+        if !self.native_window() || !self.native_client_slot_owner() {
+            return "null".into();
+        }
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        match q["op"].as_str() {
+            Some("slot") => json!(self.native_client_middle_click_pearl_slot()).to_string(),
+            Some("solve") => {
+                let Ok(p) = serde_json::from_value::<[f64; 3]>(q["target"].clone()) else {
+                    return "null".into();
+                };
+                json!(self.auto_pearl_rotation(super::auto_bow_math::V(p[0], p[1], p[2]), true))
+                    .to_string()
+            }
+            Some("angle") => self.auto_pearl_query(text),
+            _ => "null".into(),
+        }
+    }
+    pub(super) fn client_easy_pearl_interact(&mut self) -> bool {
+        if LOCAL_PREUSED.with(std::cell::Cell::get)
+            || !self.native_client_slot_owner()
+            || !self.client_easy_pearl_holding()
+            || !self.client_use_key_down()
+        {
+            return false;
+        }
+        if self.client_easy_pearl_options()["enabled"] != true {
+            return false;
+        }
+        let Some((miss, hit)) = self.client_easy_pearl_hit(0.) else {
+            return false;
+        };
+        let rotation = self.auto_pearl_rotation(super::auto_bow_math::V(hit.x, hit.y, hit.z), true);
+        let mut result = String::new();
+        self.native_client_easy_pearl(&json!({"phase":"interact","holding":true,"useDown":true,"hit":[hit.x,hit.y,hit.z],"miss":miss,"rotation":rotation}).to_string(),&mut result);
+        let result = serde_json::from_str::<Value>(&result).unwrap_or(Value::Null);
+        if let Some(warning) = result["warning"].as_str().filter(|s| !s.is_empty()) {
+            horizon_client::mod_api::Host::chat(self, &format!("§c{warning}"));
+        }
+        result["cancel"] == true
+    }
+    /// The useItem HEAD observes the real player view before prediction temporarily
+    /// aligns Item.use with its supplied packet angles.
+    pub(super) fn client_easy_pearl_local_use(
+        &mut self,
+        hand: super::Hand,
+        yaw: f32,
+        pitch: f32,
+    ) -> bool {
+        if self.client_easy_pearl_interact() {
+            self.native_client_item_interacted(true);
+            return false;
+        }
+        let old = LOCAL_PREUSED.with(|s| s.replace(true));
+        let result = self.native_with_item_rotation(yaw, pitch, |g| {
+            g.with_hand(hand, |g| {
+                g.client_use_item_only(true).unwrap_or(false) && !g.use_failed
+            })
+        });
+        LOCAL_PREUSED.with(|s| s.set(old));
+        result
+    }
+    pub(super) fn client_easy_pearl_geometry(&self, out: &mut WorldPrimitives, partial: f64) {
+        OVERLAY.with_borrow_mut(|o| *o = None);
+        let options = self.client_easy_pearl_options();
+        if options["enabled"] != true || !self.client_easy_pearl_holding() {
+            return;
+        }
+        let Some((_, hit)) = self.client_easy_pearl_hit(partial as f32) else {
+            return;
+        };
+        let pos = [hit.x.floor(), hit.y.floor(), hit.z.floor()];
+        let state = self
+            .world
+            .block(pos[0] as i32, pos[1] as i32, pos[2] as i32);
+        let reachable = self
+            .auto_pearl_rotation(super::auto_bow_math::V(hit.x, hit.y, hit.z), true)
+            .is_some();
+        let fill = color(reachable, 50);
+        let outline = color(reachable, 200);
+        let corners: [[f64; 3]; 8] = std::array::from_fn(|i| {
+            [
+                pos[0] + f64::from(((i & 1) != 0) as u8),
+                pos[1] + f64::from(((i & 2) != 0) as u8),
+                pos[2] + f64::from(((i & 4) != 0) as u8),
+            ]
+        });
+        if self.res.facts().is_air(state) {
+            let bottom = [0, 4, 5, 1];
+            out.push(PrimitiveShape::LiquidBounceQuad {
+                corners: bottom.map(|i| corners[i]),
+                colors: [fill; 4],
+            })
+            .through_walls();
+            for j in 0..4 {
+                out.line(
+                    corners[bottom[j]],
+                    corners[bottom[(j + 1) % 4]],
+                    outline,
+                    1.,
+                )
+                .through_walls();
+            }
+            for (a, b) in [(0, 1), (1, 5), (5, 4), (4, 0)] {
+                let mut ta = corners[a];
+                ta[1] += 0.7;
+                let mut tb = corners[b];
+                tb[1] += 0.7;
+                out.push(PrimitiveShape::LiquidBounceQuad {
+                    corners: [corners[a], corners[b], tb, ta],
+                    colors: [fill, fill, color(reachable, 0), color(reachable, 0)],
+                })
+                .through_walls();
+            }
+        } else {
+            for face in [
+                [0, 1, 3, 2],
+                [4, 6, 7, 5],
+                [0, 4, 5, 1],
+                [2, 3, 7, 6],
+                [0, 2, 6, 4],
+                [1, 5, 7, 3],
+            ] {
+                out.push(PrimitiveShape::LiquidBounceQuad {
+                    corners: face.map(|i| corners[i]),
+                    colors: [fill; 4],
+                })
+                .through_walls();
+            }
+            for i in 0..8 {
+                for axis in [1, 2, 4] {
+                    if i & axis == 0 {
+                        out.line(corners[i], corners[i | axis], outline, 1.)
+                            .through_walls();
+                    }
+                }
+            }
+        }
+        if options["showDistance"] == true {
+            if let Some(p) = self.player.as_ref() {
+                let distance = p.position.subtract(hit).length();
+                OVERLAY.with_borrow_mut(|o| {
+                    *o = Some((
+                        [hit.x, hit.y + f64::from(p.dimensions.eye_height), hit.z],
+                        format!("{distance:.1}m"),
+                        color(reachable, 255),
+                    ))
+                });
+            }
+        }
+    }
+    pub(super) fn client_easy_pearl_overlay(&self, batch: &mut HudBatch) {
+        let options = self.client_easy_pearl_options();
+        if options["enabled"] != true
+            || options["showDistance"] != true
+            || !self.client_easy_pearl_holding()
+        {
+            return;
+        }
+        let Some(camera) = self.native_camera() else {
+            return;
+        };
+        OVERLAY.with_borrow(|o| {
+            let Some((pos, text, color)) = o else {
+                return;
+            };
+            let matrix = glam::Mat4::from_cols_array(&camera.projection)
+                * glam::Mat4::from_cols_array(&camera.view);
+            let clip = matrix
+                * glam::Vec4::new(
+                    (pos[0] - camera.position[0]) as f32,
+                    (pos[1] - camera.position[1]) as f32,
+                    (pos[2] - camera.position[2]) as f32,
+                    1.,
+                );
+            if !clip.is_finite() || clip.w <= 0. {
+                return;
+            }
+            let screen = [
+                (clip.x / clip.w + 1.) * batch.width * 0.5,
+                (-clip.y / clip.w + 1.) * batch.height * 0.5,
+            ];
+            let (ascent, height) = self.gui.atlas.font.liquidbounce_target_metrics();
+            let scale = 9. / height;
+            let glyphs = text
+                .chars()
+                .map(|c| self.gui.atlas.font.liquidbounce_target_glyph(c, false))
+                .collect::<Vec<_>>();
+            let width = glyphs.iter().map(|g| g.advance).sum::<f32>() + 2.;
+            let left = screen[0] - width * scale * 0.5;
+            let baseline = screen[1] - height * scale * 0.5 + ascent * scale;
+            for shadow in [true, false] {
+                let mut x = left + if shadow { 2. * scale } else { 0. };
+                let y = baseline + if shadow { 2. * scale } else { 0. };
+                let fill = native_color(if shadow { 0x96000000 } else { *color });
+                for g in &glyphs {
+                    if let Some(Rect { u0, v0, u1, v1, .. }) = g.rect {
+                        let x0 = x + g.left * scale;
+                        let x1 = x + g.right * scale;
+                        let y0 = y + g.top * scale;
+                        let y1 = y + g.bottom * scale;
+                        batch.quad(
+                            [[x0, y0], [x1, y0], [x1, y1], [x0, y1]],
+                            [[u0, v0], [u1, v0], [u1, v1], [u0, v1]],
+                            fill,
+                        );
+                    }
+                    x += g.advance * scale;
+                }
+            }
+        });
+    }
+}
diff --git a/crates/horizon-client/src/game/auto_rod.rs b/crates/horizon-client/src/game/auto_rod.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/auto_rod.rs
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Fishing-hook, held-component and real living-entity facts for AutoRod.
+use super::{
+    Game, Hand, Screen,
+    auto_bow_math::{self as math, B, Trajectory, V},
+};
+use horizon_core::geometry::Vec3;
+use serde_json::{Value, json};
+fn v(p: Vec3) -> V {
+    V(p.x, p.y, p.z)
+}
+fn p(v: V) -> Vec3 {
+    Vec3::new(v.0, v.1, v.2)
+}
+fn b(e: &super::auto_bow::Entity) -> B {
+    B {
+        lo: v(e.bounds.min_position()),
+        hi: v(e.bounds.max_position()),
+    }
+}
+impl Game<'_> {
+    pub(super) fn auto_rod_animation(
+        &self,
+        hand: Hand,
+    ) -> horizon_client::first_person::SwingAnimation {
+        use horizon_client::first_person::SwingAnimation;
+        let slot = if hand == Hand::Off {
+            super::shield::OFFHAND_SLOT
+        } else {
+            self.client_hotbar_slot()
+        };
+        let Some(stack) = self.stack_in(slot) else {
+            return SwingAnimation::DEFAULT;
+        };
+        let view = horizon_client::item_render::stack_view(stack);
+        let components = self.pack.item_renderer.models.components_view(&view);
+        let Some(a) = components.get("minecraft:interact_animation") else {
+            return SwingAnimation::DEFAULT;
+        };
+        SwingAnimation {
+            kind: match a["type"].as_str().unwrap_or("whack") {
+                "none" => 0,
+                "stab" => 2,
+                _ => 1,
+            },
+            duration: a["duration"].as_i64().unwrap_or(6) as i32,
+        }
+    }
+    pub(super) fn auto_rod_query(&mut self, text: &str) -> String {
+        let Ok(q) = serde_json::from_str::<Value>(text) else {
+            return "null".into();
+        };
+        if q["op"] == "release" {
+            if self.remote.is_some() {
+                self.release_remote_use();
+            } else if let Some((slot, ticks)) = self.using.take()
+                && let Some(stack) = self.stack_in(slot).cloned()
+            {
+                let hand = if slot == super::shield::OFFHAND_SLOT {
+                    Hand::Off
+                } else {
+                    Hand::Main
+                };
+                self.with_hand(hand, |g| g.release_used_item(&stack, ticks, false));
+            }
+            return "true".into();
+        }
+        if q["op"] == "use" {
+            let hand = q["hand"].as_i64().unwrap_or(-1) as i32;
+            let yaw = q["rotation"][0].as_f64().unwrap_or(f64::from(self.yaw)) as f32;
+            let pitch = q["rotation"][1].as_f64().unwrap_or(f64::from(self.pitch)) as f32;
+            let previous = self.client_auto_rod_swing.replace(q["hideSwing"] == true);
+            let used = self.native_client_use_item(hand, yaw, pitch);
+            self.client_auto_rod_swing = previous;
+            return json!(used).to_string();
+        }
+        if q["op"] == "angle" {
+            return self.auto_bow_query(text);
+        }
+        let Some(player) = self.player.as_ref() else {
+            return "null".into();
+        };
+        let at = player.position;
+        let Some(eye) = self.eye_position().map(|a| V(a[0], a[1], a[2])) else {
+            return "null".into();
+        };
+        if q["op"] == "slot" {
+            let slot = q["slot"].as_u64().unwrap_or(255) as usize;
+            return json!(
+                self.stack_in(slot)
+                    .is_some_and(|s| s.count > 0 && s.item.as_ref() == "minecraft:fishing_rod")
+            )
+            .to_string();
+        }
+        let hook = self.hook.as_ref().map(|h| h.auto_rod_facts());
+        if q["op"] == "hook" {
+            return json!(hook).to_string();
+        }
+        let entities = super::auto_bow::entities(self);
+        if q["op"] == "distance" {
+            let id = q["id"].as_i64().unwrap_or(i64::MIN);
+            let position = entities
+                .iter()
+                .find(|e| i64::from(e.id) == id)
+                .map(|e| e.position)
+                .or_else(|| {
+                    serde_json::from_value::<[f64; 3]>(q["position"].clone())
+                        .ok()
+                        .map(|a| Vec3::new(a[0], a[1], a[2]))
+                });
+            return position.map_or_else(
+                || "null".into(),
+                |p| json!({"distance":p.distance_squared(at),"position":[p.x,p.y,p.z]}).to_string(),
+            );
+        }
+        if q["op"] == "point" || q["op"] == "projectile" {
+            let Some(e) = entities
+                .iter()
+                .find(|e| q["id"].as_i64() == Some(i64::from(e.id)))
+            else {
+                return "null".into();
+            };
+            let forecast = (e.weight == 0)
+                .then(|| super::auto_bow_forecast::positions(self, e.id, 30))
+                .flatten();
+            let predicted = |t: f64| {
+                if let Some(f) = forecast.as_ref() {
+                    let i = (t + 0.5).floor().clamp(0., 30.) as usize;
+                    let at = f[i.min(f.len() - 1)];
+                    V(at[0], at[1], at[2])
+                } else {
+                    v(e.position).fma(t, v(e.velocity))
+                }
+            };
+            if q["op"] == "point" {
+                let bounds = b(e)
+                    .moved(predicted(1.).sub(v(e.position)))
+                    .inflate(self.client_pick_margin(e.id, 0.));
+                return json!({"eye":eye.array(),"bounds":[bounds.lo.0,bounds.lo.1,bounds.lo.2,bounds.hi.0,bounds.hi.1,bounds.hi.2]}).to_string();
+            }
+            let info = Trajectory {
+                velocity: 1.5,
+                gravity: 0.04,
+                drag: 0.92,
+                water_drag: 0.92,
+                radius: 0.25,
+                copies_velocity: true,
+            };
+            return math::calculate(info, eye, e.dimensions, predicted, |from, to| {
+                super::auto_bow_ray::clip(self, p(from), p(to), true).is_some_and(|hit| hit.0)
+            })
+            .map_or_else(|| "null".into(), |a| json!(a).to_string());
+        }
+        if q["op"] != "facts" {
+            return "null".into();
+        }
+        let view = v(Vec3::direction_from_rotation(player.pitch, player.yaw));
+        let visible = super::criticals_target::candidates(self, f32::MAX, true);
+        let candidates = entities.into_iter().map(|e|json!({"id":e.id,"target":e.target,"type":e.weight,"health":e.health,"hurt":e.hurt,"age":e.age,"distance":b(&e).distance(eye),"cosine":math::max_cos(eye,view,b(&e)),"rangeSquared":e.position.distance_squared(at),"position":[e.position.x,e.position.y,e.position.z],"visible":visible.iter().any(|a|a["id"].as_i64()==Some(i64::from(e.id)))})).collect::<Vec<_>>();
+        let main = self.stack_in(self.client_hotbar_slot());
+        let component = |stack: &horizon_client::items::ItemStack, name: &str| {
+            self.pack
+                .item_renderer
+                .models
+                .components_view(&horizon_client::item_render::stack_view(stack))
+                .contains_key(name)
+        };
+        let weapon = main.is_some_and(|s| {
+            self.items().item_in_tag("minecraft:swords", &s.item)
+                // The pinned client speaks 26.3. Its legacy combat *pictures*
+                // preference does not change the negotiated protocol version.
+                || self.items().item_in_tag("minecraft:axes", &s.item)
+                || Self::client_air_place_item_class(&s.item, "MaceItem")
+                || s.enchantment_level("minecraft:knockback") > 0
+        });
+        let consumable = main
+            .into_iter()
+            .chain(self.offhand.as_ref())
+            .any(|s| component(s, "minecraft:consumable"));
+        let rods = (0..9)
+            .chain(std::iter::once(40))
+            .map(|slot| {
+                self.stack_in(slot)
+                    .is_some_and(|s| s.count > 0 && s.item.as_ref() == "minecraft:fishing_rod")
+            })
+            .collect::<Vec<_>>();
+        let attack_key = self.settings.keys.get("key.attack");
+        json!({"hook":hook,"rods":rods,"selected":self.client_hotbar_slot(),"health":player.health.health(),"mainItem":main.map_or("minecraft:air",|s|s.item.as_ref()),"weapon":weapon,"vanillaName":main.is_none_or(|s|!component(s,"minecraft:custom_name")),"notBreaking":!self.remote.as_ref().map_or(self.clicks.destroying.active,|r|r.is_destroying),"inventoryOpen":matches!(self.screen,Screen::Inventory|Screen::Creative),"using":self.using.is_some(),"consumable":consumable,"attackKey":attack_key,"candidates":candidates}).to_string()
+    }
+}
