+        globals[9] = (offset.y as f32).to_bits();
+        globals[10] = (offset.z as f32).to_bits();
+        let globals = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Globals"),
+            contents: bytemuck::cast_slice(&globals),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let inverse = view.inverse();
+        let right = inverse.x_axis;
+        let up = inverse.y_axis;
+        let forward = -inverse.z_axis;
+        let tangent = (fov.to_radians() / 2.).tan();
+        let axes = [
+            right.to_array(),
+            up.to_array(),
+            forward.to_array(),
+            [
+                tangent * targets.size[0] as f32 / targets.size[1] as f32,
+                tangent,
+                0.,
+                0.,
+            ],
+        ];
+        let axes = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectView"),
+            contents: bytemuck::cast_slice(&axes),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let group = |source: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("LiquidBounce ShaderLayer"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: effect_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: globals.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: axes.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::TextureView(source),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 4,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        pass(encoder, &targets.views[0], &self.capture, None, true, true);
+        for (i, pipeline) in [0, 1, effect.style + 2].into_iter().enumerate() {
+            let group = group(&targets.views[i]);
+            pass(
+                encoder,
+                &targets.views[i + 1],
+                &self.pipelines[pipeline],
+                Some(&group),
+                false,
+                true,
+            );
+        }
+        let group = group(&targets.views[3]);
+        pass(encoder, target, &self.composite, Some(&group), false, false);
+    }
+}
diff --git a/crates/horizon-client/src/game/blink_esp.rs b/crates/horizon-client/src/game/blink_esp.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/blink_esp.rs
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{Game,native_mob_draw::NativePlayerRender};
+use horizon_core::geometry::Vec3;
+use horizon_client::mesher::Vertex;
+// The original light probe is private to perspective; use its exact implementation below.
+fn entity_light_block(position: Vec3, crouching: bool, eye_height: f64) -> [i32; 3] {
+    let y = position.y + if crouching { 0.125 } else { 0.0 } + eye_height;
+    [
+        position.x.floor() as i32,
+        y.floor() as i32,
+        position.z.floor() as i32,
+    ]
+}
+impl Game<'_>{
+    fn client_blink_outline(&self,vertices:&[Vertex],argb:u32){
+        if argb>>24==0{return;}
+        let color=(argb&0xff00ff00)|((argb>>16)&255)|((argb&255)<<16);
+        self.glowing_vertices.borrow_mut().extend(vertices.iter().map(|v|Vertex{color,normal:[0;4],..*v}));
+    }
+    pub(super) fn client_blink_frame(&self,camera:glam::DVec3,alpha:f64,out:&mut Vec<Vertex>){
+        let mut output="null".to_owned();
+        self.native_client_blink_esp(&alpha.to_string(),&mut output);
+        let Ok(v)=serde_json::from_str::<serde_json::Value>(&output)else{return};
+        horizon_client::gfx::blink_esp::begin_frame(&v["body"].to_string());
+        horizon_client::gfx::blink_line::begin_frame(&v["line"].to_string());
+        if !self.effective_camera_type().first_person() && !v["model"].is_null(){self.client_blink_model(camera,&v["model"],out);}
+    }
+    fn client_blink_model(
+        &self,
+        camera: glam::DVec3,
+        model: &serde_json::Value,
+        out: &mut Vec<horizon_client::mesher::Vertex>,
+    ) {
+        let Some(source)=self.player_model.as_ref() else{return};
+        let Ok(position)=serde_json::from_value::<[f64;3]>(model["position"].clone())else{return};
+        let Ok(rotation)=serde_json::from_value::<[f32;2]>(model["rotation"].clone())else{return};
+        let light_percent=model["lightPercent"].as_i64().unwrap_or(60)as f32 * 0.01;
+        let outline=model["outlineColor"].as_i64().unwrap_or(0)as u32;
+        let original_position=source.position;
+        let mut snapshot=source.clone();
+        snapshot.position=Vec3::new(position[0],position[1],position[2]);
+        snapshot.previous=snapshot.position;
+        snapshot.yaw=rotation[0];snapshot.previous_yaw=rotation[0];
+        snapshot.body_yaw=rotation[0];snapshot.previous_body_yaw=rotation[0];
+        snapshot.head_yaw=rotation[0];snapshot.previous_head_yaw=rotation[0];
+        snapshot.head_pitch=rotation[1];snapshot.previous_head_pitch=rotation[1];
+        let m=&snapshot;
+        let eye = self
+            .player
+            .as_ref()
+            .map_or_else(|| m.eye_height(), |p| f64::from(p.dimensions.eye_height));
+        let probe = entity_light_block(original_position, m.extra.crouching, eye);
+        let light = self.world.light(probe[0], probe[1], probe[2]);
+        let scale=|v:u8|((f32::from(v)*light_percent).round()as i32).clamp(0,15)as u32;
+        let packed=(scale(light>>4)*16)|((scale(light&15)*16)<<8);
+        let atlas = &self.gui.atlas;
+        let lookup = |name: &str| atlas.sprites.get(name).map(|r| [r.u0, r.v0, r.u1, r.v1]);
+        let start = out.len();
+        let body = self.own_body_visible();
+        // `native_player_submit`: a native mod's own model for this player,
+        // in place of the vanilla one and its layers (an invisible player is
+        // not asked, as for the others).
+        let name = self.own_profile_name();
+        let who = NativePlayerRender {
+            name: &name,
+            local: true,
+        };
+        if body && self.mod_player_geometry(m, who, 0., camera, packed, out) {
+            self.client_blink_outline(&out[start..],outline);
+            return;
+        }
+        // A spectator still draws its own model in third person: the poses'
+        // visibility (set by player_model_visibility) hides body parts, and
+        // translucent_body marks the body OIT for the ghostly look. Only first
+        // person and dead players skip it.
+        let render = if body || self.spectator() {
+            horizon_client::mobs::render::render_with
+        } else {
+            horizon_client::mobs::render::render_layers
+        };
+        render(
+            m,
+            0.,
+            camera,
+            &lookup,
+            packed,
+            self.res.mob_data(),
+            &self.player_armor_layers(),
+            out,
+        );
+        // AvatarRenderer.shouldRenderLayers: a spectator draws no layers.
+        if horizon_client::mobs::render::layers_shown(m) {
+            let chest = self.armor[1].as_ref().map(|s| &*s.item);
+            // CapeLayer: no cape on an invisible player (`isInvisible`, whoever looks).
+            if !self.own_invisible() {
+                self.player_cape_geometry(m, chest, camera, 0., packed, out);
+            }
+            self.player_ears_geometry(
+                m,
+                &self.own_profile_name(),
+                camera,
+                0.,
+                packed,
+                out,
+            );
+            let world = horizon_hooks::players::Pass::World;
+            self.own_layers_geometry(m, world, camera, 0., packed, out);
+            self.player_elytra_geometry(m, chest, camera, 0., packed, out);
+            self.spin_attack_geometry(m, camera, 0., packed, out);
+            self.shoulder_parrots_geometry(m, camera, 0., packed, out);
+            self.stuck_in_body_geometry(m, self.remote.as_ref().map_or(0, |r| r.entity_id), camera, 0., packed, out);
+            self.held_item_geometry(m, camera, 0., packed, true, None, out);
+            // CustomHeadLayer: a pumpkin, skull or other head item.
+            self.head_item_geometry(m, camera, 0., packed, true, out);
+            // `native_mob_layer`: a native mod's layer, over the vanilla ones.
+            self.mod_mob_layer_geometry(m, Some(who), 0., camera, packed, out);
+        }
+        if !body && outline>>24!=0 {
+            let mut silhouette=Vec::new();
+            horizon_client::mobs::render::render(m,0.,camera,&lookup,packed,self.res.mob_data(),&mut silhouette);
+            self.client_blink_outline(&silhouette,outline);
+        }
+        self.client_blink_outline(&out[start..],outline);
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/blink_esp.rs b/crates/horizon-client-render/src/gfx/blink_esp.rs
