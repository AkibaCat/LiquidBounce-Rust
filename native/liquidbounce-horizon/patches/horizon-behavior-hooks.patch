+++ b/crates/horizon-client/src/game/scaffold_action.rs
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleScaffold's real player facts, direct placement predicate and dispatch.
+use super::{BuildingObstruction, Game, GameLevel, Hand, Hit};
+use horizon_core::{
+    geometry::{Direction, Vec3},
+    position::BlockPos,
+};
+use horizon_world::{
+    collision_context::{CollisionContext, CollisionEntity, CollisionItem, EntityContextKind},
+    entity_obstruction::EntityIdentity,
+    level::PlaceContext,
+    registry::BlockStateId,
+};
+use serde_json::{Value, json};
+
+fn hit(value: &Value) -> Option<Hit> {
+    Some(Hit {
+        pos: serde_json::from_value(value["block"].clone()).ok()?,
+        face: serde_json::from_value(value["face"].clone()).ok()?,
+        point: serde_json::from_value(value["point"].clone()).ok()?,
+    })
+}
+fn inside(request: &Value) -> Option<bool> {
+    request["hit"]["inside"]
+        .as_bool()
+        .or_else(|| request["inside"].as_bool())
+}
+fn hand(value: &Value) -> Option<Hand> {
+    match value.as_str()? {
+        "Main" => Some(Hand::Main),
+        "Off" => Some(Hand::Off),
+        _ => None,
+    }
+}
+fn unobstructed(
+    level: &GameLevel<'_>,
+    position: BlockPos,
+    state: BlockStateId,
+    context: &CollisionContext<'_>,
+    subject: Option<horizon_client::collisions::PowderSnowSubject>,
+) -> bool {
+    let mut scene = horizon_client::collisions::SceneCollisions {
+        world: &*level.world,
+        binding: level.collision,
+        subject,
+    };
+    let shape = level
+        .collision
+        .collision_shape_with_context(&mut scene, state, position, context)
+        .expect("Scaffold getPlacementState collision shape")
+        .moved(Vec3::new(
+            f64::from(position.x),
+            f64::from(position.y),
+            f64::from(position.z),
+        ));
+    horizon_world::entity_obstruction::is_unobstructed(
+        &mut BuildingObstruction(level.building_blocker_boxes()),
+        None,
+        &shape,
+    )
+    .expect("Scaffold getPlacementState entity obstruction")
+}
+impl Game<'_> {
+    pub(super) fn scaffold_action_query(&mut self, text: &str) -> Option<String> {
+        let request = serde_json::from_str::<Value>(text).ok()?;
+        match request["op"].as_str()? {
+            "facts" => {
+                let p = self.player.as_ref()?;
+                let keys = horizon_client::reverse_step_bridge::keys();
+                Some(json!({"position":[p.position.x,p.position.y,p.position.z],"eye":self.eye_position()?,
+                    "blockY":p.position.y.floor() as i32,"velocityY":p.velocity.y,"onGround":p.ground.on_ground,
+                    "horizontalCollision":p.collision.horizontal,"moving":p.move_vector != [0.0,0.0],
+                    "inputJump":keys[4] || p.was_auto_jump,"physicalJump":self.keys.held(horizon_client::actions::Action::Jump),"yaw":self.yaw,"pitch":self.pitch}).to_string())
+            }
+            "checkPlacement" => {
+                let hit = hit(&request["hit"])?;
+                let hand = hand(&request["hand"])?;
+                let stack = self.with_hand(hand, |g| g.held().cloned())?;
+                let player = self.player.as_ref()?;
+                let face = Direction::ALL
+                    .into_iter()
+                    .find(|d| d.normal() == hit.face)?;
+                let context = PlaceContext {
+                    clicked_pos: BlockPos::new(hit.pos[0], hit.pos[1], hit.pos[2]),
+                    face,
+                    hit: Vec3::new(hit.point[0], hit.point[1], hit.point[2]),
+                    inside: inside(&request)?,
+                    yaw: player.yaw,
+                    pitch: player.pitch,
+                    sneaking: player.shift_key_down,
+                    item: stack.item.to_string(),
+                    can_use_game_master_blocks: self.can_use_game_master_blocks(),
+                };
+                // getPlacementState uses placementContext(player) for ordinary
+                // BlockItem, but StandingAndWallBlockItem uses empty(). Capture
+                // the effective main hand independently of the hand being used.
+                let main = self
+                    .inventory
+                    .get(self.client_hotbar_slot())
+                    .and_then(Option::as_ref)
+                    .cloned();
+                let collision = CollisionContext::placement(Some(CollisionEntity {
+                    identity: EntityIdentity(
+                        self.remote
+                            .as_ref()
+                            .map_or(0, |r| r.entity_id as u32 as u64),
+                    ),
+                    kind: EntityContextKind::Player,
+                    y: player.position.y,
+                    descending: player.shift_key_down,
+                    main_hand: Some(main.as_ref().map_or(CollisionItem::EMPTY, |s| {
+                        CollisionItem {
+                            item: &s.item,
+                            count: s.count as i32,
+                        }
+                    })),
+                }));
+                let mut subject = player.powder_snow_subject();
+                subject.leather_boots = self.armor[3]
+                    .as_ref()
+                    .is_some_and(|s| s.count > 0 && &*s.item == "minecraft:leather_boots");
+                let can = self.with_level(|b, l, t| {
+                    b.liquidbounce_scaffold_placement_state(
+                        l,
+                        t,
+                        &context,
+                        |level, pos, state, placement| {
+                            if placement {
+                                unobstructed(level, pos, state, &collision, Some(subject))
+                            } else {
+                                unobstructed(
+                                    level,
+                                    pos,
+                                    state,
+                                    &CollisionContext::empty(false),
+                                    None,
+                                )
+                            }
+                        },
+                    )
+                    .is_some()
+                });
+                Some(json!(can).to_string())
+            }
+            "execute" => {
+                let hit = hit(&request["hit"])?;
+                let rotation = serde_json::from_value(request["rotation"].clone()).ok()?;
+                let hand = hand(&request["hand"])?;
+                let swing = request["swing"].as_str()?;
+                let simulated = request["simulated"].as_bool()?;
+                let placed: [i32; 3] = if simulated {
+                    std::array::from_fn(|i| hit.pos[i].wrapping_add(hit.face[i]))
+                } else {
+                    serde_json::from_value(request["placed"].clone()).ok()?
+                };
+                let accepted = self.client_scaffold_do_placement(
+                    hit,
+                    inside(&request)?,
+                    rotation,
+                    hand,
+                    swing,
+                    |g, _| {
+                        g.native_client_scaffold_success(placed, simulated);
+                        true
+                    },
+                );
+                Some(json!(accepted).to_string())
+            }
+            "sendRotation" => {
+                let [yaw, pitch]: [f32; 2] =
+                    serde_json::from_value(request["rotation"].clone()).ok()?;
+                let p = self.player.as_ref()?;
+                let at = p.position;
+                let flags = u8::from(p.ground.on_ground) | (u8::from(p.collision.horizontal) << 1);
+                self.send(
+                    horizon_protocol::packets::play::Serverbound::MovePlayerPosRot(
+                        horizon_protocol::packets::play::MovePlayerPosRot {
+                            x: at.x,
+                            y: at.y,
+                            z: at.z,
+                            yaw,
+                            pitch,
+                            flags,
+                        },
+                    ),
+                );
+                Some("true".into())
+            }
+            _ => None,
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_planner_rules.rs b/crates/horizon-client/src/game/scaffold_planner_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_planner_rules.rs
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ScaffoldMovementPlanner: support ranking, history and 8-way hysteresis.
+use std::{cmp::Ordering, collections::VecDeque};
+pub type Position = [f64; 3];
+pub type BlockPos = [i32; 3];
+pub type Bounds = [f64; 6];
+const SURFACE_EPSILON: f64 = 1.0e-3;
+const OVERLAP_HYSTERESIS: f64 = 0.02;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Line {
+    pub position: Position,
+    pub direction: Position,
+}
+impl Line {
+    pub fn nearest(self, point: Position) -> Position {
+        let delta = std::array::from_fn(|i| point[i] - self.position[i]);
+        let t = dot(self.direction, delta) / dot(self.direction, self.direction);
+        std::array::from_fn(|i| t.mul_add(self.direction[i], self.position[i]))
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SupportReference {
+    pub block: BlockPos,
+    pub offset_x: f64,
+    pub offset_z: f64,
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Candidate {
+    pub block: BlockPos,
+    pub overlap: f64,
+    pub surface_delta: f64,
+    pub distance_squared: f64,
+}
+impl Candidate {
+    /// Nonempty shape is checked by the native caller, independently of overlap.
+    pub fn from_boxes(block: BlockPos, boxes: &[Bounds], player: Position, bounds: Bounds) -> Self {
+        let mut surface_delta = f64::INFINITY;
+        let mut overlap = 0.0;
+        for shape in boxes {
+            let min_x = f64::from(block[0]) + shape[0];
+            let max_x = f64::from(block[0]) + shape[3];
+            let max_y = f64::from(block[1]) + shape[4];
+            let min_z = f64::from(block[2]) + shape[2];
+            let max_z = f64::from(block[2]) + shape[5];
+            let overlap_x = bounds[3].min(max_x) - bounds[0].max(min_x);
+            let overlap_z = bounds[5].min(max_z) - bounds[2].max(min_z);
+            if overlap_x <= 0.0 || overlap_z <= 0.0 {
+                continue;
+            }
+            let delta = (bounds[1] - max_y).abs();
+            let area = overlap_x * overlap_z;
+            if delta + SURFACE_EPSILON < surface_delta {
+                surface_delta = delta;
+                overlap = area;
+            } else if (delta - surface_delta).abs() <= SURFACE_EPSILON {
+                overlap += area;
+            }
+        }
+        let dx = player[0] - (f64::from(block[0]) + 0.5);
+        let dz = player[2] - (f64::from(block[2]) + 0.5);
+        Self {
+            block,
+            overlap,
+            surface_delta,
+            distance_squared: dx * dx + dz * dz,
+        }
+    }
+    pub fn compare(self, other: Self) -> Ordering {
+        if self.surface_delta + SURFACE_EPSILON < other.surface_delta {
+            Ordering::Less
+        } else if other.surface_delta + SURFACE_EPSILON < self.surface_delta {
+            Ordering::Greater
+        } else if self.overlap > other.overlap + OVERLAP_HYSTERESIS {
+            Ordering::Less
+        } else if self.overlap + OVERLAP_HYSTERESIS < other.overlap {
+            Ordering::Greater
+        } else if self.distance_squared < other.distance_squared {
+            Ordering::Less
+        } else if self.distance_squared > other.distance_squared {
+            Ordering::Greater
+        } else {
+            Ordering::Equal
+        }
+    }
+    pub fn stable_against(self, best: Self) -> bool {
+        self.surface_delta <= best.surface_delta + SURFACE_EPSILON
+            && self.overlap + OVERLAP_HYSTERESIS >= best.overlap
+    }
+}
+fn dot(a: Position, b: Position) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn wrap(angle: f32) -> f32 {
+    let mut value = angle % 360.0;
+    if value >= 180.0 {
+        value -= 360.0;
+    }
+    if value < -180.0 {
+        value += 360.0;
+    }
+    value
+}
+pub fn movement_angle(mut yaw: f32, [forward, backward, left, right]: [bool; 4]) -> f32 {
+    let multiplier = if backward && !forward {
+        yaw += 180.0;
+        -0.5
+    } else if forward && !backward {
+        0.5
+    } else {
+        1.0
+    };
+    if left && !right {
+        yaw -= 90.0 * multiplier;
+    }
+    if right && !left {
+        yaw += 90.0 * multiplier;
+    }
+    yaw
+}
+#[derive(Clone, Debug)]
+pub struct Planner {
+    pub history: VecDeque<BlockPos>,
+    pub last_position: Option<BlockPos>,
+    pub support: Option<SupportReference>,
+    pub direction_angle: f32,
+}
+impl Default for Planner {
+    fn default() -> Self {
+        Self {
+            history: VecDeque::new(),
+            last_position: None,
+            support: None,
+            direction_angle: f32::NAN,
+        }
+    }
+}
+impl Planner {
+    pub fn reset(&mut self) {
+        *self = Self::default();
+    }
+    pub fn track(&mut self, block: BlockPos) {
+        if self.history.back() == Some(&block) {
+            return;
+        }
+        while self.history.len() >= 4 {
+            self.history.pop_front();
+        }
+        self.history.push_back(block);
+    }
+    pub fn choose_angle(&mut self, current: f32) -> f32 {
+        if !self.direction_angle.is_nan() && wrap(self.direction_angle - current).abs() <= 30.0 {
+            return self.direction_angle;
+        }
+        let number = (current / 180.0 * 4.0 + 4.0).round_ties_even();
+        self.direction_angle = wrap((number - 4.0) / 4.0 * 180.0);
+        self.direction_angle
+    }
+    fn history_line(&self) -> Option<Line> {
+        let last = self.history.back()?;
+        let previous = self.history.get(self.history.len().checked_sub(2)?)?;
+        let a = [
+            f64::from(previous[0]) + 0.5,
+            f64::from(previous[1]),
+            f64::from(previous[2]) + 0.5,
+        ];
+        let b = [
+            f64::from(last[0]) + 0.5,
+            f64::from(last[1]),
+            f64::from(last[2]) + 0.5,
+        ];
+        let delta: Position = std::array::from_fn(|i| b[i] - a[i]);
+        let length = dot(delta, delta).sqrt();
+        let direction = if length < 1.0e-5 {
+            [0.0; 3]
+        } else {
+            delta.map(|v| v / length)
+        };
+        Some(Line {
+            position: std::array::from_fn(|i| (a[i] + b[i]) * 0.5),
+            direction,
+        })
+    }
+    pub fn line(
+        &mut self,
+        player: Position,
+        current_angle: f32,
+        candidates: &[Candidate],
+        mut direction_from_rotation: impl FnMut(f32) -> Position,
+    ) -> Option<Line> {
+        // Direction state changes even when no support candidate exists.
+        let direction = direction_from_rotation(self.choose_angle(current_angle));
+        let Some(mut best) = candidates.first().copied() else {
+            self.support = None;
+            self.last_position = None;
+            return None;
+        };
+        for &candidate in &candidates[1..] {
+            if candidate.compare(best) == Ordering::Less {
+                best = candidate;
+            }
+        }
+        let preferred = [self.history.back().copied(), self.last_position]
+            .into_iter()
+            .flatten()
+            .filter_map(|position| candidates.iter().find(|c| c.block == position).copied())
+            .find(|candidate| candidate.stable_against(best));
+        let chosen = preferred.unwrap_or(best);
+        self.last_position = Some(chosen.block);
+        let support = SupportReference {
+            block: chosen.block,
+            offset_x: player[0] - (f64::from(chosen.block[0]) + 0.5),
+            offset_z: player[2] - (f64::from(chosen.block[2]) + 0.5),
+        };
+        self.support = Some(support);
+        let anchor = self
+            .history_line()
+            .filter(|line| dot(line.direction, direction) >= 0.5)
+            .map_or_else(
+                || {
+                    [
+                        f64::from(support.block[0]) + 0.5 + support.offset_x,
+                        player[1],
+                        f64::from(support.block[2]) + 0.5 + support.offset_z,
+                    ]
+                },
+                |line| line.nearest(player),
+            );
+        Some(Line {
+            position: [anchor[0], player[1], anchor[2]],
+            direction,
+        })
+    }
+}
