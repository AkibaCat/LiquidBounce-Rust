diff --git a/crates/horizon-client/src/game/falling_forecast.rs b/crates/horizon-client/src/game/falling_forecast.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/falling_forecast.rs
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Shared full FallingPlayer replay: real loaded chunks, source hooks and timed effects.
+use super::*;
+use horizon_client::{crosshair_falling_bridge as bridge, sprint::Keys};
+pub(super) fn visit(
+    g: &mut Game<'_>,
+    ticks: i32,
+    add_y: f64,
+    after_movement: impl FnMut(&horizon_client::motion::PlayerMotion, i32) -> bool,
+) -> std::result::Result<(), String> {
+    if !g.native_client_slot_owner() {
+        return Err("no local player for falling simulation".into());
+    }
+    let p = g.player.as_ref().ok_or("no local player")?;
+    let mut raw = horizon_client::reverse_step_bridge::keys();
+    raw[4] = false;
+    raw[5] = p.shift_key_down;
+    raw[6] |= p.sprinting;
+    let keys = Keys {
+        forward: raw[0],
+        backward: raw[1],
+        left: raw[2],
+        right: raw[3],
+        jump: false,
+        shift: raw[5],
+        sprint: raw[6],
+        analog: None,
+    };
+    visit_with_keys(g, ticks, add_y, keys, after_movement)
+}
+/// The same real SimulatedPlayer replay with the caller's fixed keys. Edge
+/// prediction supplies jump=false and sneak=false, unlike FallingPlayer.
+pub(super) fn visit_with_keys(
+    g: &mut Game<'_>,
+    ticks: i32,
+    add_y: f64,
+    keys: Keys,
+    mut after_movement: impl FnMut(&horizon_client::motion::PlayerMotion, i32) -> bool,
+) -> std::result::Result<(), String> {
+    visit_with_keys_probe(g, ticks, add_y, keys, false,
+        |body, tick, _| after_movement(body, tick))
+}
+pub(super) fn visit_with_keys_probe(
+    g: &mut Game<'_>,
+    ticks: i32,
+    add_y: f64,
+    keys: Keys,
+    continues_tick: bool,
+    mut after_movement: impl FnMut(&horizon_client::motion::PlayerMotion, i32, bool) -> bool,
+) -> std::result::Result<(), String> {
+    if !g.native_client_slot_owner() {
+        return Err("no local player for player simulation".into());
+    }
+    let p = g.player.as_ref().ok_or("no local player")?;
+    let mut source = p.clone();
+    let mut body = p.clone();
+    body.auto_jump_enabled = false;
+    body.auto_jump_time = 0;
+    body.is_passenger = false;
+    body.velocity.y += add_y;
+    let (mut air, mut ground, mut strict, mut input, mut apply) = (1.0, 1.0, false, 0, false);
+    g.native_client_strafe(&mut air, &mut ground, &mut strict, &mut input, &mut apply);
+    source.client_strafe = apply.then_some((
+        horizon_client::strafe::Strafe {
+            strength_in_air: air,
+            strength_on_ground: ground,
+            strict_movement: strict,
+        },
+        input,
+    ));
+    let mut scene = World::new(g.world.air, 0);
+    scene.shape = g.world.shape;
+    for (&pos, chunk) in &g.world.chunks {
+        scene.chunks.insert(pos, chunk.clone());
+    }
+    scene.moving_pistons = g.world.moving_pistons.clone();
+    scene.shulkers = g.world.shulkers.clone();
+    let entities = g.player_entity_collisions();
+    let terrain = horizon_client::terrain_speed_bridge::enter(g.native_terrain_snapshot());
+    let scope = bridge::Scope::enter(source);
+    let mut effects = g.potions.effects.clone();
+    let result: std::result::Result<(), String> = (|| {
+        let mut motion = horizon_client::motion::MotionWorld {step_sender:None,
+            entities: &entities,
+            player: &mut body,
+            scene: &mut scene,
+            assets: &g.pack.assets,
+            collision_binding: g.collision,
+            resources: g.motion,
+            health: &g.health_resources,
+        };
+        // fromClientPlayer is called by GameTick before LocalPlayer movement;
+        // it begins a full next tick, preserving prior fluid/crouch observations.
+        for tick in 0..ticks.max(0) {
+            motion.player.status = effects.status();
+            motion.player.mobility_restricted = effects.get("blindness").is_some();
+            let (step, backed_off_edge) = horizon_client::navigation_physics::with_prediction(
+                horizon_client::navigation_physics::module_safe_walk(),
+                false,
+                || motion.liquidbounce_forecast_tick_from_phase(keys, continues_tick && tick == 0),
+            );
+            bridge::flush();
+            step.map_err(|e| e.to_string())?;
+            if after_movement(motion.player, tick, backed_off_edge) {
+                return Ok(());
+            }
+            let before = effects.modifiers();
+            effects.tick();
+            for (attr, id, _, _) in before {
+                if !effects.modifiers().iter().any(|e| e.1 == id) {
+                    motion
+                        .player
+                        .set_modifier(attr, id, 0.0, "add_value", false)
+                        .map_err(|e| e.to_string())?;
+                }
+            }
+        }
+        Ok(())
+    })();
+    bridge::flush();
+    let source = scope.finish();
+    drop(terrain);
+    // These are effects of the source module callbacks themselves. The
+    // speculative body's position, velocity and packets never reach Game.
+    if let Some(p) = g.player.as_mut() {
+        p.position = source.position;
+        p.old_position = source.old_position;
+        p.velocity = source.velocity;
+    }
+    result
+}
diff --git a/crates/horizon-client/src/game/scaffold_block_rules.rs b/crates/horizon-client/src/game/scaffold_block_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_block_rules.rs
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ScaffoldBlockItemSelection and ModuleScaffold's hotbar comparator.
+//! Native facts use the BlockItem's default state at BlockPos.ZERO.
+use std::{cmp::Ordering, collections::BTreeSet};
+
+pub const DEFAULT_DISALLOWED: [&str; 3] = [
+    "minecraft:tnt",
+    "minecraft:cobweb",
+    "minecraft:nether_portal",
+];
+pub const DEFAULT_UNFAVORABLE: [&str; 7] = [
+    "minecraft:crafting_table",
+    "minecraft:jigsaw",
+    "minecraft:smithing_table",
+    "minecraft:fletching_table",
+    "minecraft:enchanting_table",
+    "minecraft:cauldron",
+    "minecraft:magma_block",
+];
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Policy {
+    pub disallowed: BTreeSet<String>,
+    pub unfavorable: BTreeSet<String>,
+}
+impl Default for Policy {
+    fn default() -> Self {
+        Self {
+            disallowed: DEFAULT_DISALLOWED.into_iter().map(str::to_owned).collect(),
+            unfavorable: DEFAULT_UNFAVORABLE.into_iter().map(str::to_owned).collect(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AutoBlock {
+    pub enabled: bool,
+    pub always: bool,
+    pub slot_reset_delay: i32,
+    pub do_not_use_below_count: i32,
+}
+impl Default for AutoBlock {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            always: false,
+            slot_reset_delay: 5,
+            do_not_use_below_count: 1,
+        }
+    }
+}
+
+/// Only actual BlockItems produce this snapshot. Non-block items are None.
+#[derive(Clone, Debug, PartialEq)]
+pub struct BlockStack {
+    pub block: String,
+    pub count: i32,
+    pub player_can_stand_up: bool,
+    pub falling: bool,
+    pub base_entity: bool,
+    pub full_cube: bool,
+    pub redstone_conductor: bool,
+    pub friction: f32,
+    pub speed_factor: f32,
+    pub jump_factor: f32,
+    pub hardness: f32,
+}
+impl BlockStack {
+    pub fn valid(&self, policy: &Policy) -> bool {
+        self.player_can_stand_up && !self.falling && !policy.disallowed.contains(&self.block)
+    }
+    pub fn unfavorable(&self, policy: &Policy) -> bool {
+        self.friction > 0.6f32
+            || self.speed_factor < 1.0f32
+            || self.jump_factor < 1.0f32
+            || self.base_entity
+            || !self.full_cube
+            || policy.unfavorable.contains(&self.block)
+    }
+    pub fn valid_count(&self, policy: &Policy) -> i32 {
+        if self.valid(policy) { self.count } else { 0 }
+    }
+    fn hardness_distance(&self, neutral: bool) -> f64 {
+        let hardness = f64::from(self.hardness);
+        if neutral && (0.8..=2.0).contains(&hardness) {
+            0.0
+        } else {
+            (1.7 - hardness).abs()
+        }
+    }
+}
+
+/// Java Double.compare, including equal NaNs and signed zero.
+fn double_compare(a: f64, b: f64) -> Ordering {
+    if a < b {
+        return Ordering::Less;
+    }
+    if a > b {
+        return Ordering::Greater;
+    }
+    let bits = |v: f64| {
+        if v.is_nan() {
+            0x7ff8_0000_0000_0000i64
+        } else {
+            v.to_bits() as i64
+        }
+    };
+    bits(a).cmp(&bits(b))
+}
+
+/// maxWith uses this exact chain. The walkability and reversed stack-count
+/// directions intentionally preserve the frozen source, including its quirks.
+pub fn compare(a: &BlockStack, b: &BlockStack, policy: &Policy) -> Ordering {
+    (!a.unfavorable(policy))
+        .cmp(&!b.unfavorable(policy))
+        .then_with(|| a.redstone_conductor.cmp(&b.redstone_conductor))
+        .then_with(|| a.full_cube.cmp(&b.full_cube))
+        .then_with(|| double_compare(f64::from(a.friction), f64::from(b.friction)))
+        .then_with(|| {
+            double_compare(
+                (f64::from(a.jump_factor) - 1.0).abs(),
+                (f64::from(b.jump_factor) - 1.0).abs(),
+            )
+        })
+        .then_with(|| {
+            double_compare(
+                (f64::from(a.speed_factor) - 1.0).abs(),
+                (f64::from(b.speed_factor) - 1.0).abs(),
+            )
+        })
+        .then_with(|| double_compare(b.hardness_distance(true), a.hardness_distance(true)))
+        .then_with(|| b.count.cmp(&a.count))
+        .then_with(|| double_compare(b.hardness_distance(false), a.hardness_distance(false)))
+}
+
+pub fn best_slot(
+    hotbar: &[Option<BlockStack>; 9],
+    threshold: i32,
+    policy: &Policy,
+) -> Option<usize> {
+    let choose = |above_threshold: bool| {
+        let mut best: Option<usize> = None;
+        for (slot, stack) in hotbar.iter().enumerate() {
+            let Some(stack) = stack.as_ref().filter(|s| s.valid(policy)) else {
+                continue;
+            };
+            if above_threshold && stack.count <= threshold {
+                continue;
+            }
+            if best.is_none_or(|previous| {
+                compare(
+                    stack,
+                    hotbar[previous].as_ref().expect("chosen block"),
+                    policy,
+                ) == Ordering::Greater
+            }) {
+                best = Some(slot);
+            }
+        }
+        best
+    };
+    choose(true).or_else(|| choose(false))
+}
+
+/// ModuleScaffold.blockCount reads the raw selected slot when AutoBlock is off.
+/// The effective SilentHotbar main hand is separate and only affects collision
+/// context and whether a suitable block is already held.
+pub fn block_count(
+    hotbar: &[Option<BlockStack>; 9],
+    offhand: Option<&BlockStack>,
+    selected: usize,
+    auto_block: bool,
+    policy: &Policy,
+) -> i32 {
+    let offhand = offhand.map_or(0, |s| s.valid_count(policy));
+    let main = if auto_block {
+        hotbar
+            .iter()
+            .flatten()
+            .fold(0i32, |sum, s| sum.wrapping_add(s.valid_count(policy)))
+    } else {
+        hotbar
+            .get(selected)
+            .and_then(Option::as_ref)
+            .map_or(0, |s| s.valid_count(policy))
+    };
+    offhand.wrapping_add(main)
+}
diff --git a/crates/horizon-client/src/game/scaffold_selection.rs b/crates/horizon-client/src/game/scaffold_selection.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_selection.rs
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Actual BlockItem/default-state facts for Scaffold and Clutch.
+use super::{Game, ItemStack, scaffold_block_rules as rules};
+use horizon_core::{
+    geometry::{Direction, ShapeOp, VoxelShape},
+    position::BlockPos,
+};
+use horizon_world::{
+    collision_context::{CollisionContext, CollisionEntity, CollisionItem, EntityContextKind},
+    entity_obstruction::EntityIdentity,
+    level::{
+        classes::Class,
+        data::{ItemKind, state_flags},
+    },
+};
+use serde_json::{Value, json};
+
+fn full_cube(shape: &VoxelShape) -> bool {
+    shape.is_block()
+        || !VoxelShape::block()
+            .join_is_not_empty(shape, ShapeOp::XOR)
+            .expect("Scaffold full collision shape")
+}
+fn full_up_face(shape: &VoxelShape) -> bool {
+    shape.is_block()
+        || full_cube(
+            &shape
+                .face_shape(Direction::Up)
+                .expect("Scaffold collision UP face"),
+        )
+}
+fn policy(value: &Value) -> Option<rules::Policy> {
+    let mut result = rules::Policy::default();
+    for (name, target) in [
+        ("disallowed", &mut result.disallowed),
+        ("unfavorable", &mut result.unfavorable),
+    ] {
+        if let Some(values) = value.get(name) {
+            *target = values
+                .as_array()?
+                .iter()
+                .map(|v| v.as_str().map(str::to_owned))
+                .collect::<Option<_>>()?;
+        }
+    }
+    Some(result)
+}
+fn stack_json(stack: Option<&rules::BlockStack>, policy: &rules::Policy) -> Value {
+    let Some(s) = stack else { return Value::Null };
+    json!({"block":s.block,"count":s.count,"valid":s.valid(policy),"favorable":!s.unfavorable(policy),
+        "playerCanStandUp":s.player_can_stand_up,"falling":s.falling,"baseEntity":s.base_entity,
+        "fullCube":s.full_cube,"redstoneConductor":s.redstone_conductor,"friction":s.friction,
+        "speedFactor":s.speed_factor,"jumpFactor":s.jump_factor,"hardness":s.hardness})
+}
+impl Game<'_> {
+    pub(super) fn scaffold_block_facts(&self, stack: &ItemStack) -> Option<rules::BlockStack> {
+        if stack.count == 0 {
+            return None;
+        }
+        let player = self.player.as_ref()?;
+        let behaviours = self.res.behaviours();
+        let binding = behaviours.item_binding(&stack.item)?;
+        // The registry class chain assigns precisely these kinds to BlockItem
+        // and subclasses. A SolidBucketItem's block field is not a BlockItem.
+        if matches!(binding.kind, ItemKind::SolidBucket | ItemKind::Other) {
+            return None;
+        }
+        let state = behaviours.table.default_state(binding.block);
+        let block = behaviours.block_data(binding.block);
+        let movement = self
+            .motion
+            .blocks
+            .get(state)
+            .expect("Scaffold bound movement registry")
+            .coefficients;
+        let held = self
+            .inventory
+            .get(self.client_hotbar_slot())
+            .and_then(Option::as_ref);
+        let context = CollisionContext::for_entity(
+            CollisionEntity {
+                identity: EntityIdentity(
+                    self.remote
+                        .as_ref()
+                        .map_or(0, |r| r.entity_id as u32 as u64),
+                ),
+                kind: EntityContextKind::Player,
+                y: player.position.y,
+                descending: player.shift_key_down,
+                main_hand: Some(
+                    held.filter(|s| s.count > 0)
+                        .map_or(CollisionItem::EMPTY, |s| CollisionItem {
+                            item: &s.item,
+                            count: s.count as i32,
+                        }),
+                ),
+            },
+            false,
+        );
+        let mut subject = player.powder_snow_subject();
+        subject.leather_boots = self.armor[3]
+            .as_ref()
+            .is_some_and(|s| s.count > 0 && &*s.item == "minecraft:leather_boots");
+        let mut world = horizon_client::collisions::SceneCollisions {
+            world: &self.world,
+            binding: self.collision,
+            subject: Some(subject),
+        };
+        let position = BlockPos::new(0, 0, 0);
+        let supporting = self
+            .collision
+            .collision_shape_with_context(&mut world, state, position, &context)
+            .expect("Scaffold actual player collision shape at ZERO");
+        let facts = behaviours.facts(state);
+        // BlockStateBase caches this predicate only when !dynamicShape. Query
+        // uncached states with the empty context and real ZERO block entities.
+        let full = if block.dynamic_shape {
+            let shape = self
+                .collision
+                .collision_shape_with_context(
+                    &mut world,
+                    state,
+                    position,
+                    &CollisionContext::empty(false),
+                )
+                .expect("Scaffold empty-context default collision shape at ZERO");
+            full_cube(&shape)
+        } else {
+            facts.flags & state_flags::FULL_COLLISION != 0
+        };
+        Some(rules::BlockStack {
+            block: behaviours.table.name(state).to_owned(),
+            count: stack.count as i32,
+            player_can_stand_up: full_up_face(&supporting),
+            falling: block.is(Class::FallingBlock),
+            base_entity: block.is(Class::BaseEntity),
+            full_cube: full,
+            redstone_conductor: facts.flags & state_flags::CONDUCTOR != 0,
+            friction: movement.friction,
+            speed_factor: movement.speed_factor,
+            jump_factor: movement.jump_factor,
+            hardness: facts.hardness,
+        })
+    }
+    pub(super) fn scaffold_selection_query(&self, request: &str) -> Option<String> {
+        let request = serde_json::from_str::<Value>(request).ok()?;
+        let auto = request["autoBlock"].as_bool()?;
+        let threshold = i32::try_from(request["doNotUseBelowCount"].as_i64()?).ok()?;
+        let policy = policy(&request)?;
+        let hotbar: [Option<rules::BlockStack>; 9] = std::array::from_fn(|slot| {
+            self.inventory
+                .get(slot)
+                .and_then(Option::as_ref)
+                .and_then(|s| self.scaffold_block_facts(s))
+        });
+        let offhand = self
+            .offhand
+            .as_ref()
+            .and_then(|s| self.scaffold_block_facts(s));
+        let selected = self.selected;
+        let effective = self.client_hotbar_slot();
+        Some(json!({"selected":selected,"effectiveSelected":effective,
+            "blockCount":rules::block_count(&hotbar, offhand.as_ref(), selected, auto, &policy),
+            "bestSlot":rules::best_slot(&hotbar, threshold, &policy),
+            "rawMainValid":hotbar.get(selected).and_then(Option::as_ref).is_some_and(|s| s.valid(&policy)),
+            "mainValid":hotbar.get(effective).and_then(Option::as_ref).is_some_and(|s| s.valid(&policy)),
+            "offhandValid":offhand.as_ref().is_some_and(|s| s.valid(&policy)),
+            "hotbar":hotbar.iter().map(|s| stack_json(s.as_ref(), &policy)).collect::<Vec<_>>(),
+            "offhand":stack_json(offhand.as_ref(), &policy)}).to_string())
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_clutch_rules.rs b/crates/horizon-client/src/game/scaffold_clutch_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_clutch_rules.rs
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ScaffoldClutchTechnique's fall-layer search and Normal aim-ahead decision.
+pub type Position = [f64; 3];
+pub type BlockPos = [i32; 3];
+
+pub struct Search<'a> {
+    pub below: BlockPos,
+    pub offsets: &'a [BlockPos],
+    pub from: Position,
+    pub priority: Position,
+}
+pub trait Host {
+    type Target;
+    /// Real BlockState.isFaceSturdy(UP, CENTER), including unloaded rejection.
+    fn can_stand_on(&mut self, position: BlockPos) -> bool;
+    /// CenterTargetPositionFactory and the shared vanilla placement context.
+    fn find_target(&mut self, search: Search<'_>) -> Option<Self::Target>;
+    /// The server rotation can click it from the actual current player eye.
+    fn can_click(&mut self, target: &Self::Target) -> bool;
+}
+
+pub fn target<H: Host>(
+    host: &mut H,
+    from: Position,
+    fall: &[Position],
+    eye_height: f32,
+    range: f64,
+    full_offsets: &[BlockPos],
+) -> Option<H::Target> {
+    let mut feet_y = from[1];
+    for position in fall {
+        let top = feet_y.floor();
+        feet_y = position[1];
+        if position[1] >= top || top > from[1] {
+            continue;
+        }
+        if from[1] + f64::from(eye_height) - top > range {
+            break;
+        }
+        let below = [
+            from[0].floor() as i32,
+            (top - 1.0).floor() as i32,
+            from[2].floor() as i32,
+        ];
+        // Ground under this row cancels this search instead of skipping a layer.
+        if host.can_stand_on(below) {
+            return None;
+        }
+        let offsets = full_offsets
+            .iter()
+            .copied()
+            .filter(|offset| {
+                let under = [
+                    below[0].wrapping_add(offset[0]),
+                    below[1].wrapping_add(offset[1]).wrapping_sub(1),
+                    below[2].wrapping_add(offset[2]),
+                ];
+                !host.can_stand_on(under)
+            })
+            .collect::<Vec<_>>();
+        if let Some(target) = host.find_target(Search {
+            below,
+            offsets: &offsets,
+            from,
+            priority: [from[0], top - 0.5, from[2]],
+        }) {
+            return Some(target);
+        }
+    }
+    None
+}
+
+pub fn find_placement_target<H: Host>(
+    host: &mut H,
+    current: Position,
+    fall: &[Position],
+    eye_height: f32,
+    range: f64,
+    full_offsets: &[BlockPos],
+    aims_ahead: bool,
+) -> Option<H::Target> {
+    let now = target(host, current, fall, eye_height, range, full_offsets);
+    if !aims_ahead {
+        return now;
+    }
+    if let Some(now) = now
+        && host.can_click(&now)
+    {
+        return Some(now);
+    }
+    let (&next, rest) = fall.split_first()?;
+    target(host, next, rest, eye_height, range, full_offsets)
+}
diff --git a/crates/horizon-client/src/game/scaffold_clutch.rs b/crates/horizon-client/src/game/scaffold_clutch.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_clutch.rs
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete ScaffoldClutchTechnique over the shared real-world placement kernel.
+use super::{
+    Game, ItemStack,
+    block_placement::{self as placement, Target},
+    scaffold_clutch_rules as rules,
+};
+use serde_json::{Value, json};
+
+fn write_target(t: &Target) -> Value {
+    json!({"interacted":t.interacted,"placed":t.placed,"direction":t.direction,"point":t.point,"minY":t.min_y,"rotation":t.rotation})
+}
+fn read_target(v: &Value) -> Option<Target> {
+    Some(Target {
+        interacted: serde_json::from_value(v["interacted"].clone()).ok()?,
+        placed: serde_json::from_value(v["placed"].clone()).ok()?,
+        direction: serde_json::from_value(v["direction"].clone()).ok()?,
+        point: serde_json::from_value(v["point"].clone()).ok()?,
+        min_y: v["minY"].as_f64()?,
+        rotation: serde_json::from_value(v["rotation"].clone()).ok()?,
+    })
+}
+fn write_hit(click: placement::Click) -> Value {
+    let hit = click.hit;
+    json!({"block":hit.pos,"face":hit.face,"point":hit.point,"inside":click.inside})
+}
+fn click(
+    game: &Game<'_>,
+    target: &Target,
+    rotation: [f32; 2],
+    block_range: f64,
+    verification_range: f64,
+) -> Option<placement::Click> {
+    if let Some(hit) = placement::verify_click(
+        game,
+        target,
+        rotation,
+        verification_range,
+        placement::ClickTrace::World,
+        placement::FailedClick::Nothing,
+    ) {
+        return Some(hit);
+    }
+    let eye = game.eye_position()?;
+    let faces_player = (0..3)
+        .map(|i| (eye[i] - target.point[i]) * f64::from(target.direction[i]))
+        .sum::<f64>()
+        > 0.0;
+    // Source evaluates this query even when the planned face points away.
+    // It clips only the interacted block, so a different face remains valid.
+    let pointed_at =
+        placement::raytrace_block(game, target.interacted, rotation, block_range).is_some();
+    (faces_player && pointed_at).then(|| placement::planned_click(target))
+}
+struct Adapter<'g, 'r, 's> {
+    game: &'g mut Game<'r>,
+    stack: &'s ItemStack,
+    rotation: [f32; 2],
+    block_range: f64,
+    verification_range: f64,
+}
+impl rules::Host for Adapter<'_, '_, '_> {
+    type Target = Target;
+    fn can_stand_on(&mut self, position: [i32; 3]) -> bool {
+        placement::holds_solid(self.game, position)
+    }
+    fn find_target(&mut self, search: rules::Search<'_>) -> Option<Target> {
+        let location = placement::capture_location(self.game, Some(search.from), self.rotation)?;
+        let mut options = placement::Options::center(self.stack, location);
+        options.offsets = search.offsets.to_vec();
+        options.priority = placement::Priority::Position(search.priority);
+        options.range = self.block_range;
+        placement::find(self.game, search.below, &mut options)
+    }
+    fn can_click(&mut self, target: &Target) -> bool {
+        click(
+            self.game,
+            target,
+            self.rotation,
+            self.block_range,
+            self.verification_range,
+        )
+        .is_some()
+    }
+}
+impl Game<'_> {
+    pub(super) fn scaffold_clutch_query(&mut self, text: &str) -> Option<String> {
+        let request = serde_json::from_str::<Value>(text).ok()?;
+        let ahead = request["aimsAhead"].as_bool()?;
+        let server_rotation: [f32; 2] =
+            serde_json::from_value(request["serverRotation"].clone()).ok()?;
+        let block_range = self.interaction_range("minecraft:block_interaction_range", 4.5, 5.0);
+        let entity_range = self.interaction_range("minecraft:entity_interaction_range", 3.0, 5.0);
+        let verification_range = block_range.max(entity_range);
+        match request["op"].as_str()? {
+            "plan" => {
+                let fall: Vec<[f64; 3]> = serde_json::from_value(request["path"].clone()).ok()?;
+                if fall.is_empty() {
+                    return None;
+                }
+                let player = self.player.as_ref()?;
+                let current = [player.position.x, player.position.y, player.position.z];
+                let height = player.dimensions.eye_height;
+                // ModuleScaffold plans with sandstone when its best hotbar
+                // slot is absent, even if a real offhand block makes it run.
+                let stack = if request["slot"].is_null() {
+                    ItemStack::new("minecraft:sandstone", 64)
+                } else {
+                    let slot = usize::try_from(request["slot"].as_u64()?).ok()?;
+                    if slot > 8 {
+                        return None;
+                    }
+                    self.inventory.get(slot)?.as_ref()?.clone()
+                };
+                let offsets = placement::offsets(4);
+                let mut host = Adapter {
+                    game: self,
+                    stack: &stack,
+                    rotation: server_rotation,
+                    block_range,
+                    verification_range,
+                };
+                let target = rules::find_placement_target(
+                    &mut host,
+                    current,
+                    &fall,
+                    height,
+                    block_range,
+                    &offsets,
+                    ahead,
+                )?;
+                Some(write_target(&target).to_string())
+            }
+            "crosshair" => {
+                let target = read_target(&request["target"])?;
+                let hit = if ahead {
+                    click(
+                        self,
+                        &target,
+                        server_rotation,
+                        block_range,
+                        verification_range,
+                    )
+                } else {
+                    let rotation = serde_json::from_value(request["rotation"].clone()).ok()?;
+                    placement::verify_click(
+                        self,
+                        &target,
+                        rotation,
+                        verification_range,
+                        placement::ClickTrace::World,
+                        placement::FailedClick::Nothing,
+                    )
+                }?;
+                Some(write_hit(hit).to_string())
+            }
+            _ => None,
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_action.rs b/crates/horizon-client/src/game/scaffold_action.rs
