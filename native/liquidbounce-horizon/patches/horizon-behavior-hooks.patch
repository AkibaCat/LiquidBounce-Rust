+    pub hit: Option<Hit>,
+}
+pub fn simulate(
+    world: &impl World,
+    mut pos: V3,
+    mut velocity: V3,
+    info: Info,
+    kind: &str,
+    owner: u32,
+    max_ticks: usize,
+) -> Simulation {
+    let mut ticks = 0;
+    let mut positions = vec![];
+    if initial_correction(kind) {
+        velocity = info.step(velocity, world.nonempty_fluid(pos));
+        ticks = 1;
+    }
+    while ticks < max_ticks {
+        if pos[1] < world.min_y() {
+            break;
+        }
+        let next = add(pos, velocity);
+        // The original resolver intentionally evaluates the block ray before entities.
+        if let Some(hit) = world
+            .block_hit(pos, next, owner)
+            .or_else(|| world.entity_hit(pos, next, owner, info.radius))
+        {
+            positions.push(hit.position());
+            return Simulation {
+                positions,
+                hit: Some(hit),
+            };
+        }
+        pos = next;
+        velocity = info.step(velocity, world.nonempty_fluid(pos));
+        positions.push(pos);
+        ticks += 1;
+    }
+    if positions.is_empty() {
+        positions.push(pos);
+    }
+    Simulation {
+        positions,
+        hit: None,
+    }
+}
+pub fn clip_aabb(from: V3, to: V3, bounds: [V3; 2], inflate: f64) -> Option<V3> {
+    let delta = sub(to, from);
+    let mut low = 0f64;
+    let mut high = 1f64;
+    for i in 0..3 {
+        let a = bounds[0][i] - inflate;
+        let b = bounds[1][i] + inflate;
+        if delta[i].abs() < 1e-12 {
+            if from[i] < a || from[i] > b {
+                return None;
+            }
+        } else {
+            let x = (a - from[i]) / delta[i];
+            let y = (b - from[i]) / delta[i];
+            low = low.max(x.min(y));
+            high = high.min(x.max(y));
+            if low > high {
+                return None;
+            }
+        }
+    }
+    Some(add(from, mul(delta, low)))
+}
+pub fn color(kind: &str, component: Option<u32>) -> u32 {
+    let (a, r, g, b) = match kind {
+        "Arrow" => (220, 255, 255, 255),
+        "Potion" => (220, 56, 93, 198),
+        "EnderPearl" => (200, 128, 0, 128),
+        "FishingBobber" => (200, 0, 255, 255),
+        "Trident" => (220, 180, 210, 255),
+        "Snowball" => (220, 192, 192, 192),
+        "Egg" => (220, 240, 234, 214),
+        "ExpBottle" => (220, 120, 230, 120),
+        "FireworkRocket" | "Fireball" => (220, 255, 165, 0),
+        "WindCharge" => (220, 180, 235, 255),
+        _ => (220, 255, 255, 255),
+    };
+    ((a as u32) << 24)
+        | component
+            .filter(|_| matches!(kind, "Arrow" | "Potion"))
+            .map_or((r << 16) | (g << 8) | b, |c| c & 0xffffff)
+}
+pub fn snapshot(result: &Simulation, owner: u32, kind: &str, real: bool) -> Value {
+    json!({"owner":owner,"kind":kind,"real":real,"positions":result.positions,"hit":result.hit.as_ref().map(|h|match h{Hit::Block{position,block,normal}=>json!({"kind":"block","position":position,"block":block,"normal":normal}),Hit::Entity{position,id,bounds}=>json!({"kind":"entity","position":position,"id":id,"bounds":bounds})})})
+}
+#[derive(Clone, Debug, PartialEq)]
+pub struct Detail {
+    pub position: V3,
+    pub crosshair: bool,
+    pub lines: Vec<String>,
+    pub visible: [bool; 2],
+    pub edge_inset: f32,
+}
+pub fn detail(
+    settings: &Trajectories,
+    result: &Simulation,
+    owner: u32,
+    owner_position: V3,
+    local: u32,
+    player_position: V3,
+    real: bool,
+    display_name: Option<&str>,
+) -> Option<Detail> {
+    if !settings.boolean("ShowDetailedInfo.Enabled") {
+        return None;
+    }
+    let &landing = result.positions.last()?;
+    let at = settings.text("ShowDetailedInfo.ShowAt");
+    let crosshair = at == "Owner" && owner == local && real;
+    let mut position = match at {
+        "Owner" if owner == local && !real => landing,
+        "Owner" => owner_position,
+        "Landing" => landing,
+        _ => result.positions[0],
+    };
+    let offset = settings.value("ShowDetailedInfo.RenderOffset");
+    for (i, k) in ["x", "y", "z"].iter().enumerate() {
+        position[i] += offset[k].as_f64().unwrap_or(0.);
+    }
+    let ticks = result.positions.len();
+    let mut lines = vec![if settings.text("ShowDetailedInfo.TimeUnit") == "Seconds" {
+        let s = format!("{:.1}", ticks as f64 * 0.05);
+        format!("{}s", s.strip_suffix(".0").unwrap_or(&s))
+    } else {
+        ticks.to_string()
+    }];
+    if settings.boolean("ShowDetailedInfo.Distance") {
+        lines.push(format!("Dist: {:.1}m", distance(player_position, landing)));
+    }
+    if settings.boolean("ShowDetailedInfo.OwnerName") && owner != local {
+        if let Some(name) = display_name {
+            lines.push(format!(
+                "Owner: {}",
+                name.chars()
+                    .filter(|c| !c.is_control() && *c != '§')
+                    .take(256)
+                    .collect::<String>()
+            ));
+        }
+    }
+    Some(Detail {
+        position,
+        crosshair,
+        lines,
+        visible: [
+            true,
+            settings.boolean("ShowDetailedInfo.RenderOffscreen.Enabled"),
+        ],
+        edge_inset: settings.number("ShowDetailedInfo.RenderOffscreen.EdgeInset") as f32,
+    })
+}
diff --git a/crates/horizon-client/src/game/trajectories_curve.rs b/crates/horizon-client/src/game/trajectories_curve.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/trajectories_curve.rs
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// CurveUtil.transformNormalized, LiquidBounce ae0eb396, CCBlueX 2015-2026.
+pub fn sample(data: &[[f32; 2]], x: f32) -> f32 {
+    if data.is_empty() {
+        return 0.;
+    }
+    if data.len() == 1 {
+        return data[0][1];
+    }
+    let first = data[0];
+    let last = data[data.len() - 1];
+    if x <= first[0] {
+        return first[1];
+    }
+    if x >= last[0] {
+        return last[1];
+    }
+    if data.len() == 2 {
+        return first[1] + (last[1] - first[1]) * ((x - first[0]) / (last[0] - first[0]));
+    }
+    if let Some(p) = data.iter().find(|p| p[0] == x) {
+        return p[1];
+    }
+    fn points(data: &[[f32; 2]], x: f32) -> ([f32; 2], [f32; 2], [f32; 2]) {
+        let adjusted = if x == data[0][0] { x + 1. } else { x };
+        let n = if adjusted == data[data.len() - 1][0] {
+            data.len() - 1
+        } else {
+            data.iter()
+                .position(|p| p[0] >= adjusted)
+                .unwrap_or(data.len() - 1)
+        };
+        (
+            data[n.saturating_sub(2)],
+            data[n.saturating_sub(1)],
+            data[n],
+        )
+    }
+    fn controls(a: [f32; 2], b: [f32; 2], c: [f32; 2]) -> ([f32; 2], [f32; 2]) {
+        let dist = |p: [f32; 2], q: [f32; 2]| {
+            ((p[0] - q[0]) * (p[0] - q[0]) + (p[1] - q[1]) * (p[1] - q[1])).sqrt()
+        };
+        let d01 = dist(a, b);
+        let d12 = dist(b, c);
+        let total = d01 + d12;
+        if total == 0. {
+            return (b, b);
+        }
+        let fa = 0.4 * d01 / total;
+        let fb = 0.4 * d12 / total;
+        (
+            std::array::from_fn(|i| b[i] - (c[i] - a[i]) * fa),
+            std::array::from_fn(|i| b[i] + (c[i] - a[i]) * fb),
+        )
+    }
+    let (prev, p, next) = points(data, x);
+    let t = if x == next[0] {
+        1.
+    } else if next[0] - p[0] == 0. {
+        0.
+    } else {
+        ((x - p[0]) / (next[0] - p[0])).clamp(0., 1.)
+    };
+    let p1 = controls(prev, p, next).1;
+    let p2 = if let Some(n) = data.iter().position(|v| v[0] > next[0]) {
+        let segment = data[n - 1];
+        let after = data[n];
+        let (a, b, c) = points(data, segment[0] + (after[0] - segment[0]));
+        controls(a, b, c).0
+    } else {
+        next
+    };
+    let t2 = t * t;
+    let t3 = t2 * t;
+    let mt = 1. - t;
+    let mt2 = mt * mt;
+    let mt3 = mt2 * mt;
+    mt3 * p[1] + 3. * mt2 * t * p1[1] + 3. * mt * t2 * p2[1] + t3 * next[1]
+}
