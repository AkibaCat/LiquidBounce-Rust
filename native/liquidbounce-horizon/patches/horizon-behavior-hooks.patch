diff --git a/crates/horizon-client/src/game/auto_walk_world.rs b/crates/horizon-client/src/game/auto_walk_world.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/auto_walk_world.rs
