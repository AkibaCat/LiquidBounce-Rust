@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+override FRAME_LINEAR: bool = false;
+struct MeshOut {@builtin(position) position:vec4<f32>,@location(0) color:vec4<f32>,@location(1) radial:vec4<f32>}
+@vertex fn mesh(@location(0) clip:vec4<f32>,@location(1) color:vec4<f32>,@location(2) radial:vec4<f32>)->MeshOut{var o:MeshOut;o.position=clip;o.color=color;o.radial=radial;return o;}
+@fragment fn capture(i:MeshOut)->@location(0) vec4<f32>{return i.color;}
+@fragment fn plain(i:MeshOut)->@location(0) vec4<f32>{
+    var c=i.color;
+    let dist=length(i.radial.xy);let dd=fwidth(dist);let aa=max(dd,0.0001);
+    // circle/rounded_rect.fsh with CornerRadius=(1,1), StrokeWidth=2 pixels.
+    if i.radial.z>1.5 {let d=dist-1.0;let w=2.0*dd;let edge=1.0-smoothstep(-dd,0.0,d);let band=smoothstep(-w-dd,-w+dd,d);c.a*=edge*band;if c.a<0.001{discard;}}
+    // gradient_circle.fsh: inner radius 0, transparent inner colour.
+    else if i.radial.z>0.5 {let coverage=1.0-smoothstep(-aa,0.0,dist-1.0);if coverage<=0.001{discard;}c=c*clamp(dist,0.0,1.0);c.a*=coverage;if c.a<=0.001{discard;}}
+    if FRAME_LINEAR{return vec4(pow(max(c.rgb,vec3(0.0)),vec3(2.2)),c.a);}return c;
+}
+struct ScreenOut {@builtin(position) position:vec4<f32>,@location(0) uv:vec2<f32>}
+fn screen_vertex(i:u32)->ScreenOut{let p=array<vec2<f32>,3>(vec2(-1.0,-1.0),vec2(3.0,-1.0),vec2(-1.0,3.0))[i];var o:ScreenOut;o.position=vec4(p.x,-p.y,0.0,1.0);o.uv=p*0.5+0.5;return o;}
+@vertex fn screen(@builtin(vertex_index) i:u32)->ScreenOut{return screen_vertex(i);}
+@vertex fn composite_screen(@builtin(vertex_index) i:u32)->ScreenOut{var o=screen_vertex(i);o.position.y = -o.position.y;return o;}
+@group(0) @binding(3) var styled:texture_2d<f32>;
+@fragment fn composite(i:ScreenOut)->@location(0) vec4<f32>{let size=textureDimensions(styled);let p=clamp(vec2<i32>(i.uv*vec2<f32>(size)),vec2(0),vec2<i32>(size)-1);var c=textureLoad(styled,p,0);if FRAME_LINEAR{c=vec4(pow(max(c.rgb,vec3(0.0)),vec3(2.2)),c.a);}return c;}
