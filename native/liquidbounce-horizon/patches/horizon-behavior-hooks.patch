@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Agent Jump.kt, including walking back and landing duration.
+use crate::navigation::{geometry::Vec3, walk::costs::Costs};
+#[derive(Clone, Debug)]
+pub struct Jump {
+    pub run_up: Vec3,
+    pub takeoff: i32,
+    pub jumps: bool,
+    pub air_ticks: i32,
+    pub margin: f64,
+    pub hops: i32,
+    pub aim: Vec3,
+}
+impl Jump {
+    pub const RUN_UP_TOLERANCE: f64 = 0.15;
+    pub fn ticks(&self, from: Vec3) -> f64 {
+        let dx = self.run_up.x - from.x;
+        let dz = self.run_up.z - from.z;
+        let back = (dx * dx + dz * dz).sqrt();
+        let back_ticks = if back > Self::RUN_UP_TOLERANCE {
+            back * Costs::WALK + 4.0
+        } else {
+            0.0
+        };
+        back_ticks + f64::from(self.takeoff) + f64::from(self.air_ticks) + 2.0
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk_jump/jump_targets.rs b/crates/horizon-client/src/navigation/walk_jump/jump_targets.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_jump/jump_targets.rs
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent JumpTargets.kt. Callbacks run immediately on the same Terrain.
+use crate::navigation::{
+    geometry::{BlockPos, java_max, java_min},
+    simulation::motion_traits::MotionTraits,
+    terrain::{Terrain, TerrainLevel, TerrainState},
+};
+use std::sync::OnceLock;
+const DX: [i32; 8] = [1, -1, 0, 0, 1, 1, -1, -1];
+const DZ: [i32; 8] = [0, 0, 1, -1, 1, -1, 1, -1];
+#[derive(Clone, Debug)]
+pub struct JumpTargets {
+    traits: MotionTraits,
+    extra_height: f64,
+    max_rise: f64,
+    reach_scale: f64,
+}
+#[derive(Clone, Copy)]
+struct Offset {
+    x: i32,
+    z: i32,
+    distance: f64,
+}
+impl JumpTargets {
+    pub fn new(traits: MotionTraits) -> Self {
+        let default = MotionTraits::default();
+        let extra_height = traits.jump_height - default.jump_height;
+        Self {
+            traits,
+            extra_height,
+            max_rise: 1.25 + extra_height,
+            reach_scale: java_max(
+                1.0,
+                f64::from(traits.walking_speed) / f64::from(default.walking_speed),
+            ),
+        }
+    }
+    pub fn lift(&self, upward: f64) -> f64 {
+        MotionTraits::rise(java_max(upward, self.traits.jump_power)) - self.traits.jump_height
+    }
+    pub fn for_each<
+        B: TerrainState,
+        L: TerrainLevel<B>,
+        F: FnMut(&mut Terrain<B, L>, i32, i32, i32, f64) -> bool,
+    >(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        height: f64,
+        max_drop: i32,
+        sink: &mut F,
+    ) {
+        self.for_each_options(t, from, height, max_drop, max_drop, 0.0, false, sink);
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn for_each_options<
+        B: TerrainState,
+        L: TerrainLevel<B>,
+        F: FnMut(&mut Terrain<B, L>, i32, i32, i32, f64) -> bool,
+    >(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        height: f64,
+        max_drop: i32,
+        bounce_drop: i32,
+        upward: f64,
+        around: bool,
+        sink: &mut F,
+    ) {
+        let BlockPos { x, y, z } = from;
+        let lift = self.lift(upward);
+        let bouncing = lift > 0.0;
+        if !bouncing && !self.is_edge(t, x, y, z, height) {
+            return;
+        }
+        let rises = self.max_rise + lift;
+        let max_up = rises.ceil() as i32;
+        let farthest = if bouncing { 14.0 } else { 8.0 };
+        for offset in offsets() {
+            if offset.distance > farthest {
+                return;
+            }
+            let tx = x.wrapping_add(offset.x);
+            let tz = z.wrapping_add(offset.z);
+            for ty in (y.wrapping_sub(max_drop.max(bounce_drop))..=y.wrapping_add(max_up)).rev() {
+                let pos = BlockPos::new(tx, ty, tz);
+                if t.is_water(pos) {
+                    continue;
+                }
+                let stand = t.stand_height(pos);
+                let top = if stand.is_nan() {
+                    self.catch_height(t, pos)
+                } else {
+                    stand
+                };
+                let rise = top - height;
+                let in_range = !top.is_nan()
+                    && rise <= rises
+                    && (ty >= y.wrapping_sub(max_drop) || t.restitution(tx, top, tz) > 0.0);
+                if !in_range
+                    || !self.is_jumped_to(t, from, height, *offset, ty, rise, bouncing, around)
+                {
+                    continue;
+                }
+                if !sink(t, tx, ty, tz, top) {
+                    return;
+                }
+            }
+        }
+    }
+    #[allow(clippy::too_many_arguments)]
+    fn is_jumped_to<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        height: f64,
+        offset: Offset,
+        ty: i32,
+        rise: f64,
+        bouncing: bool,
+        around: bool,
+    ) -> bool {
+        if self.walk_reaches(t, from, offset, ty.wrapping_sub(from.y)) {
+            false
+        } else if bouncing {
+            ty > from.y || self.crosses_gap(t, from, height, offset)
+        } else {
+            offset.distance <= self.max_reach(rise)
+                && self.leaves_over_gap(t, from, height, offset, ty, around)
+        }
+    }
+    fn catch_height<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+    ) -> f64 {
+        if t.is_climbable(p) && t.has_room(p, t.height()) {
+            f64::from(p.y)
+        } else {
+            f64::NAN
+        }
+    }
+    fn is_edge<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        x: i32,
+        y: i32,
+        z: i32,
+        height: f64,
+    ) -> bool {
+        for i in 0..DX.len() {
+            if self.is_dip(
+                t,
+                BlockPos::new(x.wrapping_add(DX[i]), y, z.wrapping_add(DZ[i])),
+                height,
+            ) {
+                return true;
+            }
+        }
+        false
+    }
+    fn is_dip<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        height: f64,
+    ) -> bool {
+        let stand = t.stand_height(p);
+        t.is_open(p) && (stand.is_nan() || stand < height - 0.25)
+    }
+    fn is_gap<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        height: f64,
+    ) -> bool {
+        self.is_dip(t, p, height) && t.stand_height(p.offset(0, -1, 0)).is_nan()
+    }
+    fn leaves_over_gap<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        height: f64,
+        offset: Offset,
+        ty: i32,
+        around: bool,
+    ) -> bool {
+        let BlockPos { x, y, z } = from;
+        let steps = offset.x.abs().max(offset.z.abs()) * 10;
+        for step in 1..=steps {
+            let along = (f64::from(step) - 0.5) / f64::from(steps);
+            let cx = (f64::from(x) + 0.5 + f64::from(offset.x) * along).floor() as i32;
+            let cz = (f64::from(z) + 0.5 + f64::from(offset.z) * along).floor() as i32;
+            if cx != x || cz != z {
+                let p = BlockPos::new(cx, y, cz);
+                return cx == x.wrapping_add(offset.x) && cz == z.wrapping_add(offset.z)
+                    || self.is_gap(t, p, height)
+                    || ty >= y && self.is_dip(t, p, height)
+                    || around
+                        && self.is_jumped_around(t, p, x, z)
+                        && !self.is_step(t, p, height)
+                        && (self.crosses_gap(t, from, height, offset)
+                            || self.has_gap_beside(t, p, height));
+            }
+        }
+        false
+    }
+    fn is_jumped_around<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        from_x: i32,
+        from_z: i32,
+    ) -> bool {
+        if t.is_open(p) {
+            return false;
+        }
+        let mut wall: Option<usize> = None;
+        for i in 0..4 {
+            let sx = p.x.wrapping_add(DX[i]);
+            let sz = p.z.wrapping_add(DZ[i]);
+            if (sx != from_x || sz != from_z) && !t.is_open(BlockPos::new(sx, p.y, sz)) {
+                if wall.is_some() {
+                    return false;
+                }
+                wall = Some(i);
+            }
+        }
+        wall.is_none_or(|w| {
+            p.x.wrapping_sub(from_x)
+                .wrapping_abs()
+                .wrapping_add(p.z.wrapping_sub(from_z).wrapping_abs())
+                == 1
+                && p.x
+                    .wrapping_sub(from_x)
+                    .wrapping_mul(DX[w])
+                    .wrapping_add(p.z.wrapping_sub(from_z).wrapping_mul(DZ[w]))
+                    == 0
+        })
+    }
+    fn is_step<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        height: f64,
+    ) -> bool {
+        for feet in p.y..=p.y.wrapping_add(1) {
+            let top = t.stand_height(BlockPos::new(p.x, feet, p.z));
+            if !top.is_nan() && top - height <= self.max_rise {
+                return true;
+            }
+        }
+        false
+    }
+    fn has_gap_beside<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        height: f64,
+    ) -> bool {
+        for i in 0..4 {
+            if self.is_gap(t, p.offset(DX[i], 0, DZ[i]), height) {
+                return true;
+            }
+        }
+        false
+    }
+    fn crosses_gap<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        height: f64,
+        offset: Offset,
+    ) -> bool {
+        let BlockPos { x, y, z } = from;
+        let steps = offset.x.abs().max(offset.z.abs()) * 10;
+        for step in 1..=steps {
+            let along = (f64::from(step) - 0.5) / f64::from(steps);
+            let cx = (f64::from(x) + 0.5 + f64::from(offset.x) * along).floor() as i32;
+            let cz = (f64::from(z) + 0.5 + f64::from(offset.z) * along).floor() as i32;
+            let between = (cx != x || cz != z)
+                && (cx != x.wrapping_add(offset.x) || cz != z.wrapping_add(offset.z));
+            if between && self.is_gap(t, BlockPos::new(cx, y, cz), height) {
+                return true;
+            }
+        }
+        false
+    }
+    fn walk_reaches<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        offset: Offset,
+        dy: i32,
+    ) -> bool {
+        if offset.x.abs() > 1 || offset.z.abs() > 1 {
+            false
+        } else if offset.x == 0 || offset.z == 0 {
+            dy <= 1
+        } else {
+            dy == 0
+                && t.is_open(from.offset(offset.x, 0, 0))
+                && t.is_open(from.offset(0, 0, offset.z))
+        }
+    }
+    fn max_reach(&self, rise: f64) -> f64 {
+        let climb = rise - self.extra_height;
+        let reach = if climb > 0.0 {
+            5.1
+        } else if climb > -1.0 {
+            5.8
+        } else {
+            5.8 - climb * 0.5
+        };
+        java_min(reach * self.reach_scale, 8.0)
+    }
+}
+fn offsets() -> &'static [Offset] {
+    static OFFSETS: OnceLock<Vec<Offset>> = OnceLock::new();
+    OFFSETS.get_or_init(|| {
+        let mut values = Vec::new();
+        for x in -14..=14 {
+            for z in -14..=14 {
+                let distance = f64::from(x * x + z * z).sqrt();
+                if (x != 0 || z != 0) && distance <= 14.0 {
+                    values.push(Offset { x, z, distance });
+                }
+            }
+        }
+        values.sort_by(|a, b| a.distance.total_cmp(&b.distance));
+        values
+    })
+}
diff --git a/crates/horizon-client/src/navigation/walk_jump/jumps.rs b/crates/horizon-client/src/navigation/walk_jump/jumps.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_jump/jumps.rs
@@ -0,0 +1,547 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent Jumps.kt: live and planned jumps, retained simulation pools.
+use super::{airtime::Airtime, jump::Jump, run_up::RunUp};
+use crate::navigation::{
+    geometry::{BlockPos, Vec3, java_min},
+    simulation::{
+        block_grid::SimulationState,
+        player_motion::{PlayerMotion, RESTING},
+    },
+    terrain::{Terrain, TerrainLevel},
+    walk::{
+        abilities::WalkAbilities,
+        course::{Course, CourseMotion},
+    },
+};
+#[derive(Clone, Copy, Debug)]
+pub struct AirKeys {
+    pub forward: i32,
+    pub strafe: i32,
+    pub margin: f64,
+}
+struct Estimate {
+    takeoff: i32,
+    margin: f64,
+    state: PlayerMotion,
+}
+pub struct Jumps<B: SimulationState> {
+    abilities: WalkAbilities<B>,
+    min_margin: f64,
+    course: Course,
+    motion: PlayerMotion,
+    flight: Airtime,
+    run: RunUp,
+    rest: PlayerMotion,
+    ground: Vec<PlayerMotion>,
+    pool: Vec<PlayerMotion>,
+    estimates: Vec<Estimate>,
+}
+impl<B: SimulationState> Jumps<B> {
+    pub fn new(abilities: WalkAbilities<B>) -> Self {
+        Self::new_with_holds_y_rot(abilities, false)
+    }
+    pub fn new_with_holds_y_rot(abilities: WalkAbilities<B>, holds_y_rot: bool) -> Self {
+        let motion = PlayerMotion::new(abilities.motion);
+        let rest = motion.copy();
+        Self {
+            min_margin: if abilities.risky_jumps { 0.15 } else { 0.35 },
+            course: Course::new(abilities.safe_fall),
+            flight: Airtime::new(abilities.safe_fall, abilities.risky_jumps, holds_y_rot),
+            abilities,
+            motion,
+            rest,
+            run: RunUp::default(),
+            ground: Vec::new(),
+            pool: Vec::new(),
+            estimates: Vec::new(),
+        }
+    }
+    pub fn can_sprint(&self) -> bool {
+        self.abilities.can_sprint
+    }
+    pub fn plan<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        from_height: f64,
+        to: BlockPos,
+        to_height: f64,
+        around: bool,
+    ) -> Option<Jump> {
+        self.course.set(
+            t,
+            Vec3::new(
+                f64::from(from.x) + 0.5,
+                from_height,
+                f64::from(from.z) + 0.5,
+            ),
+            to,
+            to_height,
+        );
+        if !self.abilities.risky_jumps && !self.course.is_safe(t) {
+            return None;
+        }
+        let center = self.course.behind(0.0);
+        let mut best = self.from_rest(t, center, 0);
+        if !has(&best, 0.45) {
+            let longest = self.course.run_up_length(t, 1.6);
+            let mut back = 0.3;
+            while back < longest + 0.3 && !has(&best, 0.45) {
+                best = better(
+                    best,
+                    self.from_rest(t, self.course.behind(java_min(back, longest)), 0),
+                );
+                back += 0.3;
+            }
+        }
+        if !has(&best, self.min_margin) && self.course.distance <= 6.2 {
+            best = better(best, self.hopped(t));
+        }
+        for offset in [0.3, -0.3] {
+            if has(&best, self.min_margin) {
+                break;
+            }
+            self.course.aim_beside(offset);
+            best = better(best, self.from_rest(t, center, 0));
+        }
+        if around && self.course.obstructed && !has(&best, self.min_margin) {
+            best = better(best, self.around(t, from));
+        }
+        best.filter(|j| j.margin >= self.min_margin)
+    }
+    pub fn refine<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        from_height: f64,
+        to: BlockPos,
+        to_height: f64,
+    ) -> Option<Jump> {
+        self.course.set(
+            t,
+            Vec3::new(
+                f64::from(from.x) + 0.5,
+                from_height,
+                f64::from(from.z) + 0.5,
+            ),
+            to,
+            to_height,
+        );
+        let longest = self.course.run_up_length(t, 1.6);
+        let mut best = None;
+        let mut back = 0.0;
+        while back <= longest {
+            best = better(best, self.from_rest(t, self.course.behind(back), 0));
+            back += Course::RUN_UP_STEP;
+        }
+        best.filter(|j| j.margin >= self.min_margin)
+    }
+    pub fn from_here<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        to: BlockPos,
+        to_height: f64,
+        aim: Option<Vec3>,
+    ) -> Option<Jump> {
+        self.course.set(t, state.position(), to, to_height);
+        let here = state.position();
+        let mut best = self.attempt(t, state, here, Some(y_rot), 0, i32::MAX);
+        for offset in [0.3, -0.3] {
+            self.course.aim_beside(offset);
+            best = better(best, self.attempt(t, state, here, Some(y_rot), 0, i32::MAX));
+        }
+        if let Some(aim) = aim {
+            self.course.aim_x = aim.x;
+            self.course.aim_z = aim.z;
+            best = better(best, self.attempt(t, state, here, Some(y_rot), 0, i32::MAX));
+        }
+        best
+    }
+    pub fn taking_off_now<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        to: BlockPos,
+        to_height: f64,
+    ) -> Option<Jump> {
+        self.course.set(t, state.position(), to, to_height);
+        self.motion.copy_from(state);
+        self.run_tick(t, y_rot, true);
+        if self.motion.on_ground {
+            return None;
+        }
+        self.flight
+            .jump(
+                t,
+                &mut self.course,
+                &mut self.motion,
+                self.abilities.can_sprint,
+                state.position(),
+                0,
+                true,
+                0,
+            )
+            .filter(|j| j.margin >= 0.45)
+    }
+    pub fn last_from_here<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        to: BlockPos,
+        to_height: f64,
+    ) -> Option<Jump> {
+        self.course.set(t, state.position(), to, to_height);
+        self.pool.append(&mut self.ground);
+        self.motion.copy_from(state);
+        self.run_to_edge(t, Some(y_rot));
+        for takeoff in (0..self.ground.len()).rev() {
+            self.motion.copy_from(&self.ground[takeoff]);
+            self.run_tick(
+                t,
+                RunUp::y_rot_at(&self.course, &self.motion, takeoff as i32, Some(y_rot)),
+                true,
+            );
+            let jump = if self.motion.on_ground {
+                None
+            } else {
+                self.flight.jump(
+                    t,
+                    &mut self.course,
+                    &mut self.motion,
+                    self.abilities.can_sprint,
+                    state.position(),
+                    takeoff as i32,
+                    true,
+                    0,
+                )
+            };
+            if jump.as_ref().is_some_and(|j| j.margin >= self.min_margin) {
+                return jump;
+            }
+        }
+        None
+    }
+    pub fn air_keys<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        to: BlockPos,
+        to_height: f64,
+        keep_speed: bool,
+    ) -> Option<AirKeys> {
+        self.course.set(t, state.position(), to, to_height);
+        let mut best: Option<AirKeys> = None;
+        for forward in (-1..=1).rev() {
+            for strafe in [0, 1, -1] {
+                self.motion.copy_from(state);
+                self.motion.tick(
+                    t,
+                    y_rot,
+                    forward,
+                    strafe,
+                    false,
+                    self.abilities.can_sprint,
+                    false,
+                );
+                let margin = self.flight.land(
+                    t,
+                    &mut self.course,
+                    &mut self.motion,
+                    self.abilities.can_sprint,
+                );
+                if keep_speed && margin >= self.min_margin {
+                    return Some(AirKeys {
+                        forward,
+                        strafe,
+                        margin,
+                    });
+                }
+                if !margin.is_nan() && best.as_ref().is_none_or(|b| margin > b.margin + 0.02) {
+                    best = Some(AirKeys {
+                        forward,
+                        strafe,
+                        margin,
+                    });
+                }
+            }
+        }
+        best
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn take_off<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &mut PlayerMotion,
+        y_rot: Option<f32>,
+        to: BlockPos,
+        to_height: f64,
+        jump: &Jump,
+        path: &mut Vec<Vec3>,
+    ) -> bool {
+        self.course.set(t, state.position(), to, to_height);
+        self.course.aim_x = jump.aim.x;
+        self.course.aim_z = jump.aim.z;
+        self.motion.copy_from(state);
+        self.run.path = Some(Vec::new());
+        let hop_ticks = self.run.hop(
+            t,
+            &mut self.course,
+            &mut self.motion,
+            self.abilities.can_sprint,
+            jump.hops,
+        );
+        let success = hop_ticks >= 0;
+        if success {
+            let ground_ticks = jump.takeoff - hop_ticks - if jump.jumps { 0 } else { 1 };
+            for tick in 0..ground_ticks {
+                self.run_tick(
+                    t,
+                    RunUp::y_rot_at(&self.course, &self.motion, tick, y_rot),
+                    false,
+                );
+            }
+            self.run_tick(
+                t,
+                RunUp::y_rot_at(&self.course, &self.motion, ground_ticks, y_rot),
+                jump.jumps,
+            );
+            state.copy_from(&self.motion);
+        }
+        if let Some(mut added) = self.run.path.take() {
+            path.append(&mut added);
+        }
+        success
+    }
+    fn around<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+    ) -> Option<Jump> {
+        let mut best = None;
+        for spot in around_spots() {
+            let run_up = Vec3::new(
+                f64::from(from.x) + spot.x,
+                self.course.from_y,
+                f64::from(from.z) + spot.z,
+            );
+            if !self.course.can_stand_at(t, run_up) {
+                continue;
+            }
+            for offset in [0.0, 0.3, -0.3, 0.7, -0.7, 1.2, -1.2] {
+                self.course.aim_beside(offset);
+                if self.course.is_way_clear(t, run_up) {
+                    best = better(best, self.from_rest(t, run_up, 0));
+                    if has(&best, 0.45) {
+                        return best;
+                    }
+                }
+            }
+        }
+        best
+    }
+    fn hopped<L: TerrainLevel<B>>(&mut self, t: &mut Terrain<B, L>) -> Option<Jump> {
+        let runway = self.course.run_up_length(t, 8.0);
+        self.course.edge = self.course.edge_length(t);
+        for hops in 1..=2 {
+            let travel = self.run.hop_travel(
+                t,
+                &mut self.course,
+                &mut self.motion,
+                self.abilities.can_sprint,
+                runway,
+                hops,
+            );
+            let back = travel + 0.3 - self.course.edge;
+            if travel.is_nan() || back > runway {
+                return None;
+            }
+            let jump = self.from_rest(t, self.course.behind(back), hops);
+            if has(&jump, self.min_margin) {
+                return jump;
+            }
+        }
+        None
+    }
+    #[allow(clippy::wrong_self_convention)] // Name retained from Agent fromRest.
+    fn from_rest<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        run_up: Vec3,
+        hops: i32,
+    ) -> Option<Jump> {
+        // The rest object is only reset, never ticked; its sneaking stays false.
+        // The copy keeps the collider cache shared while self is borrowed.
+        self.rest.reset(t, run_up, RESTING, true, false, 0);
+        let state = self.rest.copy();
+        self.attempt(t, &state, run_up, None, hops, 4)
+    }
+    fn attempt<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        run_up: Vec3,
+        first_y_rot: Option<f32>,
+        hops: i32,
+        validations: i32,
+    ) -> Option<Jump> {
+        self.pool.append(&mut self.ground);
+        self.motion.copy_from(state);
+        let hop_ticks = self.run.hop(
+            t,
+            &mut self.course,
+            &mut self.motion,
+            self.abilities.can_sprint,
+            hops,
+        );
+        if hop_ticks < 0 {
+            return None;
+        }
+        let mut best = None;
+        if self.run_to_edge(t, first_y_rot)
+            && (self.course.target_height < self.motion.y || self.motion.delta_y > 0.0)
+        {
+            best = self.flight.jump(
+                t,
+                &mut self.course,
+                &mut self.motion,
+                self.abilities.can_sprint,
+                run_up,
+                hop_ticks + self.ground.len() as i32,
+                false,
+                hops,
+            );
+        }
+        self.estimate_takeoffs(t, first_y_rot);
+        for i in 0..self.estimates.len().min(validations.max(0) as usize) {
+            self.motion.copy_from(&self.estimates[i].state);
+            let takeoff = self.estimates[i].takeoff;
+            if let Some(jump) = self.flight.jump(
+                t,
+                &mut self.course,
+                &mut self.motion,
+                self.abilities.can_sprint,
+                run_up,
+                hop_ticks + takeoff,
+                true,
+                hops,
+            ) {
+                let good = jump.margin >= 0.45;
+                best = better(best, Some(jump));
+                if good {
+                    break;
+                }
+            }
+        }
+        // Original keeps estimates referencing the returned pool objects until
+        // the next estimateTakeoffs clears them. Rust moves them after use.
+        self.pool.extend(self.estimates.drain(..).map(|e| e.state));
+        best
+    }
+    fn run_to_edge<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        first_y_rot: Option<f32>,
+    ) -> bool {
+        for tick in 0..16 {
+            let snapshot = self.snapshot();
+            self.ground.push(snapshot);
+            self.run_tick(
+                t,
+                RunUp::y_rot_at(&self.course, &self.motion, tick, first_y_rot),
+                false,
+            );
+            if self.motion.horizontal_collision && self.motion.horizontal_speed() < 0.01 {
+                return false;
+            }
+            if !self.motion.on_ground {
+                return true;
+            }
+        }
+        false
+    }
+    fn estimate_takeoffs<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        first_y_rot: Option<f32>,
+    ) {
+        self.estimates.clear();
+        for takeoff in 0..self.ground.len() {
+            self.motion.copy_from(&self.ground[takeoff]);
+            self.run_tick(
+                t,
+                RunUp::y_rot_at(&self.course, &self.motion, takeoff as i32, first_y_rot),
+                true,
+            );
+            let margin = if self.motion.on_ground {
+                f64::NAN
+            } else {
+                self.course.estimate(CourseMotion {
+                    position: self.motion.position(),
+                    delta: self.motion.delta_movement(),
+                    is_sprinting: self.motion.is_sprinting,
+                })
+            };
+            if !margin.is_nan() {
+                let state = self.snapshot();
+                self.estimates.push(Estimate {
+                    takeoff: takeoff as i32,
+                    margin,
+                    state,
+                });
+            }
+        }
+        self.estimates.sort_by(|a, b| b.margin.total_cmp(&a.margin));
+    }
+    fn snapshot(&mut self) -> PlayerMotion {
+        if let Some(mut state) = self.pool.pop() {
+            state.copy_from(&self.motion);
+            state
+        } else {
+            self.motion.copy()
+        }
+    }
+    fn run_tick<L: TerrainLevel<B>>(&mut self, t: &mut Terrain<B, L>, y_rot: f32, jump: bool) {
+        self.run.tick(
+            t,
+            &mut self.course,
+            &mut self.motion,
+            self.abilities.can_sprint,
+            y_rot,
+            jump,
+        );
+    }
+}
+fn better(a: Option<Jump>, b: Option<Jump>) -> Option<Jump> {
+    if a.is_none()
+        || b.as_ref()
+            .is_some_and(|b| b.margin > a.as_ref().expect("a exists").margin)
+    {
+        b
+    } else {
+        a
+    }
+}
+fn has(jump: &Option<Jump>, margin: f64) -> bool {
+    jump.as_ref().is_some_and(|j| j.margin >= margin)
+}
+fn around_spots() -> Vec<Vec3> {
+    let mut spots = Vec::new();
+    for x in [-0.25, 0.1, 0.5, 0.9, 1.25] {
+        for z in [-0.25, 0.1, 0.5, 0.9, 1.25] {
+            if x != 0.5 || z != 0.5 {
+                spots.push(Vec3::new(x, 0.0, z));
+            }
+        }
+    }
+    spots.sort_by(|a, b| {
+        let ad = (a.x - 0.5) * (a.x - 0.5) + (a.z - 0.5) * (a.z - 0.5);
+        let bd = (b.x - 0.5) * (b.x - 0.5) + (b.z - 0.5) * (b.z - 0.5);
+        ad.total_cmp(&bd)
+    });
+    spots
+}
diff --git a/crates/horizon-client/src/navigation/walk_jump/landings.rs b/crates/horizon-client/src/navigation/walk_jump/landings.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_jump/landings.rs
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent navigation/walk/Landings.kt.
+use super::{
+    assisted_jump::{Landing, LandingRef},
+    jump_targets::JumpTargets,
+    jumps::Jumps,
+    vector_yaw, wrap_degrees,
+};
+use crate::navigation::{
+    geometry::{BlockPos, Vec3, java_max},
+    simulation::{block_grid::SimulationState, player_motion::PlayerMotion},
+    terrain::{Terrain, TerrainLevel},
+};
+use std::sync::Arc;
+pub(crate) struct Landings {
+    pub best: Option<LandingRef>,
+    best_score: f64,
+    best_intent: f64,
+    missed: Vec<Missed>,
+}
+pub(crate) struct Missed {
+    pub pos: BlockPos,
+    pub top: f64,
+    pub intent: f64,
+}
+impl Landings {
+    fn new() -> Self {
+        Self {
+            best: None,
+            best_score: f64::MAX,
+            best_intent: f64::MAX,
+            missed: Vec::new(),
+        }
+    }
+    pub fn run_up(
+        &mut self,
+        mut run_up: impl FnMut(&Missed) -> Option<LandingRef>,
+    ) -> Option<LandingRef> {
+        self.missed.sort_by(|a, b| java_compare(a.intent, b.intent));
+        for candidate in self.missed.iter().take(3) {
+            if candidate.intent > self.best_intent - 0.5 {
+                break;
+            }
+            if let Some(landing) = run_up(candidate) {
+                return Some(landing);
+            }
+        }
+        None
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn find<B: SimulationState, L: TerrainLevel<B>>(
+        t: &mut Terrain<B, L>,
+        targets: &mut JumpTargets,
+        jumps: &mut Jumps<B>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        heading: f32,
+        max_angle: f32,
+        feet: BlockPos,
+        height: f64,
+    ) -> Self {
+        let position = state.position();
+        let mut found = Self::new();
+        targets.for_each_options(
+            t,
+            feet,
+            height,
+            4,
+            12,
+            state.delta_y,
+            true,
+            &mut |t, x, y, z, top| {
+                let angle = angle(
+                    position,
+                    Vec3::new(f64::from(x) + 0.5, top, f64::from(z) + 0.5),
+                    heading,
+                );
+                if angle > max_angle {
+                    return true;
+                }
+                let restitution = t.restitution(x, top, z);
+                let bounces = restitution > 0.0;
+                let drop = java_max(0.0, height - top);
+                // Original angle division is float, then widens for the drop.
+                let intent = f64::from(angle / max_angle) + if bounces { 0.0 } else { drop * 0.5 };
+                let pos = BlockPos::new(x, y, z);
+                if let Some(jump) = jumps.from_here(t, state, y_rot, pos, top, None) {
+                    if intent - jump.margin < found.best_score {
+                        let takes_off = bounces && drop * restitution * restitution >= 1.0;
+                        let score = intent - jump.margin;
+                        found.best = Some(Arc::new(Landing {
+                            pos,
+                            feet: top,
+                            jump,
+                            step: None,
+                            bounces,
+                            takes_off,
+                            settles: false,
+                        }));
+                        found.best_score = score;
+                        found.best_intent = intent;
+                    }
+                } else {
+                    found.missed.push(Missed { pos, top, intent });
+                }
+                true
+            },
+        );
+        found
+    }
+}
+pub(crate) fn angle(from: Vec3, to: Vec3, heading: f32) -> f32 {
+    wrap_degrees(vector_yaw(to.x - from.x, to.z - from.z) - heading).abs()
+}
+fn java_compare(a: f64, b: f64) -> std::cmp::Ordering {
+    if a.is_nan() {
+        if b.is_nan() {
+            std::cmp::Ordering::Equal
+        } else {
+            std::cmp::Ordering::Greater
+        }
+    } else if b.is_nan() {
+        std::cmp::Ordering::Less
+    } else {
+        a.total_cmp(&b)
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk_jump/leap.rs b/crates/horizon-client/src/navigation/walk_jump/leap.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk_jump/leap.rs
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent Leap.kt: live jump, momentum hops and settling approach.
+use super::{jump::Jump, jumps::Jumps, vector_yaw, wrap_degrees};
+use crate::navigation::{
+    geometry::Vec3,
+    simulation::{
+        block_grid::SimulationState,
+        player_motion::{MotionPlayer, PlayerMotion},
+    },
+    terrain::{Terrain, TerrainLevel},
+    walk::{abilities::WalkAbilities, route::Step},
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LeapInput {
+    pub forward: i32,
+    pub strafe: i32,
+    pub jump: bool,
+    pub sprint: bool,
+    pub shift: bool,
+}
+impl LeapInput {
+    pub const fn new(forward: i32, strafe: i32, jump: bool, sprint: bool, shift: bool) -> Self {
+        Self {
+            forward,
+            strafe,
+            jump,
+            sprint,
+            shift,
+        }
+    }
+}
+#[derive(Default, Clone, Debug)]
+pub struct Leap {
+    pub target: Option<Vec3>,
+    pub sprint: bool,
+    pub hopeless: bool,
+    hops_made: i32,
+    still_ticks: i32,
+    retreat: f64,
+    running: bool,
+    refined: Option<Jump>,
+}
+impl Leap {
+    pub fn tick<B: SimulationState, L: TerrainLevel<B>>(
+        &mut self,
+        player: &impl MotionPlayer,
+        t: &mut Terrain<B, L>,
+        movement_y_rot: f32,
+        step: &Step,
+        jump: &Jump,
+        abilities: &WalkAbilities<B>,
+    ) -> LeapInput {
+        let mut state = PlayerMotion::new(abilities.motion);
+        state.reset_player(t, player);
+        let mut jumps = Jumps::new(abilities.clone());
+        let input = self.decide(t, &state, movement_y_rot, step, jump, &mut jumps);
+        self.sprint = input.sprint;
+        input
+    }
+    pub fn decide<B: SimulationState, L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        step: &Step,
+        planned: &Jump,
+        jumps: &mut Jumps<B>,
+    ) -> LeapInput {
+        self.target = Some(step.feet);
+        if !state.on_ground {
+            self.still_ticks = 0;
+            self.running = false;
+            let keys = jumps.air_keys(t, state, y_rot, step.to, step.feet.y, false);
+            let forward = keys.map_or(1, |k| k.forward);
+            return LeapInput::new(
+                forward,
+                keys.map_or(0, |k| k.strafe),
+                false,
+                forward > 0,
+                false,
+            );
+        }
+        let jump = self.refined.as_ref().unwrap_or(planned).clone();
+        let ready = self.is_ready(state, self.stop(&jump));
+        let across_gap = horizontal_distance_sqr(step.feet, state.x, state.z) > 4.0
+            && faces(state, y_rot, step.feet);
+        let take_off = if across_gap {
+            jumps.taking_off_now(t, state, y_rot, step.to, step.feet.y)
+        } else {
+            None
+        };
+        if let Some(take_off) = take_off {
+            self.target = Some(take_off.aim);
+            return LeapInput::new(1, 0, true, jumps.can_sprint(), false);
+        }
+        let now = jumps
+            .from_here(t, state, y_rot, step.to, step.feet.y, Some(jump.aim))
+            .filter(|it| ready || self.running || it.margin >= 0.35);
+        if let Some(now) = &now
+            && !self.running
+            && !faces(state, y_rot, step.feet)
+        {
+            self.target = Some(now.aim);
+            return self.approach(t, state, y_rot, state.position(), now.aim);
+        }
+        self.running = now.is_some();
+        if let Some(now) = now {
+            self.target = Some(now.aim);
+            return LeapInput::new(
+                1,
+                0,
+                now.jumps && now.takeoff == 0,
+                jumps.can_sprint(),
+                false,
+            );
+        }
+        if self.hops_made < jump.hops && (self.hops_made > 0 || ready) {
+            self.hops_made += 1;
+            return LeapInput::new(1, 0, true, jumps.can_sprint(), false);
+        }
+        self.hops_made = 0;
+        if ready && jump.hops == 0 {
+            self.move_run_up(t, step, &jump, jumps);
+        }
+        self.approach(
+            t,
+            state,
+            y_rot,
+            self.stop(self.refined.as_ref().unwrap_or(planned)),
+            step.feet,
+        )
+    }
+    fn is_ready(&mut self, state: &PlayerMotion, stop: Vec3) -> bool {
+        self.still_ticks = if state.horizontal_speed() < 0.03 {
+            self.still_ticks.wrapping_add(1)
+        } else {
+            0
+        };
+        let at_stop = horizontal_distance_sqr(stop, state.x, state.z)
+            < Jump::RUN_UP_TOLERANCE * Jump::RUN_UP_TOLERANCE;
+        self.still_ticks > 0 && (at_stop || self.still_ticks >= 5)
+    }
+    fn move_run_up<B: SimulationState, L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        step: &Step,
+        jump: &Jump,
+        jumps: &mut Jumps<B>,
+    ) {
+        if self.refined.is_none() {
+            self.refined = jumps
+                .refine(t, step.from, jump.run_up.y, step.to, step.feet.y)
+                .filter(|it| {
+                    it.run_up.distance_sqr(jump.run_up)
+                        > Jump::RUN_UP_TOLERANCE * Jump::RUN_UP_TOLERANCE
+                });
+            if self.refined.is_some() {
+                return;
+            }
+        }
+        self.hopeless = self.retreat >= 0.5;
+        self.retreat = (self.retreat + 0.1).min(0.5);
+    }
+    fn stop(&self, jump: &Jump) -> Vec3 {
+        let run_up = jump.run_up;
+        let distance = 0.05 + self.retreat;
+        let dx = jump.aim.x - run_up.x;
+        let dz = jump.aim.z - run_up.z;
+        let length = (dx * dx + dz * dz).sqrt();
+        if length < 1.0e-6 {
+            return run_up;
+        }
+        Vec3::new(
+            run_up.x - dx / length * distance,
+            run_up.y,
+            run_up.z - dz / length * distance,
+        )
+    }
+    fn approach<B: SimulationState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        state: &PlayerMotion,
+        y_rot: f32,
+        stop: Vec3,
+        look: Vec3,
+    ) -> LeapInput {
+        let mut probe = state.copy();
+        let mut best = LeapInput::new(0, 0, false, false, false);
+        let mut best_score = f64::MAX;
+        for sneak in [false, true] {
+            for forward in -1..=1 {
+                for strafe in -1..=1 {
+                    probe.copy_from(state);
+                    let input = LeapInput::new(forward, strafe, false, false, sneak);
+                    let score = Self::rest_distance_sqr(t, &mut probe, y_rot, input, stop, look);
+                    if score < best_score - 1.0e-4 {
+                        best_score = score;
+                        best = input;
+                    }
+                }
+            }
+        }
+        best
+    }
+    fn rest_distance_sqr<B: SimulationState, L: TerrainLevel<B>>(
+        t: &mut Terrain<B, L>,
+        probe: &mut PlayerMotion,
+        y_rot: f32,
+        input: LeapInput,
+        stop: Vec3,
+        look: Vec3,
+    ) -> f64 {
+        for tick in 0..8 {
+            let held = tick < 2;
+            let tick_y_rot = if tick == 0 {
+                y_rot
+            } else {
+                vector_yaw(look.x - probe.x, look.z - probe.z)
+            };
+            probe.tick(
+                t,
+                tick_y_rot,
+                if held { input.forward } else { 0 },
+                if held { input.strafe } else { 0 },
+                false,
+                false,
+                held && input.shift,
+            );
+            if !probe.on_ground {
+                return 100.0 - f64::from(tick);
+            }
+        }
+        horizontal_distance_sqr(stop, probe.x, probe.z)
+    }
+}
+pub(crate) fn horizontal_distance_sqr(point: Vec3, x: f64, z: f64) -> f64 {
+    let dx = point.x - x;
+    let dz = point.z - z;
+    dx * dx + dz * dz
+}
+fn faces(state: &PlayerMotion, y_rot: f32, aim: Vec3) -> bool {
+    wrap_degrees(vector_yaw(aim.x - state.x, aim.z - state.z) - y_rot).abs() <= 15.0
+}
