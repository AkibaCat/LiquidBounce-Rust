+        let model_pipeline=device.create_render_pipeline(&wgpu::RenderPipelineDescriptor{label:Some("BlockESP real models"),layout:Some(entity_layout),vertex:wgpu::VertexState{module:&model_shader,entry_point:Some("model"),compilation_options:Default::default(),buffers:&[Some(wgpu::VertexBufferLayout{array_stride:28,step_mode:wgpu::VertexStepMode::Vertex,attributes:&attributes})]},primitive:wgpu::PrimitiveState{cull_mode:None,..Default::default()},depth_stencil:None,multisample:Default::default(),fragment:Some(wgpu::FragmentState{module:&model_shader,entry_point:Some("capture"),compilation_options:Default::default(),targets:&[Some(FORMAT.into())]}),multiview_mask:None,cache:None});
+        Self {
+            model_pipeline,model_pending:None,
+            layout,
+            pipelines,
+            capture,
+            plain,
+            composite,
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor::default()),
+            targets: None,
+            pending: None,
