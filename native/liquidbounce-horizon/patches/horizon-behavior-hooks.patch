+    fn client_item_scroller_wall_time() -> i64 {
+        match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
+            Ok(elapsed) => elapsed.as_millis() as i64,
+            Err(error) => (error.duration().as_millis() as i64).wrapping_neg(),
