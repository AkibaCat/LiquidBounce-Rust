@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent Course.kt. Physics input is a value capture, and world
+//! operations receive Terrain explicitly so Jumps can own all its work state.
+use crate::navigation::{
+    aabb::Aabb,
+    geometry::{BlockPos, Vec3, java_min},
+    terrain::{Terrain, TerrainLevel, TerrainState},
+};
+
+#[derive(Clone, Copy, Debug)]
+pub struct CourseMotion {
+    pub position: Vec3,
+    pub delta: Vec3,
+    pub is_sprinting: bool,
+}
+#[derive(Clone, Debug)]
+pub struct Course {
+    pub from_x: f64,
+    pub from_y: f64,
+    pub from_z: f64,
+    pub target: BlockPos,
+    pub target_x: f64,
+    pub target_z: f64,
+    pub target_height: f64,
+    pub catches: bool,
+    pub dir_x: f64,
+    pub dir_z: f64,
+    pub distance: f64,
+    pub aim_x: f64,
+    pub aim_z: f64,
+    pub edge: f64,
+    pub obstructed: bool,
+    safe_fall: i32,
+}
+impl Course {
+    pub const RUN_UP_STEP: f64 = 0.1;
+    pub const MAX_AIR_TICKS: i32 = 60;
+    pub const MAX_BELOW: f64 = 4.0;
+    pub const LANDING_PROBE: f64 = 1.0e-4;
+    pub const HALF_BLOCK: f64 = 0.5;
+    pub const AIR_ACCELERATION: f64 = (0.02_f32 * 0.98_f32) as f64;
+    pub const SPRINT_AIR_ACCELERATION: f64 = (0.025999999_f32 * 0.98_f32) as f64;
+    pub fn new(safe_fall: i32) -> Self {
+        Self {
+            from_x: 0.0,
+            from_y: 0.0,
+            from_z: 0.0,
+            target: BlockPos::default(),
+            target_x: 0.0,
+            target_z: 0.0,
+            target_height: 0.0,
+            catches: false,
+            dir_x: 0.0,
+            dir_z: 0.0,
+            distance: 0.0,
+            aim_x: 0.0,
+            aim_z: 0.0,
+            edge: f64::MAX,
+            obstructed: false,
+            safe_fall,
+        }
+    }
+    pub fn set<B: TerrainState, L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: Vec3,
+        to: BlockPos,
+        to_height: f64,
+    ) {
+        self.from_x = from.x;
+        self.from_y = from.y;
+        self.from_z = from.z;
+        self.target = to;
+        self.target_x = f64::from(to.x) + 0.5;
+        self.target_z = f64::from(to.z) + 0.5;
+        self.target_height = to_height;
+        self.catches = t.is_climbable(to);
+        self.aim_x = self.target_x;
+        self.aim_z = self.target_z;
+        self.edge = f64::MAX;
+        self.obstructed = false;
+        self.dir_x = self.target_x - from.x;
+        self.dir_z = self.target_z - from.z;
+        self.distance = length(self.dir_x, self.dir_z);
+        if self.distance > 1.0e-6 {
+            self.dir_x /= self.distance;
+            self.dir_z /= self.distance;
+        }
+    }
+    pub fn aim_beside(&mut self, offset: f64) {
+        self.aim_x = self.target_x - self.dir_z * offset;
+        self.aim_z = self.target_z + self.dir_x * offset;
+    }
+    pub fn behind(&self, distance: f64) -> Vec3 {
+        Vec3::new(
+            self.from_x - self.dir_x * distance,
+            self.from_y,
+            self.from_z - self.dir_z * distance,
+        )
+    }
+    pub fn is_way_clear<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        run_up: Vec3,
+    ) -> bool {
+        let samples = (length(self.aim_x - run_up.x, self.aim_z - run_up.z) / 0.25).ceil() as i32;
+        for sample in 1..samples {
+            let along = f64::from(sample) / f64::from(samples);
+            let y = lerp(along, self.from_y, self.target_height) + 0.5;
+            let b = t.body_box(Vec3::new(
+                lerp(along, run_up.x, self.aim_x),
+                y,
+                lerp(along, run_up.z, self.aim_z),
+            ));
+            if !t.is_clear(Aabb::new(b.min, Vec3::new(b.max.x, b.max.y - 0.5, b.max.z))) {
+                return false;
+            }
+        }
+        true
+    }
+    pub fn run_up_length<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        max: f64,
+    ) -> f64 {
+        let mut distance = 0.0;
+        while distance + Self::RUN_UP_STEP <= max
+            && self.can_stand_at(t, self.behind(distance + Self::RUN_UP_STEP))
+        {
+            distance += Self::RUN_UP_STEP;
+        }
+        distance
+    }
+    pub fn can_stand_at<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        feet: Vec3,
+    ) -> bool {
+        t.is_supported(feet) && t.is_clear(t.body_box(feet))
+    }
+    pub fn edge_length<B: TerrainState, L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>) -> f64 {
+        let mut distance = 0.0;
+        while distance + Self::RUN_UP_STEP <= 1.5
+            && t.is_supported(self.behind(-(distance + Self::RUN_UP_STEP)))
+        {
+            distance += Self::RUN_UP_STEP;
+        }
+        distance
+    }
+    pub fn estimate(&self, motion: CourseMotion) -> f64 {
+        let Vec3 {
+            mut x,
+            mut y,
+            mut z,
+        } = motion.position;
+        let Vec3 {
+            x: mut dx,
+            y: mut dy,
+            z: mut dz,
+        } = motion.delta;
+        let acceleration = if motion.is_sprinting {
+            Self::SPRINT_AIR_ACCELERATION
+        } else {
+            Self::AIR_ACCELERATION
+        };
+        for _ in 0..Self::MAX_AIR_TICKS {
+            let tx = self.target_x - x;
+            let tz = self.target_z - z;
+            let len = length(tx, tz);
+            if len > 1.0e-4 {
+                let speed = (dx * tx + dz * tz) / len;
+                let push = if self.catches || !self.overshoots(len, speed, y, dy) {
+                    acceleration
+                } else {
+                    -Self::AIR_ACCELERATION
+                };
+                dx += tx / len * push;
+                dz += tz / len * push;
+            }
+            let next_y = y + dy;
+            if !self.catches
+                && dy < 0.0
+                && next_y <= self.target_height
+                && y >= self.target_height - Self::LANDING_PROBE
+            {
+                return if self.is_over(x, z) {
+                    self.margin(x + dx, z + dz)
+                } else {
+                    f64::NAN
+                };
+            }
+            x += dx;
+            y = next_y;
+            z += dz;
+            if self.catches && self.is_in_target(x, y, z) {
+                return self.margin(x, z);
+            }
+            let hits_side = dy <= 0.0 && y < self.target_height && self.is_over(x, z);
+            if hits_side || y < self.target_height - Self::MAX_BELOW {
+                return f64::NAN;
+            }
+            dx *= f64::from(0.91_f32);
+            dy = (dy - 0.08) * f64::from(0.98_f32);
+            dz *= f64::from(0.91_f32);
+        }
+        f64::NAN
+    }
+    pub fn is_over(&self, x: f64, z: f64) -> bool {
+        let half = f64::from(0.6_f32) / 2.0;
+        x > f64::from(self.target.x) - half
+            && x < f64::from(self.target.x) + 1.0 + half
+            && z > f64::from(self.target.z) - half
+            && z < f64::from(self.target.z) + 1.0 + half
+    }
+    pub fn is_in_target(&self, x: f64, y: f64, z: f64) -> bool {
+        x.floor() as i32 == self.target.x
+            && y.floor() as i32 == self.target.y
+            && z.floor() as i32 == self.target.z
+    }
+    pub fn margin(&self, x: f64, z: f64) -> f64 {
+        java_min(
+            java_min(
+                x - f64::from(self.target.x),
+                f64::from(self.target.x) + 1.0 - x,
+            ),
+            java_min(
+                z - f64::from(self.target.z),
+                f64::from(self.target.z) + 1.0 - z,
+            ),
+        )
+    }
+    pub fn overshoots(&self, remaining: f64, speed: f64, height: f64, delta_y: f64) -> bool {
+        let (mut forward, mut y, mut vertical, mut travel) = (speed, height, delta_y, 0.0);
+        for _ in 0..Self::MAX_AIR_TICKS {
+            forward += Self::SPRINT_AIR_ACCELERATION;
+            travel += forward;
+            y += vertical;
+            if travel > remaining + 0.25 {
+                return true;
+            }
+            if vertical < 0.0 && y <= self.target_height {
+                return false;
+            }
+            forward *= f64::from(0.91_f32);
+            vertical = (vertical - 0.08) * f64::from(0.98_f32);
+        }
+        false
+    }
+    pub fn is_safe<B: TerrainState, L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>) -> bool {
+        let mut travelled = Self::HALF_BLOCK;
+        while travelled < self.distance - Self::HALF_BLOCK {
+            let x = (self.from_x + self.dir_x * travelled).floor() as i32;
+            let z = (self.from_z + self.dir_z * travelled).floor() as i32;
+            if !self.catches_fall(t, x, self.from_y.floor() as i32, z) {
+                return false;
+            }
+            travelled += 0.5;
+        }
+        true
+    }
+    fn catches_fall<B: TerrainState, L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        x: i32,
+        top: i32,
+        z: i32,
+    ) -> bool {
+        for y in (top
+            .wrapping_sub(self.safe_fall)
+            .wrapping_sub(1)
+            .max(t.min_y())..=top)
+            .rev()
+        {
+            let p = BlockPos::new(x, y, z);
+            let stand = t.stand_height(p);
+            if t.is_water(p) {
+                return true;
+            }
+            if !stand.is_nan() {
+                return self.from_y - stand <= f64::from(self.safe_fall);
+            }
+            if !t.is_passable(p) {
+                return true;
+            }
+        }
+        false
+    }
+}
+fn length(x: f64, z: f64) -> f64 {
+    (x * x + z * z).sqrt()
+}
+fn lerp(alpha: f64, from: f64, to: f64) -> f64 {
+    from + alpha * (to - from)
+}
diff --git a/crates/horizon-client/src/navigation/walk/mod.rs b/crates/horizon-client/src/navigation/walk/mod.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/mod.rs
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Minecraft Agent 0abf69ac walk source units. The complete AutoWalk remains
+//! unregistered until route generation, control and native binding are complete.
+pub mod abilities;
+pub mod changes;
+pub mod costs;
+pub mod course;
+pub mod nodes;
+pub mod moves;
+pub mod parkour;
+pub mod route;
+pub mod route_search;
+pub mod straight_walk;
+pub mod water;
+
+use super::terrain::TerrainState;
+/// Live registry/state facts used by the original walk and simulation sources.
+/// Implementations must expose the real block values rather than infer them
+/// from a navigation collision shape (which may represent an opened door).
+pub trait WalkState: TerrainState {
+    fn is_air(&self) -> bool;
+    fn can_be_replaced(&self) -> bool;
+    fn is_falling(&self) -> bool;
+    fn is_slime(&self) -> bool;
+    fn friction(&self) -> f32;
+    fn speed_factor(&self) -> f32;
+    fn jump_factor(&self) -> f32;
+}
diff --git a/crates/horizon-client/src/navigation/walk/moves.rs b/crates/horizon-client/src/navigation/walk/moves.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/moves.rs
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Agent Moves.kt. The sink executes in place so Step construction and search
+//! filters observe the same interleaved Terrain cache queries as the source.
+use super::{
+    abilities::WalkAbilities,
+    changes::Changes,
+    costs::Costs,
+    nodes::{DX, DZ, Nodes},
+    parkour::Parkour,
+    route::{Move, Step},
+};
+use crate::navigation::{
+    geometry::{BlockPos, Vec3, java_max},
+    simulation::block_grid::SimulationState,
+    terrain::{Terrain, TerrainLevel},
+    walk_jump::jump::Jump,
+};
+pub struct MoveOffer<'a> {
+    pub from: BlockPos,
+    pub from_height: f64,
+    pub to: BlockPos,
+    pub movement: Move,
+    pub cost: f64,
+    pub breaks: &'a [BlockPos],
+    pub places: &'a [BlockPos],
+    pub opens: &'a [BlockPos],
+    pub jump: Option<&'a Jump>,
+}
+pub type MoveSink<'a, B, L> = dyn for<'s> FnMut(&mut Terrain<B, L>, &Nodes<B>, MoveOffer<'s>) + 'a;
+pub struct Moves<B: SimulationState> {
+    core: MoveCore<B>,
+    parkour: Parkour<B>,
+}
+struct MoveCore<B: SimulationState> {
+    nodes: Nodes<B>,
+    abilities: WalkAbilities<B>,
+    walk: f64,
+    changes: Changes,
+    opens: Vec<BlockPos>,
+    from: BlockPos,
+    from_height: f64,
+    from_stands: bool,
+    from_floor_factor: f64,
+    can_jump: bool,
+}
+impl<B: SimulationState> Moves<B> {
+    pub fn new(width: f64, abilities: WalkAbilities<B>) -> Self {
+        Self {
+            parkour: Parkour::new(abilities.clone()),
+            core: MoveCore {
+                nodes: Nodes::new(width, abilities.clone()),
+                walk: if abilities.can_sprint {
+                    Costs::SPRINT
+                } else {
+                    Costs::WALK
+                },
+                abilities,
+                changes: Changes::default(),
+                opens: Vec::new(),
+                from: BlockPos::default(),
+                from_height: 0.0,
+                from_stands: true,
+                from_floor_factor: 1.0,
+                can_jump: true,
+            },
+        }
+    }
+    pub fn nodes(&self) -> &Nodes<B> {
+        &self.core.nodes
+    }
+    pub fn step<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        from: BlockPos,
+        to: BlockPos,
+    ) -> Option<Step> {
+        let mut best: Option<Step> = None;
+        self.for_each(
+            t,
+            from,
+            &mut |t, nodes, offer| {
+                if offer.to == to
+                    && best
+                        .as_ref()
+                        .is_none_or(|current| offer.cost < current.cost)
+                {
+                    let feet = nodes.feet(t, to);
+                    let shift = nodes.crouches(t, from) || nodes.crouches(t, to);
+                    let edge = is_at_edge(t, nodes, from, offer.from_height, to, offer.movement);
+                    let is_under_water = nodes.is_underwater(t, to);
+                    best = Some(Step {
+                        from,
+                        to,
+                        movement: offer.movement,
+                        feet,
+                        breaks: offer.breaks.to_vec(),
+                        places: offer.places.to_vec(),
+                        opens: offer.opens.to_vec(),
+                        cost: offer.cost,
+                        shift,
+                        edge,
+                        is_under_water,
+                        jump: offer.jump.cloned(),
+                    });
+                }
+            },
+            &mut |target| target == to,
+        );
+        best
+    }
+    pub fn for_each<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        node: BlockPos,
+        sink: &mut MoveSink<'_, B, L>,
+        is_jump_worth: &mut impl FnMut(BlockPos) -> bool,
+    ) {
+        let c = &mut self.core;
+        let water = c.nodes.swims(t, node);
+        let climb = c.nodes.climbs(t, node);
+        c.from = node;
+        c.changes.from = node;
+        c.from_height = c.nodes.height(t, node);
+        c.from_stands = c.nodes.stands(t, node);
+        let standing = c.from_stands || !water && !climb;
+        if c.nodes.crouches(t, node) {
+            c.crouch_moves(t, sink);
+            return;
+        }
+        let floor = c.nodes.floor_block(t, node.x, node.z, c.from_height);
+        c.from_floor_factor = if water || climb {
+            1.0
+        } else {
+            Costs::floor_factor(&floor)
+        };
+        c.can_jump = water || climb || floor.jump_factor() >= 1.0;
+        for i in 0..4 {
+            let tx = node.x.wrapping_add(DX[i]);
+            let tz = node.z.wrapping_add(DZ[i]);
+            if standing || climb {
+                c.traverse(t, sink, tx, tz, standing);
+                c.ascend(t, sink, tx, tz);
+            }
+            if standing {
+                c.fall(t, sink, tx, tz);
+                c.diagonal(
+                    t,
+                    sink,
+                    node.x.wrapping_add([1, 1, -1, -1][i]),
+                    node.z.wrapping_add([1, -1, 1, -1][i]),
+                );
+            }
+            c.swim_into(t, sink, BlockPos::new(tx, node.y, tz));
+            if water {
+                c.swim_out(t, sink, tx, tz);
+            }
+        }
+        if c.abilities.can_parkour && c.from_stands && !t.is_water(node) {
+            c.changes.clear();
+            self.parkour.for_each(
+                t,
+                node,
+                c.from_height,
+                is_jump_worth,
+                &mut |t, to, cost, jump| c.emit(t, sink, to, Move::Parkour, cost, Some(jump)),
+            );
+        }
+        c.swim_into(t, sink, node.above());
+        c.swim_into(t, sink, node.offset(0, -1, 0));
+        c.climb(t, sink);
+        if standing {
+            c.pillar(t, sink);
+            c.downward(t, sink);
+        }
+    }
+}
+include!("moves_surface.rs");
+include!("moves_actions.rs");
+include!("moves_emit.rs");
+
+fn is_at_edge<B: SimulationState, L: TerrainLevel<B>>(
+    t: &mut Terrain<B, L>,
+    nodes: &Nodes<B>,
+    from: BlockPos,
+    from_height: f64,
+    to: BlockPos,
+    movement: Move,
+) -> bool {
+    if !matches!(movement, Move::Traverse | Move::Diagonal)
+        || nodes.swims(t, from)
+        || nodes.swims(t, to)
+    {
+        return false;
+    }
+    let to_height = nodes.height(t, to);
+    if (to_height - from_height).abs() > Terrain::<B, L>::STEP_HEIGHT {
+        return false;
+    }
+    nodes.is_near_drop(t, from, from_height) || nodes.is_near_drop(t, to, to_height)
+}
diff --git a/crates/horizon-client/src/navigation/walk/moves_actions.rs b/crates/horizon-client/src/navigation/walk/moves_actions.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/moves_actions.rs
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+impl<B: SimulationState> MoveCore<B> {
+    fn fall<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+    ) {
+        let p = BlockPos::new(tx, self.from.y, tz);
+        if !self.nodes.floor_top(t, p).is_nan() || t.is_water(p) {
+            return;
+        }
+        self.changes.clear();
+        if !self.pass_or_break(t, p.above()) || !self.pass_or_break(t, p) {
+            return;
+        }
+        if self.changes.breaks.is_empty() && !self.can_cross(t, tx, tz, self.from_height) {
+            return;
+        }
+        let Some(landing) = self
+            .nodes
+            .landing(t, tx, p.y.wrapping_sub(1), tz, self.from_height)
+        else {
+            return;
+        };
+        let blocks = landing.drop.ceil() as i32;
+        let floor = self
+            .nodes
+            .floor_block(t, tx, tz, self.from_height - landing.drop);
+        let bounce = Costs::bounce(&floor, blocks);
+        let cost = self.walk * self.from_floor_factor
+            + Costs::fall(blocks)
+            + bounce
+            + f64::from(landing.damage) * Costs::HURT
+            + self.changes.break_cost;
+        self.emit(
+            t,
+            sink,
+            BlockPos::new(tx, landing.y, tz),
+            Move::Fall,
+            cost,
+            None,
+        );
+    }
+    fn pillar<L: TerrainLevel<B>>(&mut self, t: &mut Terrain<B, L>, sink: &mut MoveSink<'_, B, L>) {
+        let p = self.from;
+        if !self.can_jump || !t.is_passable(p) || !self.nodes.is_placeable(t, p) {
+            return;
+        }
+        self.changes.clear();
+        if !self.pass_or_break(t, p.offset(0, 2, 0)) {
+            return;
+        }
+        self.changes.places.push(p);
+        self.emit(
+            t,
+            sink,
+            p.above(),
+            Move::Pillar,
+            Costs::jump() + Costs::PLACE + self.changes.break_cost,
+            None,
+        );
+    }
+    fn downward<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+    ) {
+        let p = self.from.offset(0, -1, 0);
+        if t.is_passable(p) {
+            return;
+        }
+        self.changes.clear();
+        let ticks = self
+            .changes
+            .break_ticks(t, &self.nodes, &self.abilities, p, true);
+        if ticks.is_nan() || self.nodes.floor_top(t, p).is_nan() {
+            return;
+        }
+        self.changes.breaks.push(p);
+        self.emit(
+            t,
+            sink,
+            p,
+            Move::Downward,
+            ticks + Costs::BREAK_OVERHEAD + Costs::fall(1),
+            None,
+        );
+    }
+    fn swim_into<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        p: BlockPos,
+    ) {
+        if !self.nodes.swims(t, p)
+            || self.nodes.water.is_low(t, p) && !self.nodes.swims(t, self.from)
+        {
+            return;
+        }
+        self.changes.clear();
+        let sprints =
+            self.abilities.can_sprint && p.y == self.from.y && self.nodes.water.is_submerged(t, p);
+        self.emit(
+            t,
+            sink,
+            p,
+            Move::Swim,
+            if sprints {
+                Costs::SPRINT_SWIM
+            } else {
+                Costs::SWIM
+            },
+            None,
+        );
+    }
+    fn swim_out<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+    ) {
+        let p = BlockPos::new(tx, self.from.y, tz);
+        self.changes.clear();
+        if self.nodes.stands(t, p) {
+            self.emit(t, sink, p, Move::Swim, Costs::SWIM, None);
+        } else if self.nodes.stands(t, p.above()) && t.is_passable(self.from.offset(0, 2, 0)) {
+            self.emit(
+                t,
+                sink,
+                p.above(),
+                Move::Swim,
+                Costs::SWIM + Costs::jump(),
+                None,
+            );
+        }
+    }
+    fn climb<L: TerrainLevel<B>>(&mut self, t: &mut Terrain<B, L>, sink: &mut MoveSink<'_, B, L>) {
+        let p = self.from;
+        if !t.is_climbable(p) {
+            return;
+        }
+        self.changes.clear();
+        let can_climb_up = self.abilities.jump_climbs || t.climb_side(p).is_some();
+        if can_climb_up && (self.nodes.climbs(t, p.above()) || self.nodes.stands(t, p.above())) {
+            self.emit(t, sink, p.above(), Move::ClimbUp, Costs::CLIMB_UP, None);
+        }
+        if self.nodes.climbs(t, p.offset(0, -1, 0)) {
+            self.emit(
+                t,
+                sink,
+                p.offset(0, -1, 0),
+                Move::ClimbDown,
+                Costs::CLIMB_DOWN,
+                None,
+            );
+        } else if !self.from_stands && t.is_passable(p.offset(0, -1, 0)) {
+            let Some(landing) =
+                self.nodes
+                    .landing(t, p.x, p.y.wrapping_sub(1), p.z, self.from_height)
+            else {
+                return;
+            };
+            let blocks = landing.drop.ceil() as i32;
+            let floor = self
+                .nodes
+                .floor_block(t, p.x, p.z, self.from_height - landing.drop);
+            let bounce = Costs::bounce(&floor, blocks);
+            self.emit(
+                t,
+                sink,
+                BlockPos::new(p.x, landing.y, p.z),
+                Move::Fall,
+                Costs::fall(blocks) + bounce + f64::from(landing.damage) * Costs::HURT,
+                None,
+            );
+        }
+    }
+    fn crouch_moves<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+    ) {
+        self.changes.clear();
+        for (dx, dz) in DX.into_iter().zip(DZ) {
+            let p = self.from.offset(dx, 0, dz);
+            let mut top = t.stand_height(p);
+            if top.is_nan() {
+                top = t.crouch_height(p);
+            }
+            if !top.is_nan() && top - self.from_height <= Terrain::<B, L>::STEP_HEIGHT {
+                self.emit(t, sink, p, Move::Traverse, Costs::SNEAK, None);
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk/moves_emit.rs b/crates/horizon-client/src/navigation/walk/moves_emit.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/moves_emit.rs
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+impl<B: SimulationState> MoveCore<B> {
+    fn emit<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        to: BlockPos,
+        movement: Move,
+        cost: f64,
+        jump: Option<Jump>,
+    ) {
+        if t.is_bowl(to) {
+            return;
+        }
+        self.opens.clear();
+        if t.can_open_doors() {
+            let body = t.body_box(Vec3::new(
+                f64::from(self.from.x) + 0.5,
+                self.from_height,
+                f64::from(self.from.z) + 0.5,
+            ));
+            let target_y = self.nodes.height(t, to);
+            let target = t.body_box(Vec3::new(
+                f64::from(to.x) + 0.5,
+                target_y,
+                f64::from(to.z) + 0.5,
+            ));
+            t.closed_in(body.minmax(target), body, &mut self.opens);
+        }
+        let cost = cost + self.opens.len() as f64 * Costs::OPEN;
+        sink(
+            t,
+            &self.nodes,
+            MoveOffer {
+                from: self.from,
+                from_height: self.from_height,
+                to,
+                movement,
+                cost,
+                breaks: &self.changes.breaks,
+                places: &self.changes.places,
+                opens: &self.opens,
+                jump: jump.as_ref(),
+            },
+        );
+    }
+    fn walk_cost<L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        x: i32,
+        z: i32,
+        top: f64,
+        wet: bool,
+    ) -> f64 {
+        if wet {
+            Costs::SWIM
+        } else {
+            self.walk
+                * (self.from_floor_factor
+                    + Costs::floor_factor(&self.nodes.floor_block(t, x, z, top)))
+                / 2.0
+        }
+    }
+    fn is_wet<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, tx: i32, tz: i32) -> bool {
+        t.is_water(self.from) || t.is_water(BlockPos::new(tx, self.from.y, tz))
+    }
+    fn jump_cost(&self, rise: f64) -> f64 {
+        if rise <= 0.6 {
+            0.0
+        } else if self.can_jump && rise <= 1.25 {
+            Costs::jump()
+        } else {
+            f64::NAN
+        }
+    }
+    fn has_jump_room<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, tx: i32, tz: i32) -> bool {
+        t.is_passable(self.from.offset(0, 2, 0))
+            && t.is_passable(BlockPos::new(tx, self.from.y.wrapping_add(2), tz))
+    }
+    fn can_cross<L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        tx: i32,
+        tz: i32,
+        height: f64,
+    ) -> bool {
+        if !self.from_stands {
+            return true;
+        }
+        let x = f64::from(self.from.x.wrapping_add(tx)) / 2.0 + 0.5;
+        let z = f64::from(self.from.z.wrapping_add(tz)) / 2.0 + 0.5;
+        t.is_clear(t.body_box(Vec3::new(x, height, z)))
+            || t.is_clear(t.body_box(Vec3::new(x, height + Terrain::<B, L>::STEP_HEIGHT, z)))
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk/moves_surface.rs b/crates/horizon-client/src/navigation/walk/moves_surface.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/moves_surface.rs
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+impl<B: SimulationState> MoveCore<B> {
+    fn pass_or_break<L: TerrainLevel<B>>(&mut self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.changes
+            .pass_or_break(t, &self.nodes, &self.abilities, p)
+    }
+    fn traverse<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+        standing: bool,
+    ) {
+        let p = BlockPos::new(tx, self.from.y, tz);
+        self.changes.clear();
+        let wet = self.is_wet(t, tx, tz);
+        let top = t.stand_height(p);
+        if !top.is_nan() {
+            let jump = self.jump_cost(top - self.from_height);
+            let fits = jump == 0.0 || !jump.is_nan() && self.has_jump_room(t, tx, tz);
+            if fits && self.can_cross(t, tx, tz, java_max(self.from_height, top)) {
+                let cost = self.walk_cost(t, tx, tz, top, wet) + jump;
+                self.emit(t, sink, p, Move::Traverse, cost, None);
+            }
+        } else if self.nodes.climbs(t, p) {
+            let cost = self.walk_cost(t, tx, tz, f64::from(p.y), wet);
+            self.emit(t, sink, p, Move::Traverse, cost, None);
+        } else if self.nodes.crouches(t, p) {
+            if t.crouch_height(p) - self.from_height <= Terrain::<B, L>::STEP_HEIGHT {
+                self.emit(t, sink, p, Move::Traverse, Costs::SNEAK, None);
+            }
+        } else {
+            self.traverse_changing(t, sink, tx, tz, standing, wet);
+        }
+    }
+    fn traverse_changing<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+        standing: bool,
+        wet: bool,
+    ) {
+        let p = BlockPos::new(tx, self.from.y, tz);
+        if !self.pass_or_break(t, p.above()) || !self.pass_or_break(t, p) {
+            return;
+        }
+        let on_floor = standing && self.from_height <= f64::from(p.y) + 1.0e-6;
+        let mut floor = self.nodes.floor_top(t, p);
+        if floor.is_nan()
+            && self.nodes.is_placeable(t, p.offset(0, -1, 0))
+            && self
+                .changes
+                .can_place_against(t, &self.nodes, p.offset(0, -1, 0), on_floor)
+        {
+            self.changes.places.push(p.offset(0, -1, 0));
+            floor = f64::from(p.y);
+        }
+        let jump = self.jump_cost(floor - self.from_height);
+        if self.changes.breaks.is_empty() && self.changes.places.is_empty()
+            || jump.is_nan()
+            || jump > 0.0 && !self.has_jump_room(t, tx, tz)
+        {
+            return;
+        }
+        if self.changes.breaks.is_empty()
+            && !self.can_cross(t, tx, tz, java_max(self.from_height, floor))
+        {
+            return;
+        }
+        let place_cost = if self.changes.breaks.is_empty() {
+            self.abilities.bridge_ticks
+        } else {
+            Costs::PLACE
+        };
+        let cost = self.walk_cost(t, tx, tz, floor, wet)
+            + jump
+            + self.changes.break_cost
+            + self.changes.places.len() as f64 * place_cost;
+        self.emit(t, sink, p, Move::Traverse, cost, None);
+    }
+    fn diagonal<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+    ) {
+        let from = self.from;
+        let p = BlockPos::new(tx, from.y, tz);
+        self.changes.clear();
+        let top = t.stand_height(p);
+        if top.is_nan() || top - self.from_height > Terrain::<B, L>::STEP_HEIGHT {
+            return;
+        }
+        if !t.is_open(BlockPos::new(tx, from.y, from.z))
+            || !t.is_open(BlockPos::new(from.x, from.y, tz))
+            || !self.can_cross(t, tx, tz, java_max(self.from_height, top))
+        {
+            return;
+        }
+        let wet = self.is_wet(t, tx, tz);
+        let cost = f64::from(std::f32::consts::SQRT_2) * self.walk_cost(t, tx, tz, top, wet);
+        self.emit(t, sink, p, Move::Diagonal, cost, None);
+    }
+    fn ascend<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        sink: &mut MoveSink<'_, B, L>,
+        tx: i32,
+        tz: i32,
+    ) {
+        let from = self.from;
+        let p = BlockPos::new(tx, from.y.wrapping_add(1), tz);
+        self.changes.clear();
+        if !self.pass_or_break(t, from.offset(0, 2, 0)) {
+            return;
+        }
+        let top = t.stand_height(p);
+        if !top.is_nan() {
+            let jump = self.jump_cost(top - self.from_height);
+            if !jump.is_nan() && self.can_cross(t, tx, tz, top) {
+                let cost = self.walk_cost(t, tx, tz, top, false) + jump + self.changes.break_cost;
+                self.emit(t, sink, p, Move::Ascend, cost, None);
+            }
+            return;
+        }
+        let head_breaks = self.changes.breaks.len();
+        if !self.pass_or_break(t, p.above()) || !self.pass_or_break(t, p) {
+            return;
+        }
+        let mut stacked = false;
+        let mut floor = self.nodes.floor_top(t, p);
+        if floor.is_nan() && self.nodes.is_placeable(t, p.offset(0, -1, 0)) {
+            let support = self
+                .nodes
+                .is_solid(t, BlockPos::new(tx, from.y.wrapping_sub(1), tz))
+                || {
+                    stacked = self.stacks(
+                        t,
+                        BlockPos::new(tx, from.y.wrapping_sub(1), tz),
+                        head_breaks,
+                    );
+                    stacked
+                };
+            if support {
+                self.changes.places.push(p.offset(0, -1, 0));
+                floor = f64::from(p.y);
+            }
+        }
+        let jump = self.jump_cost(floor - self.from_height);
+        if jump.is_nan()
+            || self.changes.breaks.len() == head_breaks && self.changes.places.is_empty()
+        {
+            return;
+        }
+        let place_cost = if stacked
+            && !self
+                .nodes
+                .is_solid(t, BlockPos::new(tx, from.y.wrapping_sub(2), tz))
+        {
+            self.abilities.bridge_ticks
+        } else {
+            Costs::PLACE
+        };
+        let cost = self.walk_cost(t, tx, tz, floor, false)
+            + jump
+            + self.changes.break_cost
+            + self.changes.places.len() as f64 * place_cost;
+        self.emit(t, sink, p, Move::Ascend, cost, None);
+    }
+    fn stacks<L: TerrainLevel<B>>(
+        &mut self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        head_breaks: usize,
+    ) -> bool {
+        if head_breaks > 0
+            || !self.changes.breaks.is_empty()
+            || self.nodes.swims(t, self.from)
+            || self.nodes.climbs(t, self.from)
+            || self.from_height > f64::from(p.y.wrapping_add(1)) + 1.0e-6
+            || !self.nodes.is_placeable(t, p)
+        {
+            return false;
+        }
+        self.changes.places.push(p);
+        true
+    }
+}
diff --git a/crates/horizon-client/src/navigation/walk/nodes.rs b/crates/horizon-client/src/navigation/walk/nodes.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/navigation/walk/nodes.rs
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Complete Agent Nodes.kt. Terrain is passed explicitly to avoid self-borrows.
+use super::{WalkState, abilities::WalkAbilities, water::Water};
+use crate::navigation::{
+    geometry::{BlockPos, Vec3},
+    terrain::{Terrain, TerrainLevel},
+};
+
+pub const DX: [i32; 4] = [1, -1, 0, 0];
+pub const DZ: [i32; 4] = [0, 0, 1, -1];
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Landing {
+    pub y: i32,
+    pub drop: f64,
+    pub damage: i32,
+}
+pub struct Nodes<B: WalkState> {
+    pub water: Water,
+    abilities: WalkAbilities<B>,
+    can_place: bool,
+    max_damage: i32,
+    max_drop: i32,
+    half_width: f64,
+}
+impl<B: WalkState> Nodes<B> {
+    pub fn new(width: f64, abilities: WalkAbilities<B>) -> Self {
+        let max_damage = 0.max((f64::from(abilities.health - 10.0).ceil() as i32).wrapping_sub(1));
+        Self {
+            water: Water::new(abilities.can_sprint),
+            can_place: abilities.can_place && abilities.placeable_blocks > 0,
+            max_damage,
+            max_drop: abilities
+                .safe_fall
+                .wrapping_add(max_damage)
+                .max(abilities.water_fall)
+                .wrapping_add(1),
+            half_width: width / 2.0,
+            abilities,
+        }
+    }
+    pub fn is_node<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.stands(t, p) || self.swims(t, p) || self.climbs(t, p) || self.crouches(t, p)
+    }
+    pub fn is_underwater<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.swims(t, p) && self.water.is_submerged(t, p)
+    }
+    pub fn stands<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        !t.stand_height(p).is_nan()
+    }
+    pub fn swims<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.water.fits(t, p)
+    }
+    pub fn climbs<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        t.is_climbable(p) && t.has_room(p, t.height())
+    }
+    pub fn crouches<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        !self.stands(t, p) && !t.crouch_height(p).is_nan() && !t.is_water(p) && !t.is_climbable(p)
+    }
+    pub fn height<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> f64 {
+        let stand = t.stand_height(p);
+        if !stand.is_nan() {
+            stand
+        } else if self.swims(t, p) || self.climbs(t, p) {
+            f64::from(p.y)
+        } else {
+            let crouch = t.crouch_height(p);
+            if !crouch.is_nan() {
+                crouch
+            } else {
+                let floor = self.floor_top(t, p);
+                if floor.is_nan() {
+                    f64::from(p.y)
+                } else {
+                    floor
+                }
+            }
+        }
+    }
+    pub fn feet<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> Vec3 {
+        let shape = t.shape(p);
+        if shape.is_empty() || !self.climbs(t, p) {
+            Vec3::new(
+                f64::from(p.x) + 0.5,
+                self.height(t, p),
+                f64::from(p.z) + 0.5,
+            )
+        } else {
+            let b = shape.bounds().expect("nonempty ladder shape");
+            Vec3::new(
+                f64::from(p.x) + room_middle(b.min.x, b.max.x),
+                self.height(t, p),
+                f64::from(p.z) + room_middle(b.min.z, b.max.z),
+            )
+        }
+    }
+    // The negated comparison intentionally retains Kotlin's NaN top sentinel.
+    #[allow(clippy::neg_cmp_op_on_partial_ord)]
+    pub fn floor_top<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> f64 {
+        let below = p.offset(0, -1, 0);
+        if !self.is_harmless(t, below) {
+            return f64::NAN;
+        }
+        let mut top = f64::NAN;
+        for b in t.shape(below).aabbs() {
+            let box_top = f64::from(p.y.wrapping_sub(1)) + b.max.y;
+            let inside = b.min.x < 0.5 + self.half_width
+                && b.max.x > 0.5 - self.half_width
+                && b.min.z < 0.5 + self.half_width
+                && b.max.z > 0.5 - self.half_width;
+            if inside
+                && box_top >= f64::from(p.y)
+                && box_top < f64::from(p.y.wrapping_add(1))
+                && !(box_top <= top)
+            {
+                top = box_top;
+            }
+        }
+        top
+    }
+    pub fn floor_block<L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        x: i32,
+        z: i32,
+        height: f64,
+    ) -> B {
+        t.state(BlockPos::new(x, (height - 0.500001).floor() as i32, z))
+    }
+    pub fn landing<L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        x: i32,
+        top: i32,
+        z: i32,
+        height: f64,
+    ) -> Option<Landing> {
+        for y in (top.wrapping_sub(self.max_drop).max(t.min_y())..=top).rev() {
+            let p = BlockPos::new(x, y, z);
+            let stand = t.stand_height(p);
+            if self.swims(t, p) {
+                let drop = height - f64::from(y);
+                return (drop <= f64::from(self.abilities.water_fall)).then_some(Landing {
+                    y,
+                    drop,
+                    damage: 0,
+                });
+            }
+            if !stand.is_nan() {
+                let drop = height - stand;
+                let damage = 0.max((drop - f64::from(self.abilities.safe_fall)).ceil() as i32);
+                return (damage <= self.max_damage).then_some(Landing { y, drop, damage });
+            }
+            if self.climbs(t, p) {
+                return Some(Landing {
+                    y,
+                    drop: height - f64::from(y),
+                    damage: 0,
+                });
+            }
+            if !t.is_passable(p) {
+                return None;
+            }
+        }
+        None
+    }
+    pub fn is_near_drop<L: TerrainLevel<B>>(
+        &self,
+        t: &mut Terrain<B, L>,
+        p: BlockPos,
+        height: f64,
+    ) -> bool {
+        for (dx, dz) in DX.into_iter().zip(DZ) {
+            let side = p.offset(dx, 0, dz);
+            if !t.is_known(side) {
+                return true;
+            }
+            let open = t.is_open(side) && self.floor_top(t, side).is_nan() && !t.is_water(side);
+            if open
+                && self
+                    .landing(t, side.x, p.y.wrapping_sub(1), side.z, height)
+                    .map_or(1, |l| l.damage)
+                    > 0
+            {
+                return true;
+            }
+        }
+        false
+    }
+    pub fn is_harmless<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        t.is_known(p) && !t.is_hazard(p)
+    }
+    pub fn is_solid<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.is_harmless(t, p) && !t.is_passable(p)
+    }
+    pub fn is_placeable<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        self.can_place
+            && self.is_harmless(t, p)
+            && t.state(p).can_be_replaced()
+            && !self.abilities.reserved.contains(&p.packed())
+    }
+    pub fn is_dry<L: TerrainLevel<B>>(&self, t: &mut Terrain<B, L>, p: BlockPos) -> bool {
+        if t.state(p).has_liquid() || t.state(p.above()).has_liquid() {
+            return false;
+        }
+        for (dx, dz) in DX.into_iter().zip(DZ) {
+            if t.state(p.offset(dx, 0, dz)).has_liquid() {
+                return false;
+            }
+        }
+        true
+    }
+}
+fn room_middle(min: f64, max: f64) -> f64 {
+    if min > 0.0 && max >= 1.0 {
+        min / 2.0
+    } else if max < 1.0 && min <= 0.0 {
+        (max + 1.0) / 2.0
+    } else {
+        0.5
+    }
+}
