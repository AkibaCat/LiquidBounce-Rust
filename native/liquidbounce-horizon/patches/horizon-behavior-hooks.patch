+// SPDX-License-Identifier: GPL-3.0-or-later
+//! ModuleTracers: floating endpoint gradients, then original ShaderLayer's RGBA8
+//! silhouettes -> nearest rows -> Euclidean field -> style -> straight-alpha scene blend.
+use glam::{DVec3, Mat4, Vec2, Vec4};
+use std::{borrow::Cow, cell::RefCell};
+use wgpu::util::DeviceExt;
+#[derive(Clone, Copy, Debug, serde::Deserialize)]
+pub struct ColoredPoint {
+    pub position: [f64; 3],
+    pub color: [f32; 4],
+}
+#[derive(Clone, Debug, serde::Deserialize)]
+pub struct Effect {
+    pub style: usize,
+    pub params: [f32; 8],
+    pub accent: [f32; 4],
+    pub range: f32,
+    pub opacity: f32,
+}
+#[derive(Default, Debug, serde::Deserialize)]
+pub struct Frame {
+    pub quads: Vec<[ColoredPoint; 4]>,
+    pub lines: Vec<[ColoredPoint; 2]>,
+    pub effect: Option<Effect>,
+    #[serde(default="default_width")]
+    pub line_width:f32,
+}
+fn default_width()->f32{1.}
+thread_local! {static PENDING:RefCell<Option<Frame>>=const{RefCell::new(None)};}
+pub fn begin_frame(json: &str) {
+    PENDING.with_borrow_mut(|f| *f = serde_json::from_str(json).ok());
+}
+#[repr(C)]
+#[derive(Clone, Copy, Debug, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct Vertex {
+    pub clip: [f32; 4],
+    pub color: [f32; 4],
+}
+/// The original plain GL line list is one physical pixel wide; endpoint colours retain
+/// Float precision. Clip in homogeneous space before expanding, including endpoint alpha.
+pub fn vertices(frame: &Frame, projection: Mat4, camera: DVec3, size: [u32; 2]) -> Vec<Vertex> {
+    let project = |p: ColoredPoint| Vertex {
+        clip: (projection
+            * (DVec3::from_array(p.position) - camera)
+                .as_vec3()
+                .extend(1.))
+        .to_array(),
+        color: p.color,
+    };
+    let mut out = vec![];
+    for q in &frame.quads {
+        let q = q.map(project);
+        for i in [0, 1, 2, 0, 2, 3] {
+            out.push(q[i]);
+        }
+    }
+    for line in &frame.lines {
+        let mut v = line.map(project);
+        let mut a = Vec4::from_array(v[0].clip);
+        let mut b = Vec4::from_array(v[1].clip);
+        for plane in 0..2 {
+            let distance = |p: Vec4| if plane == 0 { p.w - 0.00001 } else { p.w - p.z };
+            let da = distance(a);
+            let db = distance(b);
+            if da < 0. && db < 0. {
+                a = Vec4::ZERO;
+                b = Vec4::ZERO;
+                break;
+            }
+            if (da < 0.) != (db < 0.) {
+                let t = da / (da - db);
+                let c =
+                    std::array::from_fn(|i| v[0].color[i] + (v[1].color[i] - v[0].color[i]) * t);
+                let p = a.lerp(b, t);
+                if da < 0. {
+                    a = p;
+                    v[0].color = c;
+                } else {
+                    b = p;
+                    v[1].color = c;
+                }
+            }
+        }
+        if a.w <= 0. || b.w <= 0. {
+            continue;
+        }
+        let screen = Vec2::new(size[0] as f32, size[1] as f32);
+        let d = (b.truncate().truncate() / b.w - a.truncate().truncate() / a.w) * screen;
+        if d.length_squared() == 0. {
+            continue;
+        }
+        let d = d.normalize();
+        let n = Vec2::new(-d.y, d.x) / screen * frame.line_width;
+        let mut q = [v[0], v[0], v[1], v[1]];
+        for (i, (p, sign)) in [(a, 1.), (a, -1.), (b, -1.), (b, 1.)]
+            .into_iter()
+            .enumerate()
+        {
+            q[i].clip = (p + Vec4::new(n.x * sign * p.w, n.y * sign * p.w, 0., 0.)).to_array();
+        }
+        for i in [0, 1, 2, 0, 2, 3] {
+            out.push(q[i]);
+        }
+    }
+    if frame.effect.is_some() {
+        for v in &mut out {
+            v.clip[1] = -v.clip[1];
+        }
+    }
+    out
+}
+const FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba8Unorm;
+const COMMON: &str = include_str!("breadcrumbs-shaders/effect.glsl");
+const SOURCES: [&str; 11] = [
+    include_str!("breadcrumbs-shaders/field_rows.frag"),
+    include_str!("breadcrumbs-shaders/field_columns.frag"),
+    include_str!("breadcrumbs-shaders/smooth.frag"),
+    include_str!("breadcrumbs-shaders/outline.frag"),
+    include_str!("breadcrumbs-shaders/neon.frag"),
+    include_str!("breadcrumbs-shaders/rainbow.frag"),
+    include_str!("breadcrumbs-shaders/ripple.frag"),
+    include_str!("breadcrumbs-shaders/hologram.frag"),
+    include_str!("breadcrumbs-shaders/halftone.frag"),
+    include_str!("breadcrumbs-shaders/chromatic.frag"),
+    include_str!("breadcrumbs-shaders/aura.frag"),
+];
+/// Only resource bindings and version change. Original field scans, RGB565 packing,
+/// 8-bit distance encoding, noise functions and all nine style formulas remain verbatim.
+pub fn fragment_source(index: usize) -> String {
+    let globals = "layout(std140,set=0,binding=1) uniform Globals {vec4 Clock;ivec4 CameraBlock;vec4 CameraFrac;};\n#define GameTime Clock.x\n#define CameraBlockPos CameraBlock.xyz\n#define CameraOffset CameraFrac.xyz\n";
+    let common = COMMON
+        .replace("#include <minecraft:globals.glsl>", globals)
+        .replace(
+            "layout(std140) uniform EffectData",
+            "layout(std140,set=0,binding=0) uniform EffectData",
+        );
+    let source=SOURCES[index].lines().filter(|l|!l.starts_with("#version")&&!l.starts_with("#extension")).collect::<Vec<_>>().join("\n").replace("#include <liquidbounce:effect/effect.glsl>",&common).replace("layout(std140) uniform EffectView","layout(std140,set=0,binding=2) uniform EffectView").replace("uniform sampler2D InSampler;","layout(set=0,binding=3) uniform texture2D InTexture;\nlayout(set=0,binding=4) uniform sampler InFilter;\n#define InSampler sampler2D(InTexture,InFilter)");
+    format!("#version 450\n{source}")
+}
+pub fn fragment_module(index: usize) -> Result<naga::Module, String> {
+    let source = fragment_source(index);
+    let module = naga::front::glsl::Frontend::default()
+        .parse(
+            &naga::front::glsl::Options::from(naga::ShaderStage::Fragment),
+            &source,
+        )
+        .map_err(|e| e.emit_to_string(&source))?;
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::all(),
+    )
+    .validate(&module)
+    .map_err(|e| e.to_string())?;
+    Ok(module)
+}
+struct Targets {
+    size: [u32; 2],
+    views: [wgpu::TextureView; 4],
+}
+pub struct TracerRenderer {
+    layout: wgpu::BindGroupLayout,
+    pipelines: [wgpu::RenderPipeline; 11],
+    capture: wgpu::RenderPipeline,
+    plain: wgpu::RenderPipeline,
+    composite: wgpu::RenderPipeline,
+    sampler: wgpu::Sampler,
+    targets: Option<Targets>,
+    pending: Option<(Frame, wgpu::Buffer, u32)>,
+}
+impl TracerRenderer {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat, linear: bool) -> Self {
+        let uniform = |binding| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: wgpu::ShaderStages::FRAGMENT,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        };
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("LiquidBounce ShaderLayer"),
+            entries: &[
+                uniform(0),
+                uniform(1),
+                uniform(2),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 3,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 4,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("LiquidBounce ShaderLayer"),
+            bind_group_layouts: &[Some(&layout)],
+            ..Default::default()
+        });
+        let empty = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Breadcrumbs mesh"),
+            bind_group_layouts: &[],
+            ..Default::default()
+        });
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("Breadcrumbs"),
+            source: wgpu::ShaderSource::Wgsl(include_str!("breadcrumbs.wgsl").into()),
+        });
+        let attributes = wgpu::vertex_attr_array![0=>Float32x4,1=>Float32x4];
+        let constants = [(
+            "FRAME_LINEAR",
+            f64::from(u8::from(
+                linear && format == wgpu::TextureFormat::Rgba16Float,
+            )),
+        )];
+        let make = |vertex: &str,
+                    fragment: &wgpu::ShaderModule,
+                    entry: &str,
+                    target: wgpu::TextureFormat,
+                    mesh: bool,
+                    blend: bool| {
+            let buffers = [Some(wgpu::VertexBufferLayout {
+                array_stride: 32,
+                step_mode: wgpu::VertexStepMode::Vertex,
+                attributes: &attributes,
+            })];
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("LiquidBounce Breadcrumbs"),
+                layout: Some(if mesh { &empty } else { &pipeline_layout }),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(vertex),
+                    compilation_options: Default::default(),
+                    buffers: if mesh { &buffers } else { &[] },
+                },
+                primitive: wgpu::PrimitiveState {
+                    cull_mode: None,
+                    ..Default::default()
+                },
+                depth_stencil: None,
+                multisample: Default::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: fragment,
+                    entry_point: Some(entry),
+                    compilation_options: wgpu::PipelineCompilationOptions {
+                        constants: if entry == "plain" || entry == "composite" {
+                            &constants
+                        } else {
+                            &[]
+                        },
+                        ..Default::default()
+                    },
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: target,
+                        blend: blend.then_some(wgpu::BlendState::ALPHA_BLENDING),
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let pipelines = std::array::from_fn(|i| {
+            let module =
+                fragment_module(i).unwrap_or_else(|e| panic!("LiquidBounce style {i}: {e}"));
+            let fragment = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("LiquidBounce original GLSL"),
+                source: wgpu::ShaderSource::Naga(Cow::Owned(module)),
+            });
+            make("screen", &fragment, "main", FORMAT, false, false)
+        });
+        let capture = make("mesh", &shader, "capture", FORMAT, true, true);
+        let plain = make("mesh", &shader, "plain", format, true, true);
+        let composite = make(
+            "composite_screen",
+            &shader,
+            "composite",
+            format,
+            false,
+            true,
+        );
+        Self {
+            layout,
+            pipelines,
+            capture,
+            plain,
+            composite,
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor::default()),
+            targets: None,
+            pending: None,
+        }
+    }
+    pub fn pending(&self) -> bool {
+        self.pending.is_some()
+    }
+    pub fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        projection: Mat4,
+        camera: DVec3,
+        size: [u32; 2],
+        title: bool,
+    ) {
+        self.pending = None;
+        let frame = PENDING.with_borrow_mut(Option::take);
+        let Some(frame) = frame.filter(|_| !title) else {
+            return;
+        };
+        let mesh = vertices(&frame, projection, camera, size);
+        if mesh.is_empty() {
+            return;
+        }
+        let count = mesh.len() as u32;
+        let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Breadcrumbs mesh"),
+            contents: bytemuck::cast_slice(&mesh),
+            usage: wgpu::BufferUsages::VERTEX,
+        });
+        if frame.effect.is_some() && self.targets.as_ref().is_none_or(|t| t.size != size) {
+            let views = std::array::from_fn(|_| {
+                device
+                    .create_texture(&wgpu::TextureDescriptor {
+                        label: Some("LiquidBounce RGBA8 style target"),
+                        size: wgpu::Extent3d {
+                            width: size[0],
+                            height: size[1],
+                            depth_or_array_layers: 1,
+                        },
+                        mip_level_count: 1,
+                        sample_count: 1,
+                        dimension: wgpu::TextureDimension::D2,
+                        format: FORMAT,
+                        usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                            | wgpu::TextureUsages::TEXTURE_BINDING,
+                        view_formats: &[],
+                    })
+                    .create_view(&Default::default())
+            });
+            self.targets = Some(Targets { size, views });
+        }
+        self.pending = Some((frame, buffer, count));
+    }
+    pub fn draw(
+        &mut self,
+        device: &wgpu::Device,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::TextureView,
+        game_time: f32,
+        camera: DVec3,
+        view: Mat4,
+        fov: f32,
+    ) {
+        let Some((frame, buffer, count)) = self.pending.take() else {
+            return;
+        };
+        let pass = |encoder: &mut wgpu::CommandEncoder,
+                    target: &wgpu::TextureView,
+                    pipeline: &wgpu::RenderPipeline,
+                    group: Option<&wgpu::BindGroup>,
+                    mesh: bool,
+                    clear: bool| {
+            let mut p = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("LiquidBounce Breadcrumbs"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: target,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: if clear {
+                            wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT)
+                        } else {
+                            wgpu::LoadOp::Load
+                        },
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+            p.set_pipeline(pipeline);
+            if let Some(g) = group {
+                p.set_bind_group(0, g, &[]);
+            }
+            if mesh {
+                p.set_vertex_buffer(0, buffer.slice(..));
+                p.draw(0..count, 0..1);
+            } else {
+                p.draw(0..3, 0..1);
+            }
+        };
+        let Some(effect) = frame.effect else {
+            pass(encoder, target, &self.plain, None, true, false);
+            return;
+        };
+        let targets = self.targets.as_ref().unwrap();
+        let mut data = [0f32; 16];
+        data[..8].copy_from_slice(&effect.params);
+        data[8..12].copy_from_slice(&effect.accent);
+        data[12] = effect.range;
+        data[13] = effect.opacity;
+        let effect_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectData"),
+            contents: bytemuck::cast_slice(&data),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let blocks = camera.floor().as_ivec3();
+        let offset = blocks.as_dvec3() - camera;
+        let mut globals = [0u32; 12];
+        globals[0] = game_time.to_bits();
+        globals[4] = blocks.x as u32;
+        globals[5] = blocks.y as u32;
+        globals[6] = blocks.z as u32;
+        globals[8] = (offset.x as f32).to_bits();
+        globals[9] = (offset.y as f32).to_bits();
+        globals[10] = (offset.z as f32).to_bits();
+        let globals = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Globals"),
+            contents: bytemuck::cast_slice(&globals),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let inverse = view.inverse();
+        let right = inverse.x_axis;
+        let up = inverse.y_axis;
+        let forward = -inverse.z_axis;
+        let tangent = (fov.to_radians() / 2.).tan();
+        let axes = [
+            right.to_array(),
+            up.to_array(),
+            forward.to_array(),
+            [
+                tangent * targets.size[0] as f32 / targets.size[1] as f32,
+                tangent,
+                0.,
+                0.,
+            ],
+        ];
+        let axes = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("EffectView"),
+            contents: bytemuck::cast_slice(&axes),
+            usage: wgpu::BufferUsages::UNIFORM,
+        });
+        let group = |source: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("LiquidBounce ShaderLayer"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: effect_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: globals.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: axes.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::TextureView(source),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 4,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        pass(encoder, &targets.views[0], &self.capture, None, true, true);
+        for (i, pipeline) in [0, 1, effect.style + 2].into_iter().enumerate() {
+            let group = group(&targets.views[i]);
+            pass(
+                encoder,
+                &targets.views[i + 1],
+                &self.pipelines[pipeline],
+                Some(&group),
+                false,
+                true,
+            );
+        }
+        let group = group(&targets.views[3]);
+        pass(encoder, target, &self.composite, Some(&group), false, false);
+    }
+}
diff --git a/crates/horizon-client/src/game/new_chunks.rs b/crates/horizon-client/src/game/new_chunks.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/new_chunks.rs
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::world_primitives::{PrimitiveShape, WorldPrimitives};
+use horizon_protocol::packets::play::Clientbound as C;
+use horizon_world::{
+    fluid::{FluidKind, FluidState},
+    registry::BlockStateId,
+};
+use serde_json::{Value, json};
+impl Game<'_> {
+    fn client_new_chunks_flowing(&self, id: i32) -> bool {
+        self.pack
+            .assets
+            .registry
+            .state(BlockStateId(id as u32))
+            .and_then(|b| FluidState::from_block(b).ok())
+            .is_some_and(|f| f.kind() != FluidKind::Empty && !f.is_source())
+    }
+    pub(super) fn client_new_chunks_packet(&self, packet: &C) {
+        if !self.native_window() {
+            return;
+        }
+        let input = match packet {
+            C::LevelChunkWithLight(p) => json!({"action":"chunk","pos":[p.x,p.z]}),
+            C::ForgetLevelChunk(p) => json!({"action":"forget","pos":p.pos}),
+            C::BlockUpdate(p) if self.client_new_chunks_flowing(p.state) => {
+                json!({"action":"flow","positions":[p.pos]})
+            }
+            C::SectionBlocksUpdate(p) => {
+                let [sx, sy, sz] = p.section;
+                let positions = p
+                    .changes
+                    .iter()
+                    .filter_map(|&change| {
+                        if !self.client_new_chunks_flowing((change >> 12) as i32) {
+                            return None;
+                        }
+                        let local = (change & 0xfff) as i32;
+                        Some([
+                            sx.wrapping_mul(16).wrapping_add(local >> 8 & 15),
+                            sy.wrapping_mul(16).wrapping_add(local & 15),
+                            sz.wrapping_mul(16).wrapping_add(local >> 4 & 15),
+                        ])
+                    })
+                    .collect::<Vec<_>>();
+                if positions.is_empty() {
+                    return;
+                }
+                json!({"action":"flow","positions":positions})
+            }
+            _ => return,
+        };
+        self.native_client_new_chunks(&input.to_string(), &mut String::new());
+    }
+    pub(super) fn client_new_chunks_geometry(&self, out: &mut WorldPrimitives) {
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        let input = json!({"action":"render","player":[p.position.x,p.position.y,p.position.z]})
+            .to_string();
+        let mut geometry = String::new();
+        self.native_client_new_chunks(&input, &mut geometry);
+        let Ok(Value::Array(planes)) = serde_json::from_str(&geometry) else {
+            return;
+        };
+        for p in planes {
+            let Ok(corners) = serde_json::from_value::<[[f64; 3]; 4]>(p["corners"].clone()) else {
+                continue;
+            };
+            let color = p["color"].as_u64().unwrap_or(0) as u32;
+            let outline = p["outline"].as_u64().unwrap_or(0) as u32;
+            if color >> 24 != 0 {
+                out.push(PrimitiveShape::LiquidBounceQuad {
+                    corners,
+                    colors: [color; 4],
+                })
+                .through_walls();
+            }
+            if outline >> 24 != 0 {
+                for i in 0..4 {
+                    out.line(corners[i], corners[(i + 1) % 4], outline, 1.)
+                        .through_walls();
+                }
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/placement_esp.rs b/crates/horizon-client/src/game/placement_esp.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/placement_esp.rs
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::Game;
+use horizon_client::world_primitives::{PrimitiveShape, WorldPrimitives};
+use horizon_protocol::packets::play::Clientbound as C;
+use serde_json::{Value, json};
+fn now() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |v| v.as_millis() as i64)
+}
+impl Game<'_> {
+    fn client_placement_esp_box(&self, position: [i32; 3]) -> Value {
+        let state = self.world.block(position[0], position[1], position[2]);
+        let f = self.res.facts().get(state);
+        let offset = if f.outline_offset {
+            self.pack
+                .context
+                .tables
+                .offset(state, position[0], position[2])
+                .unwrap_or([0.; 3])
+        } else {
+            [0.; 3]
+        };
+        let local = if self.res.facts().is_air(state) {
+            vec![[0., 0., 0., 1., 1., 1.]]
+        } else if f.name.ends_with("shulker_box") {
+            self.context_outline(position, state).into_iter().collect()
+        } else {
+            f.outline.iter().copied().collect::<Vec<_>>()
+        };
+        let boxes = local
+            .into_iter()
+            .map(|b| std::array::from_fn(|i| f64::from(position[i % 3]) + offset[i % 3] + b[i]))
+            .collect::<Vec<[f64; 6]>>();
+        let mut b = boxes.first().copied().unwrap_or_else(|| {
+            std::array::from_fn(|i| f64::from(position[i % 3]) + if i < 3 { 0. } else { 1. })
+        });
+        for shape in &boxes[1.min(boxes.len())..] {
+            for i in 0..3 {
+                b[i] = b[i].min(shape[i]);
+                b[i + 3] = b[i + 3].max(shape[i + 3]);
+            }
+        }
+        let b: [f64; 6] = std::array::from_fn(|i| b[i] - f64::from(position[i % 3]));
+        json!({"position":position,"bounds":b})
+    }
+    pub(super) fn client_placement_esp_packet(&self, packet: &C) {
+        if !self.native_window() {
+            return;
+        }
+        let (source, positions) = match packet {
+            C::BlockUpdate(p) => (2, vec![p.pos]),
+            C::SectionBlocksUpdate(p) => {
+                let [sx, sy, sz] = p.section;
+                (
+                    4,
+                    p.changes
+                        .iter()
+                        .map(|change| {
+                            let local = (change & 0xfff) as i32;
+                            [
+                                sx.wrapping_mul(16).wrapping_add(local >> 8 & 15),
+                                sy.wrapping_mul(16).wrapping_add(local & 15),
+                                sz.wrapping_mul(16).wrapping_add(local >> 4 & 15),
+                            ]
+                        })
+                        .collect(),
+                )
+            }
+            _ => return,
+        };
+        let mut options = String::new();
+        self.native_client_placement_esp("{\"action\":\"options\"}", &mut options);
+        let Ok(options) = serde_json::from_str::<Value>(&options) else {
+            return;
+        };
+        if options["prophunt"].as_u64().unwrap_or(0) & source == 0 {
+            return;
+        }
+        let blocks = positions
+            .into_iter()
+            .map(|p| self.client_placement_esp_box(p))
+            .collect::<Vec<_>>();
+        self.native_client_placement_esp(
+            &json!({"action":"prophunt","source":source,"time":now(),"blocks":blocks}).to_string(),
+            &mut String::new(),
+        );
+    }
+    pub(super) fn client_placement_esp_tick(&mut self) {
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let mut options = String::new();
+        self.native_client_placement_esp("{\"action\":\"options\",\"tick\":true}", &mut options);
+        let Ok(options) = serde_json::from_str::<Value>(&options) else {
+            return;
+        };
+        let blocks = if options["prophunt"].as_u64().unwrap_or(0) & 1 != 0 {
+            self.falling
+                .iter()
+                .map(|f| {
+                    self.client_placement_esp_box([
+                        f.position.x.floor() as i32,
+                        f.position.y.floor() as i32,
+                        f.position.z.floor() as i32,
+                    ])
+                })
+                .collect::<Vec<_>>()
+        } else {
+            vec![]
+        };
+        self.native_client_placement_esp(
+            &json!({"action":"prophunt","source":1,"tick":true,"time":now(),"blocks":blocks})
+                .to_string(),
+            &mut String::new(),
+        );
+    }
+    pub(super) fn client_placement_esp_player_tick(&mut self) {
+        if !self.native_window() || self.player.is_none() {
+            return;
+        }
+        let mut options = String::new();
+        self.native_client_placement_esp("{\"action\":\"options\"}", &mut options);
+        let Ok(options) = serde_json::from_str::<Value>(&options) else {
+            return;
+        };
+        if !options["void"].is_object() {
+            return;
+        }
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        let player = [
+            p.position.x.floor() as i32,
+            p.position.y.floor() as i32,
+            p.position.z.floor() as i32,
+        ];
+        let facing = [[0, 1], [-1, 0], [0, -1], [1, 0]]
+            [(((f64::from(p.yaw / 90.) + 0.5).floor() as i32) & 3) as usize];
+        let side = options["void"]["side"].as_i64().unwrap_or(3) as i32;
+        let range = options["void"]["facing"].as_i64().unwrap_or(8) as i32;
+        let threshold = options["void"]["threshold"].as_i64().unwrap_or(16) as i32;
+        let min_y = self.world.layout().min_y();
+        let positions = self.with_level(|b, level, ticks| {
+            super::placement_esp_search::search(
+                player,
+                facing,
+                side,
+                range,
+                threshold,
+                min_y,
+                |p| {
+                    b.client_placement_esp_sturdy(
+                        level,
+                        ticks,
+                        horizon_core::position::BlockPos::new(p[0], p[1], p[2]),
+                    )
+                },
+            )
+        });
+        let blocks = positions
+            .into_iter()
+            .map(|p| self.client_placement_esp_box(p))
+            .collect::<Vec<_>>();
+        self.native_client_placement_esp(
+            &json!({"action":"void","time":now(),"blocks":blocks}).to_string(),
+            &mut String::new(),
+        );
+    }
+    pub(super) fn client_placement_esp_geometry(&self, out: &mut WorldPrimitives) {
+        let mut result = String::new();
+        self.native_client_placement_esp(
+            &json!({"action":"frame","time":now()}).to_string(),
+            &mut result,
+        );
+        let Ok(Value::Array(draws)) = serde_json::from_str(&result) else {
+            return;
+        };
+        for d in draws {
+            let (Ok(p), Ok(b)) = (
+                serde_json::from_value::<[i32; 3]>(d["position"].clone()),
+                serde_json::from_value::<[f64; 6]>(d["bounds"].clone()),
+            ) else {
+                continue;
+            };
+            let b: [f64; 6] = std::array::from_fn(|i| f64::from(p[i % 3]) + b[i]);
+            let [x, y, z, X, Y, Z] = b;
+            let faces = d["faces"].as_u64().unwrap_or(0) as u32;
+            let edges = d["edges"].as_u64().unwrap_or(0) as u32;
+            let color = d["color"].as_u64().unwrap_or(0) as u32;
+            let outline = d["outline"].as_u64().unwrap_or(0) as u32;
+            if color >> 24 != 0 {
+                for (i, corners) in [
+                    [[x, y, z], [X, y, z], [X, y, Z], [x, y, Z]],
+                    [[x, Y, z], [x, Y, Z], [X, Y, Z], [X, Y, z]],
+                    [[x, y, z], [x, Y, z], [X, Y, z], [X, y, z]],
+                    [[X, y, z], [X, Y, z], [X, Y, Z], [X, y, Z]],
+                    [[x, y, Z], [X, y, Z], [X, Y, Z], [x, Y, Z]],
+                    [[x, y, z], [x, y, Z], [x, Y, Z], [x, Y, z]],
+                ]
+                .into_iter()
+                .enumerate()
+                {
+                    if faces & (15 << (i * 4)) != 0 {
+                        out.push(PrimitiveShape::LiquidBounceQuad {
+                            corners,
+                            colors: [color; 4],
+                        })
+                        .through_walls();
+                    }
+                }
+            }
+            if outline >> 24 != 0 {
+                for (i, [from, to]) in [
+                    [[x, y, z], [X, y, z]],
+                    [[X, y, z], [X, y, Z]],
+                    [[X, y, Z], [x, y, Z]],
+                    [[x, y, Z], [x, y, z]],
+                    [[x, y, z], [x, Y, z]],
+                    [[X, y, z], [X, Y, z]],
+                    [[X, y, Z], [X, Y, Z]],
+                    [[x, y, Z], [x, Y, Z]],
+                    [[x, Y, z], [X, Y, z]],
+                    [[X, Y, z], [X, Y, Z]],
+                    [[X, Y, Z], [x, Y, Z]],
+                    [[x, Y, Z], [x, Y, z]],
+                ]
+                .into_iter()
+                .enumerate()
+                {
+                    if edges & (3 << (i * 2)) != 0 {
+                        out.line(from, to, outline, 1.).through_walls();
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/placement_esp_search.rs b/crates/horizon-client/src/game/placement_esp_search.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/placement_esp_search.rs
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// ModuleVoidESP search(), LiquidBounce ae0eb396. Shared verbatim with the native Game patch.
+use std::collections::BTreeSet;
+pub fn search(
+    player: [i32; 3],
+    facing: [i32; 2],
+    side_range: i32,
+    facing_range: i32,
+    threshold: i32,
+    min_y: i32,
+    mut sturdy: impl FnMut([i32; 3]) -> bool,
+) -> BTreeSet<[i32; 3]> {
+    let mut start = [player[0], player[1].wrapping_sub(1), player[2]];
+    let mut found = false;
+    for _ in 0..threshold {
+        if sturdy(start) {
+            found = true;
+            break;
+        }
+        start[1] = start[1].wrapping_sub(1);
+    }
+    if !found {
+        return BTreeSet::new();
+    }
+    let side = [-facing[1], facing[0]];
+    let a = [
+        start[0]
+            .wrapping_add(facing[0].wrapping_mul(facing_range))
+            .wrapping_sub(side[0].wrapping_mul(side_range)),
+        start[2]
+            .wrapping_add(facing[1].wrapping_mul(facing_range))
+            .wrapping_sub(side[1].wrapping_mul(side_range)),
+    ];
+    let b = [
+        start[0]
+            .wrapping_sub(facing[0].wrapping_mul(facing_range))
+            .wrapping_add(side[0].wrapping_mul(side_range)),
+        start[2]
+            .wrapping_sub(facing[1].wrapping_mul(facing_range))
+            .wrapping_add(side[1].wrapping_mul(side_range)),
+    ];
+    let mut out = BTreeSet::new();
+    for z in a[1].min(b[1])..=a[1].max(b[1]) {
+        for x in a[0].min(b[0])..=a[0].max(b[0]) {
+            let p = [x, start[1], z];
+            if sturdy(p) {
+                continue;
+            }
+            let mut scan = p;
+            let mut covered = false;
+            for _ in 0..threshold {
+                scan[1] = scan[1].wrapping_sub(1);
+                if sturdy(scan) {
+                    covered = true;
+                    break;
+                }
+                if scan[1] <= min_y {
+                    break;
+                }
+            }
+            if !covered {
+                out.insert(p);
+            }
+        }
+    }
+    out
+}
