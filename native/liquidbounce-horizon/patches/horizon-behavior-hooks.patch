+        if !self.native_window() { return; }
+        if self.client_free_cam_active(){[*forward,*backward,*left,*right,*jump,*shift]=[false;6];}
+        let navigation = self.native_client_auto_walk_input([*forward,*backward,*left,*right,*jump,*shift,*sprint]);
+        if let Some((keys,_)) = navigation { [*forward,*backward,*left,*right,*jump,*shift,*sprint] = keys; }
+        let fight_navigation = self.native_client_kill_aura_navigation_input([*forward,*backward,*left,*right,*jump,*shift,*sprint]);
+        if let Some((keys,_)) = fight_navigation { [*forward,*backward,*left,*right,*jump,*shift,*sprint] = keys; }
+        let free_cam_navigation=self.native_client_free_cam_navigation_input([*forward,*backward,*left,*right,*jump,*shift,*sprint]);
+        if let Some((keys,_))=free_cam_navigation{[*forward,*backward,*left,*right,*jump,*shift,*sprint]=keys;}
+        [*forward,*backward,*left,*right,*jump,*shift,*sprint]=self.edge_assistance_input([*forward,*backward,*left,*right,*jump,*shift,*sprint],false);
+        mod_api::dispatch_client_directional_input(self, mod_api::mods(), forward, backward, left, right, jump, shift, sprint);
+        if let Some((keys,true)) = navigation { [*forward,*backward,*left,*right,*jump,*shift] = [keys[0],keys[1],keys[2],keys[3],keys[4],keys[5]]; }
+        if let Some((_,Some(keys))) = fight_navigation { [*forward,*backward,*left,*right,*jump,*shift] = [keys[0],keys[1],keys[2],keys[3],keys[4],keys[5]]; }
+        if let Some((_,Some(keys)))=free_cam_navigation{[*forward,*backward,*left,*right,*jump,*shift]=[keys[0],keys[1],keys[2],keys[3],keys[4],keys[5]];}
+        [*forward,*backward,*left,*right,*jump,*shift,*sprint]=self.edge_assistance_input([*forward,*backward,*left,*right,*jump,*shift,*sprint],true);
+        if crate::navigation_physics::scaffold_down(){*shift=false;}
+        [*forward,*backward,*left,*right,*jump,*shift,*sprint]=self.movement_guard_input([*forward,*backward,*left,*right,*jump,*shift,*sprint]);
+        horizon_client::reverse_step_bridge::set_keys([*forward,*backward,*left,*right,*jump,*shift,*sprint]);
