@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Shared policy at the vanilla consumer, after PacketEvent listeners.
+use crate::{
+    anti_exploit_model::{AntiExploit, Notice, Settings},
+    text::Text,
+};
+use std::sync::{Mutex, OnceLock};
+fn service() -> &'static Mutex<AntiExploit> {
+    static VALUE: OnceLock<Mutex<AntiExploit>> = OnceLock::new();
+    VALUE.get_or_init(Default::default)
+}
+fn now() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis().min(i64::MAX as u128) as i64)
+}
+pub fn configure(
+    running: bool,
+    limits: u32,
+    cancel_demo: bool,
+    ignore_protocol: bool,
+    max_obfuscated: i32,
+    notify: bool,
+    scoreboard_fix: bool,
+) {
+    let mut s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    s.running = running;
+    s.settings = Settings {
+        limits,
+        cancel_demo,
+        ignore_protocol,
+        max_obfuscated,
+        notify,
+        scoreboard_fix,
+    };
+    // Source Notify.notifiedTime persists across enable/disable and worlds.
+}
+pub fn explosion(push: [f64; 3]) -> [f64; 3] {
+    service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .explosion(push, now())
+}
+pub fn particle_count(count: i32) -> i32 {
+    service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .particle_count(count, now())
+}
+pub fn particle_speed(speed: [f32; 3]) -> [f32; 3] {
+    service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .particle_speed(speed, now())
+}
+pub fn cancel_demo() -> bool {
+    service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .demo(now())
+}
+pub fn ignore_protocol_error() -> bool {
+    let s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    s.running && s.settings.ignore_protocol
+}
+pub fn scoreboard_fix() -> bool {
+    let s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    s.running && s.settings.scoreboard_fix
+}
+pub fn block_chat(text: &Text) -> bool {
+    let mut s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if s.blocked(
+        text.spans
+            .iter()
+            .map(|p| (p.style.obfuscated == Some(true), p.text.as_str())),
+    ) {
+        s.notify(Notice::Obfuscated, now());
+        true
+    } else {
+        false
+    }
+}
+pub fn sanitize_name(text: Text) -> Text {
+    let mut s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if !s.blocked(
+        text.spans
+            .iter()
+            .map(|p| (p.style.obfuscated == Some(true), p.text.as_str())),
+    ) {
+        return text;
+    }
+    s.notify(Notice::Obfuscated, now());
+    let mut text = text;
+    for span in &mut text.spans {
+        if span.style.obfuscated == Some(true) {
+            span.style.obfuscated = Some(false);
+        }
+    }
+    text
+}
+pub fn drain_notices() -> Vec<(u8, bool)> {
+    let mut s = service()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::mem::take(&mut s.notices)
+        .into_iter()
+        .map(|n| {
+            (
+                match n {
+                    Notice::Explosion => 0,
+                    Notice::Amount => 1,
+                    Notice::Speed => 2,
+                    Notice::Obfuscated => 3,
+                    Notice::Demo => 4,
+                },
+                n.error(),
+            )
+        })
+        .collect()
+}
