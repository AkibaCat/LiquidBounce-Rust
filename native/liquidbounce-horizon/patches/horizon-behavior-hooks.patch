diff --git a/crates/horizon-client/src/game/scaffold_special_rules.rs b/crates/horizon-client/src/game/scaffold_special_rules.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_special_rules.rs
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Pinned GodBridge and Breezily decisions; the native adapter supplies world facts.
+pub type Input = [bool; 4];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Cardinal {
+    South,
+    West,
+    North,
+    East,
+}
+pub fn cardinal(yaw: f64) -> Cardinal {
+    match ((yaw / 90.0 + 0.5).floor() as i32) & 3 {
+        0 => Cardinal::South,
+        1 => Cardinal::West,
+        2 => Cardinal::North,
+        _ => Cardinal::East,
+    }
+}
+pub fn cardinal_offset(yaw: f64) -> [i32; 3] {
+    match cardinal(yaw) {
+        Cardinal::South => [0, 0, 1],
+        Cardinal::West => [-1, 0, 0],
+        Cardinal::North => [0, 0, -1],
+        Cardinal::East => [1, 0, 0],
+    }
+}
+pub fn moving_yaw(movement_angle: f32) -> f32 {
+    ((movement_angle + 180.0) / 45.0).round_ties_even() * 45.0
+}
+pub fn no_input_rotation(target: Option<[f32; 2]>) -> Option<[f32; 2]> {
+    target.map(|r| [(r[0] / 90.0).floor() * 90.0 + 45.0, 75.0])
+}
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct GodBridge {
+    pub on_right_side: bool,
+}
+impl GodBridge {
+    pub fn rotation(
+        &mut self,
+        moving_yaw: f32,
+        on_ground: bool,
+        position: [f64; 3],
+        cos_sin: [f32; 2],
+        leaning_off: bool,
+        next_air: bool,
+    ) -> [f32; 2] {
+        if moving_yaw % 90.0 != 0.0 {
+            return [moving_yaw, 75.6];
+        }
+        if on_ground {
+            self.on_right_side = (position[0] + f64::from(cos_sin[0]) * 0.5).floor()
+                != position[0].floor()
+                || (position[2] + f64::from(cos_sin[1]) * 0.5).floor() != position[2].floor();
+            if leaning_off && next_air {
+                self.on_right_side = !self.on_right_side;
+            }
+        }
+        [
+            moving_yaw + if self.on_right_side { 45.0 } else { -45.0 },
+            75.7,
+        ]
+    }
+}
+#[derive(Clone, Debug, PartialEq)]
+pub struct Breezily {
+    pub last_sideways: f32,
+    pub last_air_time: i64,
+    pub current_edge_distance: f64,
+}
+impl Default for Breezily {
+    fn default() -> Self {
+        Self {
+            last_sideways: 0.0,
+            last_air_time: 0,
+            current_edge_distance: 0.45,
+        }
+    }
+}
+impl Breezily {
+    pub fn rotation(moving_yaw: f32) -> [f32; 2] {
+        [
+            moving_yaw,
+            if moving_yaw % 90.0 == 0.0 { 80.0 } else { 75.6 },
+        ]
+    }
+    pub fn input(
+        &mut self,
+        input: Input,
+        shift_down: bool,
+        below_air: bool,
+        now: i64,
+        position: [f64; 3],
+        yaw: f32,
+        mut random_distance: impl FnMut() -> f32,
+    ) -> Input {
+        if !input[0] || shift_down {
+            return input;
+        }
+        if below_air {
+            self.last_air_time = now;
+        } else if now.wrapping_sub(self.last_air_time) > 500 {
+            return input;
+        }
+        let x = position[0] - position[0].floor();
+        let z = position[2] - position[2].floor();
+        let maximum = 1.0 - self.current_edge_distance;
+        let mut sideways = 0.0;
+        match cardinal(f64::from(yaw)) {
+            Cardinal::South => {
+                if x > maximum {
+                    sideways = 1.0;
+                }
+                if x < self.current_edge_distance {
+                    sideways = -1.0;
+                }
+            }
+            Cardinal::North => {
+                if x > maximum {
+                    sideways = -1.0;
+                }
+                if x < self.current_edge_distance {
+                    sideways = 1.0;
+                }
+            }
+            Cardinal::East => {
+                if z > maximum {
+                    sideways = -1.0;
+                }
+                if z < self.current_edge_distance {
+                    sideways = 1.0;
+                }
+            }
+            Cardinal::West => {
+                if z > maximum {
+                    sideways = 1.0;
+                }
+                if z < self.current_edge_distance {
+                    sideways = -1.0;
+                }
+            }
+        }
+        if self.last_sideways != sideways && sideways != 0.0 {
+            self.last_sideways = sideways;
+            self.current_edge_distance = f64::from(random_distance());
+        }
+        [
+            input[0],
+            input[1],
+            self.last_sideways == -1.0,
+            self.last_sideways == 1.0,
+        ]
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LedgeMode {
+    Jump,
+    Sneak,
+    StopInput,
+    Backwards,
+}
+impl LedgeMode {
+    pub const ALL: [Self; 4] = [Self::Jump, Self::Sneak, Self::StopInput, Self::Backwards];
+    pub fn tag(self) -> &'static str {
+        match self {
+            Self::Jump => "Jump",
+            Self::Sneak => "Sneak",
+            Self::StopInput => "StopInput",
+            Self::Backwards => "Backwards",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LedgeAction {
+    pub jump: bool,
+    pub sneak_time: i32,
+    pub stop_input: bool,
+    pub step_back: bool,
+}
+pub fn jump_apex(jump_power: f32) -> f64 {
+    let mut motion = f64::from(jump_power);
+    let mut height = 0.0;
+    while motion > 0.0 {
+        height += motion;
+        motion = (motion - 0.08) * f64::from(0.98f32);
+    }
+    height
+}
+pub fn action(mode: LedgeMode, mut sneak_time: impl FnMut() -> i32) -> LedgeAction {
+    match mode {
+        LedgeMode::Jump => LedgeAction {
+            jump: true,
+            ..Default::default()
+        },
+        LedgeMode::Sneak => LedgeAction {
+            sneak_time: sneak_time(),
+            ..Default::default()
+        },
+        LedgeMode::StopInput => LedgeAction {
+            stop_input: true,
+            ..Default::default()
+        },
+        LedgeMode::Backwards => LedgeAction {
+            step_back: true,
+            ..Default::default()
+        },
+    }
+}
+/// Selection consumes randomness only on the source branches that choose a mode.
+pub fn ledge_mode(
+    block_count: i32,
+    force_sneak_below: i32,
+    modes: &[LedgeMode],
+    jump_power: f32,
+    mut choose: impl FnMut(usize) -> usize,
+) -> LedgeMode {
+    let mode = if block_count < force_sneak_below {
+        LedgeMode::Sneak
+    } else {
+        modes[choose(modes.len())]
+    };
+    if mode == LedgeMode::Jump && jump_apex(jump_power) >= 2.0 {
+        let remaining = modes
+            .iter()
+            .copied()
+            .filter(|m| *m != LedgeMode::Jump)
+            .collect::<Vec<_>>();
+        if remaining.is_empty() {
+            LedgeMode::Sneak
+        } else {
+            remaining[choose(remaining.len())]
+        }
+    } else {
+        mode
+    }
+}
diff --git a/crates/horizon-client/src/game/scaffold_special_techniques.rs b/crates/horizon-client/src/game/scaffold_special_techniques.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/scaffold_special_techniques.rs
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Actual GodBridge and Breezily world queries and persistent technique state.
+use super::{Game, block_placement as placement, scaffold_special_rules as rules};
+use horizon_core::{geometry::trig::DEG_TO_RAD, jmath};
+use serde_json::{Value, json};
+use std::cell::RefCell;
+thread_local! {
+    static GOD_BRIDGE:RefCell<rules::GodBridge>=RefCell::new(Default::default());
+    static BREEZILY:RefCell<rules::Breezily>=RefCell::new(Default::default());
+}
+fn target(value: &Value) -> Option<placement::Target> {
+    Some(placement::Target {
+        interacted: serde_json::from_value(value["interacted"].clone()).ok()?,
+        placed: serde_json::from_value(value["placed"].clone()).ok()?,
+        direction: serde_json::from_value(value["direction"].clone()).ok()?,
+        point: serde_json::from_value(value["point"].clone()).ok()?,
+        min_y: value["minY"].as_f64()?,
+        rotation: serde_json::from_value(value["rotation"].clone()).ok()?,
+    })
+}
+fn mode(value: &Value) -> Option<rules::LedgeMode> {
+    rules::LedgeMode::ALL
+        .into_iter()
+        .find(|m| Some(m.tag()) == value.as_str())
+}
+fn action(a: rules::LedgeAction) -> String {
+    json!({"jump":a.jump,"sneakTime":a.sneak_time,"stopInput":a.stop_input,"stepBack":a.step_back})
+        .to_string()
+}
+impl Game<'_> {
+    pub(super) fn scaffold_special_technique_query(&mut self, text: &str) -> Option<String> {
+        let request: Value = serde_json::from_str(text).ok()?;
+        match request["op"].as_str()? {
+            "plan" | "crosshair" => self.scaffold_technique_query(text),
+            "rotation" => {
+                let raw: rules::Input = serde_json::from_value(request["rawInput"].clone()).ok()?;
+                if raw == [false; 4] {
+                    return Some(
+                        json!(rules::no_input_rotation(
+                            target(&request["target"]).map(|t| t.rotation)
+                        ))
+                        .to_string(),
+                    );
+                }
+                let p = self.player.as_ref()?;
+                let moving_yaw =
+                    rules::moving_yaw(super::scaffold_planner_rules::movement_angle(p.yaw, raw));
+                if request["technique"] == "Breezily" {
+                    return Some(json!(rules::Breezily::rotation(moving_yaw)).to_string());
+                }
+                if request["technique"] != "GodBridge" {
+                    return None;
+                }
+                let position = [p.position.x, p.position.y, p.position.z];
+                let on_ground = p.ground.on_ground;
+                let radians = moving_yaw * DEG_TO_RAD;
+                let cos_sin = [
+                    jmath::cos(f64::from(radians)) as f32,
+                    jmath::sin(f64::from(radians)) as f32,
+                ];
+                let below = position.map(|v| v.floor() as i32);
+                let relative = rules::cardinal_offset(f64::from(moving_yaw));
+                let ahead = std::array::from_fn::<_, 3, _>(|i| {
+                    (position[i] + f64::from(relative[i]) * 0.6).floor() as i32
+                });
+                let is_air = |at: [i32; 3]| {
+                    self.res.facts().is_air(self.world.block(
+                        at[0],
+                        at[1].wrapping_sub(1),
+                        at[2],
+                    ))
+                };
+                let rotation = GOD_BRIDGE.with_borrow_mut(|s| {
+                    s.rotation(
+                        moving_yaw,
+                        on_ground,
+                        position,
+                        cos_sin,
+                        is_air(below),
+                        is_air(ahead),
+                    )
+                });
+                Some(json!(rotation).to_string())
+            }
+            "breezilyInput" => {
+                let input: rules::Input = serde_json::from_value(request["input"].clone()).ok()?;
+                let distance: [f32; 2] =
+                    serde_json::from_value(request["edgeDistance"].clone()).ok()?;
+                let p = self.player.as_ref()?;
+                let at = p.position;
+                let below = self.world.block(
+                    at.x.floor() as i32,
+                    (at.y.floor() as i32).wrapping_sub(1),
+                    at.z.floor() as i32,
+                );
+                let now = std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .ok()?
+                    .as_millis() as i64;
+                let input = BREEZILY.with_borrow_mut(|s| {
+                    s.input(
+                        input,
+                        p.shift_key_down,
+                        self.res.facts().is_air(below),
+                        now,
+                        [at.x, at.y, at.z],
+                        p.yaw,
+                        || {
+                            if distance[0] >= distance[1] {
+                                distance[0]
+                            } else {
+                                super::edge_random::with_thread_random(|r| {
+                                    r.next_f32_between(distance[0], distance[1].next_up())
+                                })
+                            }
+                        },
+                    )
+                });
+                Some(json!(input).to_string())
+            }
+            "godbridgeLedge" => {
+                let input: rules::Input = serde_json::from_value(request["input"].clone()).ok()?;
+                let p = self.player.as_ref()?;
+                let eye_height = f64::from(p.dimensions.eye_height);
+                let raw = horizon_client::reverse_step_bridge::keys();
+                let keys = horizon_client::sprint::Keys {
+                    forward: input[0],
+                    backward: input[1],
+                    left: input[2],
+                    right: input[3],
+                    jump: raw[4],
+                    shift: p.shift_key_down,
+                    sprint: p.sprinting || raw[6],
+                    analog: None,
+                };
+                let mut snapshot = None;
+                // This Game helper runs before Horizon's native base tick. It must
+                // advance that base once; the partial-tick replay API is reserved
+                // for callers already inside the native aiStep phase.
+                super::falling_forecast::visit_with_keys_probe(
+                    self,
+                    1,
+                    0.0,
+                    keys,
+                    false,
+                    |body, _, backed| {
+                        snapshot = Some((body.position, backed));
+                        true
+                    },
+                )
+                .ok()?;
+                let (position, backed) = snapshot?;
+                if !backed {
+                    return Some(action(Default::default()));
+                }
+                let Some(target) = target(&request["target"]) else {
+                    return Some(action(Default::default()));
+                };
+                let rotation: [f32; 2] =
+                    serde_json::from_value(request["rotation"].clone()).ok()?;
+                let range = self
+                    .interaction_range("minecraft:block_interaction_range", 4.5, 5.0)
+                    .max(self.interaction_range("minecraft:entity_interaction_range", 3.0, 5.0));
+                let start = [position.x, position.y + eye_height, position.z];
+                if let Some(click) = placement::trace_from_point(self, start, rotation, range) {
+                    let h = click.hit;
+                    let eye = self.eye_position()?;
+                    let minimum = request["minDist"].as_f64()? as f32;
+                    let valid = if h.face[1] != 0 {
+                        true
+                    } else {
+                        let axis = if h.face[2] != 0 { 2 } else { 0 };
+                        (h.point[axis] - eye[axis]).abs() >= f64::from(minimum)
+                    };
+                    if target.matches(true, h.pos, h.face, h.point) && valid {
+                        return Some(action(Default::default()));
+                    }
+                }
+                let power = self.scaffold_with_motion(|motion| {
+                    horizon_world::living_motion::jump_power(motion, 1.0)
+                        .expect("GodBridge jump power")
+                })?;
+                let block_count = i32::try_from(request["blockCount"].as_i64()?).ok()?;
+                let force = i32::try_from(request["forceSneakBelowCount"].as_i64()?).ok()?;
+                let mut modes = request["modes"]
+                    .as_array()?
+                    .iter()
+                    .map(mode)
+                    .collect::<Option<Vec<_>>>()?;
+                modes.sort_by_key(|m| rules::LedgeMode::ALL.iter().position(|v| v == m).unwrap());
+                modes.dedup();
+                if modes.is_empty() {
+                    return None;
+                }
+                let sneak: [i32; 2] = serde_json::from_value(request["sneakTime"].clone()).ok()?;
+                if sneak[0] > sneak[1] {
+                    return None;
+                }
+                let mode = rules::ledge_mode(block_count, force, &modes, power, |count| {
+                    super::edge_random::with_thread_random(|r| {
+                        r.next_i32_bound(count as i32) as usize
+                    })
+                });
+                Some(action(rules::action(mode, || {
+                    super::edge_random::random_i32_inclusive(sneak[0], sneak[1])
+                })))
+            }
+            _ => None,
+        }
+    }
+}
diff --git a/crates/horizon-client/src/game/client_liquid_filler.rs b/crates/horizon-client/src/game/client_liquid_filler.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/client_liquid_filler.rs
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Exact LiquidFiller block/fluid/filter adapter; the pure model is shared with the engine.
+use super::{Game, liquid_filler_core as core};
+use horizon_core::geometry::{Aabb,Vec3};
+use horizon_world::{fluid::FluidKind,level::{classes::Interface,data::{ItemKind,state_flags}}};
+use serde_json::{Value,json};
+struct World<'a,'g>(&'a mut Game<'g>);
+impl core::World for World<'_,'_> {
+    fn state(&mut self,p:core::Pos)->Option<core::State>{Some(state(self.0,p))}
+    fn scan(&mut self,center:[f64;3],radius:f32)->Vec<(core::Pos,core::State)>{
+        let radius=f64::from(radius);
+        let lo=center.map(|v|(v-radius).floor() as i32);let hi=center.map(|v|(v+radius).floor() as i32);
+        let min=self.0.world.shape.min_y;let max=self.0.world.shape.max_y()-1;
+        let mut out=vec![];
+        // BlockScanUtils.sectionBasedScan: chunk X, chunk Z, section Y;
+        // findBlocksInSection: local Y, local Z, local X (X changes fastest).
+        for sx in lo[0]>>4..=hi[0]>>4 {for sz in lo[2]>>4..=hi[2]>>4 {
+            for sy in (lo[1]>>4).max(min>>4)..=(hi[1]>>4).min(max>>4) {
+                for y in lo[1].max(sy<<4)..=hi[1].min((sy<<4)+15) {
+                    for z in lo[2].max(sz<<4)..=hi[2].min((sz<<4)+15) {
+                        for x in lo[0].max(sx<<4)..=hi[0].min((sx<<4)+15) {
+                            let p=[x,y,z];out.push((p,state(self.0,p)));
+                        }
+                    }
+                }
+            }
+        }}
+        // The scanner appends out-of-height AIR after all real sections.
+        // betweenClosed changes X, then Y, then Z.
+        for (from,to) in [(lo[1],hi[1].min(min-1)),(lo[1].max(max+1),hi[1])] {
+            if from>to{continue;}
+            for z in lo[2]..=hi[2]{for y in from..=to{for x in lo[0]..=hi[0]{out.push(([x,y,z],core::State{replaceable:true,..Default::default()}));}}}
+        }
+        out
+    }
+    fn unobstructed(&mut self,p:core::Pos)->bool {
+        let area=Aabb::new(Vec3::new(p[0]as f64,p[1]as f64,p[2]as f64),Vec3::new(p[0]as f64+1.,p[1]as f64+1.,p[2]as f64+1.));
+        self.0.with_level(|_,level,_|!level.building_blocker_boxes().into_iter().any(|b|b.intersects(area)))
+    }
+    fn next_int(&mut self,bound:usize)->usize{super::liquid_filler_random::with_thread_random(|r|r.next_i32_bound(bound as i32))as usize}
+}
+pub(super) fn state(g:&Game<'_>,p:core::Pos)->core::State{
+    let id=g.world.block(p[0],p[1],p[2]);let b=g.res.behaviours();let facts=b.facts(id);let block=b.data(id);
+    let fluid=match facts.fluid.kind(){
+        FluidKind::Empty=>core::Fluid::Empty,
+        FluidKind::Water|FluidKind::FlowingWater=>core::Fluid::Water,
+        FluidKind::Lava|FluidKind::FlowingLava=>core::Fluid::Lava,
+        _=>core::Fluid::Other,
+    };
+    core::State{replaceable:facts.flags&state_flags::REPLACEABLE!=0,fluid,source:facts.fluid.is_source(),absorb_pass:block.implements(Interface::BucketPickup)||matches!(b.table.name(id),"minecraft:kelp"|"minecraft:kelp_plant"|"minecraft:seagrass"|"minecraft:tall_seagrass")}
+}
+pub(super) fn slots(g:&Game<'_>)->Vec<core::Slot>{
+    let b=g.res.behaviours();std::iter::once(40).chain(0..9).filter_map(|index|{
+        let s=g.stack_in(index).filter(|s|s.count>0)?;
+        let block=b.item_binding(&s.item).filter(|i|!matches!(i.kind,ItemKind::SolidBucket|ItemKind::Other)).map(|i|b.table.name(b.table.default_state(i.block)).to_owned());
+        Some(core::Slot{index:index as u8,item:s.item.to_string(),block})
+    }).collect()
+}
+pub(super) fn settings(q:&Value)->Option<core::Settings>{Some(core::Settings{
+    place_in:q["placeIn"].as_u64()?as u32,order:core::PlaceOrder::from_tag(q["order"].as_str()?)?,use_sponge:q["useSponge"].as_bool()?,whitelist:q["whitelist"].as_bool()?,blocks:serde_json::from_value(q["blocks"].clone()).ok()?
+})}
+impl Game<'_>{
+    pub(super) fn liquid_filler_query(&mut self,text:&str)->Option<String>{
+        let q:Value=serde_json::from_str(text).ok()?;let s=settings(&q["settings"])?;let slots=slots(self);let selected=self.client_hotbar_slot()as u8;
+        match q["op"].as_str()?{
+            "targets"=>{
+                let eye=self.eye_position()?;let range=q["range"].as_f64()?;
+                let available=core::slot(&s,&slots,selected,None).is_some();
+                let targets=if available{core::targets(&mut World(self),&s,eye,range,core::normal_slot(&s,&slots,selected).is_some(),core::sponge_slot(&s,&slots,selected).is_some())}else{vec![]};
+                Some(json!({"available":available,"positions":targets}).to_string())
