@@ -0,0 +1,2 @@
+// Official MC26.3 OwnableEntity assignability. Generated by generate-owner-types.py.
+pub const OWNABLE:&[&str]=&["minecraft:camel","minecraft:camel_husk","minecraft:cat","minecraft:donkey","minecraft:horse","minecraft:llama","minecraft:mule","minecraft:nautilus","minecraft:parrot","minecraft:skeleton_horse","minecraft:trader_llama","minecraft:vex","minecraft:wolf","minecraft:zombie_horse","minecraft:zombie_nautilus"];
diff --git a/crates/horizon-client/src/game/mob_owners.rs b/crates/horizon-client/src/game/mob_owners.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/mob_owners.rs
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::{Game, view_vector};
+use horizon_client::{
+    hud::HudBatch,
+    mesher::Vertex,
+    mob_owners as owners,
+    mobs::{Mob, Who},
+    text::Text,
+};
+impl Game<'_> {
+    fn client_owner_uuid(&self, id: u32) -> Option<u128> {
+        if id == self.remote.as_ref().map_or(0, |r| r.entity_id as u32) && self.player.is_some() {
+            return Some(horizon_client::lan::playerdata::ints_uuid(
+                self.acting_uuid(),
+            ));
+        }
+        if let Some(uuid) = self.remote_player_uuid(id) {
+            return Some(uuid);
+        }
+        if let Some(g) = self
+            .lan
+            .iter()
+            .flat_map(|h| h.hub.guests.iter())
+            .find(|g| g.placed && g.entity_id as u32 == id)
+        {
+            return Some(g.uuid);
+        }
+        self.mobs
+            .iter()
+            .find(|m| m.id == id && !m.removed)
+            .and_then(|_| self.persist.uuids.get(&id))
+            .map(|u| horizon_client::lan::playerdata::ints_uuid(*u))
+    }
+    fn client_owner_who(&self, owner: Option<Who>, guest: Option<u32>) -> Option<u128> {
+        match owner {
+            Some(Who::Mob(id)) => self.client_owner_uuid(id),
+            Some(Who::Player) => match guest {
+                Some(conn) => self
+                    .lan
+                    .iter()
+                    .flat_map(|h| h.hub.guests.iter())
+                    .find(|g| g.conn == conn && g.placed)
+                    .map(|g| g.uuid),
+                None => self
+                    .player
+                    .as_ref()
+                    .map(|_| horizon_client::lan::playerdata::ints_uuid(self.acting_uuid())),
+            },
+            None => None,
+        }
+    }
+    pub(super) fn client_record_projectile_owner(
+        &self,
+        id: u32,
+        owner: Option<Who>,
+        guest: Option<u32>,
+        at: [f64; 3],
+        height: f32,
+    ) {
+        if !owners::enabled(true) {
+            return;
+        }
+        let uuid = owners::remote_owner(id)
+            .and_then(|id| self.client_owner_uuid(id))
+            .or_else(|| self.client_owner_who(owner, guest));
+        if let Some(owner) = uuid {
+            self.client_record_owner(owner, at, height);
+        }
+    }
+    fn client_record_owner(&self, owner: u128, at: [f64; 3], height: f32) {
+        let light = self.world.light(
+            at[0].floor() as i32,
+            (at[1] + f64::from(height) * 0.85).floor() as i32,
+            at[2].floor() as i32,
+        );
+        owners::record(owners::Label {
+            owner,
+            at,
+            height,
+            light: horizon_client::block_entity_render::vertex_light(light),
+        });
+    }
+    pub(super) fn client_record_mob_owner(&self, m: &Mob, alpha: f64) {
+        if !owners::enabled(false) || !owners::OWNABLE.contains(&&*m.kind.id) {
+            return;
+        }
+        let Some(uuid) = m.extra.owner.or_else(|| {
+            if &*m.kind.id == "minecraft:vex" {
+                self.persist.uuids.get(&(m.extra.counter2 as u32)).copied()
+            } else {
+                None
+            }
+        }) else {
+            return;
+        };
+        let at = [
+            m.previous.x + (m.position.x - m.previous.x) * alpha,
+            m.previous.y + (m.position.y - m.previous.y) * alpha,
+            m.previous.z + (m.position.z - m.previous.z) * alpha,
+        ];
+        self.client_record_owner(
+            horizon_client::lan::playerdata::ints_uuid(uuid),
+            at,
+            m.height(),
+        );
+    }
+    fn client_owner_name(&self, uuid: u128) -> Option<String> {
+        if self.player.is_some()
+            && uuid == horizon_client::lan::playerdata::ints_uuid(self.acting_uuid())
+        {
+            return Some(self.own_profile_name());
+        }
+        for (id, name) in self.remote_player_names() {
+            if self.remote_player_uuid(id) == Some(uuid) {
+                return Some(name);
+            }
+        }
+        self.lan
+            .iter()
+            .flat_map(|h| h.hub.guests.iter())
+            .find(|g| g.placed && g.uuid == uuid)
+            .map(|g| g.name.clone())
+    }
+    pub(super) fn mob_owner_geometry(&mut self, camera: glam::DVec3, out: &mut Vec<Vertex>) {
+        let (yaw, pitch) = self.posed_rotation.unwrap_or_else(|| {
+            if self.camera_type == super::perspective::CameraType::ThirdPersonFront {
+                (self.yaw + 180.0, -self.pitch)
+            } else {
+                (self.yaw, self.pitch)
+            }
+        });
+        let forward = glam::DVec3::from_array(view_vector(yaw, pitch));
+        let right = forward.cross(glam::DVec3::Y).normalize_or_zero();
+        let up = right.cross(forward).normalize_or_zero();
+        for label in owners::labels() {
+            let name = self
+                .client_owner_name(label.owner)
+                .unwrap_or_else(|| owners::cached(label.owner));
+            let pos = glam::DVec3::from_array(label.at);
+            if pos.distance_squared(camera) > 4096.0 {
+                continue;
+            }
+            let text = Text::literal(name).resolve_legacy();
+            let o = pos + glam::DVec3::Y * f64::from(label.height / 2.0) - camera;
+            let mut batch = HudBatch::new([1, 1]);
+            let width = self.gui.atlas.font.width_text(&text) as i32;
+            let x = (-width / 2) as f32;
+            // The pinned mixin submits one NORMAL, shadowed text pass with opaque black background.
+            batch.fill(
+                &self.gui.atlas,
+                x - 1.0,
+                -1.0,
+                width as f32 + 1.0,
+                10.0,
+                0xff000000,
+            );
+            let background = batch.vertices.len();
+            batch.text_styled_world(&self.gui.atlas, &text, x, 0.0, 0xffffffff, true);
+            self.mark_entity(out.len(), "minecraft:name_tag");
+            for (i, quad) in batch.vertices.as_chunks::<6>().0.iter().enumerate() {
+                for v in [quad[5], quad[2], quad[1], quad[0]] {
+                    let depth = if i * 6 < background {
+                        -0.002
+                    } else {
+                        -f64::from(v.depth) * 0.025
+                    };
+                    let p = o + right * f64::from(v.pos[0]) * 0.025
+                        - up * f64::from(v.pos[1]) * 0.025
+                        + forward * depth;
+                    out.push(Vertex {
+                        normal: [0; 4],
+                        pos: p.as_vec3().to_array(),
+                        uv: v.uv,
+                        layer: 0,
+                        color: v.color,
+                        light: label.light,
+                        glint_uv: [0.0; 2],
+                    });
+                }
+            }
+            self.map_patches.extend(batch.patches);
+        }
+    }
+}
diff --git a/crates/horizon-client-render/src/better_tab.rs b/crates/horizon-client-render/src/better_tab.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client-render/src/better_tab.rs
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use crate::{scoreboard::comp_text, tab_list::TabPlayer, text::Text};
+use std::{cell::RefCell, cmp::Ordering, collections::HashMap};
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Row {
+    hidden: bool,
+    color: Option<u32>,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Policy {
+    sorting: u8,
+    visibility: u8,
+    show_game_mode: bool,
+    limit: i32,
+    height: i32,
+    accurate: bool,
+    suffix: bool,
+    rows: HashMap<String, Row>,
+    error: bool,
+    staffs: Vec<String>,
+    staff_suffix:String,
+}
+thread_local! {static POLICY:RefCell<Option<Policy>>=const{RefCell::new(None)};}
+pub struct Scope(Option<Policy>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        POLICY.with(|p| *p.borrow_mut() = self.0.take());
+    }
+}
+pub fn scope(json: &str) -> Scope {
+    let policy = serde_json::from_str::<serde_json::Value>(json)
+        .ok()
+        .filter(|v| v.is_object())
+        .map(|v| Policy {
+            sorting: v["sorting"].as_u64().unwrap_or(0) as u8,
+            visibility: v["visibility"].as_u64().unwrap_or(3) as u8,
+            show_game_mode: v["showGameMode"].as_bool().unwrap_or(true),
+            limit: v["limit"].as_i64().unwrap_or(80) as i32,
+            height: v["height"].as_i64().unwrap_or(20) as i32,
+            accurate: v["accurate"].as_bool().unwrap_or(true),
+            suffix: v["suffix"].as_bool().unwrap_or(true),
+            rows: v["rows"]
+                .as_object()
+                .into_iter()
+                .flatten()
+                .map(|(k, r)| {
+                    (
+                        k.clone(),
+                        Row {
+                            hidden: r["hidden"].as_bool().unwrap_or(false),
+                            color: r["color"].as_i64().map(|v| v as u32),
+                        },
+                    )
+                })
+                .collect(),
+            error: !v["error"].is_null(),
+            staffs:v["staffs"].as_array().into_iter().flatten().filter_map(|v|v.as_str().map(str::to_owned)).collect(),
+            staff_suffix:v["staffSuffix"].as_str().unwrap_or(" - (Staff)").into(),
+        });
+    Scope(POLICY.with(|p| p.replace(policy)))
+}
+pub fn current() -> Option<Policy> {
+    POLICY.with(|p| p.borrow().clone())
+}
+pub fn ordered<'a>(raw: &'a [TabPlayer], vanilla: Vec<&'a TabPlayer>) -> Vec<&'a TabPlayer> {
+    let Some(p) = current() else {
+        return vanilla.into_iter().take(80).collect();
+    };
+    if p.error || p.limit < 0 {
+        return vec![];
+    }
+    let mut rows = if p.sorting == 0 {
+        vanilla
+    } else {
+        raw.iter().collect()
+    };
+    rows.retain(|r| !p.rows.get(&r.uuid.to_string()).is_some_and(|r| r.hidden));
+    if p.sorting != 0 {
+        rows.sort_by(|a, b| match p.sorting {
+            1 => a.latency.cmp(&b.latency),
+            2 => a
+                .name
+                .encode_utf16()
+                .count()
+                .cmp(&b.name.encode_utf16().count()),
+            3 => {
+                let len = |p: &TabPlayer| {
+                    p.display_name
+                        .as_ref()
+                        .map_or(0, |d| comp_text(d).plain().encode_utf16().count())
+                };
+                len(a).cmp(&len(b))
+            }
+            4 => a.name.encode_utf16().cmp(b.name.encode_utf16()),
+            5 => b.name.encode_utf16().cmp(a.name.encode_utf16()),
+            _ => Ordering::Equal,
+        });
+    }
+    rows.truncate(p.limit as usize);
+    rows
+}
+pub fn name(player: &TabPlayer, mut original: Text) -> Text {
+    let Some(p) = current() else {
+        return original;
+    };
+    if p.visibility & 4 != 0 {
+        original=Text::literal(&player.name);
+    }
+    if p.show_game_mode && p.visibility & 4 == 0 {
+        original.push(Text::literal(format!(
+            " [{}]",
+            match player.game_mode {
+                1 => "C",
+                2 => "A",
+                _ => "S",
+            }
+        )));
+    }
+    if p.staffs.iter().any(|s|s==&player.name){original.push(Text::styled(p.staff_suffix,crate::text::Style::color(0xffb4b4)));}
+    original
+}
+pub fn visible(bit: u8) -> bool {
+    current().is_none_or(|p| p.visibility & bit != 0)
+}
+pub fn dimensions(slots: i32, vanilla: (i32, i32)) -> (i32, i32) {
+    let Some(p) = current() else {
+        return vanilla;
+    };
+    let cols = ((f64::from(slots) / f64::from(p.height.max(1))).ceil() as i32).max(1);
+    (cols, (f64::from(slots) / f64::from(cols)).ceil() as i32)
+}
+pub fn width_extra() -> i32 {
+    if current().is_some_and(|p| p.accurate) {
+        30
+    } else {
+        0
+    }
+}
+pub fn color(id: u128, vanilla: u32) -> u32 {
+    current()
+        .and_then(|p| p.rows.get(&id.to_string()).and_then(|r| r.color))
+        .unwrap_or(vanilla)
+}
+pub fn latency(v: i32) -> Option<(Text, u32)> {
+    let p = current().filter(|p| p.accurate)?;
+    let v = v.clamp(0, 9999);
+    Some((
+        Text::literal(format!("{v}{}", if p.suffix { "ms" } else { "" })),
+        if v < 150 {
+            0xff00e970
+        } else if v < 300 {
+            0xffe7d020
+        } else {
+            0xffd74238
+        },
+    ))
+}
