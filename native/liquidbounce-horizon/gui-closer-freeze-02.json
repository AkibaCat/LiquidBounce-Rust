  "localeSubset": {
    "native/liquidbounce-interop/resources/localization/display_zh_cn.json": {
      "scope": "GUICloser descriptions/English descriptions and its three setting labels only",
      "entries": {
        "descriptions": {
          "liquidbounce.module.guiCloser.description": "如果GUI的标题与指定的模式匹配，则将其关闭。",
          "liquidbounce.module.guiCloser.mode.description": "Matches 匹配完整容器标题；Contains 搜索标题中的匹配部分。两种模式都使用 Java 正则表达式。",
          "liquidbounce.module.guiCloser.filter.description": "按顺序检查容器标题的 Java 正则表达式。首个匹配项会阻止该界面打开，默认表达式为 ^Vote$。",
          "liquidbounce.module.guiCloser.printScreenTitle.description": "在聊天中显示未匹配的容器标题，点击高亮标题即可复制。此设置会保存在本地并显示在界面中，但不会包含在公开配置导出中。"
        },
        "englishDescriptions": {
          "liquidbounce.module.guiCloser.description": "Closes GUIs if their title matches specified patterns.",
          "liquidbounce.module.guiCloser.mode.description": "Matches tests the entire container title; Contains searches for any matching part. Both modes use Java regular expressions.",
          "liquidbounce.module.guiCloser.filter.description": "Ordered Java regular expressions for container titles. The first matching expression prevents that screen from opening. The default is ^Vote$.",
          "liquidbounce.module.guiCloser.printScreenTitle.description": "Print unmatched container titles in chat. Click the highlighted title to copy it. This setting is saved locally and shown in the interface, but omitted from public configuration exports."
        },
        "labels": {
          "Mode": "模式",
          "Filter": "过滤规则",
          "PrintScreenTitle": "显示界面标题"
        }
      },
      "canonicalSha256": "bea6593e8a3bba138c84e9ba403f2bd2898c024b15e6c2c45089efd43c77aa2b"
    },
    "native/liquidbounce-interop/resources/localization/display_zh_tw.json": {
      "scope": "GUICloser descriptions/English descriptions and its three setting labels only",
      "entries": {
        "descriptions": {
          "liquidbounce.module.guiCloser.description": "如果 GUI 的標題符合指定模式，則關閉它。",
          "liquidbounce.module.guiCloser.mode.description": "Matches 比對完整容器標題；Contains 搜尋標題中的相符部分。兩種模式都使用 Java 正規表示式。",
          "liquidbounce.module.guiCloser.filter.description": "依序檢查容器標題的 Java 正規表示式。第一個相符項目會阻止該介面開啟，預設表示式為 ^Vote$。",
          "liquidbounce.module.guiCloser.printScreenTitle.description": "在聊天中顯示未相符的容器標題，點擊醒目標題即可複製。此設定會儲存在本機並顯示於介面中，但不會包含在公開設定匯出中。"
        },
        "labels": {
          "Mode": "模式",
          "Filter": "篩選規則",
          "PrintScreenTitle": "顯示介面標題"
        }
      },
      "canonicalSha256": "77c5d3e44c1e82de806daf721ce0718e870f4e92dff5f6236a7092d943e7dc31"
    }
